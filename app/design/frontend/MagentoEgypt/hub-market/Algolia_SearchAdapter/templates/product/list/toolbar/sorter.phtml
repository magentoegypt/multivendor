<?php
/**
 * Algolia backend toolbar sorter
 *
 * THEME OVERRIDE -- one change from upstream 0.9.1, which writes the loop as
 *     <?php foreach (...): ?> :?>
 * The `?>` closes PHP and the trailing ` :?>` is emitted as LITERAL TEXT once per
 * option, so the dropdown read ":?> Relevance :?> Lowest price ..." on the
 * storefront. Vendor bug, not a customisation -- re-check on any adapter upgrade.
 *
 * @var $block   \Magento\Catalog\Block\Product\ProductList\Toolbar
 * @var $escaper \Magento\Framework\Escaper
 * @var $sorter  \Algolia\SearchAdapter\ViewModel\Sorter
 */


$sorter = $block->getData('algolia_sorter');

$options = $sorter?->getSortingOptions() ?? [];

?>

<div class="toolbar-sorter sorter">
    <label class="sorter-label" for="sorter"><?= $escaper->escapeHtml(__('Sort By')) ?></label>
    <select id="sorter" data-role="sorter" class="sorter-options">
        <?php foreach ($options as $sortingOption): ?>
            <?php $_key = $sortingOption['key']; ?>
            <option value="<?= $escaper->escapeHtmlAttr($_key) ?>"
                <?php if ($block->isOrderCurrent($_key)) :?>
                    selected="selected"
                <?php endif; ?>
            >
                <?= $escaper->escapeHtml(__($sortingOption['label'])) ?>
            </option>
        <?php endforeach; ?>
    </select>
</div>
