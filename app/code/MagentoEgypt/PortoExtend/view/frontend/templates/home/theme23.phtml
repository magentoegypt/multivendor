            margin-left: 0;
        }
        .home-slider .owl-item:nth-child(2n) .products .product-image {
            padding: 0;
        }
        .home-slider .owl-item:nth-child(2n) .products .product-content {
            padding-right: 20px;
            padding-left: 0;
        }
    }
    @media (max-width: 767px) {
        .home-slider .products .product .product-loop-title h3 {
            font-size: 15px;
        }

