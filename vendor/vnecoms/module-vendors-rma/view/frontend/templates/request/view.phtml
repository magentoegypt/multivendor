<script type="text/javascript">
    require([
        'prototype',
        'Vnecoms_RMA/js/rma'
    ], function(){
        var vnecomsRmaFormAdvice = new VnecomsRmaFormAdvice();
        $$('td.item-qty .edit-field').each(function(div){
            div.observe('click',function(){
                //this.hide();
                this.parentNode.select('.edit-field').first().hide();
                this.parentNode.select('.edit-box').first().show();
                this.parentNode.select('.edit-box').first().addClassName('active');
                this.parentNode.select('div.value').first().hide();
            });

        });
        $$('td.item-qty').each(function(td){
            if(td.select('a.rule-param-apply') == false) return;
            td.select('a.rule-param-apply').first().observe('click',function(){
                td.select('div.value').first().show();
                td.select('.edit-box').first().hide();
                td.select('.edit-field').first().show();
                if (td.select('div.validation-advice').length) td.select('div.validation-advice').first().hide();
                var node=this.getAttribute('rel');
                var select= $(node).getAttribute('default');
                if(select){
                    $$('#'+node+' option').each(function(o) {
                        if(o.readAttribute('value') == select) {
                            o.selected = true;
                            throw $break;
                        }
                    });
                }
                else{
                    $(node).value = $(node).defaultValue;
                }
            });
            td.select('a.rule-chooser-trigger').first().observe('click',function(){
                var node = this.getAttribute('rel');
                var value = parseInt($(node).value);
                var maxItem = $('order-item-count-'+node).value;
                if (value != '') {
                    if (!isNaN(value)) {
                        if (value < 0) {
                            vnecomsRmaFormAdvice.showAdvice(node, 'Quantity greater 0');
                            return false;
                        }
                        if (value > maxItem) {
                            vnecomsRmaFormAdvice.showAdvice(node, ' Quantity not greater ' + maxItem);
                            return false;
                        }
                    } else {
                        vnecomsRmaFormAdvice.showAdvice(node, 'Not a number');
                        return false;
                    }
                }else {
                    vnecomsRmaFormAdvice.showAdvice(node, 'Can\'t be empty');
                    return false;
                }
                vnecomsRmaFormAdvice.removeAdvice(node);
                var id= $("item-id-"+node).value;
                new Ajax.Request('<?php echo $block->getUrl('vrma/customer/updateitem')?>', {
                    method:'post',
                    parameters:{
                        id              : id,
                        item_qty        : value,
                        form_key        :"demoformkey"
                    },
                    onComplete: function (transport) {
                        td.select('div.value').first().show();
                        td.select('.edit-box').first().hide();
                        td.select('.edit-field').first().show();
                    },
                    onSuccess: function(transport) {
                        var data = transport.responseText.evalJSON();
                        if(!data.error){
                            $("value_item_"+node).update('<span>'+data.html+'</span>');
                            $(node).setAttribute('default',value);
                        }else{
                            alert(data.message);
                        }
                    },
                });
            });
        });
    });
</script>

<script type="text/javascript">
    require([
        'prototype',
        'jquery',
        'jquery/ui'
    ], function(_,Jquery){
        Jquery("#rma-view-tabs").tabs();

        <?php if($block->isEnableRefundTab()): ?>
        /**
         * process other attribite ticket
         */
        $$('.request-information .edit-field').each(function(div){
            div.observe('click',function(){
                //this.hide();
                this.parentNode.select('.edit-field').first().hide()
                this.parentNode.select('.edit-box').first().show();
                this.parentNode.select('.edit-box').first().addClassName('active');
                this.parentNode.select('div.value').first().hide();
            });

        });

        function isNumeric( obj ) {
            return !Jquery.isArray( obj ) && (obj - parseFloat( obj ) + 1) >= 0;
        }

        $$('a.rule-param-apply').first().observe('click',function(){
            $(this).up('.value').previous().show();
            $(this).up('.edit-box').hide();
            $(this).up('.value').next().show();
            var node=this.getAttribute('rel');
            var select= $(node).getAttribute('default');
            if(select){
                $$('#'+node+' option').each(function(o) {
                    if(o.readAttribute('value') == select) {
                        o.selected = true;
                        throw $break;
                    }
                });
            }
            else{
                $(node).value=$(node).defaultValue;
            }
        });

        $$('a.rule-chooser-trigger').first().observe('click',function(){
            var node=this.getAttribute('rel');
            var value = $(node).value;
            var max_amount_refund = <?php echo $block->getMaxAmountRefund() ?>;
            var _this = this;
            if($(node).hasClassName("required-entry") && value == ""){
                alert("<?php echo __("This is a required field.") ?>");
                return;
            }

            if($(node).hasClassName("validate-number") && !isNumeric(value)){
                alert("<?php echo __("Please enter a valid number in this field.") ?>");
                return;
            }

            if(parseFloat(value) > parseFloat(max_amount_refund)){
                alert("<?php echo __("Please enter a valid amount in this field. Max amount:") ?>"+max_amount_refund);
                return;
            }

            var id=<?php echo $request->getId() ?>;
            new Ajax.Request('<?php echo $block->getUrl('vrma/customer/updateAmount')?>', {
                method:'post',
                parameters:{id : id,amount:value,form_key:"demoformkey"},
                onComplete: function (transport) {
                    $(_this).up('.value').previous().show();
                    $(_this).up('.edit-box').hide();
                    $(_this).up('.value').next().show();
                },
                onSuccess: function(transport) {
                    var data=transport.responseText.evalJSON();
                    if(!data.error){
                        Jquery("#refund_amount").val(data.amount);
                        $("refund_amount").setAttribute('default',data.amount);
                        $$(".customer-amount").first().update(data.amount_html);
                        $("refund-amount-history").update(data.amount_list);
                    }else{
                        alert(data.error);
                    }
                },
            });

        });
        <?php endif ?>

    });
</script>


