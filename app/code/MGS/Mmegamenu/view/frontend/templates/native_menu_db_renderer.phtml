<?php
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$resource = $objectManager->get(\Magento\Framework\App\ResourceConnection::class);
$storeManager = $objectManager->get(\Magento\Store\Model\StoreManagerInterface::class);
$connection = $resource->getConnection();
$store = $storeManager->getStore();
$storeId = (int) $store->getId();
$rootId = (int) $store->getRootCategoryId();

$categoryTable = $resource->getTableName('catalog_category_entity');
$varcharTable = $resource->getTableName('catalog_category_entity_varchar');
$intTable = $resource->getTableName('catalog_category_entity_int');
$urlRewriteTable = $resource->getTableName('url_rewrite');

$entityTypeId = (int) $connection->fetchOne(
    "SELECT entity_type_id FROM eav_entity_type WHERE entity_type_code = 'catalog_category'"
);
$attributes = $connection->fetchPairs(
    "SELECT attribute_code, attribute_id FROM eav_attribute
     WHERE entity_type_id = ? AND attribute_code IN ('name', 'is_active', 'include_in_menu')",
    [$entityTypeId]
);

if (empty($attributes['name']) || empty($attributes['is_active'])) {
    return;
}

$hiddenCategoryIds = [3, 7, 9, 29, 37];
$categories = $connection->fetchAll(
    "SELECT c.entity_id, c.parent_id, c.position,
            COALESCE(name_store.value, name_default.value) AS name,
            COALESCE(active_store.value, active_default.value, 1) AS is_active,
            COALESCE(menu_store.value, menu_default.value, 1) AS include_in_menu,
            ur.request_path
     FROM {$categoryTable} c
     LEFT JOIN {$varcharTable} name_default
        ON name_default.entity_id = c.entity_id
        AND name_default.attribute_id = ?
        AND name_default.store_id = 0
     LEFT JOIN {$varcharTable} name_store
        ON name_store.entity_id = c.entity_id
        AND name_store.attribute_id = ?
        AND name_store.store_id = ?
     LEFT JOIN {$intTable} active_default
        ON active_default.entity_id = c.entity_id
        AND active_default.attribute_id = ?
        AND active_default.store_id = 0
     LEFT JOIN {$intTable} active_store
        ON active_store.entity_id = c.entity_id
        AND active_store.attribute_id = ?
        AND active_store.store_id = ?
     LEFT JOIN {$intTable} menu_default
        ON menu_default.entity_id = c.entity_id
        AND menu_default.attribute_id = ?
        AND menu_default.store_id = 0
     LEFT JOIN {$intTable} menu_store
        ON menu_store.entity_id = c.entity_id
        AND menu_store.attribute_id = ?
        AND menu_store.store_id = ?
     LEFT JOIN {$urlRewriteTable} ur
        ON ur.entity_type = 'category'
        AND ur.entity_id = c.entity_id
        AND ur.store_id = ?
        AND ur.redirect_type = 0
     WHERE (c.parent_id = ? OR c.parent_id IN (
         SELECT entity_id FROM {$categoryTable} WHERE parent_id = ?
     ))
        AND c.entity_id NOT IN (?)
     ORDER BY c.parent_id ASC, c.position ASC, c.entity_id ASC",
    [
        (int) $attributes['name'],
        (int) $attributes['name'],
        $storeId,
        (int) $attributes['is_active'],
        (int) $attributes['is_active'],
        $storeId,
        (int) ($attributes['include_in_menu'] ?? 0),
        (int) ($attributes['include_in_menu'] ?? 0),
        $storeId,
        $storeId,
        $rootId,
        $rootId,
        $hiddenCategoryIds,
    ]
);

$baseUrl = $store->getBaseUrl();
$byParent = [];
foreach ($categories as $category) {
    if (
        !(int) $category['is_active']
        || !(int) $category['include_in_menu']
        || trim((string) $category['name']) === ''
    ) {
        continue;
    }

    $url = !empty($category['request_path'])
        ? $baseUrl . ltrim((string) $category['request_path'], '/')
        : $baseUrl . 'catalog/category/view/id/' . (int) $category['entity_id'];

    $byParent[(int) $category['parent_id']][] = [
        'id' => (int) $category['entity_id'],
        'name' => (string) $category['name'],
        'url' => $url,
    ];
}

$topItems = $byParent[$rootId] ?? [];
$nativeMenuId = (string) ($block->getData('native_menu_id') ?: 'me-main-category-menu');
$nativeMenuClass = (string) ($block->getData('native_menu_class') ?: 'me-category-menu');
$localeCode = (string) $objectManager->get(\Magento\Framework\Locale\ResolverInterface::class)->getLocale();
$isRtl = strpos($localeCode, 'ar') === 0;
$directionClass = $isRtl ? 'me-menu-rtl' : 'me-menu-ltr';
?>
<?php if (!empty($topItems)): ?>
    <style>
