                </block>
            </block>
            <block class="Vnecoms\Quotation\Block\Quotepage\Item\Renderer" as="simple" template="Vnecoms_Quotation::quote/item/default.phtml">
                <block class="Vnecoms\Quotation\Block\Quotepage\Item\Renderer\Actions" name="quotepage.item.renderers.simple.actions" as="actions">
