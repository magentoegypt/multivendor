<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">
					<field id="msg91_api_url" translate="label tooltip" type="text" sortOrder="160" showInDefault="1" showInWebsite="1" showInStore="0">
						<label>Msg91.com API URL</label>
						<config_path>vsms/settings/msg91_api_url</config_path>
						<depends>
							<field id="gateway">msg91</field>
						</depends>
						<comment><![CDATA[https://api.msg91.com/api/v2/sendsms<br /> or <br />https://world.msg91.com/api/v2/sendsms]]></comment>
					</field>
	            	<field id="msg91_api" translate="label tooltip" type="text" sortOrder="161" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Msg91.com Authkey</label>
	                    <config_path>vsms/settings/msg91_api</config_path>
	                    <depends>
	                        <field id="gateway">msg91</field>
	                    </depends>
	                </field>

	                <field id="msg91_sender" translate="label tooltip" type="text" sortOrder="162" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Sender Name</label>
	                    <config_path>vsms/settings/msg91_sender</config_path>
	                    <depends>
	                        <field id="gateway">msg91</field>
	                    </depends>
	                </field>

					<field id="dlt_template_id" translate="label tooltip" type="text" sortOrder="162" showInDefault="1" showInWebsite="1" showInStore="0">
						<label>DLT Template Id</label>
						<config_path>vsms/settings/dlt_template_id</config_path>
						<depends>
							<field id="gateway">msg91</field>
						</depends>
					</field>

					<field id="msg91_unicode" translate="label tooltip" type="select" sortOrder="163" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Unicode Message</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <config_path>vsms/settings/msg91_unicode</config_path>
                        <depends>
                            <field id="gateway">msg91</field>
                        </depends>
                    </field>
                </group>
            </group>
        </section>
    </system>
</config>
