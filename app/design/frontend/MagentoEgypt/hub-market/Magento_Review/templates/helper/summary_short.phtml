<?php
/**
 * Hub Market — the compact rating block on a product card.
 *
 * Overrides Magento_Review::helper/summary_short.phtml. Four departures from
 * core; the first three are QA cycle 1 findings, the fourth is QA cycle 2:
 *
 * 1. THE COUNT IS "(3)", NOT "3 Reviews", and it sits on the same line as the
 *    stars (cycle 2 re-filed the count drifting to the far edge of the card —
 *    the row must never be justify-between).
 *
 * 2. THE TRACK ALWAYS RENDERS. Core emits nothing for a product with no
 *    reviews, which is most of this catalogue, and the grid goes ragged.
 *    An unrated product shows five grey stars and an honest "(0)".
 *
 * 3. NO `id` ATTRIBUTE. Core emits `rating-result_<product id>`, which is not
 *    unique when a product appears in two rails.
 *
 * 4. THE STARS ARE SVG, NOT THE LUMA ICON FONT. QA cycle 2: "the shape of the
 *    stars used on the site is completely different from the theme" — the
 *    reference draws the plump Lucide star (measured live: lucide-star,
 *    viewBox 0 0 24 24, amber fill), the icon font draws a thin serif star.
 *    Fill fraction works by overlaying an identical amber row clipped to
 *    width:P% — identical markup above and below guarantees the clip lines up
 *    in both LTR and RTL.
 *
 * @var \Magento\Review\Block\Product\ReviewRenderer $block
 * @var \Magento\Framework\Escaper $escaper
 */

if (!$block->isReviewEnabled()) {
    return;
}

$hmCount = (int) $block->getReviewsCount();

/*
 * getRatingSummary() is a PERCENTAGE (0-100), not a score out of five — the
 * name reads like the latter and that has caused bugs elsewhere.
 */
$hmPercent = (int) $block->getRatingSummary();

$hmUrl = $block->getReviewsUrl() . ($hmCount > 0 ? '#reviews' : '#review-form');

/*
 * Singular and plural are separate strings — "1 reviews" is wrong in English
 * and Arabic pluralises on 1, 2, 3-10 and 11+, so one string cannot serve.
 */
if ($hmCount === 0) {
    $hmLabel = __('Not yet reviewed');
} elseif ($hmCount === 1) {
    $hmLabel = __('1 review, rated %1 out of 5', round($hmPercent / 20, 1));
} else {
    $hmLabel = __('%1 reviews, rated %2 out of 5', $hmCount, round($hmPercent / 20, 1));
}

/*
 * The Lucide "star" path, captured from the reference build's rendered SVG so
 * the shape is the theme's shape, not an approximation.
 */
$hmStar = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">'
    . '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1'
    . ' .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122'
    . ' 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16'
    . ' 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>';
$hmRow = str_repeat($hmStar, 5);
?>
<div class="product-reviews-summary short hm-rating<?= $hmCount > 0 ? '' : ' hm-rating--empty' ?>">
    <span class="hm-stars" role="img" aria-label="<?= $escaper->escapeHtmlAttr($hmLabel) ?>">
        <span class="hm-stars__track"><?= /* @noEscape */ $hmRow ?></span>
        <span class="hm-stars__fill" style="width: <?= /* @noEscape */ $hmPercent ?>%;"><?= /* @noEscape */ $hmRow ?></span>
    </span>
    <a class="hm-rating__count" href="<?= $escaper->escapeUrl($hmUrl) ?>">
        <?= $escaper->escapeHtml(__('(%1)', $hmCount)) ?>
        <span class="hm-sr-only"><?= $escaper->escapeHtml($hmLabel) ?></span>
    </a>
</div>
