<script>
var URL_ADD_SMS_CREDIT = '<?php echo $block->getAddSmsCreditUrl();?>';
require([
        'jquery',
        'Magento_Ui/js/modal/modal',
        'Magento_Ui/js/modal/alert',
        'mage/mage'
    ],
    function($,modal,alert){
        var smsCreditForm = $("#sms-credit-form");
        
        var options = {
            type: 'slide',
            responsive: true,
            innerScroll: true,
            title: '<?php echo __("Add / Subtract SMS Credit")?>',
            buttons: [{
                text: $.mage.__('Submit'),
                class: 'action primary',
                click: function () {
                    if(smsCreditForm.valid()){
                    	smsCreditForm.trigger('processStart');
                    	$.ajax({
                      		  url: URL_ADD_SMS_CREDIT,
                      		  method: "POST",
                      		  data: { 
                          		  credit : $("#sms-credit-amount").val(),
                          		  description: $("#sms-credit-description").val(),
                          		  vendor_id: '<?php echo $block->getVendor()->getId()?>'
                 			  },
                      		  dataType: "json"
                  		}).done(function( response ){
                      		if(response.error){
                      			smsCreditForm.trigger('processStop');
                      			alert({
                    				modalClass: 'confirm ves-error',
                                    title: "<?php echo __("Add / Edit Credit");?>",
                                    content: response.msg,
                                });
                      		}else{
                      			smsCreditForm.trigger('processStop');
                      			$("#sms-credit-form")[0].reset();
                      			smsCreditTransactionGridJsObject.resetFilter();
                      			$('#sms-credit-popup-mpdal').trigger('closeModal');
                      		}
                  		});
                    }
                }
            }]
        };
        var popup = modal(options, $('#sms-credit-popup-mpdal'));
    }
);
</script>

