        text-align: center;
        margin-bottom: 2.6em;
    }
    .home-slider .products .product-content {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }
    .home-slider .products .product-loop-title {
        -ms-flex: 0 0 100%;
        flex: 0 0 100%;
        width: 100%;
    }
    .home-slider .products .product .price {
        background: #fff;
        font-size: 1em;
        padding: 2.2em 3.25em 2.9em;
        border-radius: 6em;
        font-family: Poppins;
        color: #141a1f;
        font-weight: 700;
        display: -ms-flexbox;
        display: flex;
        align-items: center;
        justify-content: space-between;
        visibility: hidden;
        line-height: 1;
    }
    .home-slider .products .product .price del {
        font-size: 0.55em;
        display: block;
        margin-right: 0.2143em;
        vertical-align: baseline;
        color: #a7a7a7;
        line-height: 1;
    }
    .home-slider .price ins {
        display: inline-block;
        text-decoration: none;
        vertical-align: baseline;
        line-height: 1;
    }
    .home-slider .products .price-wrapper {
        display: block;
        text-align: right;
        font-size: 3em;
    }
    .home-slider .products .add-links-wrap {
