<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Vnecoms\VendorsSearch\Model\Session\Storage" type="Magento\Framework\Session\Storage">
        <arguments>
            <argument name="namespace" xsi:type="string">searchbyvendor</argument>
        </arguments>
    </virtualType>
    <virtualType name="Vnecoms\VendorsSearch\Model\Session" type="Magento\Framework\Session\Generic">
        <arguments>
            <argument name="storage" xsi:type="object">Vnecoms\VendorsSearch\Model\Session\Storage</argument>
        </arguments>
    </virtualType>


    <virtualType name="Vnecoms\VendorsSearch\Block\Navigation\State" type="Magento\LayeredNavigation\Block\Navigation\State">
        <arguments>
            <!--<argument name="catalogLayer" xsi:type="object">Vnecoms\VendorsLayerNavigation\Model\Layer\VendorHomePage</argument>-->
            <argument name="layerResolver" xsi:type="object">Vnecoms\VendorsSearch\Model\Layer\Resolver</argument>
        </arguments>
    </virtualType>

    <type name="Vnecoms\VendorsSearch\Block\Navigation\FilterRenderer">
        <arguments>
            <!--<argument name="catalogLayer" xsi:type="object">Vnecoms\VendorsLayerNavigation\Model\Layer\VendorHomePage</argument>-->
            <argument name="layerResolver" xsi:type="object">Vnecoms\VendorsSearch\Model\Layer\Resolver</argument>
        </arguments>
    </type>


    <type name="Vnecoms\VendorsSearch\Block\SearchResult\ListProduct">
        <arguments>
            <argument name="layerResolver" xsi:type="object">Vnecoms\VendorsSearch\Model\Layer\Resolver</argument>
            <argument name="catalogLayer" xsi:type="object">Magento\Catalog\Model\Layer\Search</argument>
        </arguments>
    </type>

    <type name="Magento\Catalog\Model\Layer\Search">
        <plugin name="filterVendor" type="Vnecoms\VendorsSearch\Plugin\Catalog\Layer" />
    </type>
    
    <virtualType name="Vnecoms\VendorsSearch\Block\Navigation\Search" type="Magento\LayeredNavigation\Block\Navigation\Search">
        <arguments>
            <argument name="visibilityFlag" xsi:type="object">Vnecoms\VendorsLayerNavigation\Model\Layer\VendorHomePage\AvailabilityFlag</argument>
            <argument name="filterList" xsi:type="object">vendorSearchFilterList</argument>
            <argument name="layerResolver" xsi:type="object">Vnecoms\VendorsSearch\Model\Layer\Resolver</argument>
        </arguments>
    </virtualType>

    <virtualType name="vendorSearchFilterList" type="Vnecoms\VendorsSearch\Model\Layer\FilterList">
        <arguments>
            <argument name="filterableAttributes" xsi:type="object">Vnecoms\VendorsSearch\Model\Layer\Search\FilterableAttributeList</argument>
            <argument name="filters" xsi:type="array">
                <item name="attribute" xsi:type="string">Magento\CatalogSearch\Model\Layer\Filter\Attribute</item>
                <item name="price" xsi:type="string">Magento\CatalogSearch\Model\Layer\Filter\Price</item>
                <item name="decimal" xsi:type="string">Magento\CatalogSearch\Model\Layer\Filter\Decimal</item>
                <item name="category" xsi:type="string">Magento\CatalogSearch\Model\Layer\Filter\Category</item>
            </argument>
        </arguments>
    </virtualType>

</config>
