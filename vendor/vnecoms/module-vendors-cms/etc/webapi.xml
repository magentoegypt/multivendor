<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Cms Page -->
    <route url="/V1/vendors/cmsPage/:pageId" method="GET">
        <service class="Vnecoms\VendorsCms\Api\PageRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <route url="/V1/vendors/cmsPage" method="GET">
        <service class="Vnecoms\VendorsCms\Api\PageRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <route url="/V1/vendors/cmsPage" method="POST">
        <service class="Vnecoms\VendorsCms\Api\PageRepositoryInterface" method="save"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>

    <route url="/V1/vendors/cmsPage/:pageId" method="DELETE">
        <service class="Vnecoms\VendorsCms\Api\PageRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>


    <!-- Cms Block -->
    <route url="/V1/vendors/cmsBlock/:blockId" method="GET">
        <service class="Vnecoms\VendorsCms\Api\BlockRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <route url="/V1/vendors/cmsBlock" method="GET">
        <service class="Vnecoms\VendorsCms\Api\BlockRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <route url="/V1/vendors/cmsBlock" method="POST">
        <service class="Vnecoms\VendorsCms\Api\BlockRepositoryInterface" method="save"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>

    <route url="/V1/vendors/cmsBlock/:blockId" method="DELETE">
        <service class="Vnecoms\VendorsCms\Api\BlockRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
</routes>
