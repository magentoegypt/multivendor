    </route>
    <route method="PUT" url="/V1/vnecoms-quotation/:proposalId">
        <service class="Vnecoms\Quotation\Api\ProposalRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Vnecoms_Quotation::Proposal_update"/>
        </resources>
    </route>
    <route method="DELETE" url="/V1/vnecoms-quotation/:proposalId">
        <service class="Vnecoms\Quotation\Api\ProposalRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="Vnecoms_Quotation::Proposal_delete"/>
        </resources>
