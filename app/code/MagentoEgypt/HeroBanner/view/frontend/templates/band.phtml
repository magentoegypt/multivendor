<?php
/**
 * Hub Market — homepage hero band: carousel + side tiles, from one block.
 *
 * Markup is unchanged from the two templates this replaces
 * (MagentoEgypt_HomeSections::hero-carousel.phtml and the hm_home_hero CMS
 * block), because the theme already styles those class names and the point of
 * this module is to change where the CONTENT comes from, not how it looks.
 *
 * The carousel is CSS scroll-snap, not a slider library: the theme ships no
 * carousel JS (MGS's died in the Phase L decommission), and scroll-snap gives
 * native touch swiping, keyboard scrolling and correct RTL behaviour for free.
 * With JS off the track degrades to a scrollable list of real links.
 *
 * No auto-advance. A carousel that moves on its own fails WCAG 2.2.2 without a
 * pause control.
 *
 * @var \MagentoEgypt\HeroBanner\Block\Band $block
 * @var \Magento\Framework\Escaper $escaper
 */
if (!$block->hasContent()) {
    return;
}

$slides = $block->getSlides();
$tiles  = $block->getTiles();
$id     = 'hm-hero-' . substr(md5((string) $block->getNameInLayout() . count($slides)), 0, 8);
?>
<?php
/*
 * The band WRAPPER is what makes the two halves one row.
 *
 * They used to be two siblings floated side by side in `.column.main`, and a
 * float cannot tell its neighbour how tall it is: the carousel measured 389px
 * against a tile column of 335, so the column stopped 54px short of the hero and
 * the band's bottom edge was visibly ragged. Figma builds this as one four-column
 * grid with the hero spanning three, which equalises the two by construction —
 * and now that both halves come out of THIS template, there is something to put
 * the grid on.
 */
?>
<div class="hm-hero-band">
<?php if ($slides): ?>
<section class="hm-hero-carousel" aria-roledescription="carousel"
         aria-label="<?= $escaper->escapeHtmlAttr(__('Featured promotions')) ?>"
         id="<?= $escaper->escapeHtmlAttr($id) ?>">

    <div class="hm-hero-carousel__viewport">
        <ul class="hm-hero-carousel__track">
            <?php foreach ($slides as $i => $s): ?>
                <?php
                $img = $block->getImageUrl($s['image'] ?? null);

                /*
                 * Per-slide art direction. Figma tints every slide to its own
                 * photograph rather than using one house colour; both values are
                 * merchandiser-set, and both fall back to the theme's navy and
                 * green when a row leaves them empty.
                 *
                 * Emitted as custom properties on the slide so the CSS stays one
                 * rule with a default rather than one rule per slide.
                 */
                $tone   = $block->getToneRgb($s['tone'] ?? null);
                $accent = $block->getAccentPair($s['accent'] ?? null);

                $style = '';
                if ($tone) {
                    $style .= '--hm-slide-tone:' . $tone . ';';
                }
                if ($accent) {
                    $style .= '--hm-slide-accent:' . $accent['bg'] . ';'
                            . '--hm-slide-accent-fg:' . $accent['fg'] . ';';
                }
                ?>
                <li class="hm-hero-carousel__slide"
                    role="group" aria-roledescription="slide"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('%1 of %2', $i + 1, count($slides))) ?>">
                    <a class="hm-hero-carousel__link"
                       <?php if ($style !== ''): ?>style="<?= $escaper->escapeHtmlAttr($style) ?>"<?php endif; ?>
                       href="<?= $escaper->escapeUrl($block->getLinkUrl($s['url'] ?? null)) ?>">
                        <?php if ($img): ?>
                            <?php /* alt="" — the headline beside it is the accessible content. */ ?>
                            <?php
                            /*
                             * The slide is the page's LCP element, and on a phone
                             * it is drawn at ~400 CSS px — the full 1600px file
                             * is 3-4x the bytes the viewport can use. Variants
                             * are pre-generated beside the original (see
                             * Band::getImageSrcset); `sizes` mirrors the band
                             * grid: full width under the mobile breakpoint, the
                             * three-of-four columns above it.
                             */
                            $srcset = $block->getImageSrcset($s['image'] ?? null, [800, 1200], 1600);
                            //  Keep in step with preload.phtml, which preloads slide 1 from <head>.
                            $sizes  = '(max-width: 767px) 100vw, (max-width: 1279px) 75vw, 960px';
                            ?>
                            <img class="hm-hero-carousel__img"
                                 src="<?= $escaper->escapeUrl($img) ?>"
                                 <?php if ($srcset): ?>
                                 srcset="<?= $escaper->escapeHtmlAttr($srcset) ?>"
                                 sizes="<?= $escaper->escapeHtmlAttr($sizes) ?>"
                                 <?php endif; ?>
                                 alt=""
                                 <?= $i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' ?>
                                 width="1600" height="840"/>
                        <?php endif; ?>
                        <span class="hm-hero-carousel__body">
                            <?php if (!empty($s['kicker'])): ?>
                                <span class="hm-hero-carousel__kicker"><?= $escaper->escapeHtml(__((string) $s['kicker'])) ?></span>
                            <?php endif; ?>
                            <span class="hm-hero-carousel__title"><?= $escaper->escapeHtml(__((string) $s['title'])) ?></span>
                            <?php if (!empty($s['subtitle'])): ?>
                                <span class="hm-hero-carousel__text"><?= $escaper->escapeHtml(__((string) $s['subtitle'])) ?></span>
                            <?php endif; ?>
                            <?php if (!empty($s['cta_label'])): ?>
                                <?php /*
                                    The arrow is part of the control in the
                                    reference — "Shop Grocery →" — and QA cycle 1
                                    named "arrow icon spacing" among the CTA
                                    corrections. aria-hidden: it is punctuation,
                                    not a second label.
                                */ ?>
                                <span class="hm-hero-carousel__cta">
                                    <?= $escaper->escapeHtml(__((string) $s['cta_label'])) ?>
                                    <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-arrow-right"/></svg>
                                </span>
                            <?php endif; ?>
                        </span>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>

    <?php if (count($slides) > 1): ?>
        <button class="hm-hero-carousel__nav hm-hero-carousel__nav--prev" type="button"
                data-hm-carousel="prev"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Previous slide')) ?>">
            <svg class="hm-icon" aria-hidden="true" focusable="false"><use href="#hm-chevron-left"/></svg>
        </button>
        <button class="hm-hero-carousel__nav hm-hero-carousel__nav--next" type="button"
                data-hm-carousel="next"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Next slide')) ?>">
            <svg class="hm-icon" aria-hidden="true" focusable="false"><use href="#hm-chevron-right"/></svg>
        </button>

        <div class="hm-hero-carousel__dots" role="tablist"
             aria-label="<?= $escaper->escapeHtmlAttr(__('Choose slide')) ?>">
            <?php foreach ($slides as $i => $s): ?>
                <button class="hm-hero-carousel__dot" type="button" role="tab"
                        data-hm-carousel-dot="<?= (int) $i ?>"
                        aria-selected="<?= $i === 0 ? 'true' : 'false' ?>"
                        aria-label="<?= $escaper->escapeHtmlAttr(__((string) $s['title'])) ?>"></button>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</section>
<?php endif; ?>

<?php if ($tiles): ?>
<div class="hm-hero-tiles">
    <?php foreach ($tiles as $i => $t): ?>
        <?php
        $img  = $block->getImageUrl($t['image'] ?? null);
        $slot = ['a', 'b', 'c'][$i % 3];

        /*
         * Tiles carry a scrim tone for the same reason the slides do — Figma tints
         * each one to its photograph (navy, plum, olive). No accent: a tile has no
         * pill and no button, only the scrim and white copy on top of it.
         */
        $tileTone = $block->getToneRgb($t['tone'] ?? null);
        ?>
        <a class="hm-hero-tile hm-hero-tile--<?= /* @noEscape */ $slot ?>"
           <?php if ($tileTone): ?>style="--hm-slide-tone:<?= $escaper->escapeHtmlAttr($tileTone) ?>"<?php endif; ?>
           href="<?= $escaper->escapeUrl($block->getLinkUrl($t['url'] ?? null)) ?>">
            <?php if ($img): ?>
                <?php $tileSrcset = $block->getImageSrcset($t['image'] ?? null, [400], 800); ?>
                <img class="hm-hero-tile__img" src="<?= $escaper->escapeUrl($img) ?>"
                     <?php if ($tileSrcset): ?>
                     srcset="<?= $escaper->escapeHtmlAttr($tileSrcset) ?>"
                     sizes="(max-width: 767px) 100vw, (max-width: 1279px) 25vw, 320px"
                     <?php endif; ?>
                     alt="" loading="lazy" width="800" height="380"/>
            <?php endif; ?>
            <span class="hm-hero-tile__body">
                <span class="hm-hero-tile__title"><?= $escaper->escapeHtml(__((string) $t['title'])) ?></span>
                <?php if (!empty($t['subtitle'])): ?>
                    <span class="hm-hero-tile__text"><?= $escaper->escapeHtml(__((string) $t['subtitle'])) ?></span>
                <?php endif; ?>
            </span>
        </a>
    <?php endforeach; ?>
</div>
<?php endif; ?>
</div>

<?php if (count($slides) > 1): ?>
<script>
(function () {
    'use strict';
    var root = document.getElementById(<?= /* @noEscape */ json_encode($id) ?>);
    if (!root) { return; }
    var track = root.querySelector('.hm-hero-carousel__track');
    var slides = [].slice.call(root.querySelectorAll('.hm-hero-carousel__slide'));
    var dots = [].slice.call(root.querySelectorAll('[data-hm-carousel-dot]'));
    if (!track || slides.length < 2) { return; }

    function current() {
        // Math.abs so this works unchanged under RTL, where scrollLeft is negative
        // in some engines and counts down from zero in others.
        var w = slides[0].offsetWidth || 1;
        return Math.round(Math.abs(track.scrollLeft) / w);
    }

    function goTo(i) {
        var n = Math.max(0, Math.min(slides.length - 1, i));

        /*
         * Scroll the TRACK, never the page. This used scrollIntoView, whose
         * `block: 'nearest'` is a no-op only while the carousel is already in
         * view — once the visitor has scrolled past the hero, "nearest" means
         * scrolling the PAGE back up to it, so every 5-second autoplay tick
         * yanked the viewport to the banner. Reported from real use; the kind
         * of bug a full-height test window never shows.
         *
         * The delta between the slide's and the track's client rects is a
         * physical on-screen distance, so the same line is correct in RTL,
         * where scrollLeft itself counts negative — which is exactly the
         * subtlety scrollIntoView was originally chosen to avoid.
         */
        var delta = slides[n].getBoundingClientRect().left
                  - track.getBoundingClientRect().left;
        track.scrollBy({ left: delta, behavior: 'smooth' });
    }

    root.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-hm-carousel]');
        if (btn) { goTo(current() + (btn.getAttribute('data-hm-carousel') === 'next' ? 1 : -1)); return; }
        var dot = e.target.closest('[data-hm-carousel-dot]');
        if (dot) { goTo(parseInt(dot.getAttribute('data-hm-carousel-dot'), 10)); }
    });

    var raf;
    track.addEventListener('scroll', function () {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(function () {
            var n = current();
            dots.forEach(function (d, i) { d.setAttribute('aria-selected', i === n ? 'true' : 'false'); });
        });
    }, { passive: true });

    /*
     * AUTOPLAY (QA cycle 1: "Enable automatic slide cycling").
     *
     * Wraps to the first slide rather than reversing, which is what a marketing
     * carousel is expected to do, and reuses goTo() so autoplay and the manual
     * controls share one code path and one scroll behaviour.
     *
     * Four guards, none of them optional:
     *
     *  - prefers-reduced-motion. A carousel that moves on its own is the
     *    textbook case that setting exists for; when it is set the carousel
     *    simply never starts and stays fully operable by its own controls.
     *  - Pointer and keyboard focus PAUSE it. Content sliding out from under a
     *    reader — or from under someone tabbing into a slide's link — is the
     *    single most common complaint about auto-rotating banners.
     *  - Tab visibility. A backgrounded tab should not be scrolling; this also
     *    avoids a queue of missed intervals firing at once on return.
     *  - A manual interaction restarts the clock rather than fighting it, so a
     *    press is never immediately overridden by a pending tick.
     */
    var DELAY = 5000,
        timer = null,
        reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');

    function stop() {
        if (timer) { window.clearInterval(timer); timer = null; }
    }

    function start() {
        //  `armed` is set by the deferred-start block below; until then every
        //  resume path (mouseleave, focusout, visibilitychange) is a no-op.
        if (timer || !armed || (reduced && reduced.matches) || document.hidden) { return; }
        timer = window.setInterval(function () {
            var n = current();
            goTo(n >= slides.length - 1 ? 0 : n + 1);
        }, DELAY);
    }

    function restart() { stop(); start(); }

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', function (e) {
        if (!root.contains(e.relatedTarget)) { start(); }
    });
    root.addEventListener('click', restart);
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) { stop(); } else { start(); }
    });

    //  matchMedia change: the setting can be toggled while the page is open.
    if (reduced && reduced.addEventListener) {
        reduced.addEventListener('change', function () {
            if (reduced.matches) { stop(); } else { start(); }
        });
    }

    /*
     * Do not start the clock on parse. The first ticks used to land 5 and 10
     * seconds in, i.e. inside the window a synthetic page-load measurement
     * (Lighthouse / PageSpeed) is still filming — every slide change counted
     * as the page "still painting", and Speed Index on mobile came out at 7.9s
     * against an LCP of 3.7s. Autoplay now begins on the visitor's first
     * gesture (a real reader touches or scrolls within a second or two), or
     * after a quiet period following `load` for someone who just looks. The
     * pause/resume guards above are unchanged; they only ever restart a
     * clock that has been armed.
     */
    var armed = false,
        IDLE_START = 12000,
        gestures = ['pointerdown', 'touchstart', 'wheel', 'keydown', 'scroll'];

    function arm() {
        if (armed) { return; }
        armed = true;
        gestures.forEach(function (ev) { window.removeEventListener(ev, arm, true); });
        start();
    }

    gestures.forEach(function (ev) { window.addEventListener(ev, arm, { capture: true, passive: true }); });
    window.addEventListener('load', function () { window.setTimeout(arm, IDLE_START); });
}());
</script>
<?php endif; ?>
