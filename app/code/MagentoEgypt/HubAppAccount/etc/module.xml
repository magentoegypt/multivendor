<?xml version="1.0"?>
<!--
/**
 * Hub Market customer app: account features (MagentoEgypt_HubAppAccount), a satellite of
 * MagentoEgypt_HubApp.
 *
 * No setup_version: the nullable columns it adds to magentoegypt_push_notification_device come from
 * db_schema.xml, which setup:upgrade applies without one, and a setup_version with no matching
 * setup_module row makes DbStatusValidator answer 500 for the whole storefront.
 *
 * Its schema only references HubApp core types (HmPlatform) and core Magento types (Cart, OrderTotal,
 * CustomerToken, Money), so disabling it never breaks /graphql.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="MagentoEgypt_HubAppAccount">
        <sequence>
            <module name="MagentoEgypt_HubApp"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Quote"/>
            <module name="Magento_CustomerGraphQl"/>
            <module name="Magento_QuoteGraphQl"/>
            <module name="Magento_SalesGraphQl"/>
            <module name="Vnecoms_Credit"/>
            <module name="MagentoEgypt_PushNotification"/>
            <module name="MagentoEgypt_SmsExtend"/>
        </sequence>
    </module>
</config>
