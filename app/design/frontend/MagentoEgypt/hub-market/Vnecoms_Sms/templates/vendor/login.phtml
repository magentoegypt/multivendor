                    "verifyOtpURL": "<?= $escaper->escapeUrl($block->getUrl('vsms/otp_login/verify')) ?>",
                    "login_type_config": "<?= $escaper->escapeJs($smsHelper->getConfigTypeLogin()) ?>",
                    "loginButtonSelector": "#hm-login-form .action.login"
                }
            }
        }
        </script>
        <div class="ves-loadingbox" id="ves-loadingbox">
            <div class="ves-overlay"></div>
            <div class="loading-img"></div>
        </div>
        <div class="sms-otp-dialog" id="sms-otp-dialog">
            <div class="sms-otp-step-1">
                <p><?= $escaper->escapeHtml(__('This extra step shows it’s really you trying to sign in. Click to the button below to send an OTP to your phone number')) ?> <span class="sms-otp-mobile"></span></p>
                <button class="action primary send-otp-btn" id="send-otp-btn"><span><?= $escaper->escapeHtml(__('Get OTP')) ?></span></button>
            </div>
            <div class="sms-otp-step-2">
