<?php
/**
 * Hub Market — the one-paragraph product summary under the price.
 *
 * The reference puts a short description there and Magento's own
 * `product.info.overview` block renders `short_description` — which is empty on
 * every one of the 2304 products in this catalogue, so that block emitted
 * nothing and the slot was simply missing.
 *
 * Rather than write marketing copy for 2304 products, this falls back to the
 * merchant's OWN full description, trimmed to a lead paragraph. Nothing is
 * invented: the words are the ones already on the product. `short_description`
 * still wins whenever someone fills it in, so populating it properly later
 * needs no code change.
 *
 * Not a data patch, deliberately. Writing a derived summary into
 * short_description would bake today's guess at a trim length into 2304 rows
 * and quietly overwrite whatever the merchandising team enters next.
 *
 * @var \Magento\Catalog\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
$hmProduct = $block->getProduct();
if (!$hmProduct) {
    return;
}

/*
 * The store's own language. Used for one thing only: refusing Arabic copy on a
 * store that does not read it — see the script check in the cleaner below.
 *
 * Read off the product's own store rather than through the locale resolver.
 * The resolver would have to arrive as a layout argument, and Magento 2.4
 * accepts only `Block\ArgumentInterface` implementations there — passing
 * `Locale\ResolverInterface` logs "Instance of ArgumentInterface is expected"
 * and drops the whole block, which is how the summary vanished from every
 * product page for one deploy. Wrapping it in a ViewModel would mean a new
 * class with a constructor dependency, and this install runs in production
 * mode, so that is a di:compile — a lot of machinery for a locale string.
 * `Store::getConfig()` is public API and store-scoped, which is exactly what is
 * needed here.
 */
$hmStore = $hmProduct->getStore();
$hmStoreArabic = $hmStore && str_starts_with((string) $hmStore->getConfig('general/locale/code'), 'ar');

/*
 * BOTH sources go through the same cleaner.
 *
 * The first version trusted short_description and only cleaned the description
 * fallback. That was wrong: on this catalogue short_description is where the
 * worst markup lives — one product's is a whole escaped <section> of Vue-era
 * ProductActions markup — and it went straight to the page as literal
 * "&lt;section class=&quot;…" text. Whichever field supplies the text, it gets
 * the same treatment.
 */
$hmClean = static function (string $raw) use ($hmStoreArabic): string {
    /*
     * DECODE FIRST. Several products store their markup escaped — `&lt;br/&gt;`
     * rather than `<br/>`. strip_tags sees that as ordinary text and leaves it,
     * which is exactly how literal tags ended up rendered on the page.
     */
    $raw = html_entity_decode($raw, ENT_QUOTES | ENT_HTML5, 'UTF-8');

    /*
     * <style> and <script> must go WITH their contents. strip_tags drops the
     * tags and keeps the text between them, so a Page Builder body — they all
     * open with a <style> block of #html-body rules — would dump raw CSS here.
     */
    $raw = preg_replace('#<(style|script)\b[^>]*>.*?</\1>#is', ' ', $raw);

    //  Widget/block directives are dropped rather than rendered: a widget
    //  belongs in the description tab, not in a one-line summary.
    $raw = preg_replace('/\{\{[^}]*\}\}/', '', $raw);

    //  Space out block ends before stripping, or "<li>Zippered main
    //  compartment.</li><li>Front zippered pocket.</li>" collapses to
    //  "compartment.Front".
    $raw = preg_replace('#<(br|/p|/li|/h[1-6]|/div|/td|/tr)[^>]*>#i', ' ', $raw);

    $out = trim(preg_replace('/\s+/u', ' ', strip_tags($raw)));

    //  If what survived has no letters, or still carries CSS or attribute
    //  wreckage, there is no sentence to show. An empty slot beats debris.
    if (!preg_match('/\p{L}/u', $out) || preg_match('/[{}<>]|#html-body/', $out)) {
        return '';
    }

    /*
     * AND NOT A SPEC TABLE. Much of this catalogue's short_description is a
     * scraped `label: value label: value` block — phone specs, bag dimensions,
     * fragrance notes. Run through the cleaner it becomes one long colon-strewn
     * line under the price, and every one of those attributes is already in the
     * More Information table a few hundred pixels below it. 112 of the 2,191
     * products with any text at all are shaped this way.
     *
     * Three colons and at most one sentence ending. Both halves are needed:
     * real copy on this catalogue runs 4 to 9 sentence endings against 1 or 2
     * colons, while a spec block runs 3 to 13 colons against none.
     *
     * The sentence test requires whitespace or end-of-string after the stop, or
     * "6.7 بوصة" and "7.3cm/2.9inch" count as sentences and the phone and shoe
     * dumps read as prose — that miscount alone hid six of these.
     *
     * Deliberately conservative. Several descriptions open with a readable lead
     * and a couple of policy bullets before turning into a spec list; those
     * carry 3 sentence endings, survive this test, and keep the lead that the
     * 200-character trim below actually shows.
     */
    $colons = preg_match_all('/[:：]/u', $out);
    if ($colons >= 3 && preg_match_all('/[.!?؟۔](?:\s|$)/u', $out) <= 1) {
        return '';
    }

    /*
     * AND NOT IN THE WRONG SCRIPT. This catalogue was imported from an Arabic
     * source: `short_description` is mostly a scraped spec block and only 3 of
     * 2,304 products carry an English override, so the English store fell back
     * to the default value and printed Arabic under an English title and an
     * English price. Counted before the fix: 145 of the 2,300 products on this
     * website did that.
     *
     * Half the letters is the test rather than "contains any Arabic", so a
     * brand or a size in Arabic inside an otherwise English sentence still
     * reads. Rejecting here rather than at the end means the fallback keeps
     * looking: a product whose short_description is Arabic but whose
     * description is English now shows the English one.
     *
     * ONE-DIRECTIONAL, deliberately. The mirror rule — refusing Latin copy on
     * the Arabic store — would blank the summary on the store this catalogue is
     * actually written for wherever only English copy exists, which trades a
     * real defect for a bigger one. English on an Arabic page is readable;
     * Arabic on an English page is not.
     */
    if (!$hmStoreArabic) {
        $arabic = preg_match_all('/\p{Arabic}/u', $out);
        $letters = preg_match_all('/\p{L}/u', $out);
        if ($letters > 0 && $arabic / $letters > 0.5) {
            return '';
        }
    }

    return $out;
};

$hmSummary = $hmClean((string) $hmProduct->getShortDescription());
if ($hmSummary === '') {
    $hmSummary = $hmClean((string) $hmProduct->getDescription());
}

if ($hmSummary === '') {
    return;
}

/*
 * Trim to a lead paragraph on a WORD boundary, and only when there is enough
 * left over to be worth trimming — cutting "…" onto a 165-character
 * description reads as truncated data rather than as a summary.
 */
$hmLimit = 200;
if (mb_strlen($hmSummary, 'UTF-8') > $hmLimit + 40) {
    $hmCut = mb_substr($hmSummary, 0, $hmLimit, 'UTF-8');
    //  mb_strrpos on a space: Arabic descriptions are multi-byte and a byte
    //  slice would cut mid-codepoint.
    $hmSpace = mb_strrpos($hmCut, ' ', 0, 'UTF-8');
    if ($hmSpace !== false && $hmSpace > $hmLimit * 0.6) {
        $hmCut = mb_substr($hmCut, 0, $hmSpace, 'UTF-8');
    }
    $hmSummary = rtrim($hmCut, " .,;:—-") . '…';
}
?>
<p class="hm-pdp__summary"><?= $escaper->escapeHtml($hmSummary) ?></p>
