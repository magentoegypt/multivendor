        </arguments>
    </type>

    <virtualType name="vendorFilterList" type="Vnecoms\VendorsLayerNavigation\Model\Layer\FilterList">
        <arguments>
            <argument name="filters" xsi:type="array">
                <item name="attribute" xsi:type="string">Vnecoms\VendorsCategory\Model\Layer\Filter\Attribute</item>
                <item name="decimal" xsi:type="string">Vnecoms\VendorsCategory\Model\Layer\Filter\Decimal</item>
                <item name="price" xsi:type="string">Vnecoms\VendorsCategory\Model\Layer\Filter\Price</item>
            </argument>
        </arguments>
    </virtualType>


