<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">magentoegypt_push_notification_listing.magentoegypt_push_notification_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">magentoegypt_push_notification_columns</item>
        <item name="buttons" xsi:type="array">
            <item name="add" xsi:type="array">
                <item name="name" xsi:type="string">add</item>
                <item name="label" xsi:type="string" translate="true">Add New Notification</item>
                <item name="class" xsi:type="string">primary</item>
                <item name="url" xsi:type="string">*/*/new</item>
            </item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add" class="MagentoEgypt\PushNotification\Block\Adminhtml\Notification\AddButton"/>
        </buttons>
        <spinner>magentoegypt_push_notification_columns</spinner>
        <deps>
            <dep>magentoegypt_push_notification_listing.magentoegypt_push_notification_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="magentoegypt_push_notification_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">notification_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MagentoEgypt_PushNotification::manage_notification</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="magentoegypt_push_notification_listing_data_source">
            <settings>
                <requestFieldName>notification_id</requestFieldName>
                <primaryFieldName>notification_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected notifications?</message>
                        <title translate="true">Delete items</title>
                    </confirm>
                    <url path="pushnotification/notification/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="magentoegypt_push_notification_columns">
        <settings>
            <editorConfig>
                <param name="selectProvider" xsi:type="string">magentoegypt_push_notification_listing.magentoegypt_push_notification_listing.magentoegypt_push_notification_columns.ids</param>
                <param name="enabled" xsi:type="boolean">false</param>
                <param name="indexField" xsi:type="string">notification_id</param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">magentoegypt_push_notification_listing.magentoegypt_push_notification_listing.magentoegypt_push_notification_columns_editor</item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids">
            <settings>
                <indexField>notification_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="notification_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="title">
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
            </settings>
        </column>
        <column name="target_type" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="MagentoEgypt\PushNotification\Model\Source\TargetType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Audience</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="MagentoEgypt\PushNotification\Model\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
            </settings>
        </column>
        <column name="recipients_count">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Recipients</label>
                <dataType>text</dataType>
            </settings>
        </column>
        <column name="success_count">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Delivered</label>
                <dataType>text</dataType>
            </settings>
        </column>
        <column name="failure_count">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Failed</label>
                <dataType>text</dataType>
            </settings>
        </column>
        <column name="scheduled_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Scheduled At</label>
            </settings>
        </column>
        <column name="sent_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Sent At</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="MagentoEgypt\PushNotification\Ui\Component\Listing\Column\Actions">
            <settings>
                <indexField>notification_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>120</resizeDefaultWidth>
            </settings>
        </actionsColumn>
    </columns>
</listing>
