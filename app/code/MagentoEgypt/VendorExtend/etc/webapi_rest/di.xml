<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Webapi\Controller\PathProcessor">
        <plugin name="api_locale" type="MagentoEgypt\VendorExtend\Plugin\Controller\PathProcessor"/>
    </type>
    <type name="Vnecoms\VendorsApi\Model\Data\Vendor\ToModel">
        <plugin name="vendor_status_pending" type="MagentoEgypt\VendorExtend\Plugin\Model\Vendor\ToModel"/>
        <!-- Vnecoms' createVendorAccount() var_dump()s and exit()s on any error. -->
        <plugin name="magentoegypt_create_vendor_account" type="MagentoEgypt\VendorExtend\Plugin\VendorsApi\CreateVendorAccount"/>
    </type>
    <!-- Pending / disabled / non-sellers: 403 with the reason, not 401 (helper) or 400 (vendors/me). -->
    <type name="Vnecoms\VendorsApi\Helper\Data">
        <plugin name="magentoegypt_vendor_access_guard" type="MagentoEgypt\VendorExtend\Plugin\VendorsApi\VendorAccessGuard"/>
    </type>
    <type name="Vnecoms\VendorsApi\Model\VendorRepository">
        <plugin name="magentoegypt_vendor_access_guard" type="MagentoEgypt\VendorExtend\Plugin\VendorsApi\VendorAccessGuard"/>
    </type>
</config>
