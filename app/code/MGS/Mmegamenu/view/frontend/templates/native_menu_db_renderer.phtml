            text-align: right !important;
        }
        .me-native-menu-wrapper.me-menu-rtl .me-sub-link {
            direction: rtl !important;
            text-align: right !important;
        }
        .me-native-menu-wrapper.me-menu-ltr .me-category-menu {
            direction: ltr !important;
        }
        .me-native-menu-wrapper.me-menu-ltr .me-sub-panel {
            direction: ltr !important;
            left: 0 !important;
            right: auto !important;
            text-align: left !important;
        }
        .me-native-menu-wrapper.me-menu-ltr .me-sub-link {
            direction: ltr !important;
            text-align: left !important;
        }
        @media (max-width: 991px) {
            .me-native-menu-wrapper {
                height: auto !important;
                min-height: 56px !important;
            }
            .me-native-menu-wrapper .me-category-menu {
                overflow-x: auto !important;
                overflow-y: visible !important;
                padding-bottom: 0 !important;
                scrollbar-width: none !important;
            }
            .me-native-menu-wrapper .me-category-menu::-webkit-scrollbar {
                display: none !important;
            }
        }
    </style>
    <script>
        (function () {
            var currentScript = document.currentScript;
            if (currentScript && currentScript.parentElement) {
                currentScript.parentElement.classList.add('<?php echo $directionClass; ?>');
                currentScript.parentElement.setAttribute('dir', '<?php echo $isRtl ? 'rtl' : 'ltr'; ?>');
            }
        })();
    </script>
    <ul id="<?php echo htmlspecialchars($nativeMenuId, ENT_QUOTES, 'UTF-8'); ?>"
        class="<?php echo htmlspecialchars($nativeMenuClass, ENT_QUOTES, 'UTF-8'); ?>">
        <?php foreach ($topItems as $item): ?>
            <?php $children = $byParent[$item['id']] ?? []; ?>
            <li class="me-nav-item<?php echo !empty($children) ? ' me-has-children' : ''; ?>">
                <a class="me-nav-link" href="<?php echo htmlspecialchars($item['url'], ENT_QUOTES, 'UTF-8'); ?>">
                    <span><?php echo htmlspecialchars($item['name'], ENT_QUOTES, 'UTF-8'); ?></span>
                </a>
                <?php if (!empty($children)): ?>
                    <div class="me-sub-panel" dir="<?php echo $isRtl ? 'rtl' : 'ltr'; ?>">
                        <?php foreach ($children as $child): ?>
                            <a class="me-sub-link" href="<?php echo htmlspecialchars($child['url'], ENT_QUOTES, 'UTF-8'); ?>">
                                <?php echo htmlspecialchars($child['name'], ENT_QUOTES, 'UTF-8'); ?>
                            </a>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>
    <script>
        (function () {
            var menu = document.getElementById('<?php echo addslashes($nativeMenuId); ?>');
            if (!menu || menu.dataset.meDropdownReady === '1') {
                return;
            }
            menu.dataset.meDropdownReady = '1';
            menu.addEventListener('click', function (event) {
                var item = event.target.closest('.me-has-children');
                if (!item || !menu.contains(item)) {
                    return;
                }
                if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
                    return;
                }
                if (!item.classList.contains('me-open')) {
                    event.preventDefault();
                    Array.prototype.forEach.call(menu.querySelectorAll('.me-open'), function (openItem) {
                        if (openItem !== item) {
                            openItem.classList.remove('me-open');
                        }
                    });
                    item.classList.add('me-open');
                }
            });
            document.addEventListener('click', function (event) {
                if (!menu.contains(event.target)) {
                    Array.prototype.forEach.call(menu.querySelectorAll('.me-open'), function (openItem) {
                        openItem.classList.remove('me-open');
                    });
                }
            });
        })();
    </script>
<?php endif; ?>
