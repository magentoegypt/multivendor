<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ves_rma_request_entity" resource="default" engine="innodb" comment="RMA Request Entity">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity Id"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" comment="Website Id"/>
        <column xsi:type="varchar" name="increment_id" length="50" comment="Increment Id"/>
        <column xsi:type="smallint" name="package_opened" nullable="false" default="0" comment="package_opened"/>
        <column xsi:type="varchar" name="type" nullable="false" default="0" length="255" comment="type"/>
        <column xsi:type="smallint" name="reason" nullable="false" default="0" comment="reason"/>
        <column xsi:type="text" name="other_reason" nullable="false" comment="Other Reason"/>
        <column xsi:type="int" name="customer_id" nullable="false" default="0" comment="Customer ID"/>
        <column xsi:type="varchar" name="customer_name" nullable="false" default="" length="255" comment="Customer Name"/>
        <column xsi:type="varchar" name="customer_email" nullable="false" default="" length="255" comment="Customer Email"/>
        <column xsi:type="varchar" name="order_incremental_id" nullable="false" default="" length="255" comment="Order incremental Id"/>
        <column xsi:type="varchar" name="ip_address" nullable="false" default="" length="255" comment="Ip Address"/>
        <column xsi:type="varchar" name="state" nullable="false" default="0" length="255" comment="State"/>
        <column xsi:type="int" name="status" nullable="false" default="0" comment="Status"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated Time"/>
        <column xsi:type="int" name="is_admin_read" nullable="false" comment="Is Admin Read"/>
        <column xsi:type="int" name="is_customer_read" nullable="false" comment="Is Customer Read"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_WEBSITE_ID" table="ves_rma_request_entity"
                    column="website_id" referenceTable="store_website" referenceColumn="website_id"/>
        <constraint xsi:type="unique" referenceId="VES_RMA_REQUEST_ENTITY_UNIQUE_INDEX">
            <column name="increment_id"/>
            <column name="website_id"/>
        </constraint>
    </table>

    <table name="ves_rma_request_entity_datetime" resource="default" engine="innodb" comment="RMA Entity Datetime">
        <column xsi:type="int" name="value_id" nullable="false" identity="true" comment="Value Id"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" default="0" comment="Attribute Id"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" default="0" comment="Entity Id"/>
        <column xsi:type="datetime" name="value" nullable="true" comment="Value"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_DATETIME_ATTRIBUTE_ID" table="ves_rma_request_entity_datetime"
                    column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id"/>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_DATETIME_ENTITY_ID" table="ves_rma_request_entity_datetime"
                    column="entity_id" referenceTable="ves_rma_request_entity" referenceColumn="entity_id"/>
        <constraint xsi:type="unique" referenceId="VES_RMA_REQUEST_ENTITY_DATETIME_UNIQUE_INDEX">
            <column name="entity_id"/>
            <column name="attribute_id"/>
        </constraint>
    </table>

    <table name="ves_rma_request_entity_decimal" resource="default" engine="innodb" comment="RMA Entity Decimal">
        <column xsi:type="int" name="value_id" nullable="false" identity="true" comment="Value Id"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" default="0" comment="Attribute Id"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" default="0" comment="Entity Id"/>
        <column xsi:type="decimal" name="value" scale="4" precision="12" nullable="false" comment="Value"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_DECIMAL_ATTRIBUTE_ID" table="ves_rma_request_entity_decimal"
                    column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id"/>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_DECIMAL_ENTITY_ID" table="ves_rma_request_entity_decimal"
                    column="entity_id" referenceTable="ves_rma_request_entity" referenceColumn="entity_id"/>
        <constraint xsi:type="unique" referenceId="VES_RMA_REQUEST_ENTITY_DECIMAL_UNIQUE_INDEX">
            <column name="entity_id"/>
            <column name="attribute_id"/>
        </constraint>
    </table>

    <table name="ves_rma_request_entity_int" resource="default" engine="innodb" comment="RMA Entity Int">
        <column xsi:type="int" name="value_id" nullable="false" identity="true" comment="Value Id"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" default="0" comment="Attribute Id"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" default="0" comment="Entity Id"/>
        <column xsi:type="int" name="value" nullable="false" default="0" comment="Value"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_INT_ATTRIBUTE_ID" table="ves_rma_request_entity_int"
                    column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id"/>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_INT_ENTITY_ID" table="ves_rma_request_entity_int"
                    column="entity_id" referenceTable="ves_rma_request_entity" referenceColumn="entity_id"/>
        <constraint xsi:type="unique" referenceId="VES_RMA_REQUEST_ENTITY_INT_UNIQUE_INDEX">
            <column name="entity_id"/>
            <column name="attribute_id"/>
        </constraint>
    </table>

    <table name="ves_rma_request_entity_text" resource="default" engine="innodb" comment="RMA Entity Text">
        <column xsi:type="int" name="value_id" nullable="false" identity="true" comment="Value Id"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" default="0" comment="Attribute Id"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" default="0" comment="Entity Id"/>
        <column xsi:type="text" name="value" nullable="false" comment="Value"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_TEXT_ATTRIBUTE_ID" table="ves_rma_request_entity_text"
                    column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id"/>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_TEXT_ENTITY_ID" table="ves_rma_request_entity_text"
                    column="entity_id" referenceTable="ves_rma_request_entity" referenceColumn="entity_id"/>
        <constraint xsi:type="unique" referenceId="VES_RMA_REQUEST_ENTITY_TEXT_UNIQUE_INDEX">
            <column name="entity_id"/>
            <column name="attribute_id"/>
        </constraint>
    </table>

    <table name="ves_rma_request_entity_varchar" resource="default" engine="innodb" comment="RMA Entity Varchar">
        <column xsi:type="int" name="value_id" nullable="false" identity="true" comment="Value Id"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" default="0" comment="Attribute Id"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" default="0" comment="Entity Id"/>
        <column xsi:type="varchar" name="value" length="255" comment="Value"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_VARCHAR_ATTRIBUTE_ID" table="ves_rma_request_entity_varchar"
                    column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id"/>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ENTITY_VARCHAR_ENTITY_ID" table="ves_rma_request_entity_varchar"
                    column="entity_id" referenceTable="ves_rma_request_entity" referenceColumn="entity_id"/>
        <constraint xsi:type="unique" referenceId="VES_RMA_REQUEST_ENTITY_VARCHAR_UNIQUE_INDEX">
            <column name="entity_id"/>
            <column name="attribute_id"/>
        </constraint>
    </table>

    <table name="ves_rma_request_eav_attribute" resource="default" engine="innodb" comment="RMA Eav Attribute">
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" identity="false" comment="Attribute Id"/>
        <column xsi:type="smallint" name="is_visible" unsigned="true" nullable="false" default="1" comment="Is Visible"/>
        <column xsi:type="varchar" name="input_filter" length="255" comment="Input Filter"/>
        <column xsi:type="smallint" name="multiline_count" unsigned="true" nullable="false" default="1" comment="Multiline Count"/>
        <column xsi:type="text" name="validate_rules" comment="Validate Rules"/>
        <column xsi:type="smallint" name="is_system" unsigned="true" nullable="false" default="0" comment="Is System"/>
        <column xsi:type="smallint" name="is_used_in_profile_form" unsigned="true" nullable="false" default="0"
                comment="Is Used in Profile Form"/>
        <column xsi:type="smallint" name="is_used_in_registration_form" unsigned="true" nullable="false" default="0"
                comment="Is Used in Registration Form"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="varchar" name="data_model" length="255" comment="Data Model"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="attribute_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_EAV_ATTRIBUTE_ATTRIBUTE_ID" table="ves_rma_request_eav_attribute"
                    column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id"/>
    </table>

    <table name="ves_rma_request_message" resource="default" engine="innodb" comment="RMA Request Message">
        <column xsi:type="int" name="message_id" unsigned="true" nullable="false" identity="true" comment="Message ID"/>
        <column xsi:type="int" name="request_id" unsigned="true" nullable="true" comment="request_id"/>
        <column xsi:type="mediumtext" name="message" nullable="false" comment="Message"/>
        <column xsi:type="mediumtext" name="attachment" nullable="false" comment="Attachment"/>
        <column xsi:type="varchar" name="type" nullable="false" default="" length="255" comment="Type"/>
        <column xsi:type="text" name="from" nullable="false" comment="From"/>
        <column xsi:type="text" name="to" nullable="false" comment="To"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="message_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_MESSAGE_REQUEST_ID" table="ves_rma_request_message"
                    column="request_id" referenceTable="ves_rma_request_entity" referenceColumn="entity_id"/>
    </table>

    <table name="ves_rma_request_item" resource="default" engine="innodb" comment="RMA Request Item">
        <column xsi:type="int" name="item_id" unsigned="true" nullable="false" identity="true" comment="Item ID"/>
        <column xsi:type="int" name="order_item_id" unsigned="true" nullable="true" comment="order_item_id"/>
        <column xsi:type="int" name="qty" unsigned="true" nullable="true" comment="qty"/>
        <column xsi:type="int" name="request_id" unsigned="true" nullable="true" comment="request_id"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="item_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ITEM_REQUEST_ID" table="ves_rma_request_item"
                    column="request_id" referenceTable="ves_rma_request_entity" referenceColumn="entity_id"/>
    </table>

    <table name="ves_rma_reason" resource="default" engine="innodb" comment="RMA Reason">
        <column xsi:type="int" name="reason_id" unsigned="true" nullable="false" identity="true" comment="Reason ID"/>
        <column xsi:type="text" name="title" nullable="false" comment="Title"/>
        <column xsi:type="smallint" name="is_main" nullable="false" default="0" comment="Is Main"/>
        <column xsi:type="smallint" name="status" nullable="false" default="0" comment="Status"/>
        <column xsi:type="smallint" name="who_pay_shipping" nullable="false" default="0" comment="Who pay shipping"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="reason_id"/>
        </constraint>
    </table>

    <table name="ves_rma_reason_store" resource="default" engine="innodb" comment="RMA Reason Store">
        <column xsi:type="int" name="reason_store_id" unsigned="true" nullable="false" identity="true"
                comment="Reason Store ID"/>
        <column xsi:type="text" name="title" nullable="false" comment="Title"/>
        <column xsi:type="varchar" name="store_id" nullable="false" default="" length="255" comment="Store Id"/>
        <column xsi:type="int" name="reason_id" unsigned="true" nullable="true" comment="reason_id"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="reason_store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REASON_STORE_REASON_ID" table="ves_rma_reason_store"
                    column="reason_id" referenceTable="ves_rma_reason" referenceColumn="reason_id"/>
        <constraint xsi:type="unique" referenceId="VES_RMA_REASON_STORE_UNIQUE_INDEX">
            <column name="reason_id"/>
            <column name="store_id"/>
        </constraint>
    </table>

    <table name="ves_rma_status" resource="default" engine="innodb" comment="RMA Status">
        <column xsi:type="int" name="status_id" unsigned="true" nullable="false" identity="true"
                comment="Status ID"/>
        <column xsi:type="text" name="title" nullable="false" comment="Title"/>
        <column xsi:type="varchar" name="code" nullable="false" default="" length="255" comment="code"/>
        <column xsi:type="smallint" name="is_main" nullable="false" default="0" comment="Is Main"/>
        <column xsi:type="smallint" name="status" nullable="false" default="0" comment="Status"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="status_id"/>
        </constraint>
    </table>

    <table name="ves_rma_status_store" resource="default" engine="innodb" comment="RMA Status Store">
        <column xsi:type="int" name="status_store_id" unsigned="true" nullable="false" identity="true"
                comment="Status Store ID"/>
        <column xsi:type="text" name="title" nullable="false" comment="Title"/>
        <column xsi:type="varchar" name="store_id" nullable="false" default="" length="255" comment="Store Id"/>
        <column xsi:type="int" name="status_id" unsigned="true" nullable="true" comment="status_id"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="status_store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_STATUS_STORE_STATUS_ID" table="ves_rma_status_store"
                    column="status_id" referenceTable="ves_rma_status" referenceColumn="status_id"/>
        <constraint xsi:type="unique" referenceId="VES_RMA_STATUS_STORE_UNIQUE_INDEX">
            <column name="status_id"/>
            <column name="store_id"/>
        </constraint>
    </table>

    <table name="ves_rma_status_state" resource="default" engine="innodb" comment="RMA Status State">
        <column xsi:type="int" name="status_state_id" unsigned="true" nullable="false" identity="true"
                comment="Status State ID"/>
        <column xsi:type="text" name="state" nullable="false" comment="Title"/>
        <column xsi:type="int" name="status_id" unsigned="true" nullable="true" comment="status_id"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="status_state_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_STATUS_STATE_STATUS_ID" table="ves_rma_status_state"
                    column="status_id" referenceTable="ves_rma_status" referenceColumn="status_id"/>
    </table>

    <table name="ves_rma_request_address" resource="default" engine="innodb" comment="RMA Request Address">
        <column xsi:type="int" name="address_id" unsigned="true" nullable="false" identity="true"
                comment="Address ID"/>
        <column xsi:type="int" name="request_id" unsigned="true" nullable="true" comment="request_id"/>
        <column xsi:type="varchar" name="lastname" nullable="false" default="" length="255" comment="lastname"/>
        <column xsi:type="varchar" name="firstname" nullable="false" default="" length="255" comment="firstname"/>
        <column xsi:type="text" name="company" nullable="false" comment="company"/>
        <column xsi:type="varchar" name="telephone" nullable="false" default="" length="255" comment="telephone"/>
        <column xsi:type="varchar" name="fax" nullable="false" default="" length="255" comment="fax"/>
        <column xsi:type="mediumtext" name="address" nullable="false" comment="address"/>
        <column xsi:type="varchar" name="city" nullable="false" default="" length="255" comment="city"/>
        <column xsi:type="varchar" name="country_id" nullable="false" default="" length="255" comment="country_id"/>
        <column xsi:type="varchar" name="region" nullable="false" default="" length="255" comment="region"/>
        <column xsi:type="varchar" name="region_id" nullable="false" default="" length="255" comment="region_id"/>
        <column xsi:type="varchar" name="postcode" nullable="false" default="" length="255" comment="postcode"/>
        <column xsi:type="mediumtext" name="additional_information" nullable="false" comment="additional_information"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="address_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_ADDRESS_REQUEST_ID" table="ves_rma_request_address"
                    column="request_id" referenceTable="ves_rma_request_entity" referenceColumn="entity_id"/>
    </table>

    <table name="ves_rma_request_history" resource="default" engine="innodb" comment="RMA Request History">
        <column xsi:type="int" name="history_id" unsigned="true" nullable="false" identity="true"
                comment="History ID"/>
        <column xsi:type="varchar" name="change_by" nullable="false" default="" length="255" comment="change_by"/>
        <column xsi:type="varchar" name="type" nullable="false" default="" length="255" comment="type"/>
        <column xsi:type="smallint" name="status" nullable="false" default="0" comment="Status"/>
        <column xsi:type="int" name="request_id" unsigned="true" nullable="true" comment="request_id"/>
        <column xsi:type="timestamp" name="created_time" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Creation Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="history_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_REQUEST_HISTORY_REQUEST_ID" table="ves_rma_request_history"
                    column="request_id" referenceTable="ves_rma_request_entity" referenceColumn="entity_id"/>
    </table>

    <table name="ves_rma_reponse" resource="default" engine="innodb" comment="RMA quick reponse">
        <column xsi:type="int" name="reponse_id" unsigned="true" nullable="false" identity="true"
                comment="Reponse ID"/>
        <column xsi:type="text" name="title" nullable="false" comment="Title"/>
        <column xsi:type="mediumtext" name="content" nullable="false" comment="Content"/>
        <column xsi:type="smallint" name="status" nullable="false" default="0" comment="Status"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="reponse_id"/>
        </constraint>
    </table>

    <table name="ves_rma_status_template" resource="default" engine="innodb" comment="RMA Status email template">
        <column xsi:type="int" name="template_id" unsigned="true" nullable="false" identity="true"
                comment="Template ID"/>
        <column xsi:type="varchar" name="template_admin_notify" nullable="false" default="" length="255" comment="Template Admin Notify"/>
        <column xsi:type="varchar" name="template_customer_notify" nullable="false" default="" length="255" comment="Template Customer Notify"/>
        <column xsi:type="int" name="template_status_id" unsigned="true" nullable="true" comment="template_status_id"/>
        <column xsi:type="varchar" name="store_id" nullable="false" default="" length="255" comment="Store Id"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="template_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VES_RMA_STATUS_TEMPLATE_STATUS_ID" table="ves_rma_status_template"
                    column="template_status_id" referenceTable="ves_rma_status" referenceColumn="status_id"/>
        <constraint xsi:type="unique" referenceId="VES_RMA_STATUS_TEMPLATE_UNIQUE_INDEX">
            <column name="template_status_id"/>
            <column name="store_id"/>
        </constraint>
    </table>

    <table name="ves_rma_request_email_queue" resource="default" engine="innodb" comment="RMA Queue Email">
        <column xsi:type="int" name="queue_id" unsigned="true" nullable="false" identity="true"
                comment="Quote ID"/>
        <column xsi:type="varchar" name="email_sender" nullable="false" default="" length="255" comment="email_sender"/>
        <column xsi:type="varchar" name="email_to" nullable="false" default="" length="255" comment="email_to"/>
        <column xsi:type="varchar" name="email_type" nullable="false" default="" length="255" comment="email_type"/>
        <column xsi:type="text" name="addition_information" nullable="false" comment="addition_information"/>
        <column xsi:type="varchar" name="template_id" nullable="false" default="" length="255" comment="template_id"/>
        <column xsi:type="smallint" name="status" nullable="false" default="0" comment="Status"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="queue_id"/>
        </constraint>
    </table>

    <table name="ves_rma_request_num" resource="default" engine="innodb" comment="Custom Ticket Number Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Id"/>
        <column xsi:type="int" name="sequence_value" nullable="true" comment="Sequence value"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>

</schema>
