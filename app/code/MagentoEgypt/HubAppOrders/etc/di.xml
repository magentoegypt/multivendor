<?xml version="1.0"?>
<!--
/**
 * HubAppOrders wiring.
 *
 * HmOrderPackageTrack.tracking_url is built only for carriers with a public tracking page that
 * takes the number in its URL. The codes are Magento's online carriers, the ones Vnecoms offers a
 * seller in the tracking form besides "Custom Value" (VendorsShipping Block\Vendors\Order\Tracking).
 * %s is the URL-encoded tracking number. A carrier added here gets a "Track parcel" button in the
 * app; a code that is not listed (custom, above all) shows the carrier and the number to copy.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MagentoEgypt\HubAppOrders\Model\Package\TrackingUrl">
        <arguments>
            <argument name="templates" xsi:type="array">
                <item name="dhl" xsi:type="string">https://www.dhl.com/global-en/home/tracking/tracking-express.html?submit=1&amp;tracking-id=%s</item>
                <item name="fedex" xsi:type="string">https://www.fedex.com/fedextrack/?trknbr=%s</item>
                <item name="ups" xsi:type="string">https://www.ups.com/track?tracknum=%s</item>
                <item name="usps" xsi:type="string">https://tools.usps.com/go/TrackConfirmAction?tLabels=%s</item>
            </argument>
        </arguments>
    </type>
</config>
