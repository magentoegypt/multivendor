#!/bin/bash
# Hub Market: WebP copies of cached catalog images (ClickUp 14zb93nuuez / QA CL036-TC63, 2026-09-24).
#
# Magento 2.4.8 has no built-in WebP conversion ("web/webp/enable" does not exist). Product cards
# (hub-market theme, Magento_Catalog::product/image_with_borders.phtml) offer "<cached image>.webp"
# through <picture>. This script writes those files next to each cached JPEG/PNG with cwebp. Where
# WebP would not be smaller it writes an empty "<image>.nowebp" marker instead, and Apache
# (hub-market-backend.conf) answers the .webp URL with the original image, as it does for images
# this script has not reached yet.
#
# Usage: hm-webp-sync [recent|all]
#   recent  images written in the last 20 minutes (crontab, every 10 minutes)
#   all     every cached image without an up-to-date .webp (nightly, and the first run)
#
# Encoding (2026-10-01): the WebP is made from the ORIGINAL upload in pub/media/catalog/product/, resized to
# the cached image's exact size (fit, then padded with white, or kept transparent for PNG, as Magento frames
# it). Before, it was made from the cached JPEG, which Magento had already compressed at quality 80, so every
# WebP was compressed twice. Settings: -q 88 -m 6 -sharp_yuv (sharper colour edges). On a 30-image sample the
# error against the original halved. When the original is missing, the cached image is used as before.
# A WebP is kept unless it is more than 10% larger than the cached JPEG/PNG; otherwise the ".nowebp" marker
# makes Apache serve the cached file. Existing .webp files are never redone; only new or changed cache
# images are encoded.
set -euo pipefail

CACHE=${HM_WEBP_CACHE:-/var/www/multi.magento2.click/pub/media/catalog/product/cache}
ORIGINALS=${CACHE%/cache}
CWEBP=(cwebp -quiet -q 88 -m 6 -sharp_yuv -metadata none)
TMPDIR_HM=$(mktemp -d /dev/shm/hm-webp.XXXXXX)
trap 'rm -rf "$TMPDIR_HM"' EXIT

# encode <cached image> <output.webp>: from the original when it exists, else from the cached image.
encode() {
    local src=$1 out=$2 rel orig w h ref
    rel=${src#"$CACHE"/}; rel=${rel#*/}          # drop "<size hash>/"
    orig="$ORIGINALS/$rel"
    if [[ -f "$orig" ]] && read -r w h < <(identify -format '%w %h' "$src" 2>/dev/null); then
        ref="$TMPDIR_HM/ref.png"
        if [[ ${src,,} == *.png ]]; then
            convert "$orig[0]" -filter Lanczos -resize "${w}x${h}" -background none -gravity center \
                -extent "${w}x${h}" PNG32:"$ref" 2>/dev/null
        else
            convert "$orig[0]" -filter Lanczos -resize "${w}x${h}" -background white -gravity center \
                -extent "${w}x${h}" -alpha remove PNG24:"$ref" 2>/dev/null
        fi && [[ -s "$ref" ]] && "${CWEBP[@]}" "$ref" -o "$out" 2>/dev/null && return 0
    fi
    "${CWEBP[@]}" "$src" -o "$out" 2>/dev/null
}

mode=${1:-recent}
case "$mode" in
    recent) age=(-mmin -20) ;;
    all) age=() ;;
    *) echo "usage: $0 [recent|all]" >&2; exit 2 ;;
esac

made=0; kept=0; failed=0
while IFS= read -r -d '' src; do
    out="$src.webp"
    marker="$src.nowebp"
    [[ -f "$out" && ! "$src" -nt "$out" ]] && continue
    [[ -f "$marker" && ! "$src" -nt "$marker" ]] && continue
    tmp="$out.tmp$$"
    if encode "$src" "$tmp"; then
        if (( $(stat -c %s "$tmp") * 10 <= $(stat -c %s "$src") * 11 )); then
            mv -f "$tmp" "$out"
            rm -f "$marker"
            made=$((made + 1))
        else
            rm -f "$tmp" "$out"
            : > "$marker"
            kept=$((kept + 1))
        fi
    else
        rm -f "$tmp"
        failed=$((failed + 1))
    fi
done < <(find "$CACHE" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) "${age[@]}" -print0)

echo "$(date -u +%FT%TZ) hm-webp-sync $mode: $made written, $kept kept original (WebP not smaller), $failed failed"
