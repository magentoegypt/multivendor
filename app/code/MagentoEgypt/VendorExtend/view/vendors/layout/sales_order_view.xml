<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="default_order_items_renderer">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">MagentoEgypt_VendorExtend::order/view/items/renderer/default.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="order_totals">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">MagentoEgypt_VendorExtend::order/totals.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="order_info" template="MagentoEgypt_VendorExtend::order/view/info.phtml" />
    </body>
</page>
