<?php
/**
 * Hub Market — the one-paragraph product summary under the price.
 *
 * The reference puts a short description there and Magento's own
 * `product.info.overview` block renders `short_description` — which is empty on
 * every one of the 2304 products in this catalogue, so that block emitted
 * nothing and the slot was simply missing.
 *
 * Rather than write marketing copy for 2304 products, this falls back to the
 * merchant's OWN full description, trimmed to a lead paragraph. Nothing is
 * invented: the words are the ones already on the product. `short_description`
 * still wins whenever someone fills it in, so populating it properly later
 * needs no code change.
 *
 * Not a data patch, deliberately. Writing a derived summary into
 * short_description would bake today's guess at a trim length into 2304 rows
 * and quietly overwrite whatever the merchandising team enters next.
 *
 * @var \Magento\Catalog\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
$hmProduct = $block->getProduct();
if (!$hmProduct) {
    return;
}

/*
 * BOTH sources go through the same cleaner.
 *
 * The first version trusted short_description and only cleaned the description
 * fallback. That was wrong: on this catalogue short_description is where the
 * worst markup lives — one product's is a whole escaped <section> of Vue-era
 * ProductActions markup — and it went straight to the page as literal
 * "&lt;section class=&quot;…" text. Whichever field supplies the text, it gets
 * the same treatment.
 */
$hmClean = static function (string $raw): string {
    /*
     * DECODE FIRST. Several products store their markup escaped — `&lt;br/&gt;`
     * rather than `<br/>`. strip_tags sees that as ordinary text and leaves it,
     * which is exactly how literal tags ended up rendered on the page.
     */
    $raw = html_entity_decode($raw, ENT_QUOTES | ENT_HTML5, 'UTF-8');

    /*
     * <style> and <script> must go WITH their contents. strip_tags drops the
     * tags and keeps the text between them, so a Page Builder body — they all
     * open with a <style> block of #html-body rules — would dump raw CSS here.
     */
    $raw = preg_replace('#<(style|script)\b[^>]*>.*?</\1>#is', ' ', $raw);

    //  Widget/block directives are dropped rather than rendered: a widget
    //  belongs in the description tab, not in a one-line summary.
    $raw = preg_replace('/\{\{[^}]*\}\}/', '', $raw);

    //  Space out block ends before stripping, or "<li>Zippered main
    //  compartment.</li><li>Front zippered pocket.</li>" collapses to
    //  "compartment.Front".
    $raw = preg_replace('#<(br|/p|/li|/h[1-6]|/div|/td|/tr)[^>]*>#i', ' ', $raw);

    $out = trim(preg_replace('/\s+/u', ' ', strip_tags($raw)));

    //  If what survived has no letters, or still carries CSS or attribute
    //  wreckage, there is no sentence to show. An empty slot beats debris.
    if (!preg_match('/\p{L}/u', $out) || preg_match('/[{}<>]|#html-body/', $out)) {
        return '';
    }
    return $out;
};

$hmSummary = $hmClean((string) $hmProduct->getShortDescription());
if ($hmSummary === '') {
    $hmSummary = $hmClean((string) $hmProduct->getDescription());
}

if ($hmSummary === '') {
    return;
}

/*
 * Trim to a lead paragraph on a WORD boundary, and only when there is enough
 * left over to be worth trimming — cutting "…" onto a 165-character
 * description reads as truncated data rather than as a summary.
 */
$hmLimit = 200;
if (mb_strlen($hmSummary, 'UTF-8') > $hmLimit + 40) {
    $hmCut = mb_substr($hmSummary, 0, $hmLimit, 'UTF-8');
    //  mb_strrpos on a space: Arabic descriptions are multi-byte and a byte
    //  slice would cut mid-codepoint.
    $hmSpace = mb_strrpos($hmCut, ' ', 0, 'UTF-8');
    if ($hmSpace !== false && $hmSpace > $hmLimit * 0.6) {
        $hmCut = mb_substr($hmCut, 0, $hmSpace, 'UTF-8');
    }
    $hmSummary = rtrim($hmCut, " .,;:—-") . '…';
}
?>
<p class="hm-pdp__summary"><?= $escaper->escapeHtml($hmSummary) ?></p>
