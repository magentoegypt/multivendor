<?xml version="1.0" encoding="UTF-8"?>
<!--
    App Home Sections grid (Figma G2a): the app Home in admin order.
    Position, active and the two titles are editable in place; the form owns
    everything else. Mass enable / disable / delete purge the cached Homes once.
-->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">magentoegypt_hubapp_section_listing.magentoegypt_hubapp_section_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add Section</label>
            </button>
        </buttons>
        <spinner>magentoegypt_hubapp_section_columns</spinner>
        <deps>
            <dep>magentoegypt_hubapp_section_listing.magentoegypt_hubapp_section_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="magentoegypt_hubapp_section_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">section_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MagentoEgypt_HubApp::home_sections</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="magentoegypt_hubapp_section_listing_data_source">
            <settings>
                <requestFieldName>section_id</requestFieldName>
                <primaryFieldName>section_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="enable">
                <settings>
                    <url path="magentoegypt_hubapp/section/massStatus">
                        <param name="status">1</param>
                    </url>
                    <type>enable</type>
                    <label translate="true">Enable</label>
                </settings>
            </action>
            <action name="disable">
                <settings>
                    <url path="magentoegypt_hubapp/section/massStatus">
                        <param name="status">0</param>
                    </url>
                    <type>disable</type>
                    <label translate="true">Disable</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected sections? The app stops showing them on its next Home request.</message>
                        <title translate="true">Delete sections</title>
                    </confirm>
                    <url path="magentoegypt_hubapp/section/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
            <action name="edit">
                <settings>
                    <callback>
                        <target>editSelected</target>
                        <provider>magentoegypt_hubapp_section_listing.magentoegypt_hubapp_section_listing.magentoegypt_hubapp_section_columns_editor</provider>
                    </callback>
                    <type>edit</type>
                    <label translate="true">Edit</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="magentoegypt_hubapp_section_columns">
        <settings>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="magentoegypt_hubapp/section/inlineEdit"/>
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <param name="indexField" xsi:type="string">section_id</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="selectProvider" xsi:type="string">magentoegypt_hubapp_section_listing.magentoegypt_hubapp_section_listing.magentoegypt_hubapp_section_columns.ids</param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">magentoegypt_hubapp_section_listing.magentoegypt_hubapp_section_listing.magentoegypt_hubapp_section_columns_editor</item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>

        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>section_id</indexField>
            </settings>
        </selectionsColumn>

        <column name="section_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>

        <column name="position" sortOrder="20">
            <settings>
                <filter>textRange</filter>
                <editor>
                    <validation>
                        <rule name="validate-number" xsi:type="boolean">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Position</label>
                <sorting>asc</sorting>
            </settings>
        </column>

        <column name="type" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <options class="MagentoEgypt\HubApp\Model\Source\SectionType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Type</label>
            </settings>
        </column>

        <column name="title_en" sortOrder="40">
            <settings>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Title (English)</label>
            </settings>
        </column>

        <column name="title_ar" sortOrder="50">
            <settings>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Title (Arabic)</label>
            </settings>
        </column>

        <column name="audience" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="MagentoEgypt\HubApp\Model\Source\Audience"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Audience</label>
            </settings>
        </column>

        <column name="starts_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="70">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Show From</label>
            </settings>
        </column>

        <column name="ends_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Show Until</label>
            </settings>
        </column>

        <column name="store_id" class="Magento\Store\Ui\Component\Listing\Column\Store" sortOrder="90">
            <settings>
                <label translate="true">Store View</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
            </settings>
        </column>

        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="100">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Enabledisable"/>
                <filter>select</filter>
                <editor>
                    <editorType>select</editorType>
                </editor>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>

        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="110">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>

        <actionsColumn name="actions" class="MagentoEgypt\HubApp\Ui\Component\Listing\Column\SectionActions" sortOrder="120">
            <settings>
                <indexField>section_id</indexField>
                <resizeEnabled>false</resizeEnabled>
            </settings>
        </actionsColumn>
    </columns>
</listing>
