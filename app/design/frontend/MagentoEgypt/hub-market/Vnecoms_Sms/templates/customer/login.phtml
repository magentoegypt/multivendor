            allowDropdown: <?= /* @noEscape */ strtolower($smsHelper->getAllowCountryDropdown()) ?>,
            onlyCountries: <?= /* @noEscape */ $smsHelper->isAllowedAllCountries() ? '[]' : json_encode(explode(',', $smsHelper->getAllowedCountries())) ?>,
            preferredCountries: <?= /* @noEscape */ json_encode(explode(',', $smsHelper->getPreferredCountries())) ?>,
            geoIpUrl: '<?= $escaper->escapeJs($smsHelper->getGeoIpDatabase() ? $block->getUrl('vsms/geoip') : 'https://ipinfo.io') ?>',
