	<virtualType name="Vnecoms\Quotation\FileUploader" type="Magento\Catalog\Model\ImageUploader">
		<arguments>
			<argument name="baseTmpPath" xsi:type="string">ves_quotation/tmp/attachments</argument>
			<argument name="basePath" xsi:type="string">ves_quotation/attachments</argument>
			<argument name="allowedExtensions" xsi:type="array">
				<item name="jpg" xsi:type="string">jpg</item>
				<item name="jpeg" xsi:type="string">jpeg</item>
				<item name="gif" xsi:type="string">gif</item>
				<item name="png" xsi:type="string">png</item>
			</argument>
		</arguments>
	</virtualType>

	<type name="Vnecoms\Quotation\Controller\Message\Upload">
		<arguments>
			<argument name="fileUploader" xsi:type="object">Vnecoms\Quotation\FileUploader</argument>
		</arguments>
	</type>

	<type name="Vnecoms\Quotation\Controller\Message\Send">
		<arguments>
			<argument name="imageUploader" xsi:type="object">Vnecoms\Quotation\FileUploader</argument>
		</arguments>
	</type>

	<virtualType name="Vnecoms\Quotation\Model\Quote\Pdf\Config" type="Magento\Sales\Model\Order\Pdf\Config">
		<arguments>
			<argument name="dataStorage" xsi:type="object">quotePdfConfigDataStorage</argument>
		</arguments>
	</virtualType>

	<type name="Vnecoms\Quotation\Model\Quote\Pdf">
		<arguments>
			<argument name="pdfConfig" xsi:type="object">Vnecoms\Quotation\Model\Quote\Pdf\Config</argument>
		</arguments>
	</type>

	<virtualType name="Vnecoms\Quotation\Model\Quote\Pdf\Config\Reader" type="Magento\Sales\Model\Order\Pdf\Config\Reader">
		<arguments>
			<argument name="fileName" xsi:type="string">quote_pdf.xml</argument>
			<argument name="converter" xsi:type="object">Magento\Sales\Model\Order\Pdf\Config\Converter</argument>
			<argument name="schemaLocator" xsi:type="object">Vnecoms\Quotation\Model\Quote\Pdf\Config\SchemaLocator</argument>
		</arguments>
	</virtualType>

	<virtualType name="quotePdfConfigDataStorage" type="Magento\Framework\Config\Data">
		<arguments>
			<argument name="reader" xsi:type="object">Vnecoms\Quotation\Model\Quote\Pdf\Config\Reader</argument>
			<argument name="cacheId" xsi:type="string">quote_pdf_config</argument>
		</arguments>
	</virtualType>


