                <input type="text" name="sms_otp_code" id="sms-otp-input" value="" class="input-text required-entry" placeholder="<?= $escaper->escapeHtmlAttr(__('Your OTP')) ?>"/>
                <button class="action primary send-otp-btn" id="verify-otp-btn"><span><?= $escaper->escapeHtml(__('Verify')) ?></span></button>
                <a href="#" class="resend-otp-btn" id="resend-otp-btn" data-time="<?= $escaper->escapeHtmlAttr($smsHelper->getOtpResendPeriodTime()) ?>"><?= $escaper->escapeHtml(__('Resend after %1 seconds', $smsHelper->getOtpResendPeriodTime())) ?></a>
            </div>
        </div>
    <?php endif; ?>
</div>
