<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Vnecoms\VendorsCms\Block\Vendors\Page\Grid\Renderer\Action\UrlBuilder">
        <arguments>
            <argument name="frontendUrlBuilder" xsi:type="object">Magento\Framework\Url</argument>
        </arguments>
    </type>

    <virtualType name="Vnecoms\VendorsCms\Block\Rule\Conditions" type="Magento\Rule\Block\Conditions"/>

    <type name="Vnecoms\VendorsCms\Block\App\Conditions">
        <arguments>
            <!--<argument name="conditions" xsi:type="object">Vnecoms\VendorsCms\Block\Conditions</argument>-->
            <argument name="vendorRule" xsi:type="object">Vnecoms\VendorsCms\Model\Rule\Rule</argument>
        </arguments>
    </type>

    <virtualType name="Vnecoms\VendorsCms\Ui\Component\Form\Element\BlockWysiwyg" type="Vnecoms\VendorsPageBuilder\Ui\Component\Form\Element\Wysiwyg">
        <arguments>
            <argument name="overrideSnapshot" xsi:type="boolean">true</argument>
        </arguments>
    </virtualType>

    <preference for="Magento\Ui\Component\Wysiwyg\ConfigInterface" type="Vnecoms\VendorsCms\Model\Wysiwyg\Config" />

</config>

