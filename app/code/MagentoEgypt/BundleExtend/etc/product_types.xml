<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Catalog:etc/product_types.xsd">
    <type name="new_bundle"
          label="New Bundle"
          modelInstance="Magento\Bundle\Model\Product\Type"
          composite="true"
          indexPriority="40"
          sortOrder="55">
        <priceModel instance="Magento\Bundle\Model\Product\Price"/>
        <!-- Custom price indexer: the core bundle indexer hard-filters type_id='bundle' and skips
             new_bundle, leaving these products with no catalog_product_index_price rows (which the
             frontend product collection INNER JOINs), so they never appear in listings/search.
             This copy filters type_id='new_bundle'. -->
        <indexerModel instance="MagentoEgypt\BundleExtend\Model\ResourceModel\Indexer\Price"/>
        <stockIndexerModel instance="Magento\Bundle\Model\ResourceModel\Indexer\Stock"/>
        <allowedSelectionTypes>
            <type name="simple"/>
            <type name="virtual"/>
            <type name="configurable"/>
        </allowedSelectionTypes>
        <customAttributes>
            <attribute name="refundable" value="true"/>
        </customAttributes>
    </type>
</config>
