<?xml version="1.0"?>
<!--
/**
 * Hub Market cart heading semantics.
 *
 * Core renders the cart summary title through Magento_Theme::text.phtml as
 * `<strong class="summary title">Summary</strong>` — visually a section heading,
 * semantically nothing. text.phtml already takes the tag as an argument, so this
 * needs no template override at all.
 *
 * The class is kept so every existing rule that targets `.summary.title` still
 * applies; only the tag and the wording change. "Order Summary" matches the Figma
 * reference and already has an Arabic translation shipped in VendorExtend's
 * ar_SA.csv, so /ar/ renders it too.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.cart.summary.title">
            <arguments>
                <argument translate="true" name="text" xsi:type="string">Order Summary</argument>
                <argument name="tag" xsi:type="string">h2</argument>
                <argument name="css_class" xsi:type="string">summary title</argument>
            </arguments>
        </referenceBlock>

        <!--
            Per-seller grouping for the line items. The reference draws one card
            per vendor with the seller named across the top; this supplies the
            grouping and the shop-page URL. See the note at the head of the
            theme's cart/form.phtml.
        -->
        <referenceBlock name="checkout.cart.form">
            <arguments>
                <argument name="vendor_groups" xsi:type="object">MagentoEgypt\CheckoutExtend\ViewModel\CartVendors</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="page.main.title" template="Magento_Theme::html/title-cart.phtml">
            <arguments>
                <argument name="view_model" xsi:type="object">MagentoEgypt\CheckoutExtend\ViewModel\CartTitle</argument>
            </arguments>
        </referenceBlock>

        <!--
            THE ORDER OF THE SUMMARY RAIL.

            Core stacks it: title, shipping estimator, totals, coupon, checkout
            button. Measured against the reference, that put 101px of collapsed
            accordion between the heading and the first number, and another 93px
            between the Order Total and the button that acts on it — so the two
            things a shopper is looking for, the sum and the way to pay it, were
            the two furthest apart.

            The reference's sequence is numbers, action, reassurance. That is what
            this produces:

                Order Summary -> totals -> Proceed to Checkout -> trust list
                              -> Estimate Shipping and Tax -> Apply Discount Code

            Neither accordion is removed. Both are real features the static
            prototype simply does not have, both are collapsed by default, and
            both belong below the fold of the rail rather than in front of the
            total — which is also the conventional placement for a coupon field.
        -->
        <referenceContainer name="cart.summary">
            <!--
                Continue Shopping directly under Proceed to Checkout, which is
                where the reference pairs them. It used to live at the bottom
                left of the item list — the two options a shopper is choosing
                between were in opposite corners of the page. Uses the cart
                block so it shares getContinueShoppingUrl() with the copy it
                replaces.
            -->
            <!--
                Free-shipping notice, directly under the totals and above the
                checkout button, which is where the reference puts it. The
                Uses Magento\Checkout\Block\Cart, an already compiled class, so
                it needs no DI compile. See the template for why the view model
                version cannot ship without one.

                before="checkout.cart.methods.bottom", not "checkout.cart.methods":
                the latter is a CONTAINER NESTED INSIDE the former, not a sibling
                in cart.summary, so referencing it placed the block nowhere and it
                rendered not at all. Sibling references only.
            -->
            <block class="Magento\Checkout\Block\Cart"
                   name="checkout.cart.summary.freeshipping"
                   template="Magento_Checkout::cart/freeshipping.phtml"
                   after="checkout.cart.totals.container"/>
            <block class="Magento\Checkout\Block\Cart"
                   name="checkout.cart.summary.continue"
                   template="Magento_Checkout::cart/continue.phtml"
                   after="checkout.cart.methods.bottom"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="checkout.cart.summary.trust"
                   template="Magento_Checkout::cart/trust.phtml"
                   after="checkout.cart.summary.continue"/>
        </referenceContainer>

        <!--
            "Check Out with Multiple Addresses" removed from the cart. It sat
            directly under Proceed to Checkout as a second, competing call to
            action, and the reference has no such flow.

            This hides the entry point, not the feature: Magento_Multishipping is
            still enabled and /multishipping/checkout/ still answers. To retire it
            properly, set multishipping/options/checkout_multiple to 0 in admin
            (Stores > Configuration > Sales > Multishipping Settings) — that also
            closes the route and drops it from the account area.
        -->
        <referenceBlock name="checkout.cart.methods.multishipping" remove="true"/>

        <!--
            Cross-sell — "More Choices:" — REMOVED, per QA cycle 1: the reference
            cart ends at the summary. Same story as the PDP upsell, and the same
            reason config is not the lever: MGS_ThemeSettings supplies the title
            (catalog/themesettings/crosssell_title), not the block.

            checkout/cart/crosssell_enabled would also switch it off, but in
            admin rather than in the theme — which would silently change the Luma
            website on this same installation too.
        -->
        <referenceBlock name="checkout.cart.crosssell" remove="true"/>

        <!--
            QA cycle 2 item 4: the prototype's order summary is totals, the two
            buttons and the trust bullets — no "Estimate Shipping and Tax" and
            no "Apply Discount Code" accordions. Coupons still apply at checkout
            payment step if that block is ever restored there.
        -->
        <!-- NOT the shipping estimator block: cart/shipping.phtml is where
             window.checkoutConfig is written for every cart-page script, and
             removing it threw "reading 'quoteData'" on load. It is hidden in
             _hm-qa02-recheck.less instead. -->
        <referenceBlock name="checkout.cart.coupon" remove="true"/>

        <move element="checkout.cart.shipping" destination="cart.summary" after="checkout.cart.summary.trust"/>
        <move element="checkout.cart.coupon"   destination="cart.summary" after="checkout.cart.shipping"/>
    </body>
</page>
