<?php
/**
 * Hub Market "Recent Orders" on the account dashboard — the same card as the
 * order history, so the two pages do not disagree about what an order looks
 * like.
 *
 * SAME PATH TRAP AS history.phtml. `customer_account_dashboard_top` renders
 * `Magento_Sales::order/recent.phtml` only until Magento_OrderCancellationUi's
 * `customer_account_index.xml` calls `setTemplate` on it. That module is enabled
 * here, so an override under Magento_Sales would compile and never render.
 * Overriding at this path also keeps the Cancel Order affordance.
 *
 * Differences from the history card, all of them from what this block actually
 * has: it carries a "Ship To" name, which becomes a fourth meta field; it has a
 * block title with a View All link; and it has no pager.
 *
 * @var \Magento\Sales\Block\Order\Recent $block
 * @var \Magento\OrderCancellationUi\ViewModel\Config $viewModel
 * @var \Magento\Framework\Escaper $escaper
 */

// phpcs:disable Magento2.Templates.ThisInTemplate

$viewModel = $block->getViewModel();
$_orders   = $block->getOrders();
$count     = count($_orders);

/** @var \MagentoEgypt\CheckoutExtend\ViewModel\OrderHistoryItems|null $hmItems */
$hmItems = $block->getData('history_items');
if ($hmItems && $count) {
    //  Flat in the number of orders — see the ViewModel note. This block caps
    //  itself at five, but the batching is the same code either way.
    $hmItems->preload($_orders);
}
?>
<div class="block block-dashboard-orders">
    <div class="block-title order">
        <strong><?= $escaper->escapeHtml(__('Recent Orders')) ?></strong>
        <?php if ($count > 0): ?>
            <a class="action view" href="<?= $escaper->escapeUrl($block->getUrl('sales/order/history')) ?>">
                <span><?= $escaper->escapeHtml(__('View All')) ?></span>
            </a>
        <?php endif; ?>
    </div>

    <div class="block-content">
        <?= $block->getChildHtml() ?>

        <?php if ($count > 0): ?>
            <div class="hm-order-cards" id="my-orders-table">
                <?php foreach ($_orders as $_order): ?>
                    <?php
                    $hmStatus  = (string) $_order->getStatus();
                    $hmTint    = $hmItems ? $hmItems->getStatusTint($hmStatus) : 'neutral';
                    $hmLines   = $hmItems ? $hmItems->getItems($_order) : [];
                    $hmShipTo  = $_order->getShippingAddress() ? $_order->getShippingAddress()->getName() : null;
                    $hmCanView = $hmStatus !== 'received';
                    ?>
                    <section class="hm-order-card">
                        <div class="hm-order-card__head">
                            <div class="hm-order-card__meta">
                                <span class="hm-order-card__field">
                                    <span class="hm-order-card__label"><?= $escaper->escapeHtml(__('Order #')) ?></span>
                                    <span class="hm-order-card__value"><?= $escaper->escapeHtml($_order->getRealOrderId()) ?></span>
                                </span>
                                <span class="hm-order-card__field">
                                    <span class="hm-order-card__label"><?= $escaper->escapeHtml(__('Date')) ?></span>
                                    <span class="hm-order-card__value"><?= $escaper->escapeHtml($block->formatDate($_order->getCreatedAt())) ?></span>
                                </span>
                                <?php if ($hmShipTo): ?>
                                    <span class="hm-order-card__field">
                                        <span class="hm-order-card__label"><?= $escaper->escapeHtml(__('Ship To')) ?></span>
                                        <span class="hm-order-card__value"><?= $escaper->escapeHtml($hmShipTo) ?></span>
                                    </span>
                                <?php endif; ?>
                                <span class="hm-order-card__field">
                                    <span class="hm-order-card__label"><?= $escaper->escapeHtml(__('Order Total')) ?></span>
                                    <span class="hm-order-card__value hm-order-card__total"><?= /* @noEscape */ $_order->formatPrice($_order->getGrandTotal()) ?></span>
                                </span>
                            </div>

                            <span class="hm-order-card__status hm-order-card__status--<?= $escaper->escapeHtmlAttr($hmTint) ?>">
                                <?= $escaper->escapeHtml($_order->getStatusLabel()) ?>
                            </span>
                        </div>

                        <?php if ($hmLines): ?>
                            <ul class="hm-order-card__items">
                                <?php foreach ($hmLines as $hmLine): ?>
                                    <li class="hm-order-line">
                                        <span class="hm-order-line__media">
                                            <?php if ($hmLine['thumb']): ?>
                                                <img class="hm-order-line__img"
                                                     src="<?= $escaper->escapeUrl($hmLine['thumb']) ?>"
                                                     alt="" loading="lazy" width="64" height="64">
                                            <?php endif; ?>
                                        </span>
                                        <span class="hm-order-line__body">
                                            <?php if ($hmLine['url']): ?>
                                                <a class="hm-order-line__name" href="<?= $escaper->escapeUrl($hmLine['url']) ?>">
                                                    <?= $escaper->escapeHtml($hmLine['name']) ?>
                                                </a>
                                            <?php else: ?>
                                                <span class="hm-order-line__name"><?= $escaper->escapeHtml($hmLine['name']) ?></span>
                                            <?php endif; ?>
                                            <?php if ($hmLine['vendor']): ?>
                                                <span class="hm-order-line__vendor"><?= $escaper->escapeHtml($hmLine['vendor']) ?></span>
                                            <?php endif; ?>
                                            <span class="hm-order-line__price">
                                                <?= /* @noEscape */ $_order->formatPrice($hmLine['price']) ?>
                                                <?php if ($hmLine['qty'] > 1): ?>
                                                    <span class="hm-order-line__qty"><?= $escaper->escapeHtml(__('Qty: %1', $hmLine['qty'])) ?></span>
                                                <?php endif; ?>
                                            </span>
                                        </span>
                                    </li>
                                <?php endforeach; ?>
                            </ul>
                        <?php endif; ?>

                        <?php if ($hmCanView): ?>
                            <div class="hm-order-card__actions">
                                <a href="<?= $escaper->escapeUrl($block->getViewUrl($_order)) ?>" class="action view hm-btn hm-btn--secondary">
                                    <span><?= $escaper->escapeHtml(__('View Order')) ?></span>
                                </a>

                                <?php if ($this->helper(\Magento\Sales\Helper\Reorder::class)->canReorder($_order->getEntityId())): ?>
                                    <a href="#" data-post='<?= /* @noEscape */
                                        $this->helper(\Magento\Framework\Data\Helper\PostHelper::class)
                                            ->getPostData($block->getReorderUrl($_order))
                                    ?>' class="action order hm-btn hm-btn--primary">
                                        <span><?= $escaper->escapeHtml(__('Buy Again')) ?></span>
                                    </a>
                                <?php endif ?>

                                <?php if ($viewModel->canCancel($_order->getEntityId())): ?>
                                    <a href="#" class="cancel-order hm-order-card__cancel"
                                       id="cancel-order-<?= /* @noEscape */ $_order->getId() ?>" data-mage-init='{
                                           "cancelOrderModal":{
                                               "url": "<?= /* @noEscape */ $block->getBaseUrl(); ?>",
                                               "order_id": "<?= $escaper->escapeHtml(__($_order->getId())); ?>"
                                           }
                                        }'>
                                        <span><?= $escaper->escapeHtml(__('Cancel Order')) ?></span>
                                    </a>
                                    <?= $this->getLayout()->createBlock(\Magento\Framework\View\Element\Template::class)
                                        ->setOrder($_order)
                                        ->setReasons($viewModel->getCancellationReasons($_order->getEntityId()))
                                        ->setTemplate('Magento_OrderCancellationUi::cancel-order-modal.phtml')->toHtml()
                                    ?>
                                <?php endif ?>
                            </div>
                        <?php endif ?>
                    </section>
                <?php endforeach; ?>
            </div>
        <?php else: ?>
            <div class="message info empty">
                <span><?= $escaper->escapeHtml(__('You have placed no orders.')) ?></span>
            </div>
        <?php endif; ?>
    </div>
</div>
