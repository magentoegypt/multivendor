<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Vnecoms\VendorsLayerNavigation\Model\Layer\VendorHomePage\ItemCollectionProvider">
        <arguments>
            <argument name="collectionFactory" xsi:type="object">Magento\CatalogSearch\Model\ResourceModel\Fulltext\CollectionFactory</argument>
        </arguments>
    </type>
    <type name="MGS\Lookbook\Model\Lookbook">
        <plugin name="phpfixlookbook" type="MagentoEgypt\VendorExtend\Plugin\Lookbook"/>
    </type>
    <!-- LayerPlugin + VendorsSearch Elasticsuite Collection override removed during
         2.4.8 upgrade: Elasticsuite was retired in favour of native OpenSearch, so
         vendor search falls back to vnecoms' own SearchCollection virtualType.
         Original Elasticsuite-coupled files preserved in _disabled_modules/. -->
    <preference for="Vnecoms\BannerManager\Block\Banner" type="MagentoEgypt\VendorExtend\Block\BannerManager\Banner"/>
    <type name="Vnecoms\VendorsPriceComparison\Helper\Data">
        <arguments>
            <argument name="allowedAttributes" xsi:type="array">
                <item name="ves_category_ids" xsi:type="string">ves_category_ids</item>
                <item name="category_ids" xsi:type="string">category_ids</item>
            </argument>
        </arguments>
    </type>
    <preference for="Vnecoms\VendorsApi\Api\ProductRepositoryInterface" type="MagentoEgypt\VendorExtend\Model\ProductRepository" />
    <preference for="MagentoEgypt\VendorExtend\Api\VendorRepositoryInterface" type="MagentoEgypt\VendorExtend\Model\VendorRepository" />
    <preference for="MagentoEgypt\VendorExtend\Api\OrderRepositoryInterface" type="MagentoEgypt\VendorExtend\Model\OrderRepository" />
    <preference for="MagentoEgypt\VendorExtend\Api\VendorSelfServiceInterface" type="MagentoEgypt\VendorExtend\Model\VendorSelfService" />
    <!-- Store-view text of the seller's products for the vendor app's product form (2026-10-03). -->
    <preference for="MagentoEgypt\VendorExtend\Api\ProductTranslationsInterface" type="MagentoEgypt\VendorExtend\Model\ProductTranslations" />
    <preference for="MagentoEgypt\VendorExtend\Api\Data\Product\TranslationsInterface" type="MagentoEgypt\VendorExtend\Model\Data\Product\Translations" />
    <preference for="MagentoEgypt\VendorExtend\Api\Data\Product\StoreTranslationInterface" type="MagentoEgypt\VendorExtend\Model\Data\Product\StoreTranslation" />
    <preference for="MagentoEgypt\VendorExtend\Api\Data\Sale\OrderInterface" type="MagentoEgypt\VendorExtend\Model\Data\Sale\Order" />
    <preference for="Vnecoms\Quotation\Model\Sequence" type="MagentoEgypt\VendorExtend\Model\QuoteSequence" />

    <type name="Vnecoms\RMA\Model\Pdf\Request">
        <plugin name="format_date_html" type="MagentoEgypt\VendorExtend\Plugin\FormatDateHtml"/>
    </type>
    <type name="Vnecoms\RMA\Model\Request">
        <plugin name="format_date_html" type="MagentoEgypt\VendorExtend\Plugin\FormatDateHtml"/>
    </type>

    <!-- Add new type of credit processor -->
	<type name="Vnecoms\Credit\Model\Processor">
        <arguments>
            <argument name="creditProcessors" xsi:type="array">
                <item name="order_payment" xsi:type="object">MagentoEgypt\VendorExtend\Model\CreditProcessor\OrderPayment</item>
                <item name="item_commission" xsi:type="object">MagentoEgypt\VendorExtend\Model\CreditProcessor\ItemCommission</item>
                <item name="withdraw_credit" xsi:type="object">MagentoEgypt\VendorExtend\Model\CreditProcessor\Withdraw</item>
                <item name="cancel_withdrawal" xsi:type="object">MagentoEgypt\VendorExtend\Model\CreditProcessor\CancelWithdrawal</item>
                <item name="order_payment_refund" xsi:type="object">MagentoEgypt\VendorExtend\Model\CreditProcessor\RefundOrderPayment</item>
                <item name="item_commission_refund" xsi:type="object">MagentoEgypt\VendorExtend\Model\CreditProcessor\RefundItemCommission</item>
                <item name="vendor_refund_spent_credit" xsi:type="object">MagentoEgypt\VendorExtend\Model\CreditProcessor\RefundSpentCredit</item>
                <item name="buy_credit" xsi:type="object">MagentoEgypt\VendorExtend\Model\Processor\BuyCredit</item>
                <item name="refund_spent_credit" xsi:type="object">MagentoEgypt\VendorExtend\Model\Processor\RefundSpentCredit</item>
                <item name="refund_by_credit" xsi:type="object">MagentoEgypt\VendorExtend\Model\Processor\RefundByCredit</item>
                <item name="spend_credit" xsi:type="object">MagentoEgypt\VendorExtend\Model\Processor\SpendCredit</item>
                <item name="admin_add_credit" xsi:type="object">MagentoEgypt\VendorExtend\Model\Processor\AdminAddCredit</item>
                <item name="admin_subtract_credit" xsi:type="object">MagentoEgypt\VendorExtend\Model\Processor\AdminSubtractCredit</item>
            </argument>
        </arguments>
    </type>
    <!--
        Vendor shop pages listed no products: Vnecoms' Home\ListProduct builds the
        grid from the catalog LAYER, which has no vendor filter, while its own
        vendor-filtered collection is used only to count for the "Items (n)" tab.
        The subclass replaces just that one method and keeps the tab and the
        toolbar count.
    -->
    <preference for="Vnecoms\VendorsPage\Block\Home\ListProduct"
                type="MagentoEgypt\VendorExtend\Block\VendorsPage\Home\ListProduct"/>

    <!--
        CL036-DEV01.21 — the search index must hold only what the storefront
        will serve, or category pages render short. See the plugin for the whole
        story; the registration is GLOBAL because the indexer runs from cron and
        from the CLI, not in the frontend area.
    -->
    <type name="Magento\Elasticsearch\Model\Indexer\IndexerHandler">
        <plugin name="hm_exclude_unapproved_from_search_index"
                type="MagentoEgypt\VendorExtend\Plugin\Indexer\ExcludeUnapprovedProducts"
                sortOrder="100"/>
    </type>

    <!--
        No vendor themes are installed, so neither the seller registration form
        nor the seller panel's settings should offer a theme to choose. GLOBAL:
        one renders in `frontend`, the other in `vendors` and `adminhtml`.
    -->
    <type name="Vnecoms\VendorsCustomTheme\Block\Account\Create\ThemeList">
        <plugin name="hm_hide_empty_theme_chooser"
                type="MagentoEgypt\VendorExtend\Plugin\CustomTheme\HideEmptyThemeChooser"/>
    </type>
    <type name="Vnecoms\VendorsCustomTheme\Block\Adminhtml\System\Config\Form\Field\Theme">
        <plugin name="hm_hide_empty_theme_field"
                type="MagentoEgypt\VendorExtend\Plugin\CustomTheme\HideEmptyThemeChooser"/>
    </type>

    <!--
        CL036-TC09: a vendor's notification mail must never fail the order it
        announces. Vnecoms mails the vendor from inside placeOrder() (and from
        invoice, shipment and credit memo creation); a vendor with no linked
        account has no address, the mail throws a TypeError that Vnecoms' own
        catch (\Exception) misses, and checkout reports an error for an order
        that was placed. See the plugin. GLOBAL: checkout places orders in
        `webapi_rest`; invoices and shipments come from `adminhtml` and `vendors`.
    -->
    <!-- Seller "Average Orders": divide by paid orders, the ones Lifetime Sales sums. See the plugin. -->
    <type name="Vnecoms\VendorsSales\Model\ResourceModel\Order">
        <plugin name="hm_average_orders_paid_only"
                type="MagentoEgypt\VendorExtend\Plugin\VendorsSales\AverageOrdersPaidOnly"/>
    </type>
    <!-- Seller "Total Products" leaves out configurable variants the catalog never lists (13, not 16). See the plugin. -->
    <type name="Vnecoms\VendorsDashboard\Block\Dashboard">
        <plugin name="hm_total_products_listable"
                type="MagentoEgypt\VendorExtend\Plugin\VendorsDashboard\TotalProductsListable"/>
    </type>
    <type name="Vnecoms\VendorsDashboard\Block\Adminhtml\Vendor\Edit\Tab\Dashboard">
        <plugin name="hm_total_products_listable"
                type="MagentoEgypt\VendorExtend\Plugin\VendorsDashboard\TotalProductsListable"/>
    </type>
    <type name="Vnecoms\VendorsApi\Model\DashboardRepository">
        <plugin name="hm_total_products_listable"
                type="MagentoEgypt\VendorExtend\Plugin\VendorsDashboard\TotalProductsListable"/>
    </type>
    <type name="Vnecoms\VendorsSales\Model\Order\Email\Sender\OrderSender">
        <plugin name="hm_vendor_email_cannot_fail_the_order"
                type="MagentoEgypt\VendorExtend\Plugin\VendorsSales\VendorEmailCannotFailTheOrder"/>
    </type>
    <type name="Vnecoms\VendorsSales\Model\Order\Email\Sender\InvoiceSender">
        <plugin name="hm_vendor_email_cannot_fail_the_order"
                type="MagentoEgypt\VendorExtend\Plugin\VendorsSales\VendorEmailCannotFailTheOrder"/>
    </type>
    <type name="Vnecoms\VendorsSales\Model\Order\Email\Sender\ShipmentSender">
        <plugin name="hm_vendor_email_cannot_fail_the_order"
                type="MagentoEgypt\VendorExtend\Plugin\VendorsSales\VendorEmailCannotFailTheOrder"/>
    </type>
    <type name="Vnecoms\VendorsSales\Model\Order\Email\Sender\CreditmemoSender">
        <plugin name="hm_vendor_email_cannot_fail_the_order"
                type="MagentoEgypt\VendorExtend\Plugin\VendorsSales\VendorEmailCannotFailTheOrder"/>
    </type>

    <!-- Seller API lists report the real total_count, not the page size (see KeepsTotalCount) -->
    <preference for="Vnecoms\VendorsApi\Api\Data\Sale\OrderSearchResultInterface"
                type="MagentoEgypt\VendorExtend\Model\Data\VendorsApi\OrderSearchResult"/>
    <preference for="Vnecoms\VendorsApi\Api\Data\Sale\InvoiceSearchResultInterface"
                type="MagentoEgypt\VendorExtend\Model\Data\VendorsApi\InvoiceSearchResult"/>
    <preference for="Vnecoms\VendorsApi\Api\Data\Sale\MemoSearchResultInterface"
                type="MagentoEgypt\VendorExtend\Model\Data\VendorsApi\MemoSearchResult"/>
    <preference for="Vnecoms\VendorsApi\Api\Data\Sale\ShipmentSearchResultInterface"
                type="MagentoEgypt\VendorExtend\Model\Data\VendorsApi\ShipmentSearchResult"/>
    <preference for="Vnecoms\VendorsApi\Api\Data\Credit\WithdrawalSearchResultInterface"
                type="MagentoEgypt\VendorExtend\Model\Data\VendorsApi\WithdrawalSearchResult"/>

    <!-- Seller dashboard / report charts bucketed by the store's local day, not UTC (TC66-QA02) -->
    <preference for="Vnecoms\VendorsDashboard\Model\Graph"
                type="MagentoEgypt\VendorExtend\Model\Dashboard\StoreTimeGraph"/>

    <!-- Seller API shipments / credit memos: address as the text their interfaces declare (was a 500) -->
    <type name="Vnecoms\VendorsApi\Model\Data\Sale\Shipment">
        <plugin name="hm_address_as_text" type="MagentoEgypt\VendorExtend\Plugin\VendorsApi\AddressAsText"/>
    </type>
    <type name="Vnecoms\VendorsApi\Model\Data\Sale\Memo">
        <plugin name="hm_address_as_text" type="MagentoEgypt\VendorExtend\Plugin\VendorsApi\AddressAsText"/>
    </type>

    <!-- Never an empty seller name; no seller card for a deleted seller (see the plugin) -->
    <type name="Vnecoms\Vendors\Helper\Data">
        <plugin name="hm_seller_name_fallback"
                type="MagentoEgypt\VendorExtend\Plugin\Vendors\SellerNameFallback"/>
    </type>
    <type name="Vnecoms\Vendors\Block\Profile">
        <plugin name="hm_no_card_for_missing_seller"
                type="MagentoEgypt\VendorExtend\Plugin\Vendors\SellerNameFallback"/>
    </type>
    <!-- CL036-TC28 (86d4bjum9): "Discount Amount" on order item rows also shows the special/catalog price reduction
         (admin order, admin Marketplace order, seller panel). Display only. -->
    <type name="Magento\Sales\Block\Adminhtml\Items\AbstractItems">
        <plugin name="magentoegypt_order_item_discount_column" type="MagentoEgypt\VendorExtend\Plugin\Sales\OrderItemDiscountColumn"/>
    </type>
</config>
