<?php
/**
 * Vendor store name.
 *
 * Hub Market fork of Vnecoms_Vendors::profile/title.phtml. Core hard-codes <h3>,
 * which left the vendor microsite with NO <h1> at all — carried over unresolved
 * from Phase I and confirmed again in Phase M (`/shop/<vendor>` rendered h3s for
 * Items / About / Shipping / Refund under no h1, a broken heading hierarchy as well
 * as a missing page title).
 *
 * THE TAG IS A PARAMETER, NOT A BLANKET CHANGE. This same template is rendered by
 * TWO different layouts:
 *
 *   vendor_page.xml          -> vendor.profile.top.title, vendor.profile.left.title
 *   catalog_product_view.xml -> vendor.profile.title        (the PDP!)
 *
 * The PDP already has an <h1> for the product name, and the microsite renders the
 * title twice (top banner + left column). Promoting the tag unconditionally would
 * produce two <h1> on every product page and two on the microsite, breaking the
 * "exactly 1 <h1>" parity gate in the opposite direction.
 *
 * So the default stays <h3> — identical to core everywhere it is not opted in — and
 * only `vendor.profile.top.title` is given heading_tag="h1", in
 * Vnecoms_VendorsPage/layout/vendor_page.xml.
 *
 * @var $block \Vnecoms\VendorsPage\Block\Profile\Content
 */

// Whitelisted: this comes from layout, but an unvalidated tag would be an HTML
// injection point the moment someone passes it a computed value.
$allowed = ['h1', 'h2', 'h3', 'h4', 'span', 'div'];
$tag = (string) $block->getData('heading_tag');
$tag = in_array($tag, $allowed, true) ? $tag : 'h3';

/*
 * NEVER let this be empty. getStoreName() reads the `store_name` vendor
 * attribute, which DOES NOT EXIST on this install — only `dispatch_time` is
 * defined on the vendor entity type — so it returns '' for everyone, and
 * `company` is itself blank on 3 of the 22 approved vendors.
 *
 * Promoting the tag to <h1> without this fallback produced a literally empty
 * `<h1 class="vendor-title"> </h1>` on /shop/test_1, which is WORSE for a screen
 * reader than the missing heading it replaced: an empty heading is announced as a
 * heading with no name. Fall back through company to the vendor's URL key, which
 * always exists because it is what routed us to this page.
 */

/*
 * Same humanising as MagentoEgypt\HomeSections\ViewModel\VendorNames::publicName().
 *
 * Four sellers on this install never filled in `company`, and the fallback below
 * ends at the vendor's url key — the routing identifier. The cart was fixed to
 * show "Test 1" while this template still printed "test_1", so the same seller
 * was named two different ways on two pages.
 *
 * Duplicated deliberately rather than injected: this template is rendered by
 * THREE different block names (the PDP vendor card, and the microsite's top and
 * left headings), so a per-block ViewModel argument would have to be added in
 * three places and would silently drop a block if any name were wrong. The
 * transformation is four lines and has no state.
 *
 * Existing capitalisation is preserved so "MIA" and "ENARA" are not flattened.
 */
$hmPublicName = static function (string $key): string {
    $words = array_filter(preg_split('/\s+/', trim(str_replace(['_', '-', '.'], ' ', $key))) ?: []);

    return implode(' ', array_map(
        static fn (string $w): string => $w === mb_strtolower($w, 'UTF-8')
            ? mb_convert_case($w, MB_CASE_TITLE, 'UTF-8')
            : $w,
        $words
    ));
};

$storeName = trim((string) $block->getStoreName());
if ($storeName === '') {
    $vendor = $block->getVendor();
    $storeName = trim((string) $vendor->getCompany())
        ?: $hmPublicName(trim((string) $vendor->getVendorId()));
}

/*
 * Localise the seller's name for the current store. Vendor data has no store
 * scope (ves_vendor_entity_varchar has no store_id), so one stored value serves
 * the English store, the Arabic store and the seller's own panel — an Arabic
 * company name rendered untranslated on the English storefront. Mapping lives
 * in the theme i18n CSVs; anything unmapped passes through unchanged, so a
 * seller who has not been given an English name still gets their own.
 */
$storeName = (string) __($storeName);
?>
<<?= /* @noEscape */ $tag ?> class="vendor-title">
    <?php if ($block->getVendorUrl()): ?>
        <a href="<?= $block->escapeUrl($block->getVendorUrl()) ?>"
           title="<?= $block->escapeHtmlAttr($storeName) ?>"><?= $block->escapeHtml($storeName) ?></a>
    <?php else: ?>
        <?= $block->escapeHtml($storeName) ?>
    <?php endif; ?>
    <?php
    /*
     * Approved-seller mark, the same signal the PDP seller line already uses:
     * vendor status 2. There is no `verified` attribute among the 21 vendor
     * attributes on this install, and the marketplace already promises approval
     * before a store goes live, so this restates an existing claim rather than
     * inventing a second one. Omitted entirely when a vendor is not approved.
     */
    $hmVendorForCheck = $block->getVendor();
    ?>
    <?php if ($hmVendorForCheck && (int) $hmVendorForCheck->getStatus() === 2): ?>
        <span class="hm-vendor-card__check" title="<?= $block->escapeHtmlAttr(__('Approved seller')) ?>">
            <?php /* The badge glyph, not a bare tick — the shared UI shows a ringed check. */ ?>
            <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-vendor-verified"/></svg>
            <span class="hm-sr-only"><?= $block->escapeHtml(__('Approved seller')) ?></span>
        </span>
    <?php endif; ?>
</<?= /* @noEscape */ $tag ?>>
