<?php
/**
 * Hub Market override of Vnecoms_RMA::request/view/form-reply.phtml.
 *
 * The reply editor on the returns detail page, localised. Two changes, both in
 * the script at the bottom; the markup is Vnecoms' own, untouched.
 *
 *   1. `js/hm-editor-locale` joins the require list and wraps the config, so
 *      on the Arabic store the toolbar's tooltips are Arabic and the content
 *      area is RTL. See that file for why a language pack has to be registered
 *      in JS rather than pointed at with `language: 'ar'`.
 *
 *   2. The `plugins` list is gone. Each of its three entries held several
 *      space-separated names, and HugeRTE reads one entry as ONE plugin name,
 *      so all three 404'd and no plugin ever loaded. Removing it changes
 *      nothing a shopper can see and removes three console errors. Spelling
 *      the names out properly would ADD behaviour, which is a different task.
 *
 * NOTE the argument list: `mage/validation` and the two wysiwyg modules return
 * values, so the locale module is the FIFTH argument, not the second. Getting
 * that wrong hands you jQuery under another name and apply() is undefined.
 */
?>
<div class="reply-message" id="reply-message-button">
    <button class="action primary" type="button"
            onclick="showFormReply()" ><span>
                    <i class="fa fa-fw fa-reply"></i>
                    <span><?php echo __('Reply')?></span></span>
    </button>
</div>
<div class="form-reply" style="display:none" id="form-reply-ticket">
    <form class="form-ticket-reply"
          action="<?php /* @escapeNotVerified */ echo $block->getSaveUrl() ?>"
          method="post" id="form-ticket-reply"
          enctype="multipart/form-data"
          data-hasrequired="<?php /* @escapeNotVerified */ echo __('* Required Fields') ?>"
          data-mage-init='{"validation":{}}'
    >
        <div class="ticket-content">
            <div>
                <?php //echo $block->getHtmlEditor(); ?>
                <textarea name="message" id="content_message_reply" class="textarea input-text" rows="10" cols="15" data-validate="{required:true}"></textarea>
            </div>
            <div id="knockout-message-attachment" class="uploader" data-bind="scope: 'attachment'">
                <p class="lable"><?php echo __('Allow Extension : ').$block->getUploaderExtensionNote() ?>
                </p>
                <!-- ko template: getTemplate() --><!-- /ko -->
                <script type="text/x-magento-init">
                            {
                                "#knockout-message-attachment": {
                                    "Magento_Ui/js/core/app": {
                                        "components": {
                                            "attachment": {
                                                "component": "Vnecoms_RMA/js/form/upload/uploader",
                                                "uploaderConfig":{
                                                    "url": "<?php echo $block->getUrl("vrma/customer/upload");?>"
                                                },
                                                "dataScope" : "data.attachment",
                                                "dataType" : "data.text",
                                                "formElement" : "data.input"
                                            }
                                        }
                                    }
                                }
                            }
                        </script>
            </div>

            <div class="buttons-set">
                <input type="hidden" name="request_id" value="<?php echo $block->getRequestRma()->getId() ?>">
                <button class="btn btn-default" id="msg-discard-btn" type="button"><i class="fa fa-times"></i> <?php echo __("Discard")?></button>
                <button class="action primary" type="button" id="msg-send-btn">
                    <span><i class="fa fa-envelope-o"></i>
                        <span><?php echo __('Send')?>
                    </span></span></button>
            </div>
            <div class="clear"></div>

        </div>
    </form>
</div>
<div class="clear"></div>
<script type="text/javascript">
    window.tinyMCE_GZ = window.tinyMCE_GZ || {}; window.tinyMCE_GZ.loaded = true;
    require([
             "jquery",'mage/validation',
             "mage/adminhtml/wysiwyg/tiny_mce/setup",
             "mage/adminhtml/wysiwyg/widget",
             "js/hm-editor-locale"
    ], function($, validation, wysiwyg, widget, hmEditorLocale){
        $(function() {
            /**
             * Show form reply ticket
             */
            function showFormReply(){
                $('#form-reply-ticket').show();
                $('#reply-message-button').hide();
                Effect.ScrollTo("form-reply-ticket", { duration: 1.0 });
            }
            window.showFormReply = showFormReply;

            /**
             * add quote to new message
             * @param obj
             */
            function quoteMessage(obj) {
                var message = $("#messagebody"+obj).html();
                this.showFormReply();
                if(tinyMCE.getInstanceById('content_message_reply')){
                    tinyMCE.getInstanceById('content_message_reply').getBody().innerHTML
                        += '<blockquote>'+message+'</blockquote>';
                }
                else{
                    $("#content_message_reply").html('<blockquote>'+message+'</blockquote>');
                }
                Effect.ScrollTo("form-reply-ticket", { duration: 1.0 });
            }
            window.quoteMessage = quoteMessage;

            wysiwygpage_msg_content = tinymce.init(hmEditorLocale.apply({
                selector: '#content_message_reply',
                height: 200,
                menubar: false,
                toolbar: 'undo redo | formatselect | bold italic forecolor | alignleft aligncenter alignright alignjustify | removeformat'
            }));

            $("#msg-discard-btn").click(function(){
                $("#form-reply-ticket").hide();
                $("#reply-message-button").show();
                tinyMCE.get('content_message_reply').setContent('<p></p>');
                $$(".file-uploader-summary").each(function(e){
                    e.remove();
                });
            });
        });

        $("#msg-send-btn").click(function(){
            var content = tinyMCE.get('content_message_reply').getContent();
            if($("#form-ticket-reply").validation() && $("#form-ticket-reply").validation('isValid') && content){
                $('#content_message_reply').val(content);
                $("#vnecoms-msg-notification").removeClass('hide');
                $("#form-reply-ticket").hide();
                $.ajax({
                    method: "POST",
                    url: "<?php echo $block->getUrl('*/*/reply');?>",
                    dataType: 'json',
                    data : $("#form-ticket-reply").serializeArray(),
                    success: function (data) {
                        $("#vnecoms-msg-notification").addClass('hide');
                        if(data.error){
                            $("#form-reply-ticket").show();
                            alert(data.msg);
                        }else{
                            $("#reply-message-button").show();
                            $('.box-message-list').html(data.message_list);
                            tinyMCE.get('content_message_reply').setContent('<p></p>');
                            $$(".file-uploader-summary").each(function(e){
                                e.remove();
                            });
                        }
                    }
                });

            }else{
                alert('<?php echo __("Please enter message");?>');
            }

        });

    });
</script>