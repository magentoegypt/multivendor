<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="vendors.app.grid.container">
            <block class="Vnecoms\Vendors\Block\Vendors\Widget\Grid" name="vendors.cms.app.grid" as="grid">
                <arguments>
                    <argument name="id" xsi:type="string">appGrid</argument>
                    <argument name="default_sort" xsi:type="string">app_id</argument>
                    <argument name="default_dir" xsi:type="string">ASC</argument>
                    <argument name="dataSource" xsi:type="object">Vnecoms\VendorsCms\Model\ResourceModel\App\Collection</argument>
                </arguments>
                <block class="Vnecoms\Vendors\Block\Vendors\Widget\Grid\ColumnSet" name="vendors.cms.app.grid.columnSet" as="grid.columnSet">
                    <arguments>
                        <argument name="rowUrl" xsi:type="array">
                            <item name="path" xsi:type="string">*/*/edit</item>
                            <item name="extraParamsTemplate" xsi:type="array">
                                <item name="instance_id" xsi:type="string">getId</item>
                                <item name="code" xsi:type="string">getCode</item>
                            </item>
                        </argument>
                    </arguments>
                    <block class="Vnecoms\Vendors\Block\Vendors\Widget\Grid\Column" as="app_id">
                        <arguments>
                            <argument name="header" xsi:type="string" translate="true">App ID</argument>
                            <argument name="index" xsi:type="string">app_id</argument>
                            <argument name="column_css_class" xsi:type="string">col-id</argument>
                            <argument name="header_css_class" xsi:type="string">col-id</argument>
                        </arguments>
                    </block>
                    <block class="Vnecoms\Vendors\Block\Vendors\Widget\Grid\Column" as="title">
                        <arguments>
                            <argument name="header" xsi:type="string" translate="true">Title</argument>
                            <argument name="index" xsi:type="string">title</argument>
                        </arguments>
                    </block>
                    <block class="Vnecoms\Vendors\Block\Vendors\Widget\Grid\Column" as="type">
                        <arguments>
                            <argument name="header" xsi:type="string" translate="true">Type</argument>
                            <argument name="index" xsi:type="string">type</argument>
                            <argument name="type" xsi:type="string">options</argument>
                            <argument name="options" xsi:type="options" model="Vnecoms\VendorsCms\Model\ResourceModel\App\Options\Types"/>
                        </arguments>
                    </block>
                    <block class="Vnecoms\Vendors\Block\Vendors\Widget\Grid\Column" as="sort_order">
                        <arguments>
                            <argument name="header" xsi:type="string" translate="true">Sort Order</argument>
                            <argument name="index" xsi:type="string">sort_order</argument>
                        </arguments>
                    </block>
                </block>
            </block>
        </referenceBlock>
    </body>
</page>
