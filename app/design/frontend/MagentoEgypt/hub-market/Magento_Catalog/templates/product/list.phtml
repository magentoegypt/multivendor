 *
 * ---------------------------------------------------------------------------
 * Hub Market fork of the category product list.
 *
 * WHY THIS EXISTS. The homepage rails and the category listing are the same card
 * in the design and were NOT the same card here: the rails render through
 * Magento_CatalogWidget's grid.phtml, which this theme already forked, while the
 * listing renders through this template, which it had not. The listing therefore
 * had no discount badge, no seller name, a sans-serif title, and — worse — the
 * compact icon actions the card CSS now expects with none of the markup they
 * hang on, so the "Add to Cart" button collapsed to a 3px orange sliver beside
 * an empty box. Measured on /clothes.html before this change.
 *
 * The card structure below is deliberately identical to
 * Magento_CatalogWidget::product/widget/content/grid.phtml. Read that file's
 * header for the reasoning behind each part; the notes are not repeated here.
 * If one changes, change both.
 *
 * Everything else is core, including the list-mode branch, the `$pos` inline
 * style hooks and the secureRenderer calls. Keep in sync on upgrade — diff
 * against vendor/magento/module-catalog/view/frontend/templates/product/list.phtml
 * ---------------------------------------------------------------------------
 */
use Magento\Catalog\Pricing\Price\FinalPrice;
use Magento\Catalog\Pricing\Price\RegularPrice;
use Magento\Framework\App\Action\Action;

?>
<?php
/**
 * @var $block \Magento\Catalog\Block\Product\ListProduct
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */
?>
<?php
$_productCollection = $block->getLoadedProductCollection();
/** @var \Magento\Catalog\Helper\Output $_helper */
$_helper = $block->getData('outputHelper');

/** @var \MagentoEgypt\HomeSections\ViewModel\VendorNames|null $hmVendors */
$hmVendors = $block->getData('vendor_names');
?>
<?php if (!$_productCollection->count()): ?>
    <div class="message info empty">
        <div><?= $escaper->escapeHtml(__('We can\'t find products matching the selection.')) ?></div>
    </div>
<?php else: ?>
    <?= $block->getToolbarHtml() ?>
    <?= $block->getAdditionalHtml() ?>
    <?php
    if ($block->getMode() === 'grid') {
        $viewMode = 'grid';
        $imageDisplayArea = 'category_page_grid';
        $showDescription = false;
        $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
    } else {
        $viewMode = 'list';
        $imageDisplayArea = 'category_page_list';
        $showDescription = true;
        //  QA cycle 2 item 2-B: the list rows used the FULL summary, which for an
        //  unreviewed product prints "Be the first to review this product" where
        //  every grid card shows an empty five-star row and (0). Same short
        //  summary in both modes, so the rows line up.
        $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
    }
    /**
     * Position for actions regarding image size changing in vde if needed
     */
    $pos = $block->getPositioned();
    ?>
    <div class="products wrapper <?= /* @noEscape */ $viewMode ?> products-<?= /* @noEscape */ $viewMode ?>">
        <ol class="products list items product-items">
            <?php /** @var $_product \Magento\Catalog\Model\Product */ ?>
            <?php foreach ($_productCollection as $_product): ?>
            <?php
            /*
             * Bundles opt OUT of the hover-reveal card actions.
             *
             * A bundle cannot be added to the basket from a listing — it has to be
             * configured first — so its button is a link to the product page, and
             * that is a navigation affordance rather than a shortcut. Hiding it
             * until hover would leave the one product type whose card NEEDS a
             * visible call to action with none, and on touch there is no hover at
             * all. new_bundle is this install's own bundle type and behaves the
             * same way, so both are excluded.
             */
            $hmIsBundle = in_array($_product->getTypeId(), ['bundle', 'new_bundle'], true);
            ?>
            <li class="item product product-item">
                <div class="product-item-info<?= $hmIsBundle ? ' hm-card--bundle' : '' ?>"
                     id="product-item-info_<?= /* @noEscape */ $_product->getId() ?>"
                     data-container="product-<?= /* @noEscape */ $viewMode ?>">
                    <?php
                    $productImage = $block->getImage($_product, $imageDisplayArea);
                    if ($pos != null) {
                        $position = 'left:' . $productImage->getWidth() . 'px;'
                            . 'top:' . $productImage->getHeight() . 'px;';
                    }

                    /* Discount from the price model, never from special_price alone. */
                    $hmDiscount = 0;
                    try {
                        $priceInfo = $_product->getPriceInfo();
                        $regular   = (float) $priceInfo->getPrice(RegularPrice::PRICE_CODE)->getAmount()->getValue();
                        $final     = (float) $priceInfo->getPrice(FinalPrice::PRICE_CODE)->getAmount()->getValue();
                        if ($regular > 0 && $final > 0 && $final < $regular) {
                            $hmDiscount = (int) round((1 - $final / $regular) * 100);
                        }
                    } catch (\Throwable $e) {
                        $hmDiscount = 0;
                    }

                    $hmVendorName = $hmVendors ? $hmVendors->getName($_product->getData('vendor_id')) : null;
                    ?>
                    <div class="product-item-media">
                        <?php // Product Image ?>
                        <a href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>"
                           class="product photo product-item-photo"
                           tabindex="-1">
                            <?= $productImage->toHtml() ?>
                        </a>
                        <?php if ($hmDiscount > 0): ?>
                            <span class="hm-badge hm-badge--discount">
                                <?= $escaper->escapeHtml(__('-%1%', $hmDiscount)) ?>
                            </span>
                        <?php endif; ?>
                    </div>
                    <div class="product details product-item-details">
                        <?php $_productNameStripped = $block->stripTags($_product->getName(), null, true); ?>
                        <?php /*
                            RENDERED EVEN WHEN EMPTY, for the same reason the review
                            summary below passes `true`: the slot has to hold its
                            height or the cards in a row stop lining up. This was
                            wrapped in `if ($hmVendorName)`, so a card whose product
                            has no vendor lost the line entirely and pulled its name,
                            stars and swatches 24px up relative to its neighbours —
                            measured on the search results page, names at y=1208 on
                            vendorless cards against y=1232 on the rest of the row.
                            Not every product in this catalogue has a vendor_id, so
                            this is the normal case, not an edge one.
                        */ ?>
                        <span class="hm-card__vendor"><?= $hmVendorName ? $escaper->escapeHtml($hmVendorName) : '' ?></span>
                        <strong class="product name product-item-name">
                            <a class="product-item-link"
                               href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>">
                                <?=/* @noEscape */ $_helper->productAttribute($_product, $_product->getName(), 'name')?>
                            </a>
                        </strong>
                        <?php /*
                            THIRD ARGUMENT IS THE POINT. Core's ReviewRenderer returns an
                            empty string before it reaches any template when a product has
                            no rating summary:
                                if (null === getRatingSummary() && !$displayIfNoReviews) return '';
                            Passing true is the only way this theme's override of
                            summary_short.phtml gets to draw its empty five-star track, which
                            is what keeps every card in a row the same height. 94% of this
                            catalogue carries no review, so without it the rows render ragged —
                            the defect QA cycle 1 filed as "star ratings missing" against five
                            separate sections.
                        */ ?>
                        <?= $block->getReviewsSummaryHtml($_product, $templateType, true) ?>

                        <?= $block->getProductDetailsHtml($_product) ?>

                        <div class="hm-card__foot">
                            <?= /* @noEscape */ $block->getProductPrice($_product) ?>

                            <div class="product-item-inner">
                                <div class="product actions product-item-actions">
                                    <div class="actions-primary">
                                        <?php if ($_product->isSaleable()):?>
                                            <?php $postParams = $block->getAddToCartPostParams($_product); ?>
                                            <form data-role="tocart-form"
                                                  data-product-sku="<?= $escaper->escapeHtml($_product->getSku()) ?>"
                                                  action="<?= $escaper->escapeUrl($postParams['action']) ?>"
                                                  data-mage-init='{"catalogAddToCart": {}}'
                                                  method="post">
                                                <?php $options = $block->getData('viewModel')->getOptionsData($_product); ?>
                                                <?php foreach ($options as $optionItem): ?>
                                                    <input type="hidden"
                                                           name="<?= $escaper->escapeHtml($optionItem['name']) ?>"
                                                           value="<?= $escaper->escapeHtml($optionItem['value']) ?>">
                                                <?php endforeach; ?>
                                                <input type="hidden"
                                                       name="product"
                                                       value="<?= /* @noEscape */ $postParams['data']['product'] ?>">
                                                <input type="hidden"
                                                       name="<?= /* @noEscape */ Action::PARAM_NAME_URL_ENCODED ?>"
                                                       value="<?=
                                                       /* @noEscape */ $postParams['data'][Action::PARAM_NAME_URL_ENCODED]
                                                        ?>">
                                                <?= $block->getBlockHtml('formkey') ?>
                                                <?php /*
                                                    Icon button, matching the rails. The label stays in
                                                    the DOM and is clipped by CSS so the control keeps an
                                                    accessible name.

                                                    `disabled` is core's: catalogAddToCart enables it on
                                                    bind, which is how Magento blocks a submit before the
                                                    JS is ready. Kept.
                                                */ ?>
                                                <button type="submit"
                                                        title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>"
                                                        class="action tocart primary"
                                                        disabled>
                                                    <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-cart"/></svg>
                                                    <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                                                </button>
                                            </form>
                                        <?php else:?>
                                            <?php if ($_product->isAvailable()):?>
                                                <div class="stock available">
                                                    <span><?= $escaper->escapeHtml(__('In stock')) ?></span></div>
                                            <?php else:?>
                                                <div class="stock unavailable">
                                                    <span><?= $escaper->escapeHtml(__('Out of stock')) ?></span></div>
                                            <?php endif; ?>
                                        <?php endif; ?>
                                    </div>
                                    <?= ($pos && strpos($pos, $viewMode . '-primary')) ?
                                        /* @noEscape */ $secureRenderer->renderStyleAsTag(
                                            $position,
                                            'product-item-info_' . $_product->getId() . ' div.actions-primary'
                                        ) : '' ?>
                                    <div data-role="add-to-links" class="actions-secondary">
                                        <?php if ($addToBlock = $block->getChildBlock('addto')): ?>
                                            <?= $addToBlock->setProduct($_product)->getChildHtml() ?>
                                        <?php endif; ?>
                                    </div>
                                    <?= ($pos && strpos($pos, $viewMode . '-secondary')) ?
                                        /* @noEscape */ $secureRenderer->renderStyleAsTag(
                                            $position,
                                            'product-item-info_' . $_product->getId() . ' div.actions-secondary'
                                        ) : '' ?>
                                </div>
                                <?php if ($showDescription): ?>
                                    <?php
                                    /*
                                     * QA cycle 2, item 2-B: "List View isn't showing up
                                     * evenly." It wasn't — this slot rendered the RAW
                                     * short_description HTML, and this catalog's
                                     * descriptions range from two sentences to a full
                                     * nutrition-facts <table>, so every row was a
                                     * different height (one row in the recording is
                                     * mostly table). Three rules make the rows even:
                                     *
                                     * 1. TEXT ONLY. Tags are stripped, so a table can
                                     *    never render here. The PDP still shows the
                                     *    full formatted description.
                                     * 2. CLAMPED to ~160 characters (the CSS line-clamp
                                     *    is the second fence).
                                     * 3. LANGUAGE-GUARDED. Most descriptions here are
                                     *    Arabic-only; dumped into the English view they
                                     *    read as garbage (QA crossed exactly that out
                                     *    on the cart too). On a non-Arabic store an
                                     *    Arabic-dominant description is dropped — the
                                     *    row keeps its Learn More link. The Arabic
                                     *    store shows everything: English fallback copy
                                     *    is normal there and was never flagged.
                                     */
                                    $hmDescHtml = (string) $_helper->productAttribute(
                                        $_product,
                                        $_product->getShortDescription(),
                                        'short_description'
                                    );
                                    $hmDescText = trim((string) preg_replace(
                                        '/\s+/u',
                                        ' ',
                                        html_entity_decode(strip_tags($hmDescHtml), ENT_QUOTES | ENT_HTML5, 'UTF-8')
                                    ));
                                    if (mb_strlen($hmDescText) > 160) {
                                        $hmDescText = mb_substr($hmDescText, 0, 157) . '…';
                                    }
                                    $hmSample  = mb_substr($hmDescText, 0, 120);
                                    $hmArabic  = (int) preg_match_all('/[\x{0600}-\x{06FF}]/u', $hmSample);
                                    $hmLatin   = (int) preg_match_all('/[A-Za-z]/u', $hmSample);
                                    $hmRtlView = str_starts_with((string) $_product->getStore()->getConfig('general/locale/code'), 'ar');
                                    if (!$hmRtlView && $hmArabic > $hmLatin) {
                                        $hmDescText = '';
                                    }
                                    ?>
                                    <div class="product description product-item-description">
                                        <?php if ($hmDescText !== ''): ?>
                                            <p class="hm-list-desc"><?= $escaper->escapeHtml($hmDescText) ?></p>
                                        <?php endif; ?>
                                        <a href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>"
                                           title="<?= /* @noEscape */ $_productNameStripped ?>"
                                           class="action more"><?= $escaper->escapeHtml(__('Learn More')) ?></a>
                                    </div>
                                <?php endif; ?>
                            </div>
                        </div>
                    </div>
                </div>
                <?= ($pos && strpos($pos, $viewMode . '-actions')) ?
                /* @noEscape */ $secureRenderer->renderStyleAsTag(
                    $position,
                    'product-item-info_' . $_product->getId() . ' div.product-item-actions'
                ) : '' ?>
            </li>
            <?php endforeach; ?>
        </ol>
    </div>
    <?= $block->getChildBlock('toolbar')->setIsBottom(true)->toHtml() ?>
    <?php // phpcs:ignore Magento2.Legacy.PhtmlTemplate ?>
<?php endif; ?>
