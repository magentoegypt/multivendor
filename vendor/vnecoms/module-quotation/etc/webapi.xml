<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route method="POST" url="/V1/vnecoms-quotation/quote">
        <service class="Vnecoms\Quotation\Api\QuoteRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Vnecoms_Quotation::Quote_save"/>
        </resources>
    </route>
    <route method="GET" url="/V1/vnecoms-quotation/search">
        <service class="Vnecoms\Quotation\Api\QuoteRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Vnecoms_Quotation::Quote_view"/>
        </resources>
    </route>
    <route method="GET" url="/V1/vnecoms-quotation/:quoteId">
        <service class="Vnecoms\Quotation\Api\QuoteRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="Vnecoms_Quotation::Quote_view"/>
        </resources>
    </route>
    <route method="PUT" url="/V1/vnecoms-quotation/:quoteId">
        <service class="Vnecoms\Quotation\Api\QuoteRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Vnecoms_Quotation::Quote_update"/>
        </resources>
    </route>
    <route method="DELETE" url="/V1/vnecoms-quotation/:quoteId">
        <service class="Vnecoms\Quotation\Api\QuoteRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="Vnecoms_Quotation::Quote_delete"/>
        </resources>
    </route>
