<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        sortOrder 100 so this runs AFTER Magento_ConfigurableProduct's
        `configurable_product_widget_product_list` plugin, which is declared at
        sortOrder 2 and is what overruns the count. See the plugin class for the
        measurements.
    -->
    <type name="Magento\CatalogWidget\Block\Product\ProductsList">
        <plugin name="magentoegypt_enforce_products_count"
                type="MagentoEgypt\HomeSections\Plugin\CatalogWidget\EnforceProductsCount"
                sortOrder="100"/>
    </type>

    <!-- "Top Rated" / "Newest" sort options on the listing toolbar — QA cycle 2
         item 2-A; see the plugin class for the review_entity_summary join and
         why top_rated must be intercepted before core applies it. -->
    <type name="Magento\Catalog\Block\Product\ProductList\Toolbar">
        <plugin name="magentoegypt_toolbar_sort_options"
                type="MagentoEgypt\HomeSections\Plugin\Catalog\ToolbarSortOptions"/>
    </type>
</config>
