    <div class="message-notification-box hide" id="vnecoms-msg-notification"><?php echo __("Sending ...")?></div>

    <script type="text/javascript">
        window.tinyMCE_GZ = window.tinyMCE_GZ || {}; window.tinyMCE_GZ.loaded = true;
        require([
            "jquery",
            'mage/validation',
            "mage/adminhtml/wysiwyg/tiny_mce/setup",
            "mage/adminhtml/wysiwyg/widget",
            "jquery/chonsen",
            "jquery/colorbox"
        ],function($){
            $(function() {

                /**
                 * Show form reply ticket
                 */
                function showFormReply(){
                    $('#form-reply-ticket').show();
                    $('#reply-message-button').hide();
                    Effect.ScrollTo("form-reply-ticket", { duration: 1.0 });
                }
                window.showFormReply = showFormReply;
                /**
                 * add quote to new message
                 * @param obj
                 */
                function quoteMessage(obj) {
                    var message = $("#messagebody"+obj).html();
                    this.showFormReply();
                    if(tinyMCE.getInstanceById('content_message_reply')){
                        tinyMCE.getInstanceById('content_message_reply').getBody().innerHTML
                            += '<blockquote>'+message+'</blockquote>';
                    }
                    else{
                        $("#content_message_reply").html('<blockquote>'+message+'</blockquote>');
                    }
                    Effect.ScrollTo("form-reply-ticket", { duration: 1.0 });
                }
                window.quoteMessage = quoteMessage;

                var jsonTemplate = <?php echo $this->getTemplateJson() ?>;
                if ($(".chosen-select")) $(".chosen-select").chosen();
                $(".icon-attachment-img-view").colorbox({rel: 'icon-attachment-img-view'});
                
                tinymce.init({
                  	selector: '#content_message_reply',
                  	height: 200,
                  	menubar: false,
                  	plugins: [
                	    'advlist autolink lists link image charmap print preview anchor textcolor',
                	    'searchreplace visualblocks code fullscreen',
                	    'insertdatetime media table paste code help wordcount'
                    ],
                    toolbar: 'undo redo | formatselect | bold italic forecolor | alignleft aligncenter alignright alignjustify | removeformat',
                });

                $('.mailbox-quick-reponse').change(function(){

                    for(var i = 0 ; i < jsonTemplate.length ; i++){
                        if(jsonTemplate[i].reponse_id == $( this ).val())
                        {
                        	tinyMCE.get('content_message_reply').setContent(jsonTemplate[i].content);
                            break;
                        }
                    }

                });


                $('.mailbox-read-info').click(function(){
                    if(!$(this).parent().hasClass('last')){
                        $(this).toggleClass("read");
                        $(this).siblings('.mailbox-read-message').toggleClass("hide");
                        $(this).find('.quote-message').toggleClass("hide");
                    }
                });

                $("#msg-discard-btn").click(function(){
                    $("#form-reply-ticket").hide();
                    $("#reply-message-button").show();
                    tinyMCE.get('content_message_reply').setContent('<p></p>');
                    $$(".file-uploader-summary").each(function(e){
                        e.remove();
                    });
                });

                $("#msg-send-btn").click(function(){
                	$('#content_message_reply').val(tinyMCE.get('content_message_reply').getContent());
                    if($("#edit_form").validation() && $("#edit_form").validation('isValid')){
                        $("#vnecoms-msg-notification").removeClass('hide');
                        $("#form-reply-ticket").hide();
                        $.ajax({
                            method: "POST",
                            url: "<?php echo $block->getUrl('*/*/reply');?>",
                            dataType: 'json',
                            data : $("#edit_form").serializeArray(),
                            success: function (data) {
                                $("#vnecoms-msg-notification").addClass('hide');
                                if(data.error){
                                    $("#form-reply-ticket").show();
                                    alert({
                                        modalClass: 'alert ves-error',
                                        title: '<?php echo __("Error");?>',
                                        content: data.msg,
                                    });
                                }else{
                                    $("#reply-message-button").show();
                                    $('.box-message-list').html(data.message_list);
                                    tinyMCE.get('content_message_reply').setContent('<p></p>');
                                    $$(".file-uploader-summary").each(function(e){
                                        e.remove();
                                    });
                                }
                            }
                        });
                    }

                });

            });
        });
    </script>

</div>
