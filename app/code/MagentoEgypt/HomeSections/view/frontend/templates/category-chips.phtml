<?php
/**
 * Hub Market — homepage category chips.
 *
 * Matches the Figma reference's chip row: a tinted tile carrying a glyph, the
 * category name, and a live item count. The count is read from the real category
 * tree, so it cannot drift from the catalog the way a hand-written CMS block
 * would.
 *
 * Categories with zero products are filtered out in the block — this catalog has
 * empty scaffolding categories (Promotions, Sale) that would otherwise render as
 * chips leading nowhere.
 *
 * THE GLYPH IS DECORATIVE. `aria-hidden` on the wrapper is not belt-and-braces:
 * screen readers announce emoji as words, so an unmarked 🛒 makes this link read
 * as "shopping trolley Grocery 2400 items". The name and count carry the meaning.
 *
 * @var \MagentoEgypt\HomeSections\Block\CategoryChips $block
 * @var \Magento\Framework\Escaper $escaper
 */
$categories = $block->getCategories();
if (!$categories) {
    return;
}
?>
<section class="hm-chips" aria-label="<?= $escaper->escapeHtmlAttr(__('Shop by category')) ?>">
    <ul class="hm-chips__list">
        <?php foreach ($categories as $c): ?>
            <li class="hm-chips__item">
                <a class="hm-chips__link hm-chips__link--<?= (int) $c['tint'] ?>"
                   href="<?= $escaper->escapeUrl($c['url']) ?>">
                    <span class="hm-chips__icon" aria-hidden="true"><?= $escaper->escapeHtml($c['icon']) ?></span>
                    <span class="hm-chips__name"><?= $escaper->escapeHtml($c['name']) ?></span>
                    <span class="hm-chips__count">
                        <?= $escaper->escapeHtml(__('%1 items', $c['count'])) ?>
                    </span>
                </a>
            </li>
        <?php endforeach; ?>
    </ul>
</section>
