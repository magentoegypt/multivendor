<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="magentoegypt_push_notification" resource="default" engine="innodb" comment="Push Notification">
        <column xsi:type="int" name="notification_id" unsigned="true" nullable="false" identity="true" comment="Notification ID"/>
        <column xsi:type="varchar" name="title" nullable="false" length="255" comment="Notification Title"/>
        <column xsi:type="text" name="message" nullable="false" comment="Notification Message"/>
        <column xsi:type="varchar" name="image" nullable="true" length="255" comment="Notification Image"/>
        <column xsi:type="varchar" name="action_url" nullable="true" length="500" comment="Action URL"/>
        <column xsi:type="varchar" name="target_type" nullable="false" length="32" default="all" comment="Target Type (all, customers, vendors, customer_group)"/>
        <column xsi:type="text" name="target_ids" nullable="true" comment="Comma-separated target IDs (group/vendor/customer IDs)"/>
        <column xsi:type="smallint" name="status" unsigned="true" nullable="false" default="0" comment="0=Draft, 1=Scheduled, 2=Sent, 3=Failed"/>
        <column xsi:type="int" name="recipients_count" unsigned="true" nullable="false" default="0" comment="Recipients Count"/>
        <column xsi:type="int" name="success_count" unsigned="true" nullable="false" default="0" comment="Successful Sends"/>
        <column xsi:type="int" name="failure_count" unsigned="true" nullable="false" default="0" comment="Failed Sends"/>
        <column xsi:type="timestamp" name="scheduled_at" on_update="false" nullable="true" comment="Scheduled Send Time"/>
        <column xsi:type="timestamp" name="sent_at" on_update="false" nullable="true" comment="Actual Sent Time"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <column xsi:type="int" name="created_by" unsigned="true" nullable="true" comment="Admin User ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="notification_id"/>
        </constraint>
        <index referenceId="MAGENTOEGYPT_PUSH_NOTIFICATION_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="MAGENTOEGYPT_PUSH_NOTIFICATION_SCHEDULED_AT" indexType="btree">
            <column name="scheduled_at"/>
        </index>
        <index referenceId="MAGENTOEGYPT_PUSH_NOTIFICATION_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <table name="magentoegypt_push_notification_device" resource="default" engine="innodb" comment="Push Notification Device Tokens">
        <column xsi:type="int" name="device_id" unsigned="true" nullable="false" identity="true" comment="Device ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer ID"/>
        <column xsi:type="int" name="vendor_id" unsigned="true" nullable="true" comment="Vendor ID"/>
        <column xsi:type="varchar" name="device_token" nullable="false" length="500" comment="FCM/APNs Device Token"/>
        <column xsi:type="varchar" name="platform" nullable="false" length="20" default="android" comment="Platform (android, ios, web)"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="device_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGENTOEGYPT_PUSH_NOTIFICATION_DEVICE_TOKEN_UNIQUE">
            <column name="device_token"/>
        </constraint>
        <index referenceId="MAGENTOEGYPT_PUSH_NOTIFICATION_DEVICE_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="MAGENTOEGYPT_PUSH_NOTIFICATION_DEVICE_VENDOR_ID" indexType="btree">
            <column name="vendor_id"/>
        </index>
        <index referenceId="MAGENTOEGYPT_PUSH_NOTIFICATION_DEVICE_PLATFORM" indexType="btree">
            <column name="platform"/>
        </index>
    </table>
</schema>
