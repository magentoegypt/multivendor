                        <?php /* @escapeNotVerified */ //echo $block->escapeHtml($typeData['label']) ?>
                    </li>
                    <?php
                //}
                ?>
            </ul> -->
        </div>
    </script>

    <script data-role="img-dialog-container-tmpl" type="text/x-magento-template">
      <div class="image-panel" data-role="dialog">
      </div>
    </script>

    <script data-role="img-dialog-tmpl" type="text/x-magento-template">
            <div class="image-panel-preview">
                <img src="<%- data.url %>" alt="<%- data.label %>" />
            </div>
            <div class="image-panel-controls">
                <strong class="image-name"><%- data.label %></strong>

                <fieldset class="fieldset-image-panel custom-field banner-item-fields">
                    <strong class="image-name"><%- data.item_title %></strong>

                    <div class="field field-item-title">
                        <label class="label" for="item_title"><?php /* @escapeNotVerified */ echo __('Item Title') ?></label>
                        <div class="control">
                            <input id="item_title" type="text" name="banner[media_gallery][images][<%- data.file_id %>][title]" value="<%- data.title %>"  />
                        </div>
                    </div>

                    <div class="field field-item-alt">
                        <label class="label" for="item_alt"><?php /* @escapeNotVerified */ echo __('Item Image Alt') ?></label>
                        <div class="control">
                            <input id="item_alt" type="text" name="banner[media_gallery][images][<%- data.file_id %>][alt]" value="<%- data.alt %>"  />
