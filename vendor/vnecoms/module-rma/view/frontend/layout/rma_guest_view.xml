<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="rma_request_guest_view_item_renderers"/>
    <head>
        <css src="jquery/fileUploader/css/jquery.fileupload-ui.css"/>
        <css src="Vnecoms_RMA::css/fileupload.css"/>
        <css src="Vnecoms_RMA::css/font-awesome.css"/>
        <css src="Vnecoms_RMA::css/tabs.css"/>
        <css src="Vnecoms_RMA::css/rma.css"/>
        <css src="Vnecoms_RMA::css/colorbox.css"/>
    </head>
    <body>
 
        <referenceContainer name="content">
            <block class="Vnecoms\RMA\Block\Frontend\View" name="guest.view" template="request/guest/view.phtml" cacheable="false">
                <block class="Vnecoms\RMA\Block\Frontend\View\Items" name="rma_items"
                       template="request/view/items.phtml" cacheable="false">
                    <block class="Magento\Framework\View\Element\RendererList" name="rma.request.item.renderers" as="renderer.list"/>
                </block>
                <block class="Vnecoms\RMA\Block\Frontend\Guest\Message" name="message" template="request/view/message.phtml" />
                <block class="Vnecoms\RMA\Block\Frontend\Guest\Message" name="form-reply" template="request/view/form-reply.phtml" />
            </block>
        </referenceContainer>

    </body>
</page>
