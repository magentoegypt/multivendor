<?xml version="1.0"?>
<!--
    CL036-TC104, configurable product pages only (this handle):
    - hm.pdp.sku.variant: the SKU under the product title follows the variant the customer picks;
    - hm.pdp.gallery.same.picture: the product photo is not redrawn (no flicker) when the chosen
      variant shows the same picture.
    See each template's header.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\ConfigurableProduct\Block\Product\View\Type\Configurable"
                   name="hm.pdp.sku.variant"
                   after="-"
                   template="Magento_ConfigurableProduct::product/view/sku-follows-variant.phtml"/>
            <block class="Magento\ConfigurableProduct\Block\Product\View\Type\Configurable"
                   name="hm.pdp.gallery.same.picture"
                   after="hm.pdp.sku.variant"
                   template="Magento_ConfigurableProduct::product/view/gallery-same-picture.phtml"/>
        </referenceContainer>
    </body>
</page>
