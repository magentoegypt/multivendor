<?php
/**
 * Algolia InstantSearch hit → Hub Market product card.
 *
 * Upstream renders a Bootstrap cell (`col-md-4 col-sm-6`) wrapping
 * `.result-wrapper / .result-thumbnail / .result-title`, which shares no classes
 * with this theme. The PLP therefore lost the whole card component the moment
 * InstantSearch took over category pages.
 *
 * Rather than restyle Algolia's markup, this emits the SAME markup Magento's
 * product listing emits — `.product-item-info`, `.product-item-photo`,
 * `.product-item-name`, `.price-box`, `.hm-card__vendor` — so the 18KB of
 * already-QA'd rules in _hm-product-item.less apply untouched. That is the same
 * reasoning that file documents: one card component, many renderers.
 *
 * `class="result"` is KEPT on both links. Algolia's click-analytics and
 * Personalization selectors are literally `.ais-Hits-item a.result,
 * .ais-InfiniteHits-item a.result` (see algoliaConfig.ccAnalytics.ISSelector and
 * personalization.clickedEvents). Dropping it silently kills click tracking and
 * would take the Insights events for DEV05 with it.
 *
 * The <li> itself belongs to InstantSearch (`li.ais-Hits-item`), so the grid
 * mapping onto `.products-grid .product-items` lives in _hm-algolia.less.
 *
 * @var \Algolia\AlgoliaSearch\Block\Instant\Hit $block
 * @var \Magento\Framework\Escaper $escaper
 */
$priceKey = $block->getPriceKey();

$baseFormatedVar = $escaper->escapeHtml('price' . $priceKey . '_formated');
$origFormatedVar = $escaper->escapeHtml('price' . $priceKey . '_original_formated');
$maxVar          = $escaper->escapeHtml('price' . $priceKey . '_max');

/* The theme draws its stars as five inline SVGs over a clipped fill track. */
$star = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">'
    . '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0'
    . ' 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122'
    . ' 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16'
    . ' 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>';
$stars = str_repeat($star, 5);
?>
<script type="text/template" id="instant-hit-template">
    <div class="product-item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
        <meta itemprop="position" content="{{__position}}" />
        <?php /*
            The .product-item wrapper is REQUIRED, not decorative: every rule in
            _hm-product-item.less is written as `.product-item .product-item-info`,
            so emitting .product-item-info alone matches nothing. InstantSearch owns
            the <li>, which is why the wrapper sits inside it.
        */ ?>
        <div class="product-item-info" itemprop="item" itemscope itemtype="http://schema.org/Product">

        <div class="product-item-media">
            <meta itemprop="url"
                {{^__queryID}} content="{{url}}" {{/__queryID}}
                {{#__queryID}} content="{{urlForInsights}}" {{/__queryID}} />

            <a class="result product-item-photo"
                {{^__queryID}} href="{{url}}" {{/__queryID}}
                {{#__queryID}} href="{{urlForInsights}}" {{/__queryID}}
                data-objectid="{{objectID}}"
                data-indexname="{{__indexName}}"
                data-position="{{__position}}"
                data-queryid="{{__queryID}}"
                tabindex="-1"
                aria-hidden="true">
                <span class="product-image-container">
                    <span class="product-image-wrapper">
                        {{#image_url}}<img class="product-image-photo" itemprop="image" loading="lazy"
                                           src="{{{image_url}}}" alt="{{{name}}}" />{{/image_url}}
                        {{^image_url}}<span class="no-image"></span>{{/image_url}}
                    </span>
                </span>
            </a>

            {{#<?= $origFormatedVar ?>}}
            <span class="hm-badge hm-badge--discount"><?= $escaper->escapeHtml(__('Sale')) ?></span>
            {{/<?= $origFormatedVar ?>}}
        </div>

        <div class="product-item-details">
            <?php /* Seller comes from MagentoEgypt_AlgoliaVendor, already localised per store index. */ ?>
            {{#seller}}<span class="hm-card__vendor">{{seller}}</span>{{/seller}}

            <strong class="product-item-name">
                <a class="result product-item-link"
                    {{^__queryID}} href="{{url}}" {{/__queryID}}
                    {{#__queryID}} href="{{urlForInsights}}" {{/__queryID}}
                    data-objectid="{{objectID}}"
                    data-indexname="{{__indexName}}"
                    data-position="{{__position}}"
                    data-queryid="{{__queryID}}"
                    itemprop="name">{{{ _highlightResult.name.value }}}</a>
            </strong>

            {{#rating_summary}}
            <div class="product-reviews-summary short hm-rating">
                <span class="hm-stars" role="img" aria-label="{{rating_summary}}%">
                    <span class="hm-stars__track"><?= /* @noEscape */ $stars ?></span>
                    <span class="hm-stars__fill" style="width: {{rating_summary}}%"><?= /* @noEscape */ $stars ?></span>
                </span>
            </div>
            {{/rating_summary}}

            <div class="hm-card__foot">
                <div class="price-box price-final_price">
                    {{#<?= $origFormatedVar ?>}}
                    <span class="old-price">
                        <span class="price-container">
                            <span class="price-wrapper"><span class="price">{{{<?= $origFormatedVar ?>}}}</span></span>
                        </span>
                    </span>
                    {{/<?= $origFormatedVar ?>}}
                    <span class="{{#<?= $origFormatedVar ?>}}special-price{{/<?= $origFormatedVar ?>}}">
                        <span class="price-container">
                            <span class="price-wrapper">
                                <?php /*
                                    NO range append here. `*_formated` is ALREADY the
                                    whole range for a configurable/bundle — Algolia
                                    indexes it as "EGP 51.85 - EGP 65.45". Appending
                                    {{default_max}} printed a second copy, and
                                    `default_max_formated` does not exist as a field,
                                    so it rendered a dangling en dash after the price.
                                    Upstream uses default_max only to switch the
                                    schema.org type, never to build the label.
                                */ ?>
                                <span class="price">{{{<?= $baseFormatedVar ?>}}}</span>
                            </span>
                        </span>
                    </span>
                </div>
            </div>
        </div>
        </div>
    </div>
</script>
