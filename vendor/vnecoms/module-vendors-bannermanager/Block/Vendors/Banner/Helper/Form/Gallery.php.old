<?php


namespace Vnecoms\BannerManager\Block\Vendors\Banner\Helper\Form;

use Magento\Framework\Exception\LocalizedException;
use Magento\Eav\Model\Entity\Attribute;
use Magento\Framework\Data\Form\Element\Renderer\RendererInterface;
use Magento\Framework\Data\Form\Element\AbstractElement;

/**
 * Class Block Gallery
 *
 * @category Vnecoms
 * @package  Vnecoms_BannerManager
 * @module   BannerManager
 * @author   Vnecoms Developer Team
 */
class Gallery extends \Magento\Backend\Block\Template implements  RendererInterface
{

    /** @var \Magento\Store\Model\StoreManagerInterface  */
    protected $_storeManager;

    /** @var \Magento\Framework\View\LayoutInterface  */
    protected $_layout;

    /** @var \Magento\Framework\Data\FormFactory  */
    protected $_formFactory;

    /** @var  \Magento\Framework\Data\Form\AbstractForm */
    protected $_form;


    /**
     * Note can't instance this abstract in constructor
     *
     * @var AbstractElement|null
     */
    protected $_element = null;


    /**
     * Gallery Block constructor
     *
     * @param \Magento\Backend\Block\Template\Context $context
     * @param \Magento\Framework\Data\FormFactory $formFactory
     * @param \Magento\Framework\Data\Form\AbstractForm $form
     * @param array $data
     */
    public function __construct(
        \Magento\Backend\Block\Template\Context $context,
        \Magento\Framework\Data\FormFactory $formFactory,
        \Magento\Framework\Data\Form\AbstractForm $form,
        array $data = []
    )
    {
        $this->_storeManager = $context->getStoreManager();
        $this->_formFactory  = $formFactory;
        $this->_layout       = $context->getLayout();
        $this->_form         = $form;
        parent::__construct($context, $data);
    }

    /**
     * Show render html of element
     *
     * @param AbstractElement $element
     * @return string
     * @throws LocalizedException
     */
    public function render(\Magento\Framework\Data\Form\Element\AbstractElement $element)
    {
        $this->setElement($element);
        return $this->getElementHtml();
    }

    /**
     * Get element block html
     *
     * @param null
     * @return string
     * @throws LocalizedException
     */
    public function getElementHtml()
    {
        try {
            $html = $this->getContentHtml();

        } catch (\Exception $e)
        {
            throw new LocalizedException(__($e->getMessage()));
        }

        return $html;
    }

    /**
     * Prepares content block
     *
     * @return string
     */
    public function getContentHtml()
    {
        /** @var \Vnecoms\BannerManager\Block\Vendors\Banner\Helper\Form\Gallery\Upload $content */
        $content = $this->_layout->createBlock('\Vnecoms\BannerManager\Block\Vendors\Banner\Helper\Form\Gallery\Upload');
        $content->setId($this->getHtmlId() . '_content')->setElement($this);
        $galleryJs = $content->getJsObjectName();
        $content->getUploader()->getConfig()->setMegiaGallery($galleryJs);
        return $content->toHtml();
    }
    

    /**
     * Retrieve data object related with form
     *
     * @param null
     *@return mixed
     */
    public function getDataObject()
    {
        return $this->getElement()->getForm()->getDataObject();
    }


    /**
     * Get HTML code
     *
     * @return string
     */
    public function toHtml()
    {
        return '<tr><td class="value" colspan="3">' . $this->getElementHtml() . '</td></tr>';
    }

    /**
     * get Store Id
     *
     * @return int
     */
    protected function _getDefaultStoreId()
    {
        return \Magento\Store\Model\Store::DEFAULT_STORE_ID;
    }

    /**
     * Get form dataobject
     *
     * @param null
     * @return \Magento\Framework\Data\Form\AbstractForm
     */
    public function getForm()
    {
        return $this->_form;
    }

    /**
     * Get Element
     *
     * @return mixed
     */
    public function getElement()
    {
        return $this->_element;
    }

    /**
     * set Element
     *
     * @param AbstractElement $element
     * @return $this
     */
    public function setElement(AbstractElement $element)
    {
        $this->_element = $element;
        return $this;
    }



}
