<?xml version="1.0"?>
<!--
/**
 * Frontend-only: the minicart's compare-at price.
 *
 * Declared on AbstractItem so every product type's item renderer inherits it.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\CustomerData\AbstractItem">
        <plugin name="magentoegypt_minicart_compare_price"
                type="MagentoEgypt\CheckoutExtend\Plugin\Checkout\CustomerData\ItemComparePrice"
                sortOrder="10"/>
    </type>
</config>
