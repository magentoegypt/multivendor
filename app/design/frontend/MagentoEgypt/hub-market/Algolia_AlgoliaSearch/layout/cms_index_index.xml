<?xml version="1.0"?>
<!--
/**
 * Hub Market (DEV07): "Home: Trending Items" (Algolia Recommend), right after
 * the Best Selling Items rail. The extension's own widget template; the cards
 * and the hide-when-empty behaviour come from the theme's js/recommend.js.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Algolia\AlgoliaSearch\Block\Widget\TrendsItem"
                   name="hm.algolia.home.trends"
                   template="Algolia_AlgoliaSearch::recommend/widget/trends-item.phtml"
                   after="hm.home.bestsellers">
                <arguments>
                    <argument name="numOfTrendsItem" xsi:type="string">8</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
