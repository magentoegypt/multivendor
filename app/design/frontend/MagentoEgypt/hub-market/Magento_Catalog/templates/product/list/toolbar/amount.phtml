<?php
/**
 * Product list toolbar
 *
 * @var \Magento\Catalog\Block\Product\ProductList\Toolbar $block
 * @var \Magento\Framework\Locale\LocaleFormatter $localeFormatter
 */
?>
<?php
/*
 * Hub Market: ONE change from core — the live-region attributes below.
 *
 * This element is the only feedback a shopper gets that a layered-navigation
 * filter, a sort, or a page change actually did anything ("Items 1-12 of 47").
 * On a screen reader it changed silently, because core ships no live region here.
 *
 * `polite` not `assertive`: a result count is not an emergency, and assertive
 * would interrupt whatever the user is reading mid-sentence. `aria-atomic` makes
 * the whole sentence re-announce rather than just the digits that changed, which
 * on their own are meaningless ("47").
 *
 * Note the global message containers already carry role="alert" (2 per page), so
 * add-to-cart and error feedback was ALREADY announced — this fills the gap that
 * genuinely existed rather than blanket-adding regions.
 */
?>
<?php
/*
 * Hub Market: the COUNT, not the range.
 *
 * Core prints "Items 1-12 of 47" once a listing paginates. Figma prints "6
 * results" — the total, whatever page you are on. The range is not just longer;
 * it answers a question ("which slice am I looking at?") that the pagination
 * below already answers, while burying the one shoppers actually scan for.
 *
 * The three-branch structure stays because the singular still has to read "1
 * result" rather than "1 results", and Arabic needs its own two forms.
 */
?>
<?php /* data-total: the search results header reads this rather than counting
         again. It is the only place on the page that has genuinely counted, and
         asking the search layer separately re-runs the search early enough to
         change it. Digits, not the formatted string, so the reader does not have
         to parse Arabic-Indic numerals. */ ?>
<p class="toolbar-amount" id="toolbar-amount" aria-live="polite" aria-atomic="true"
   data-total="<?= (int) $block->getTotalNum() ?>">
    <?php if ($block->getTotalNum() == 1):?>
        <?= $block->escapeHtml(
            __(
                '%1 result',
                '<span class="toolbar-number">' . $localeFormatter->formatNumber($block->getTotalNum()) . '</span>'
            ),
            ['span']
        ) ?>
    <?php else:?>
        <?= $block->escapeHtml(
            __(
                '%1 results',
                '<span class="toolbar-number">' . $localeFormatter->formatNumber($block->getTotalNum()) . '</span>'
            ),
            ['span']
        ) ?>
    <?php endif; ?>
</p>
