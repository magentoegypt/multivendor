type Query {
    hmReturnConfig: HmReturnConfig! @resolver(class: "MagentoEgypt\\HubAppReturns\\Model\\Resolver\\ReturnConfig") @doc(description: "Return form settings and reasons. Public.") @cache(cacheable: false)
    hmReturnableOrders(
        pageSize: Int = 10 @doc(description: "Orders per page, 1-20."),
        currentPage: Int = 1 @doc(description: "Page number from 1.")
    ): HmReturnableOrderPage! @resolver(class: "MagentoEgypt\\HubAppReturns\\Model\\Resolver\\ReturnableOrders") @doc(description: "Customer's orders with a returnable item, newest first. Token.") @cache(cacheable: false)
    hmReturns(
        pageSize: Int = 20 @doc(description: "Items per page, 1-50."),
        currentPage: Int = 1 @doc(description: "Page number from 1.")
    ): HmReturnPage! @resolver(class: "MagentoEgypt\\HubAppReturns\\Model\\Resolver\\Returns") @doc(description: "Customer's returns, newest first. Token.") @cache(cacheable: false)
    hmReturn(
        id: Int! @doc(description: "Return id.")
    ): HmReturn @resolver(class: "MagentoEgypt\\HubAppReturns\\Model\\Resolver\\ReturnDetail") @doc(description: "One of the customer's returns; null if not theirs. Token.") @cache(cacheable: false)
}

type Mutation {
    hmCreateReturn(
        input: HmCreateReturnInput! @doc(description: "Return request.")
    ): HmReturnOutput! @resolver(class: "MagentoEgypt\\HubAppReturns\\Model\\Resolver\\CreateReturn") @doc(description: "File a return for one seller's items in one of the customer's orders. Token.")
    hmAddReturnMessage(
        input: HmAddReturnMessageInput! @doc(description: "Message.")
    ): HmReturnOutput! @resolver(class: "MagentoEgypt\\HubAppReturns\\Model\\Resolver\\AddReturnMessage") @doc(description: "Customer reply; notifies seller and admin like the website. Token.")
}

enum HmReturnType @doc(description: "Requested outcome.") {
    REFUND @doc(description: "Refund.")
    REPLACE @doc(description: "Replacement.")
}

enum HmRefundAmountType @doc(description: "Refund amount mode.") {
    FULL @doc(description: "Full amount.")
    CUSTOM @doc(description: "Custom amount <= item total.")
}

enum HmReturnState @doc(description: "Lifecycle.") {
    OPEN @doc(description: "Open.")
    CLOSED @doc(description: "Closed.")
    CANCELED @doc(description: "Cancelled.")
}

enum HmReturnActor @doc(description: "Who acted.") {
    CUSTOMER @doc(description: "The customer.")
    SELLER @doc(description: "The seller.")
    HUB_MARKET @doc(description: "Hub Market staff (names never exposed).")
}

type HmReturnConfig @doc(description: "Return form settings.") {
    enabled: Boolean! @doc(description: "Returns available.")
    reasons_enabled: Boolean! @doc(description: "Reason picker shown.")
    other_reason_allowed: Boolean! @doc(description: "Free-text reason allowed.")
    partial_quantity_allowed: Boolean! @doc(description: "Qty below remaining allowed (allow_per_order).")
    reasons: [HmReturnReason!]! @doc(description: "Active reasons, sorted.")
    policy_html: String @doc(description: "Policy CMS block HTML.")
    window_days: Int @doc(description: "Days after order creation; null = no window (website rule for customers).")
}

type HmReturnReason @doc(description: "Reason.") {
    id: Int! @doc(description: "Reason id.")
    label: String! @doc(description: "Localised label.")
}

type HmReturnableOrderPage @doc(description: "Orders page.") {
    items: [HmReturnableOrder!]! @doc(description: "Orders.")
    total_count: Int! @doc(description: "Eligible orders.")
    page_info: SearchResultPageInfo! @doc(description: "Paging.")
}

type HmReturnableOrder @doc(description: "Eligible order.") {
    order_number: String! @doc(description: "Increment id.")
    created_at: String! @doc(description: "Placed, ISO-8601 UTC.")
    status_label: String! @doc(description: "Localised status.")
    items: [HmReturnableItem!]! @doc(description: "Lines to pick: each top-level line, but a bundle through its child lines.")
}

type HmReturnableItem @doc(description: "Order line.") {
    order_item_id: Int! @doc(description: "sales_order_item id: a top-level line, or a bundle's child line.")
    sku: String! @doc(description: "SKU.")
    name: String! @doc(description: "Name.")
    image_url: String @doc(description: "Thumbnail, absolute HTTPS.")
    options: [HmLabelValue!]! @doc(description: "Chosen options; a bundle's child line starts with the bundle it belongs to.")
    qty_ordered: Float! @doc(description: "Ordered.")
    qty_returnable: Float! @doc(description: "Returnable now (website formula).")
    open_return_numbers: [String!]! @doc(description: "Non-cancelled returns already holding this line.")
    seller: HmSellerSummary @doc(description: "Seller; one seller per return.")
}

input HmCreateReturnInput @doc(description: "Return request.") {
    order_number: String! @doc(description: "Order increment id.")
    items: [HmReturnItemInput!]! @doc(description: "Lines and quantities, one seller.")
    type: HmReturnType! @doc(description: "Refund or replace.")
    reason_id: Int @doc(description: "Reason; required when reasons are enabled and other_reason is empty.")
    other_reason: String @doc(description: "Free-text reason when allowed.")
    package_opened: Boolean! @doc(description: "Package opened.")
    comment: String! @doc(description: "First message.")
    refund_amount_type: HmRefundAmountType @doc(description: "REFUND only; FULL when omitted.")
    refund_custom_amount: Float @doc(description: "CUSTOM amount.")
    tracking_code: String @doc(description: "Return shipment tracking.")
}

input HmReturnItemInput @doc(description: "Line to return.") {
    order_item_id: Int! @doc(description: "HmReturnableItem.order_item_id: a top-level line, or a bundle's child line; never the bundle's own line.")
    quantity: Float! @doc(description: "Qty, 1..qty_returnable.")
}

input HmAddReturnMessageInput @doc(description: "Reply.") {
    return_id: Int! @doc(description: "Return id.")
    message: String! @doc(description: "Plain text, max 5000 chars.")
}

type HmReturnOutput @doc(description: "Mutation result.") {
    rma: HmReturn! @doc(description: "The return after the change.")
}

type HmReturnPage @doc(description: "Returns page.") {
    items: [HmReturnSummary!]! @doc(description: "Returns.")
    total_count: Int! @doc(description: "Total.")
    page_info: SearchResultPageInfo! @doc(description: "Paging.")
}

type HmReturnSummary @doc(description: "Return row.") {
    id: Int! @doc(description: "Id.")
    number: String! @doc(description: "RMA number.")
    order_number: String! @doc(description: "Order number.")
    created_at: String! @doc(description: "Created, UTC.")
    updated_at: String! @doc(description: "Updated, UTC.")
    state: HmReturnState! @doc(description: "State.")
    status_label: String! @doc(description: "Localised status.")
    type: HmReturnType! @doc(description: "Outcome.")
    item_count: Int! @doc(description: "Lines.")
    seller: HmSellerSummary @doc(description: "Seller.")
    has_unread_reply: Boolean! @doc(description: "is_customer_read = 0.")
}

type HmReturn @doc(description: "Return detail.") {
    id: Int! @doc(description: "Id.")
    number: String! @doc(description: "RMA number.")
    order_number: String! @doc(description: "Order number.")
    created_at: String! @doc(description: "Created, UTC.")
    updated_at: String! @doc(description: "Updated, UTC.")
    state: HmReturnState! @doc(description: "State.")
    status_code: String! @doc(description: "ves_rma_status code.")
    status_label: String! @doc(description: "Localised status.")
    type: HmReturnType! @doc(description: "Outcome.")
    reason: HmReturnReason @doc(description: "Reason.")
    other_reason: String @doc(description: "Free-text reason.")
    package_opened: Boolean! @doc(description: "Package opened.")
    refund_amount_type: HmRefundAmountType @doc(description: "Refund mode.")
    refund_amount: Money @doc(description: "Refund amount when set.")
    tracking_code: String @doc(description: "Tracking.")
    seller: HmSellerSummary @doc(description: "Seller.")
    items: [HmReturnItem!]! @doc(description: "Lines.")
    history: [HmReturnHistoryEntry!]! @doc(description: "Status history, oldest first.")
    messages: [HmReturnMessage!]! @doc(description: "Thread, oldest first.")
}

type HmReturnItem @doc(description: "Returned line.") {
    order_item_id: Int! @doc(description: "Order line id.")
    sku: String! @doc(description: "SKU.")
    name: String! @doc(description: "Name.")
    image_url: String @doc(description: "Thumbnail.")
    quantity: Float! @doc(description: "Qty requested.")
}

type HmReturnHistoryEntry @doc(description: "Status change.") {
    status_code: String! @doc(description: "Status code.")
    status_label: String! @doc(description: "Localised label.")
    changed_by: HmReturnActor! @doc(description: "Actor role.")
    created_at: String! @doc(description: "When, UTC.")
}

type HmReturnMessage @doc(description: "Message.") {
    id: Int! @doc(description: "Id.")
    author: HmReturnActor! @doc(description: "Role.")
    author_name: String! @doc(description: "Customer or seller name; 'Hub Market' for staff.")
    body_html: String! @doc(description: "Sanitised HTML.")
    body_text: String! @doc(description: "Plain text.")
    attachment_urls: [String!]! @doc(description: "Attachment URLs (read-only in P2).")
    created_at: String! @doc(description: "When, UTC.")
}
