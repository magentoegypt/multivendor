<script type="text/javascript">
var smsCreditPackages = <?php echo $block->getSmsCreditJSON()?>;
require([
    'jquery',
    'uiRegistry',
    'mage/translate',
    'Magento_Ui/js/modal/modal',
    'mage/mage',
    'mage/validation',
    'domReady!'
], function($, registry, $t, modal){
	/**
	 * Set Credit Package
	 */
	function setCreditPackagePrice(credit){
		$(smsCreditPackages).each(function(index,smsPackage){
			console.log(smsPackage);
			if(smsPackage.credit == credit){
				$('#sms_credit_package_price').html(smsPackage.price_formated);
				$('#sms_credit_package_credit').html(smsPackage.credit_formated);
			}
		});
	}
	var currentCredit = <?php echo $this->getCredit();?>;
	$(smsCreditPackages).each(function(index, smsPackage){
		$('#sms_credit_package').append('<option value="' + smsPackage.credit + '"'+(smsPackage.price > currentCredit?'disabled="disabled"':"")+'>' + smsPackage.credit_formated + '</option>');
	});

	setCreditPackagePrice($('#sms_credit_package').val());
	
	$('#sms_credit_package').change(function(){
		var credit = $(this).val();
		setCreditPackagePrice(credit);
	});

	var options = {
        type: 'popup',
        modalClass:'sms-credit-deposit-modal',
        responsive: true,
        innerScroll: true,
        title: '<?php echo __("Buy SMS Credit")?>',
        buttons: []
    };
    var popup = modal(options, $('#sms-credit-deposit'));

    $('#sms-credit-deposit-handle').click(function(){
    	$('#sms-credit-deposit').modal('openModal');
    	$("#sms-credit-deposit").removeClass('review');
        return false;
    });

    $('#btn-buy-smscredit-form').click(function(){
        if(!$('#sms_credit_package').validation().validation('isValid')) return;
        $("#sms-credit-deposit").addClass('review');
    });

    $('#btn-buy-smscredit-back').click(function(){
        $("#sms-credit-deposit").removeClass('review');
    });

    var dataForm = $('#form-validate');
    var ignore = null;
    
    dataForm.mage('validation').find('input:text').attr('autocomplete', 'off');

});
</script>
