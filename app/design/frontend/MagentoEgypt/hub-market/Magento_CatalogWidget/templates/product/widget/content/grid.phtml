 * See COPYING.txt for license details.
 *
 * ---------------------------------------------------------------------------
 * Hub Market fork of the CatalogWidget product rail.
 *
 * TWO earlier changes from core, both kept:
 *
 * 1. The rail title is an <h2>, not core's <strong>. Core renders every rail
 *    heading as `<div class="block-title"><strong>…</strong></div>` with no
 *    role and no aria-level, so it is not a heading in the accessibility tree at
 *    all. Because the CSS makes it LOOK like one this went unnoticed through
 *    nine phases. Measured before the change: only four real <h2> existed on the
 *    homepage, and Today's Deals / Picked For You / Featured Products — every
 *    widget rail, all rendered by THIS template — had none.
 *
 * 2. A per-instance `hm-rail--<block name>` slug class. Every rail renders
 *    identical markup, so CSS had no way to tell "Today's Deals" from "Grocery
 *    Essentials". The block NAME is the only thing that distinguishes them and it
 *    was not in the HTML. The slug is what carries the section emoji and the
 *    per-band tint (see _hm-home.less and _hm-figma.less).
 *
 * NEW in the Figma parity pass — the CARD, which is most of this file:
 *
 *   - Section head. Figma pairs every rail title with a subtitle and a trailing
 *     "See All ->" link. Both come from layout arguments, so a rail without them
 *     renders exactly as before.
 *   - Discount badge. Computed from the price model, never from a hard-coded
 *     percentage, so it cannot disagree with the price beneath it.
 *   - Vendor line. The seller's name above the title — see ViewModel\VendorNames
 *     for why it is a batch map and not a lookup per card.
 *   - Compact actions. Figma's card has no full-width "Add to Cart"; it has a
 *     24px cart button on the price row and a wishlist button on the image.
 *     Both keep Magento's own form and post-data, so behaviour is unchanged.
 *
 * The `<div class="block-title">` wrapper is deliberately KEPT even though the
 * head is now a flex row: it is the CSS hook used by _hm-product-item.less,
 * _hm-pdp.less, _hm-checkout.less and _hm-vendor.less.
 *
 * Keep in sync with core on upgrade — diff against
 * vendor/magento/module-catalog-widget/view/frontend/templates/product/widget/content/grid.phtml
 * ---------------------------------------------------------------------------
 */

use Magento\Catalog\Block\Product\ReviewRendererInterface;
use Magento\Catalog\Helper\Product\Compare;
use Magento\Catalog\Pricing\Price\FinalPrice;
use Magento\Catalog\Pricing\Price\RegularPrice;
use Magento\CatalogWidget\Block\Product\ProductsList;
use Magento\Framework\App\Action\Action;
use Magento\Framework\Escaper;
use Magento\Wishlist\Helper\Data;

/** @var Escaper $escaper */
/** @var ProductsList $block */

// phpcs:disable Generic.Files.LineLength.TooLong
// phpcs:disable Magento2.Templates.ThisInTemplate.FoundHelper
// phpcs:disable Magento2.Templates.ThisInTemplate.FoundThis
?>
<?php if ($exist = ($block->getProductCollection() && $block->getProductCollection()->count())): ?>
    <?php
    $type = 'widget-product-grid';

    $mode = 'grid';

    $image = 'new_products_content_widget_grid';
    $items = $block->getProductCollection()->getItems();

    $showWishlist = true;
    $showCompare = true;
    $showCart = true;
    $templateType = ReviewRendererInterface::SHORT_VIEW;
    $description = false;

    $hmRailSlug = preg_replace('/[^a-z0-9]+/', '-', strtolower((string) $block->getNameInLayout()));

    /*
     * Optional per-rail extras, all supplied as layout arguments so this template
     * stays generic. A rail that declares none renders the plain heading.
     */
    $hmSubtitle  = (string) $block->getData('subtitle');
    $hmMoreUrl   = (string) $block->getData('more_url');
    $hmMoreLabel = (string) ($block->getData('more_label') ?: __('See All'));

    /*
     * getUrl() is only correct for a ROUTE. The rails point at category and CMS
     * pages, so the argument is a path relative to the base URL and is joined
     * here rather than run through the URL builder, which would prefix
     * `frontend/` style routing onto it.
     */
    if ($hmMoreUrl !== '' && !preg_match('~^https?://~i', $hmMoreUrl)) {
        $hmMoreUrl = rtrim($block->getBaseUrl(), '/') . '/' . ltrim($hmMoreUrl, '/');
    }

    /** @var \MagentoEgypt\HomeSections\ViewModel\VendorNames|null $hmVendors */
    $hmVendors = $block->getData('vendor_names');
    ?>
    <div class="block widget block-products-list <?= /* @noEscape */ $mode ?> hm-rail--<?= $escaper->escapeHtmlAttr($hmRailSlug) ?>">
        <?php if ($block->getTitle()): ?>
            <div class="block-title hm-section__head">
                <div class="hm-section__heading">
                    <?php
                    /*
                     * Optional chip beside the title. Supplied either by the block
                     * (Picked For You computes it from which signal produced the
                     * row) or as a plain layout argument for a static one.
                     * method_exists rather than an interface: eight rails share
                     * this template and only one of them has anything to say here.
                     */
                    $hmBadge = method_exists($block, 'getHeadBadge')
                        ? (string) $block->getHeadBadge()
                        : (string) $block->getData('head_badge');
                    ?>
                    <?php /* Hub Market: <h2>, not <strong> — see the file header.
                             The badge sits BEFORE the title — QA cycle 2 item 1-C
                             drew an arrow moving it there, and the reference
                             renders "[● AI ENGINE] Picked For You" in that order.
                             The dot is drawn by CSS (.hm-section__badge::before);
                             it is decorative. */ ?>
                    <h2>
                        <?php if ($hmBadge !== ''): ?>
                            <span class="hm-section__badge"><?= $escaper->escapeHtml($hmBadge) ?></span>
                        <?php endif; ?>
                        <?= $escaper->escapeHtml(__($block->getTitle())) ?>
                    </h2>
                    <?php if ($hmSubtitle !== ''): ?>
                        <p class="hm-section__sub"><?= $escaper->escapeHtml(__($hmSubtitle)) ?></p>
                    <?php endif; ?>
                </div>
                <?php /* Rail extras (the deals countdown) sit beside the heading. */ ?>
                <?= $block->getChildHtml('rail_extra') ?>
                <?php
                /*
                 * "Refresh" — Picked For You only. It rotates which slice of the
                 * ranked set the row shows; see PickedForYou::getRefreshUrl().
                 * A link rather than a button because it navigates.
                 */
                $hmRefreshUrl = method_exists($block, 'getRefreshUrl') ? (string) $block->getRefreshUrl() : '';
                ?>
                <?php if ($hmRefreshUrl !== ''): ?>
                    <a class="hm-section__refresh" href="<?= $escaper->escapeUrl($hmRefreshUrl) ?>">
                        <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-refresh"/></svg>
                        <?= $escaper->escapeHtml(__('Refresh')) ?>
                    </a>
                <?php endif; ?>
                <?php if ($hmMoreUrl !== ''): ?>
                    <a class="hm-section__more" href="<?= $escaper->escapeUrl($hmMoreUrl) ?>">
                        <?= $escaper->escapeHtml($hmMoreLabel) ?>
                        <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-arrow-right"/></svg>
                    </a>
                <?php endif; ?>
            </div>
        <?php endif ?>
        <?php
        /*
         * Search-term chips, between the head and the row. Picked For You only —
         * see PickedForYou::getSearchTags() on why the label is not always
         * "YOUR SEARCHES".
         */
        $hmTags = method_exists($block, 'getSearchTags') ? $block->getSearchTags() : ['label' => '', 'terms' => []];
        ?>
        <?php if (!empty($hmTags['terms'])): ?>
            <div class="hm-section__tags">
                <span class="hm-section__tags-label"><?= $escaper->escapeHtml($hmTags['label']) ?>:</span>
                <?php foreach ($hmTags['terms'] as $hmTag): ?>
                    <?php /* Magnifier prefix per chip — QA cycle 2 item 1-C; the
                             reference chips each open with the search glyph. */ ?>
                    <a class="hm-section__tag" href="<?= $escaper->escapeUrl($hmTag['url']) ?>">
                        <svg class="hm-icon" aria-hidden="true" focusable="false"><use href="#hm-search"/></svg>
                        <?= $escaper->escapeHtml($hmTag['term']) ?>
                    </a>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>

        <div class="block-content">
            <?= /* @noEscape */ '<!-- ' . $image . '-->' ?>
            <div class="products-<?= /* @noEscape */ $mode ?> <?= /* @noEscape */ $mode ?>">
                <ol class="product-items <?= /* @noEscape */ $type ?>">
                    <?php $iterator = 1; ?>
                    <?php foreach ($items as $_item): ?>
                        <?php
                        /*
                         * Discount percentage, from the price model rather than from
                         * a raw attribute read: special_price alone ignores catalog
                         * price rules and tier prices, so a card can otherwise show
                         * "-25%" beside a price that is not 25% off. getFinalPrice
                         * here is the same amount the price box below renders.
                         */
                        $hmDiscount = 0;
                        try {
                            $priceInfo = $_item->getPriceInfo();
                            $regular   = (float) $priceInfo->getPrice(RegularPrice::PRICE_CODE)->getAmount()->getValue();
                            $final     = (float) $priceInfo->getPrice(FinalPrice::PRICE_CODE)->getAmount()->getValue();
                            if ($regular > 0 && $final > 0 && $final < $regular) {
                                $hmDiscount = (int) round((1 - $final / $regular) * 100);
                            }
                        } catch (\Throwable $e) {
                            $hmDiscount = 0;   // a card must never fail over a badge
                        }

                        $hmVendorName = $hmVendors ? $hmVendors->getName($_item->getData('vendor_id')) : null;
                        ?>
                        <?= /* @noEscape */ ($iterator++ == 1) ? '<li class="product-item">' : '</li><li class="product-item">' ?>
                        <?php /* Bundles keep a permanently visible action — see list.phtml. */ ?>
                        <?php $hmIsBundle = in_array($_item->getTypeId(), ['bundle', 'new_bundle'], true); ?>
                        <div class="product-item-info<?= $hmIsBundle ? ' hm-card--bundle' : '' ?>">
                            <div class="product-item-media">
                                <a href="<?= $escaper->escapeUrl($block->getProductUrl($_item)) ?>" class="product-item-photo">
                                    <?= $block->getImage($_item, $image)->toHtml() ?>
                                </a>
                                <?php if ($hmDiscount > 0): ?>
                                    <span class="hm-badge hm-badge--discount">
                                        <?= $escaper->escapeHtml(__('-%1%', $hmDiscount)) ?>
                                    </span>
                                <?php endif; ?>
                                <?php if ($this->helper(Data::class)->isAllow() && $showWishlist): ?>
                                    <?php /*
                                        Figma reveals this on hover only, which means it
                                        never appears on a touch device. Always rendered
                                        here; the CSS fades it in on pointer devices only.
                                    */ ?>
                                    <a href="#"
                                       data-post='<?= /* @noEscape */ $block->getAddToWishlistParams($_item) ?>'
                                       class="action towishlist hm-card__wish"
                                       data-action="add-to-wishlist"
                                       title="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>">
                                        <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-wishlist"/></svg>
                                        <span><?= $escaper->escapeHtml(__('Add to Wish List')) ?></span>
                                    </a>
                                <?php endif; ?>
                            </div>
                            <div class="product-item-details">
                                <?php if ($hmVendorName): ?>
                                    <span class="hm-card__vendor"><?= $escaper->escapeHtml($hmVendorName) ?></span>
                                <?php endif; ?>
                                <strong class="product-item-name">
                                    <a title="<?= $escaper->escapeHtml($_item->getName()) ?>"
                                       href="<?= $escaper->escapeUrl($block->getProductUrl($_item)) ?>"
                                       class="product-item-link">
                                        <?= $escaper->escapeHtml($_item->getName()) ?>
                                    </a>
                                </strong>
                                <?php if ($templateType): ?>
                                    <?php /*
                                        THIRD ARGUMENT IS THE POINT. Core's ReviewRenderer returns an
                                        empty string before it reaches any template when a product has
                                        no rating summary:
                                            if (null === getRatingSummary() && !$displayIfNoReviews) return '';
                                        Passing true is the only way this theme's override of
                                        summary_short.phtml gets to draw its empty five-star track, which
                                        is what keeps every card in a row the same height. 94% of this
                                        catalogue carries no review, so without it the rows render ragged —
                                        the defect QA cycle 1 filed as "star ratings missing" against five
                                        separate sections.
                                    */ ?>
                                    <?= $block->getReviewsSummaryHtml($_item, $templateType, true) ?>
                                <?php endif; ?>

                                <?= $block->getProductDetailsHtml($_item) ?>

                                <div class="hm-card__foot">
                                    <?= $block->getProductPriceHtml($_item, $type) ?>

                                    <?php if ($showCompare || $showCart): ?>
                                        <div class="product-item-inner">
                                            <div class="product-item-actions">
                                                <?php if ($showCart): ?>
                                                    <div class="actions-primary">
                                                        <?php if ($_item->isSaleable()): ?>
                                                            <?php $postParams = $block->getAddToCartPostParams($_item); ?>
                                                            <form data-role="tocart-form" data-product-sku="<?= $escaper->escapeHtml($_item->getSku()) ?>" action="<?= $escaper->escapeUrl($postParams['action']) ?>" method="post">
                                                                <?php $options = $block->getOptionsData($_item); ?>
                                                                <?php foreach ($options as $optionItem): ?>
                                                                    <input type="hidden"
                                                                           name="<?= $escaper->escapeHtml($optionItem['name']) ?>"
                                                                           value="<?= $escaper->escapeHtml($optionItem['value']) ?>">
                                                                <?php endforeach; ?>
                                                                <input type="hidden" name="product" value="<?= $escaper->escapeHtmlAttr($postParams['data']['product']) ?>">
                                                                <input type="hidden" name="<?= /* @noEscape */ Action::PARAM_NAME_URL_ENCODED ?>" value="<?= /* @noEscape */ $postParams['data'][Action::PARAM_NAME_URL_ENCODED] ?>">
                                                                <?= $block->getBlockHtml('formkey') ?>
                                                                <?php /*
                                                                    Icon button, per Figma. The label stays in the
                                                                    DOM (clipped by CSS) so the control keeps an
                                                                    accessible name — the reference build shipped
                                                                    19 icon-only buttons with none at all.
                                                                */ ?>
                                                                <button type="submit"
                                                                        title="<?= $escaper->escapeHtml(__('Add to Cart')) ?>"
                                                                        class="action tocart primary">
                                                                    <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-cart"/></svg>
                                                                    <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                                                                </button>
                                                            </form>
                                                            <?php if ($block->getBlockHtml('formkey')): ?>
                                                            <script type="text/x-magento-init">
                                                            {
                                                                "[data-role=tocart-form], .form.map.checkout": {
                                                                    "catalogAddToCart": {
                                                                        "product_sku": "<?= $escaper->escapeJs($_item->getSku()); ?>"
                                                                    }
                                                                }
                                                            }
                                                            </script>
                                                            <?php endif;?>
                                                        <?php else: ?>
                                                            <?php if ($_item->isAvailable()): ?>
                                                                <div class="stock available"><span><?= $escaper->escapeHtml(__('In stock')) ?></span></div>
                                                            <?php else: ?>
                                                                <div class="stock unavailable"><span><?= $escaper->escapeHtml(__('Out of stock')) ?></span></div>
                                                            <?php endif; ?>
                                                        <?php endif; ?>
                                                    </div>
                                                <?php endif; ?>
                                                <?php /*
                                                    Compare is gone from the card. The other five listing
                                                    types drop it in layout (Magento_Theme/layout/default.xml)
                                                    because they render it through the `addto` child block;
                                                    this widget builds the control inline, so layout has
                                                    nothing to remove and it has to come out here.

                                                    Figma's card carries two actions — the wishlist disc on
                                                    the image and add-to-cart in the price row. The compare
                                                    FEATURE is untouched; only the per-card button is gone.
                                                */ ?>
                                            </div>
                                        </div>
                                    <?php endif; ?>
                                </div>

                                <?php
                                /*
                                 * Why this product is here — the reference's
                                 * per-card tag. Only Picked For You supplies one;
                                 * every other rail renders the card unchanged.
                                 */
                                $hmReason = method_exists($block, 'getReasonFor')
                                    ? (string) $block->getReasonFor((int) $_item->getId())
                                    : '';
                                ?>
                                <?php if ($hmReason !== ''): ?>
                                    <?php /* Icon + violet strip with its own top hairline —
                                             QA cycle 2 item 1-C, matching the reference's
                                             separated reason footer. */ ?>
                                    <span class="hm-card__reason">
                                        <svg class="hm-icon" aria-hidden="true" focusable="false"><use href="#hm-zap"/></svg>
                                        <?= $escaper->escapeHtml($hmReason) ?>
                                    </span>
                                <?php endif; ?>
                            </div>
                        </div>
                        <?= ($iterator == count($items) + 1) ? '</li>' : '' ?>
                    <?php endforeach ?>
                </ol>
            </div>
            <?= $block->getPagerHtml() ?>

            <?php
            /*
             * Section foot — a note on the left, a "view all" link on the right.
             * QA cycle 1 asked for it on Picked For You; written generically so
             * any rail can carry one from layout.
             */
            $hmFootNote = method_exists($block, 'getFootNote')
                ? (string) $block->getFootNote()
                : (string) $block->getData('foot_note');
            $hmFootUrl  = (string) $block->getData('foot_url');
            ?>
            <?php if ($hmFootNote !== '' || $hmFootUrl !== ''): ?>
                <div class="hm-section__foot">
                    <?php if ($hmFootNote !== ''): ?>
                        <p class="hm-section__foot-note"><?= $escaper->escapeHtml(__($hmFootNote)) ?></p>
                    <?php endif; ?>
                    <?php if ($hmFootUrl !== ''): ?>
                        <?php
                        $hmFootHref = preg_match('~^https?://~i', $hmFootUrl)
                            ? $hmFootUrl
                            : rtrim($block->getBaseUrl(), '/') . '/' . ltrim($hmFootUrl, '/');
                        ?>
                        <a class="hm-section__foot-link" href="<?= $escaper->escapeUrl($hmFootHref) ?>">
                            <?= $escaper->escapeHtml(__((string) ($block->getData('foot_label') ?: __('View all')))) ?>
                            <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-arrow-right"/></svg>
                        </a>
                    <?php endif; ?>
                </div>
            <?php endif; ?>
        </div>
    </div>
<?php endif;?>
