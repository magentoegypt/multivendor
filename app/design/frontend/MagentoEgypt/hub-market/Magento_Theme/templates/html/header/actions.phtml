<?php
/**
 * Hub Market — header action rail (account, wishlist, mini-cart).
 *
 * Every control here is icon-plus-label. The Figma build shipped 19 icon-only
 * buttons with zero accessible names — `aria-label` appeared 0 times in the
 * whole bundle — so the labels are real text, visually hidden below the
 * breakpoint rather than omitted.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

/** @var \Magento\Customer\Model\Context $customerContext */
$wishlistUrl = $block->getUrl('wishlist');
$accountUrl  = $block->getUrl('customer/account');
$loginUrl    = $block->getUrl('customer/account/login');
$registerUrl = $block->getUrl('customer/account/create');
$ordersUrl   = $block->getUrl('sales/order/history');
$logoutUrl   = $block->getUrl('customer/account/logout');

/*
 * WHICH HALF OF THE MENU TO RENDER.
 *
 * `Magento\Customer\Block\Account\AuthorizationLink::isLoggedIn()` reads
 * `Magento\Framework\App\Http\Context`, NOT the customer session. That
 * distinction is the whole reason this is safe inside full-page cache: the FPC
 * varies its entries by that context (Customer\Model\App\Action\ContextPlugin
 * registers CONTEXT_AUTH as a vary key), so guests and signed-in customers get
 * separate cached copies. Branching on the SESSION would bake one visitor's
 * state into the shared page; branching on the CONTEXT cannot.
 *
 * Only the boolean is safe to use here. The customer's NAME is not — the FPC
 * varies on "is anyone logged in", not on WHO — so any personal detail still has
 * to come from customer-data in the browser.
 */
$authState  = $block->getChildBlock('authState');
$isLoggedIn = $authState !== false && $authState->isLoggedIn();
?>
<div class="hm-header__actions">

    <?php
    /*
     * CL036-DEV01.05 — the account icon carries a menu.
     *
     * Opens on hover and on keyboard focus, in CSS (`:hover`, `:focus-within`).
     * No JS: the trigger stays a real link to the account page, so the control
     * still does something useful with the menu closed, with JS blocked, or on
     * a touch device where there is no hover. The rail itself is desktop-only —
     * _hm-mobile-parity.less hides it under 768px, where these destinations live
     * in the menu sheet instead.
     *
     * The first cut of this shipped BOTH halves and let Knockout choose from the
     * `customer` customer-data section, mirroring the utility strip above. QA
     * signed in and the menu still offered Login / Register — and so did the
     * strip, which has worked that way since it was built. The section is
     * per-visitor and lives in localStorage, and it only refreshes when the
     * action that changed it is listed in a sections.xml; something in this
     * store's login path leaves it holding the guest copy. Server-side it is
     * correct: asked directly for customer 84, the section returns
     * {"fullname":"test dev5",...}.
     *
     * So the menu no longer asks the browser. $isLoggedIn above comes from the
     * cache context, which is decided per request on the server and cannot go
     * stale.
     */
    ?>
    <div class="hm-header__action hm-header__action--account">
        <a class="hm-account__trigger" href="<?= $escaper->escapeUrl($accountUrl) ?>" aria-haspopup="true">
            <svg class="hm-icon" aria-hidden="true" focusable="false"><use href="#hm-account"/></svg>
            <span class="hm-header__action-label"><?= $escaper->escapeHtml(__('Account')) ?></span>
        </a>

        <div class="hm-account__menu">
            <?php if ($isLoggedIn): ?>
                <a class="hm-account__link" href="<?= $escaper->escapeUrl($accountUrl) ?>">
                    <?= $escaper->escapeHtml(__('My Account')) ?>
                </a>
                <a class="hm-account__link" href="<?= $escaper->escapeUrl($ordersUrl) ?>">
                    <?= $escaper->escapeHtml(__('My Orders')) ?>
                </a>
                <?php /* Logout accepts GET in 2.4.8 (Controller\Account\Logout
                         implements HttpGetActionInterface), so a plain link
                         avoids baking a form key into cached HTML. */ ?>
                <a class="hm-account__link" href="<?= $escaper->escapeUrl($logoutUrl) ?>">
                    <?= $escaper->escapeHtml(__('Sign Out')) ?>
                </a>
            <?php else: ?>
                <a class="hm-account__link" href="<?= $escaper->escapeUrl($loginUrl) ?>">
                    <?= $escaper->escapeHtml(__('Login')) ?>
                </a>
                <a class="hm-account__link" href="<?= $escaper->escapeUrl($registerUrl) ?>">
                    <?= $escaper->escapeHtml(__('Register')) ?>
                </a>
            <?php endif; ?>
        </div>
    </div>

    <a class="hm-header__action" href="<?= $escaper->escapeUrl($wishlistUrl) ?>">
        <svg class="hm-icon" aria-hidden="true" focusable="false"><use href="#hm-wishlist"/></svg>
        <span class="hm-header__action-label"><?= $escaper->escapeHtml(__('Wishlist')) ?></span>
    </a>

    <div class="hm-header__action hm-header__action--cart">
        <?= $block->getChildHtml('minicart') ?>
    </div>

    <?php /*
        Phones (CL036-DEV01.01 item 1): the prototype's phone header is logo /
        cart / hamburger. The account and wishlist links above are hidden below
        768px by _hm-mobile-parity.less and reappear at the top of the category
        sheet (topmenu.phtml, .hm-nav__quick); the hamburger itself is the
        category <details>' own <summary>, lifted into this row by CSS.
    */ ?>
</div>
