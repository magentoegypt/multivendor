<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="page">
            <resource>Vnecoms_VendorsPage::page</resource>
            <group id="base_url" translate="label tooltip" type="text" sortOrder="5" showInDefault="1">
				<label>Base URL</label>
	        	<field id="url_type" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Base URL</label>
                    <frontend_model>Vnecoms\VendorsDomain\Block\Vendors\System\Config\Form\Field\Domain</frontend_model>
                    <source_model>Vnecoms\VendorsDomain\Model\Config\Source\Url</source_model>
                    <backend_model>Vnecoms\VendorsDomain\Model\Config\Backend\Url</backend_model>
                </field>
			</group>
			<group id="general">
				<field id="logo" translate="label" type="image" sortOrder="5" showInDefault="1">
	            	<label>Header Logo</label>
	            	<comment>Allowed file types: PNG, GIF, JPG, JPEG</comment>
	            	<backend_model>Vnecoms\VendorsConfig\Model\Config\Backend\Image</backend_model>
	            	<upload_dir config="system/filesystem/media" scope_info="1">ves_vendors/header_logo</upload_dir>
                    <base_url type="media">ves_vendors/header_logo</base_url>
	        	</field>
			</group>
		</section>
    </system>
</config>
