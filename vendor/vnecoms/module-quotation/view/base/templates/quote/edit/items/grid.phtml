/**
 * @var $block \Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Items\Grid
 */
$isEditable = $block->isEdiable();
$_items = $block->getItems();
$quote = $block->getRealQuote()->collectTotals();
?>

<?php if (empty($_items)): ?>
    <div id="order-items_grid">
        <div class="admin__table-wrapper">
            <table class="data-table order-tables quote-table">
                <thead>
                <tr class="headings">
                    <th class="col-product"><span><?php /* @escapeNotVerified */ echo __('Product') ?></span></th>
                    <th class="col-stock-qty"><span><?php /* @escapeNotVerified */ echo __('Available Stock') ?></span></th>
                    <th class="col-price"><span><?php /* @escapeNotVerified */ echo __('Original Price') ?></span></th>
                    <th colspan="2" class="col-margingp"><span><?php /* @escapeNotVerified */ echo __('Qty & Proposals') ?></span></th>
                    <th class="col-action"><span /></th>
                </tr>
                </thead>
                <tbody>
                <tr class="even">
                    <td class="empty-text" colspan="100"><?php /* @escapeNotVerified */ echo __('No quote items') ?></td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
<?php else: ?>
    <div class="admin__table-wrapper" id="order-items_grid">

        <table class="data-table order-tables quote-table">
            <thead>
            <tr class="headings">
                <th class="col-product"><span><?php /* @escapeNotVerified */ echo __('Product') ?></span></th>
                <th class="col-stock-qty"><span><?php /* @escapeNotVerified */ echo __('Available Stock') ?></span></th>
                <th class="col-price"><span><?php /* @escapeNotVerified */ echo __('Original Price') ?></span></th>
                <th class="col-qty-proposal"><span><?php /* @escapeNotVerified */ echo __('Qty & Proposals') ?></span></th>
                <th class="col-action"><span><?php /* @escapeNotVerified */ echo __('Actions') ?></span></th>
            </tr>
            </thead>
            <?php $i = 0 ?>
            <?php foreach ($_items as $_item):$i++ ?>
                <tbody class="<?php /* @escapeNotVerified */ echo($i%2) ? 'even' : 'odd' ?>">
                <tr>
                    <td class="col-product">
                        <span id="quote_item_<?php /* @escapeNotVerified */ echo $_item->getId() ?>_title"><?php echo $block->escapeHtml($_item->getName()) ?></span>
                        <div class="product-sku-block">
                            <span><?php /* @escapeNotVerified */ echo __('SKU') ?>:</span>
                            <?php echo $block->escapeHtml($_item->getSku()); ?>
                        </div>
                        <div class="product-configure-block">
                            <?php /* option list */ ?>
                            <?php if ($_options = $block->getOptionList($_item)):?>
                                <dl class="item-options">
                                    <?php foreach ($_options as $_option) : ?>
                                        <?php $_formatedOptionValue = $block->getFormatedOptionValue($_option) ?>
                                        <dt><?php echo $block->escapeHtml($_option['label']) ?>:</dt>
                                        <dd>
                                            <?php if (isset($_formatedOptionValue['full_view'])): ?>
                                                <?php /* @escapeNotVerified */ echo $_formatedOptionValue['full_view'] ?>
                                            <?php else: ?>
                                                <?php /* @escapeNotVerified */ echo $_formatedOptionValue['value'] ?>
                                            <?php endif; ?>
                                        </dd>
                                    <?php endforeach; ?>
                                </dl>
                            <?php endif;?>
                            <?php /*message list*/ ?>
                            <?php $addInfoBlock = $block->getProductAdditionalInformationBlock(); ?>
                            <?php if ($addInfoBlock): ?>
                                <?php echo $addInfoBlock->setItem($_item)->toHtml() ?>
                            <?php endif;?>

                            <?php if($_item->getComment()):?>
                            <div class="quote-item-comment">
                                <?php echo $_item->getComment() ?>
                            </div>
                            <?php endif;?>
                        </div>
                    </td>
                    <td class="col-stock-qty">
                        <?php foreach ($block->getStockItem($_item) as $stock): ?>
                            <p><span style="font-weight: bold"><?php echo $stock["stock_name"] ?>:</span> <?php echo $stock["qty"] ? $stock["qty"] : "unlimited" ?></p>
                        <?php endforeach;?>
                    </td>
                    <td class="col-price">
                        <?php echo $block->getItemUnitPriceHtml($_item); ?>
                    </td>
                    <td class="col-qty-proposal">
                    <?php /* both qty and margin gross price and proposal columns */ ?>
                    <?php echo $block->getItemProposalHtml($_item); ?>
                    </td>
                    <td class="col-actions last">
                        <?php if($isEditable):?>
                        <a href="javascript: void(0);" onclick="quote.removeQuoteItem(<?php echo $_item->getId()?>)" class="quote-item-action-delete"><i class="quote-icon-minus-circle"></i></a>
                        <?php endif;?>
                    </td>
                </tr>
                </tbody>
            <?php endforeach; ?>

            <tfoot>
            <tr class="total_qty" style="text-align: right">
                <td colspan="4" class="col-0" scope="row">
                    <strong><?php echo __("Total Qty") ?>: </strong>
                    <span class="price"><strong><?php echo $quote->getItemsQty() ?></strong></span>
                </td>
            </tr>

            <tr class="grand_total" style="text-align: right">
                <td colspan="4" class="col-1" scope="row">
                    <strong><?php echo __("Grand Total") ?>: </strong>
                    <span class="price"><strong><?php echo $block->formatPrice($quote->getGrandTotal()) ?></strong></span>
                </td>
            </tr>

            </tfoot>
        </table>
    </div>

<?php endif;?>
