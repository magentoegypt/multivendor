<?xml version="1.0"?>
<!--
/**
 * Hub Market — homepage.
 *
 * Deliberately built as THEME layout rather than as CMS page content.
 *
 * CMS pages are theme-independent: the `home` page renders on whichever theme
 * is active. There are two of them — page_id 2 (Arabic, live and populated) and
 * page_id 84 (English, currently rendering empty "dash" placeholders) — and both
 * are still served to real visitors by Mgs/supro. Editing either would change
 * the live storefront before this theme is ready.
 *
 * Scoping the homepage here means it renders ONLY under MagentoEgypt/hub-market.
 * Supro keeps its existing homepage untouched, and switching the theme back
 * restores it exactly.
 *
 * Content is still editable: each static section reads from a CMS block, so
 * merchandisers change copy and imagery in admin without touching layout. The
 * product and vendor rails are live widgets.
 *
 * This also retires the last real MGS Fbuilder dependency: the homepage was
 * the only genuine one; the other 15 Fbuilder pages are MGS demo content.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!--
            Set here because the block that would normally supply it (cms_page) is
            removed above. Without this the homepage renders <title></title>.

            TRADE-OFF, stated plainly: this takes the homepage title out of the
            admin. It is the same string for both store views today, so nothing is
            lost right now — but if the title needs to differ per store view or be
            merchant-editable, the better fix is to point web/default/cms_home_page
            at a new, EMPTY CMS page. The cms_page block would then supply the
            title and meta from admin while rendering no content, and this line
            would come out. That change also has to be undone on rollback, which is
            why it was not done during go-live.
        -->
        <title>Hub Market — Multi-Vendor Marketplace</title>
    </head>
    <body>
        <attribute name="class" value="hm-home"/>

        <!--
            0. LCP PRELOAD for the first hero slide. Lives in head.additional
            because Magento assembles <head> before it renders the body, so the
            band block cannot add the asset itself. Same Band block, second
            template — see MagentoEgypt_HeroBanner::preload.phtml.
        -->
        <referenceContainer name="head.additional">
            <block class="MagentoEgypt\HeroBanner\Block\Band"
                   name="hm.home.hero.preload"
                   template="MagentoEgypt_HeroBanner::preload.phtml"/>
        </referenceContainer>

        <referenceContainer name="content">

            <!--
                The legacy CMS body (Fbuilder markup on the Arabic page, empty
                dash placeholders on the English one) must not render here.

                NOTE: a literal double-hyphen is illegal inside an XML comment.
                Writing the placeholders out as punctuation here is what made this
                exact file malformed once before; Magento then ignores the file
                SILENTLY, with nothing in the log, and the homepage quietly loses
                every section. docs/design/validate-theme-xml.sh exists for this.

                Note what removing this block ALSO removes, because it is not
                obvious: Magento\Cms\Block\Page::_prepareLayout() is what sets the
                page title, meta description, meta keywords and the
                cms-IDENTIFIER body class. Removing the block shipped an empty
                title element on the homepage.

                Pointing the block at an empty template does NOT work — its
                _toHtml() filters $page->getContent() directly and ignores the
                template entirely (module-cms/Block/Page.php:164). So the block
                really does have to go, and the title is set explicitly below.
            -->
            <referenceBlock name="cms_page" remove="true"/>

            <!--
                1. HERO BAND — carousel slides AND the three side tiles, from one
                block, backed by one admin-managed table.

                Content > Hero Banner. See app/code/MagentoEgypt/HeroBanner.

                WHAT THIS REPLACES, and why both had to go together:

                  - hm.home.hero.carousel (MagentoEgypt\HomeSections\Block\HeroCarousel)
                    derived its slides from the category tree and took the copy for
                    each one from the `slide_copy` array that used to sit in this
                    file. Every headline change was a layout edit and a static
                    redeploy, and a slide could only ever point at a category.
                  - hm.home.hero, a CMS block (`hm_home_hero`) holding raw markup
                    for the three tiles. Images and links lived in unversioned HTML
                    that a merchandiser had to hand-edit.

                They are one component in the design — the tile column must match
                the carousel's height and share its art direction — and keeping
                them in two unrelated systems is what let them drift. Both are rows
                in magentoegypt_hero_banner now, edited in one grid.

                The old blocks and their templates remain on disk and still work if
                declared; nothing else in the theme references them.
            -->
            <block class="MagentoEgypt\HeroBanner\Block\Band"
                   name="hm.home.hero.band" before="-"
                   template="MagentoEgypt_HeroBanner::band.phtml">
                <arguments>
                    <argument name="tile_limit" xsi:type="number">3</argument>
                </arguments>
            </block>

            <!--
                1b. The promo tiles are part of hm.home.hero.band now. The CMS
                block that held them (hm_home_hero) is left in the database rather
                than deleted, so the previous markup is recoverable, but nothing
                renders it.
            -->

            <!--
                2. Service promises — REMOVED from the homepage.

                Figma carries exactly one trust strip and it sits near the FOOT of
                the page (hm.home.trust, the five-badge row above the app banner).
                This four-item strip under the hero was a second one, and the two
                said the same thing: "Nationwide delivery / Easy returns / Secure
                payment / Verified sellers" against "Approved sellers only / Secure
                payments / Nationwide delivery / Easy returns / WhatsApp support".
                Four of five claims were duplicated on a single page.

                The template stays on disk (Magento_Cms::home/usp.phtml) and the
                block still renders anywhere else it is declared — this only takes
                it off the homepage.
            -->
            <!-- (was: hm.home.usp) -->

            <!--
                3. Shop by category — chips with LIVE item counts.

                Replaces the static CMS block (hm_home_categories), whose tiles
                carried no counts and would have gone stale against the catalog.
                The block filters out categories with zero products, which this
                catalog has several of (Promotions, Sale).
            -->
            <block class="MagentoEgypt\HomeSections\Block\CategoryChips"
                   name="hm.home.categories" after="hm.home.hero.band"
                   template="MagentoEgypt_HomeSections::category-chips.phtml">
                <arguments>
                    <argument name="limit" xsi:type="number">8</argument>
                    <!--
                        Chip glyphs, keyed on category URL KEY.

                        Figma's chips carry a flat icon; ours carried the category
                        IMAGE, cropped to a 40px circle. Those images are wide
                        merchandising photographs and none of them survives that crop:
                        the shoes chip rendered as a dog, computer as a beach, clothes
                        as an unreadable smear. A glyph is both the design's choice and
                        the legible one at this size.

                        URL key rather than name or id: the key is identical in both
                        store views (verified: /clothes.html and /bags.html in each),
                        so one map serves Arabic and English, and it survives a
                        category being renamed. An unmapped category falls back to a
                        neutral tag glyph in the block rather than rendering blank.

                        THE KEYS WERE WRONG, AND THAT WAS THE BUG QA FILED. This map
                        used to name `toys`, `mobile-tablet` and `pharmacy`; the
                        catalogue's actual level-2 keys are `games`, `electronics`
                        and — for pharmacy — nothing at all. Every unmatched chip
                        fell through to the tag glyph, which QA reported as "generic
                        tag icons". Verified against the live category tree before
                        rewriting rather than transcribed from the design.

                        VALUES ARE EMOJI, matching the reference, which renders this
                        row as 🛒 💊 🛋️ 👗 📦 🧸 ✨ 📱 — verified against
                        doze-coyote-58038022.figma.site, not inferred. They were
                        briefly sprite ids because QA asked for "SVG icons"; the
                        reference has none here, and QA's own examples (pill, box,
                        teddy bear) describe the emoji. Written as HTML entities so
                        the XML stays 7-bit and no editor can mangle a surrogate pair.

                        Electronics is 📱 in this row and 💻 in the nav bar — that
                        is the reference's own pairing, not an inconsistency.
                    -->
                    <argument name="icons" xsi:type="array">
                        <item name="super-market" xsi:type="string">&#128722;</item>
                        <item name="pharmacy" xsi:type="string">&#128138;</item>
                        <item name="furniture" xsi:type="string">&#128715;&#65039;</item>
                        <item name="clothes" xsi:type="string">&#128087;</item>
                        <item name="fmcg" xsi:type="string">&#128230;</item>
                        <item name="games" xsi:type="string">&#129528;</item>
                        <item name="health" xsi:type="string">&#10024;</item>
                        <item name="electronics" xsi:type="string">&#128241;</item>
                        <!-- Not in the reference row, but mapped so a promoted
                             category never falls back to the neutral tag. -->
                        <item name="home-appliances" xsi:type="string">&#127968;</item>
                        <item name="mobile-tablet" xsi:type="string">&#128241;</item>
                        <item name="computer" xsi:type="string">&#128187;</item>
                        <item name="bags" xsi:type="string">&#128092;</item>
                        <item name="shoes" xsi:type="string">&#128095;</item>
                        <item name="accessories" xsi:type="string">&#128087;</item>
                        <item name="sports" xsi:type="string">&#9917;</item>
                    </argument>
                    <!--
                        Chip tints, also keyed on URL KEY, as slots 0-7 into the
                        pastel ramp in _hm-figma.less.

                        Figma pairs its eight pastels to the CATEGORY, not to the
                        position in the row, and that is worth reproducing for a
                        reason beyond parity: with a positional modulo, disabling
                        or adding one category re-colours every chip after it. An
                        unmapped category still falls back to the positional
                        rotation, so the row is never uncoloured.

                        Slots:  0 mint  1 blue  2 amber  3 pink
                                4 lavender  5 cream  6 rose  7 indigo
                    -->
                    <argument name="tints" xsi:type="array">
                        <item name="super-market" xsi:type="number">0</item>
                        <item name="pharmacy" xsi:type="number">1</item>
                        <item name="furniture" xsi:type="number">2</item>
                        <item name="clothes" xsi:type="number">3</item>
                        <item name="fmcg" xsi:type="number">4</item>
                        <item name="games" xsi:type="number">5</item>
                        <item name="health" xsi:type="number">6</item>
                        <item name="electronics" xsi:type="number">7</item>
                        <item name="home-appliances" xsi:type="number">6</item>
                        <item name="bags" xsi:type="number">7</item>
                        <item name="shoes" xsi:type="number">5</item>
                        <item name="mobile-tablet" xsi:type="number">1</item>
                        <item name="computer" xsi:type="number">4</item>
                        <item name="sports" xsi:type="number">0</item>
                    </argument>

                    <!--
                        THE ROW, in the reference's order. Doubles as an allow-list:
                        naming eight keys is what takes "Home Appliances" and "Bags"
                        out, which QA asked for, without touching catalogue
                        positions and therefore without reordering the main menu.

                        `pharmacy` and `fmcg` DO NOT EXIST in this catalogue. They
                        are listed because the reference has them and because the
                        block skips a key it cannot find — so the day those
                        categories are created and filled, the chips appear in the
                        right place with the right icon and tint, with no code
                        change. Until then the row renders the six that exist.
                    -->
                    <argument name="order" xsi:type="array">
                        <item name="1" xsi:type="string">super-market</item>
                        <item name="2" xsi:type="string">pharmacy</item>
                        <item name="3" xsi:type="string">furniture</item>
                        <item name="4" xsi:type="string">clothes</item>
                        <item name="5" xsi:type="string">fmcg</item>
                        <item name="6" xsi:type="string">games</item>
                        <item name="7" xsi:type="string">health</item>
                        <item name="8" xsi:type="string">electronics</item>
                    </argument>
                </arguments>
            </block>

            <!-- 4. Featured products (live) -->
            <block class="Magento\CatalogWidget\Block\Product\ProductsList"
                   name="hm.home.featured"
                   after="hm.home.bestsellers">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Popular Products</argument>
                    <argument name="more_url" xsi:type="string">all.html</argument>
                    <argument name="more_label" xsi:type="string" translate="true">View All</argument>
                    <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
                    <argument name="products_count" xsi:type="number">8</argument>
                    <argument name="show_pager" xsi:type="number">0</argument>
                    <argument name="template" xsi:type="string">Magento_CatalogWidget::product/widget/content/grid.phtml</argument>
                    <!-- "all products", newest first -->
                    <argument name="conditions_encoded" xsi:type="string">^[`1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Combine`,`aggregator`:`all`,`value`:`1`,`new_child`:``^]^]</argument>
                </arguments>
            </block>

            <!-- 5. Vendor spotlight (live) — reuses the existing widget block -->
            <block class="MagentoEgypt\VendorExtend\Block\Widget\Seller"
                   name="hm.home.vendors"
                   after="hm.home.pickedforyou">
                <arguments>
                    <!--
                        The block's _toHtml() calls setTemplate(getConfig('template')),
                        so with no template argument it renders nothing at all.
                    -->
                    <argument name="template" xsi:type="string">MagentoEgypt_VendorExtend::widget/sellerlist.phtml</argument>
                    <!--
                        Star rating + dispatch estimate for each card (QA cycle 1).
                        A view model because the block's own API stops at name,
                        logo, url and product count — see VendorMeta for why this
                        route and not a constructor.
                    -->
                    <argument name="vendor_meta" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorMeta</argument>
                    <!--
                        Without seller_ids the collection filters on is_home = 1.
                        That is an EAV attribute no vendor here has set, so the
                        rail came back empty. Curated ids are also editorially
                        right for a "Featured Stores" rail. ves_vendor_entity has BOTH entity_id and a separate
                        vendor_id, and vendor_id is a string url-key, not the
                        numeric id. These are approved stores that have products.
                    -->
                    <argument name="title" xsi:type="string" translate="true">Featured Stores</argument>
                    <!-- No subtitle: QA cycle 2 item 1-D — "we need remove
                         'Approved sellers with the widest ranges'"; the
                         reference heads this rail with the title alone. -->
                    <!--
                        FOUR ids, and the rail rendered THREE. `seno` was silently
                        dropped, and not by anything in this layout: the vendor
                        collection INNER JOINs ves_vendor_user on is_super_user = 1
                        and then customer_entity, and vendor 12 (seno) has no
                        ves_vendor_user row at all — no owner account. An inner
                        join on a missing row removes the vendor, so the widget
                        asked for four, matched three, and the fourth grid track
                        sat empty with nothing in the markup to explain it.

                        Replaced rather than repaired: giving seno an owner account
                        is a vendor-administration act, not a homepage one. ENARA
                        is approved, HAS a super user, and carries 11 products —
                        the largest eligible catalog after the three already here.
                        seno itself is raised separately; it has 29 products and is
                        invisible to every block that uses this collection.
                    -->
                    <argument name="seller_ids" xsi:type="string">ENARA,ronza,loly,MIA</argument>
                    <argument name="items" xsi:type="number">4</argument>
                    <argument name="show_name" xsi:type="number">1</argument>
                    <argument name="autoplay" xsi:type="number">0</argument>
                    <argument name="navigation" xsi:type="number">1</argument>
                </arguments>
            </block>

            <!--
                6. Bundle Deals — the navy band, now with real bundle CARDS.

                It was a CMS block (`hm_home_bundles`) rendering a heading and a
                "Browse bundles" button: an empty promotional band where Figma
                shows four merchandised bundles. The block reads the catalog's own
                bundle products, so the rail cannot advertise a bundle that has
                been disabled or has fallen out of the price index.

                Both `bundle` and `new_bundle` are collected — new_bundle is this
                project's own type and keeps its options in the core bundle tables.

                The CMS block stays in the database, unreferenced, so the previous
                copy is recoverable.
            -->
            <block class="MagentoEgypt\HomeSections\Block\BundleDeals"
                   name="hm.home.bundles" after="hm.home.rail.furniture"
                   template="MagentoEgypt_HomeSections::bundle-deals.phtml">
                <arguments>
                    <!--
                        The star renderer, as a VIEW MODEL rather than a
                        constructor dependency — see ReviewStars for why both
                        halves of that matter. Same route `vendor_names` takes
                        into the product rails.
                    -->
                    <argument name="review_stars" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\ReviewStars</argument>
                    <argument name="limit" xsi:type="number">4</argument>
                </arguments>
            </block>

            <!--
                7-10. Category rails, matching the Figma reference's
                Grocery Essentials / Fashion Trends / Beauty & Cosmetics /
                Furniture Picks sections.

                Mapped onto categories that actually exist in this catalog rather
                than the Figma's invented ones, with the product counts measured
                today:
                    Supermarket        id 101   8 products
                    clothes            id 140  40 products
                    Beauty & Perfumes  id 103  16 products
                    furniture          id  74  11 products

                All four are plain CatalogWidget blocks filtered on category_ids,
                so they need no new module and no setup:di:compile — and the
                titles are translate="true", so the Arabic store view picks up
                i18n/ar_SA.csv instead of showing English.
            -->
            <block class="Magento\CatalogWidget\Block\Product\ProductsList"
                   name="hm.home.rail.grocery" after="hm.home.vendors">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Grocery Essentials</argument>
                    <argument name="subtitle" xsi:type="string" translate="true">Fresh &amp; delivered today</argument>
                    <argument name="more_url" xsi:type="string">super-market.html</argument>
                    <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
                    <argument name="products_count" xsi:type="number">4</argument>
                    <argument name="show_pager" xsi:type="number">0</argument>
                    <argument name="template" xsi:type="string">Magento_CatalogWidget::product/widget/content/grid.phtml</argument>
                    <argument name="conditions_encoded" xsi:type="string">^[`1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Combine`,`aggregator`:`all`,`value`:`1`,`new_child`:``^],`1--1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Product`,`attribute`:`category_ids`,`operator`:`==`,`value`:`101`^]^]</argument>
                </arguments>
            </block>

            <block class="Magento\CatalogWidget\Block\Product\ProductsList"
                   name="hm.home.rail.fashion" after="hm.home.rail.grocery">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Fashion Trends</argument>
                    <argument name="subtitle" xsi:type="string" translate="true">New arrivals this week</argument>
                    <argument name="more_url" xsi:type="string">clothes.html</argument>
                    <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
                    <argument name="products_count" xsi:type="number">4</argument>
                    <argument name="show_pager" xsi:type="number">0</argument>
                    <argument name="template" xsi:type="string">Magento_CatalogWidget::product/widget/content/grid.phtml</argument>
                    <argument name="conditions_encoded" xsi:type="string">^[`1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Combine`,`aggregator`:`all`,`value`:`1`,`new_child`:``^],`1--1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Product`,`attribute`:`category_ids`,`operator`:`==`,`value`:`140`^]^]</argument>
                </arguments>
            </block>

            <block class="Magento\CatalogWidget\Block\Product\ProductsList"
                   name="hm.home.rail.beauty" after="hm.home.rail.fashion">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Beauty &amp; Cosmetics</argument>
                    <argument name="subtitle" xsi:type="string" translate="true">Curated beauty picks</argument>
                    <argument name="more_url" xsi:type="string">health.html</argument>
                    <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
                    <argument name="products_count" xsi:type="number">4</argument>
                    <argument name="show_pager" xsi:type="number">0</argument>
                    <argument name="template" xsi:type="string">Magento_CatalogWidget::product/widget/content/grid.phtml</argument>
                    <argument name="conditions_encoded" xsi:type="string">^[`1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Combine`,`aggregator`:`all`,`value`:`1`,`new_child`:``^],`1--1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Product`,`attribute`:`category_ids`,`operator`:`==`,`value`:`103`^]^]</argument>
                </arguments>
            </block>

            <block class="Magento\CatalogWidget\Block\Product\ProductsList"
                   name="hm.home.rail.furniture" after="hm.home.rail.beauty">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Furniture Picks</argument>
                    <argument name="subtitle" xsi:type="string" translate="true">For your home</argument>
                    <argument name="more_url" xsi:type="string">furniture.html</argument>
                    <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
                    <argument name="products_count" xsi:type="number">4</argument>
                    <argument name="show_pager" xsi:type="number">0</argument>
                    <argument name="template" xsi:type="string">Magento_CatalogWidget::product/widget/content/grid.phtml</argument>
                    <argument name="conditions_encoded" xsi:type="string">^[`1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Combine`,`aggregator`:`all`,`value`:`1`,`new_child`:``^],`1--1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Product`,`attribute`:`category_ids`,`operator`:`==`,`value`:`74`^]^]</argument>
                </arguments>
            </block>


            <!--
                11. Top Brands (Figma: "Top Brands on MECommerce").
                Backed by the real MGS_Brand catalogue - 29 brands, 190 product
                links. MGS_Brand was decommissioned in Phase L and re-enabled
                specifically for this section; its data survived because
                disabling a module never drops its tables.
            -->
            <block class="MagentoEgypt\HomeSections\Block\TopBrands"
                   name="hm.home.brands" after="hm.home.featured"
                   template="MagentoEgypt_HomeSections::top-brands.phtml">
                <arguments>
                    <!-- MGS_Brand's front name; see top-brands.phtml. -->
                    <argument name="more_url" xsi:type="string">brand</argument>
                    <!-- Eight, because Figma runs this row eight wide and the ninth
                         brand wrapped onto a row of its own. -->
                    <argument name="limit" xsi:type="number">8</argument>
                </arguments>
            </block>

            <!--
                12. New Stores (Figma: "New Stores on MECommerce").
                Approved vendors only - 3 of the 25 vendor rows. Showing unvetted
                applicants would contradict the "reviewed and approved before
                going live" promise made in the USP strip above.
            -->
            <!--
                12b. Top Vendors This Month (Figma places this between Top Brands
                and New Stores).

                Same block as New Stores, ranked by REAL customer rating instead of
                join date. The star value is derived from review_entity_summary in a
                second query, so it cannot be an SQL ORDER BY — the block fetches a
                wider pool and re-sorts in PHP. See NewStores::isRatingOrder().

                `order_by` is part of the block's cache key, or this rail and New
                Stores would collide on one entry and render identical HTML.
            -->
            <block class="MagentoEgypt\HomeSections\Block\NewStores"
                   name="hm.home.topvendors" after="hm.home.brands"
                   template="MagentoEgypt_HomeSections::new-stores.phtml">
                <arguments>
                    <!-- "verified", not "approved" (QA cycle 2 item 1-K), and the
                         cycle-2 brand: Hub Market. -->
                    <argument name="subtitle" xsi:type="string" translate="true">Highest-rated sellers verified by Hub Market</argument>
                    <argument name="limit" xsi:type="number">4</argument>
                    <argument name="order_by" xsi:type="string">rating</argument>
                    <argument name="heading" xsi:type="string" translate="true">Top Vendors This Month</argument>
                </arguments>
            </block>

            <block class="MagentoEgypt\HomeSections\Block\NewStores"
                   name="hm.home.newstores" after="hm.home.topvendors"
                   template="MagentoEgypt_HomeSections::new-stores.phtml">
                <arguments>
                    <argument name="subtitle" xsi:type="string" translate="true">Recently joined verified sellers</argument>
                    <argument name="limit" xsi:type="number">4</argument>
                </arguments>
            </block>


            <!--
                13. Best Selling Items (Figma: "Best Selling Items").

                Ranked from REAL sales. Magento's own bestseller aggregate holds
                seven rows covering only three products on this install because
                the report cron has not been running; the raw order lines show 12
                products have actually sold. The block therefore reads
                sales_order_item directly and inherits CatalogWidget's card
                rendering so the row is visually identical to the category rails.
            -->
            <block class="MagentoEgypt\HomeSections\Block\BestSellers"
                   name="hm.home.bestsellers" after="hm.home.promos">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Best Selling Items</argument>
                    <argument name="subtitle" xsi:type="string" translate="true">Top-rated across all categories this month</argument>
                    <!--
                        Figma gives every rail head a trailing "See All" link.
                        Four rails had one and five did not; these are the two
                        that have a real destination. all.html is category 168
                        ("All", 734 products) — its English URL rewrite was
                        missing entirely and had to be generated before this
                        link could point anywhere.
                    -->
                    <argument name="more_url" xsi:type="string">all.html</argument>
                    <argument name="more_label" xsi:type="string" translate="true">View All</argument>
                    <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
                    <argument name="products_count" xsi:type="number">6</argument>
                    <argument name="show_pager" xsi:type="number">0</argument>
                    <argument name="template" xsi:type="string">Magento_CatalogWidget::product/widget/content/grid.phtml</argument>
                    <!-- Fallback rule, used only if nothing has sold yet. -->
                    <argument name="conditions_encoded" xsi:type="string">^[`1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Combine`,`aggregator`:`all`,`value`:`1`,`new_child`:``^]^]</argument>
                </arguments>
            </block>

            <!--
                14. Picked For You (Figma: the "AI ENGINE / Picked For You" panel).

                Backed by Magento's own recently-viewed tracking, which is REAL
                per-visitor personalisation that populates itself as people
                browse — not a fabricated recommendation engine. There is no ML
                model here and the section does not pretend otherwise.

                report_viewed_product_index is currently empty (no real traffic
                yet), so this renders nothing until visitors browse. That is the
                correct behaviour for a personalised row: an empty state beats
                showing strangers a fake "picked for you".
            -->
            <block class="MagentoEgypt\HomeSections\Block\PickedForYou"
                   name="hm.home.pickedforyou" after="hm.home.deals">
                <arguments>
                    <!--
                        Section foot, per QA cycle 1 ("Recommendations update as
                        you shop..." on the left, "View all recommendations ->"
                        on the right). The NOTE comes from the block, because
                        which sentence is true depends on whether the row is
                        actually personalised yet; the link is static.
                    -->
                    <argument name="foot_url" xsi:type="string">all.html</argument>
                    <argument name="foot_label" xsi:type="string" translate="true">View all recommendations</argument>
                    <argument name="title" xsi:type="string" translate="true">Picked For You</argument>
                    <!--
                        QA03 item 1-C asked for Figma's exact subtitle, so that is
                        what ships. Recording what it claims against what runs, for
                        whoever reads this next: there is no model and no per-visitor
                        personalisation here. The rail is Magento's own
                        recently-viewed index, and the "Your searches" chips beside it
                        come from the store-wide `search_query` table ordered by
                        popularity — the same list for every visitor. The copy and the
                        AI ENGINE badge are presentational until something behind them
                        actually personalises.
                    -->
                    <argument name="subtitle" xsi:type="string" translate="true">Personalised recommendations based on your search history &amp; behaviour</argument>
                    <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
                    <argument name="products_count" xsi:type="number">4</argument>
                    <argument name="show_pager" xsi:type="number">0</argument>
                    <argument name="template" xsi:type="string">Magento_CatalogWidget::product/widget/content/grid.phtml</argument>
                    <argument name="conditions_encoded" xsi:type="string">^[`1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Combine`,`aggregator`:`all`,`value`:`1`,`new_child`:``^]^]</argument>
                </arguments>
            </block>


            <!--
                15. Promo tiles (Figma: the three coloured banners).
                Every destination is a page that exists here. The Figma's third
                tile advertises "Split in 4 with Tabby" - Tabby is NOT a
                configured payment method on this store, so that tile points at
                seller registration instead. Advertising an unavailable payment
                method is the same mistake the Gulf USP copy made.
            -->
            <!--
                Position: Figma places the three banners immediately AFTER the bundle
                band and before Best Selling. Ours sat after New Stores, near the
                bottom, which put three promotional tiles between the vendor rails and
                the trust strip instead of breaking up the long run of product grids.
            -->
            <block class="Magento\Cms\Block\Block" name="hm.home.promos" after="hm.home.bundles">
                <arguments>
                    <argument name="block_id" xsi:type="string">hm_home_promos</argument>
                </arguments>
            </block>

            <!--
                16. Trust row (Figma: the badges strip above the app banner).
                Five claims, each checkable against this install rather than
                copied from the design.
            -->
            <block class="Magento\Cms\Block\Block" name="hm.home.trust" after="hm.home.newstores">
                <arguments>
                    <argument name="block_id" xsi:type="string">hm_home_trust</argument>
                </arguments>
            </block>




            <!--
                Today's Deals: products whose special_price is live right now,
                deepest discount first. Renders nothing when no offer is active,
                so it cannot invent a sale.
            -->
            <block class="MagentoEgypt\HomeSections\Block\TodaysDeals"
                   name="hm.home.deals" after="hm.home.categories">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Today's Deals</argument>
                    <!--
                        The reference's deals band carries an "All Deals" link on
                        the right of its heading, and the client filed its absence
                        (CL036-DEV01.01 item 5). grid.phtml renders the link only
                        when more_url is set; every other rail on this page
                        already passes one.
                    -->
                    <argument name="more_url" xsi:type="string">all.html</argument>
                    <argument name="more_label" xsi:type="string" translate="true">All Deals</argument>
                    <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
                    <argument name="products_count" xsi:type="number">4</argument>
                    <argument name="show_pager" xsi:type="number">0</argument>
                    <argument name="template" xsi:type="string">Magento_CatalogWidget::product/widget/content/grid.phtml</argument>
                    <argument name="conditions_encoded" xsi:type="string">^[`1`:^[`type`:`Magento||CatalogWidget||Model||Rule||Condition||Combine`,`aggregator`:`all`,`value`:`1`,`new_child`:``^]^]</argument>
                </arguments>

                <!--
                    Deals countdown, now a CHILD of the rail and rendered inside its
                    section head as `rail_extra`.

                    It used to be a standalone sibling declared AFTER hm.home.deals,
                    which is where it rendered: orphaned below the product grid, in a
                    pale pill, with nothing to relate it to. Figma puts it inline with
                    the heading, which is the only position where "05:23:40 remaining"
                    means anything.

                    The earlier note in this file said nesting had fataled the page by
                    making the countdown inherit ProductsList's required
                    conditions_encoded argument. That is not what child nesting does —
                    a child block is constructed from its OWN class with its OWN
                    arguments. The original failure came from declaring it with the
                    ProductsList class. DealsCountdown extends plain Template and reads
                    one date; grid.phtml pulls it in with getChildHtml('rail_extra').
                -->
                <block class="MagentoEgypt\HomeSections\Block\DealsCountdown"
                       name="hm.home.deals.countdown"
                       as="rail_extra"
                       template="MagentoEgypt_HomeSections::deals-countdown.phtml"/>
            </block>


            <!--
                App / mobile banner. Ships WITHOUT App Store or Google Play
                badges: no such URL exists anywhere on this install, and a badge
                that links nowhere costs a tap and returns a 404. Add two anchors
                to .hm-app__actions in the CMS block when real URLs exist.
            -->
            <block class="Magento\Cms\Block\Block" name="hm.home.app" after="hm.home.trust">
                <arguments>
                    <argument name="block_id" xsi:type="string">hm_home_app</argument>
                </arguments>
            </block>

        </referenceContainer>
    </body>
</page>
