<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">

	            	<field id="ultimate_api" translate="label tooltip" type="text" sortOrder="161" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Api Key</label>
	                    <config_path>vsms/settings/ultimate_api</config_path>
	                    <depends>
	                        <field id="gateway">ultimate</field>
	                    </depends>
	                </field>

					<field id="ultimate_sender" translate="label tooltip" type="text" sortOrder="162" showInDefault="1" showInWebsite="1" showInStore="0">
						<label>Sender</label>
						<config_path>vsms/settings/ultimate_sender</config_path>
						<depends>
							<field id="gateway">ultimate</field>
						</depends>
					</field>

					<field id="ultimate_api_url" translate="label tooltip" type="text" sortOrder="164" showInDefault="1" showInWebsite="1" showInStore="0">
						<label>Api Host Url</label>
						<config_path>vsms/settings/ultimate_api_url</config_path>
						<depends>
							<field id="gateway">ultimate</field>
						</depends>
					</field>

                </group>
            </group>
        </section>
    </system>
</config>
