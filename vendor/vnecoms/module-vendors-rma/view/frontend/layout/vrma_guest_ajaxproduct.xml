<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <update handle="vendorsrma_guest_item_renderers"/>
    <container name="root">
        <block class="Vnecoms\VendorsRMA\Block\Frontend\Guest\NewRequest\Items" name="items" template="Vnecoms_VendorsRMA::new_request/create/items.phtml" cacheable="false">
            <block class="Magento\Framework\View\Element\RendererList" name="vendor.rma.request.item.renderers" as="renderer.list"/>
        </block>
        <block class="Magento\Framework\View\Element\Template" name="additional.product.info" template="Magento_Theme::template.phtml"/>
    </container>
</layout>


