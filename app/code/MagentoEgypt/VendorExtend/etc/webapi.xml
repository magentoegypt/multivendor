<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/vendor/order/:orderId" method="GET">
        <service class="MagentoEgypt\VendorExtend\Api\OrderRepositoryInterface" method="getOrder"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
    <route url="/V1/vendor/:vendorId" method="DELETE">
        <service class="MagentoEgypt\VendorExtend\Api\VendorRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="Vnecoms_Vendors::vendors"/>
        </resources>
    </route>

    <!-- Vendor app without the admin token: every route below resolves the seller from the
         caller's own customer token (customerId is forced), never from a client-sent id. -->
    <route url="/V1/vendors/me" method="PUT">
        <service class="MagentoEgypt\VendorExtend\Api\VendorSelfServiceInterface" method="updateMe"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
    <route url="/V1/vendors/me" method="DELETE">
        <service class="MagentoEgypt\VendorExtend\Api\VendorSelfServiceInterface" method="deleteMe"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
    <route url="/V1/vendors/me/stockItems/:sku" method="GET">
        <service class="MagentoEgypt\VendorExtend\Api\VendorSelfServiceInterface" method="getStockItem"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
    <route url="/V1/vendors/me/categories" method="GET">
        <service class="MagentoEgypt\VendorExtend\Api\VendorSelfServiceInterface" method="getCategories"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
    <!-- Anonymous, but only with the single-use token otp/verify issues for VENDOR_REGISTER. -->
    <route url="/V1/vendors/register" method="POST">
        <service class="MagentoEgypt\VendorExtend\Api\VendorSelfServiceInterface" method="register"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>