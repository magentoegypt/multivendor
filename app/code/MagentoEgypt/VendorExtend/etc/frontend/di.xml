    </type>
    <type name="Lof\ProductReviews\Model\Sender">
        <plugin name="fix_issue_guest" type="MagentoEgypt\VendorExtend\Plugin\Model\ProductReviews\Sender"/>
    </type>
    <preference for="MGS\Brand\Block\Product\ProductList\Related" type="MagentoEgypt\VendorExtend\Block\Brand\Product\ProductList\Related"/>

    <type name="Vnecoms\VendorsProduct\Helper\Data">
        <plugin name="only_approve_show" type="MagentoEgypt\VendorExtend\Plugin\Helper\VendorsProduct\Data"/>
    </type>
    <virtualType name="Vnecoms\VendorsCategory\Model\Layer\Category\Context" type="Vnecoms\VendorsLayerNavigation\Model\Layer\VendorHomePage\Context">
        <arguments>
            <argument name="collectionFilter" xsi:type="object">MagentoEgypt\VendorExtend\Model\Layer\Category\CollectionFilter</argument>
        </arguments>
    </virtualType>
    <type name="Vnecoms\VendorsCategory\Block\Product\ListProduct">
        <plugin name="only_approve_show" type="MagentoEgypt\VendorExtend\Plugin\Block\VendorsCategory\ListProduct"/>
    </type>
    <type name="Vnecoms\VendorsPriceComparison\Observer\ProductViewPredispatch">
        <plugin name="select_sale_product_view" type="MagentoEgypt\VendorExtend\Plugin\SelectSaleProductView"/>
    </type>
    <type name="Vnecoms\VendorsPriceComparison\Model\LoadProduct">
        <plugin name="select_sale_product_view" type="MagentoEgypt\VendorExtend\Plugin\PriceComparisonLoadProduct"/>
    </type>
    <preference for="Vnecoms\Quotation\Model\Quote" type="MagentoEgypt\VendorExtend\Model\Quote"/>
    <preference for="Vnecoms\VendorsRMA\Block\Frontend\Customer\NewRequest\Info" type="MagentoEgypt\VendorExtend\Block\RMA\CustomerInfo"/>
    <preference for="Vnecoms\VendorsRMA\Block\Frontend\Guest\NewRequest\Info" type="MagentoEgypt\VendorExtend\Block\RMA\GuestInfo"/>

    <type name="Vnecoms\VendorsRMA\Block\Frontend\PrintRma">
        <plugin name="format_date_html" type="MagentoEgypt\VendorExtend\Plugin\FormatDateHtml"/>
    </type>
    <type name="Vnecoms\VendorsRMA\Block\Frontend\View">
        <plugin name="format_date_html" type="MagentoEgypt\VendorExtend\Plugin\FormatDateHtml"/>
    </type>
    <type name="Vnecoms\VendorsRMA\Block\Frontend\View\Message">
        <plugin name="format_date_html" type="MagentoEgypt\VendorExtend\Plugin\FormatDateHtml"/>
    </type>
    <type name="Vnecoms\RMA\Block\Frontend\Customer\ListRma">
        <plugin name="format_date_html" type="MagentoEgypt\VendorExtend\Plugin\FormatDateHtml"/>
    </type>
    <type name="Vnecoms\RMA\Block\Frontend\Guest\ListRma">
        <plugin name="format_date_html" type="MagentoEgypt\VendorExtend\Plugin\FormatDateHtml"/>
    </type>

    <preference for="Vnecoms\VendorsPage\Block\Home\ProductList\Toolbar" type="MagentoEgypt\VendorExtend\Block\VendorsPage\Home\ProductList\Toolbar"/>
    <type name="MagentoEgypt\VendorExtend\Block\VendorsPage\Home\ProductList\Toolbar">
        <plugin name="customCountProductItems" disabled="true" />
    </type>
    <!--
        QA03 item 2-A: the prototype's category filter panel is Price Range,
        Minimum Rating, Availability and Vendors. Only the first is a Magento
        filter; the other three are appended by this plugin.

        A PLUGIN, not an entry in `categoryFilterList`'s `filters` array. That
        array is a MAP from backend type to class — FilterList::getFilters()
        instantiates the category filter and then one filter per FILTERABLE
        ATTRIBUTE, and never iterates the map — so items added to it are simply
        never built. Worse, declaring the argument in an area di.xml REPLACES
        the global one rather than merging, which silently dropped Mageplaza's
        Category/Attribute/Price back to Magento's defaults. Both verified by
        resolving the virtual type with the frontend config loaded.
    -->
    <type name="Magento\Catalog\Model\Layer\FilterList">
        <plugin name="hm_qa03_extra_filters"
                type="MagentoEgypt\VendorExtend\Plugin\Model\Layer\FilterListPlugin"
                sortOrder="100"/>
    </type>

    <!-- QA03 item 2-A: the prototype heads this block "Price Range". -->
    <type name="Mageplaza\LayeredNavigation\Model\Layer\Filter\Price">
        <plugin name="hm_qa03_price_range_name"
                type="MagentoEgypt\VendorExtend\Plugin\Model\Layer\PriceFilterNamePlugin"
                sortOrder="100"/>
    </type>

    <!--
        CL036-DEV01.22 — a rail must not link to a product that 404s.
        sortOrder 10: after ConfigurableProduct's parent injection (2), before
        HomeSections' EnforceProductsCount (100).
    -->
    <type name="Magento\CatalogWidget\Block\Product\ProductsList">
        <plugin name="hm_drop_unservable_widget_products"
                type="MagentoEgypt\VendorExtend\Plugin\CatalogWidget\DropUnservableProducts"
                sortOrder="10"/>
    </type>

    <!--
        CL036-DEV01.24 — every vendor page sent a signed-out visitor to the
        CUSTOMER login, because Vnecoms' controllers extend Magento's
        AbstractAccount and Magento's plugin authenticates first. See the class.
    -->
    <type name="Magento\Customer\Model\Url">
        <plugin name="hm_seller_login_url"
                type="MagentoEgypt\VendorExtend\Plugin\Customer\SellerLoginUrl"
                sortOrder="100"/>
    </type>
    <type name="Magento\Customer\Model\Session">
        <plugin name="hm_seller_login_redirect"
                type="MagentoEgypt\VendorExtend\Plugin\Customer\SellerLoginUrl"
                sortOrder="100"/>
    </type>

    <!--
        Hub Market: the seller product ADD and EDIT pages (/marketplace/catalog_product/new|edit)
        fataled for every seller on Magento 2.4.8:

          CompositeConfigProvider::__construct(): Argument #3 ($variablePluginConfigProvider)
          must be of type array, null given

        Vnecoms runs its seller product form in the FRONTEND area, and its controller's
        dependency chain builds Magento\Cms\Model\Wysiwyg\Config for the description
        editor. That needs CompositeConfigProvider's four provider maps, which Magento only
        declares in Magento_Cms/etc/adminhtml/di.xml; in the compiled frontend map they are
        empty, and 2.4.8's constructor requires arrays. It fails while the CONTROLLER is
        constructed, so no layout/template/ui_component change can route around it.

        These are the same four maps Magento declares for adminhtml, copied verbatim.
    -->
    <type name="Magento\Cms\Model\Wysiwyg\CompositeConfigProvider">
        <arguments>
            <argument name="variablePluginConfigProvider" xsi:type="array">
                <item name="default" xsi:type="string">Magento\Variable\Model\Variable\ConfigProvider</item>
            </argument>
            <argument name="widgetPluginConfigProvider" xsi:type="array">
                <item name="default" xsi:type="string">Magento\Widget\Model\Widget\Config</item>
            </argument>
            <argument name="wysiwygConfigPostProcessor" xsi:type="array">
                <item name="default" xsi:type="string">Magento\Cms\Model\Wysiwyg\DefaultConfigProvider</item>
            </argument>
            <argument name="galleryConfigProvider" xsi:type="array">
                <item name="default" xsi:type="string">Magento\Cms\Model\Wysiwyg\Gallery\DefaultConfigProvider</item>
            </argument>
        </arguments>
    </type>

    <!--
        Same failure class, found by building the seller product_form component from the CLI
        before a second compile rather than by crashing the page again. Each of these is
        declared by Magento for adminhtml only; Vnecoms' storefront product form needs them.

        - Eav\CompositeConfigProcessor: its eavWysiwygDataProcessors map (Catalog's default
          only; PageBuilder's processor is left out on purpose, the seller editor is plain
          WYSIWYG and PageBuilder would pull its whole admin editor into the storefront).
        - UploadResizeConfigInterface: the product image gallery block.
        - Initialization\Helper\HandlerInterface: product SAVE initialisation.
        - AttributesListInterface: configurable products.
        - SalesChannelNameResolverInterface: the inventory panel.
    -->
    <type name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Eav\CompositeConfigProcessor">
        <arguments>
            <argument name="eavWysiwygDataProcessors" xsi:type="array">
                <item name="default" xsi:type="object">Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Eav\WysiwygConfigDataProcessor</item>
            </argument>
        </arguments>
    </type>
    <preference for="Magento\Backend\Model\Image\UploadResizeConfigInterface" type="Magento\Backend\Model\Image\UploadResizeConfig"/>
    <preference for="Magento\Catalog\Controller\Adminhtml\Product\Initialization\Helper\HandlerInterface" type="Magento\Catalog\Controller\Adminhtml\Product\Initialization\Helper\Plugin\Handler\Composite"/>
    <preference for="Magento\ConfigurableProduct\Model\AttributesListInterface" type="Magento\ConfigurableProduct\Model\AttributesList"/>
    <preference for="Magento\InventorySalesAdminUi\Model\SalesChannelNameResolverInterface" type="Magento\InventorySalesAdminUi\Model\WebsiteNameResolver"/>

    <!--
        Third and last of the set. The description/custom WYSIWYG fields are rendered by
        PageBuilder's form element (it replaces the core wysiwyg element globally), whose
        InlineEditingSupportedAdapterList only gets its adapter map in PageBuilder's adminhtml
        di.xml. This is just that map (which editor adapters support inline editing), not
        PageBuilder's editor. Found by preparing the WHOLE seller product_form component tree
        from the CLI (229 components; 220 for configurable), which the first probe did not do.
        With this and the entries above, new-simple, existing-configurable and
        new-configurable forms all prepare with zero errors.
    -->
    <type name="Magento\PageBuilder\Model\Wysiwyg\InlineEditingSupportedAdapterList">
        <arguments>
            <argument name="wysiwygAdaptersSupportingInlineEditing" xsi:type="array">
                <item name="mage/adminhtml/wysiwyg/tiny_mce/tinymceAdapter" xsi:type="boolean">true</item>
            </argument>
        </arguments>
    </type>

    <!-- Seller "Add product": Vnecoms' storefront NewAction has no _session; see the plugin. -->
    <type name="Vnecoms\VendorsProduct\Controller\Catalog\Product\NewAction">
        <plugin name="hm_new_action_session" type="MagentoEgypt\VendorExtend\Plugin\VendorsProduct\NewActionSession"/>
    </type>

    <!-- Storefront breadcrumbs accept Vnecoms' admin-style addLink(); see the plugin. -->
    <type name="Magento\Theme\Block\Html\Breadcrumbs">
        <plugin name="hm_breadcrumbs_add_link" type="MagentoEgypt\VendorExtend\Plugin\Theme\BreadcrumbsAddLink"/>
    </type>
    <!-- TC47: guest context carried customer_name " " so no first visit was ever cacheable. -->
    <type name="Magento\Framework\App\Http\Context">
        <plugin name="hm_http_context_blank_value" type="MagentoEgypt\VendorExtend\Plugin\Framework\HttpContextBlankValue"/>
    </type>
</config>
