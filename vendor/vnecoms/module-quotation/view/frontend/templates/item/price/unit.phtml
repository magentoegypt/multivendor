/** @var $block \Vnecoms\Quotation\Block\Item\Price\Renderer */

$_item = $block->getItem();
$baseCurrency = $_item->getStore()->getBaseCurrency();
$currentCurrency = $_item->getStore()->getCurrentCurrency();
$itemStorePrice = $baseCurrency->convert($_item->getBaseOriginPrice(), $currentCurrency->getCode());
?>
<span class="price-including-tax" data-label="<?php echo $block->escapeHtml(__('Excl. Tax')); ?>">
    <span class="cart-price">
        <?php /* @escapeNotVerified */ echo $this->helper('Magento\Checkout\Helper\Data')->formatPrice($itemStorePrice) ?>
    </span>
</span>