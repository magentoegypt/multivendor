<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
	<head>
		<css src="Vnecoms_Quotation::css/icons.css"/>
		<css src="Vnecoms_Quotation::css/styles.css"/>
		<css src="jquery/fileUploader/css/jquery.fileupload-ui.css"/>
		<link src="Vnecoms_Quotation::js/post-implementation.js"/>
		<css src="Vnecoms_Quotation::css/messages.css"/>
		<css src="Vnecoms_Quotation::css/attachments.css"/>
		<css src="Vnecoms_Quotation::css/fileuploader.css"/>
	</head>
	
	<update handle="quotation_quote_create_customer_block"/>
    <update handle="quotation_quote_create_item_price"/>
    <body>
    	<referenceBlock name="customer.grid.container" remove="true"/>
		<referenceBlock name="store" remove="true"/>
        <referenceContainer name="admin.scope.col.wrap" htmlClass="admin__old" /> <!-- ToDo UI: remove this wrapper with old styles removal. The class name "admin__old" is for tests only, we shouldn't use it in any way -->

        <referenceBlock name="page.title">
            <action method="setTitleId">
                <argument translate="true" name="id" xsi:type="string">quote-header</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="after.body.start">
            <block class="Magento\Backend\Block\Template" name="optional_zip_countries" as="optional_zip_countries" template="Magento_Directory::js/optional_zip_countries.phtml"/>
            <block class="Magento\Catalog\Block\Adminhtml\Product\Composite\Configure" template="Magento_Catalog::catalog/product/composite/configure.phtml"/>
        </referenceContainer>
        <referenceContainer name="js">
            <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Js" template="Vnecoms_Quotation::quote/edit/js.phtml" name="create"/>
        </referenceContainer>

        <referenceBlock name="content">
            <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Quote" name="quote_content">
                <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Form" template="quote/edit/form.phtml" name="quote_form" as="form">
                    <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Messages" name="message"/>
                    <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Customer" template="quote/edit/abstract.phtml" name="customer.grid.container"/>
                    <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Store" template="quote/edit/abstract.phtml" name="store">
                        <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Store\Select" template="quote/edit/store/select.phtml" name="select"/>
                    </block>
                    <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Data" template="quote/edit/data.phtml" name="data">
                        <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Information" template="quote/edit/info.phtml" name="info">
                        	<block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Comment" template="quote/edit/message.phtml" name="message"/>
                        </block>
                        <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Totals" template="quote/edit/totals.phtml" name="totals"/>
                        <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Search" template="quote/edit/abstract.phtml" name="search">
                            <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Search\Grid" name="search_grid" as="grid">
                                <action method="setTemplate">
                                    <argument name="template" xsi:type="string">Vnecoms_Quotation::widget/grid.phtml</argument>
                                </action>
                            </block>
                        </block>
                        <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Items" template="quote/edit/items.phtml" name="items">
                            <block class="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Items\Grid" template="quote/edit/items/grid.phtml" name="items_grid" />
                        </block>
                        <block class="Magento\Framework\View\Element\Text\ListText" name="quote_item_extra_info"/>
                    </block>
                </block>
            </block>
        </referenceBlock>
    </body>
</page>
