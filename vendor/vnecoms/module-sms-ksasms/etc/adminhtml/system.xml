<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">
	            	<field id="ksasms_username" translate="label tooltip" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>User Name</label>
	                    <config_path>vsms/settings/ksasms_username</config_path>
	                    <depends>
	                        <field id="gateway">ksasms</field>
	                    </depends>
	                    <comment>Your user name from ksa-sms.com</comment>
	                </field>
	                
	                <field id="ksasms_password" translate="label tooltip" type="text" sortOrder="91" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Password</label>
	                    <config_path>vsms/settings/ksasms_password</config_path>
	                    <depends>
	                        <field id="gateway">ksasms</field>
	                    </depends>
	                </field>
	                <field id="ksasms_sender" translate="label tooltip" type="text" sortOrder="92" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Sender Name</label>
	                    <config_path>vsms/settings/ksasms_sender</config_path>
	                    <depends>
	                        <field id="gateway">ksasms</field>
	                    </depends>
	                </field>
                </group>
            </group>
        </section>
    </system>
</config>
