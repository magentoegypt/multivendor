<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">
	            	<field id="jawalbsms_username" translate="label tooltip" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>JawalbSms Username</label>
	                    <config_path>vsms/settings/jawalbsms_username</config_path>
	                    <depends>
	                        <field id="gateway">jawalbsms</field>
	                    </depends>
	                </field>
	                <field id="jawalbsms_password" translate="label tooltip" type="text" sortOrder="81" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>JawalbSms Password</label>
	                    <config_path>vsms/settings/jawalbsms_password</config_path>
	                    <depends>
	                        <field id="gateway">jawalbsms</field>
	                    </depends>
	                </field>
	                <field id="jawalbsms_sender" translate="label tooltip" type="text" sortOrder="82" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>JawalbSms Sender</label>
	                    <config_path>vsms/settings/jawalbsms_sender</config_path>
	                    <depends>
	                        <field id="gateway">jawalbsms</field>
	                    </depends>
	                </field>
                </group>
            </group>
        </section>
    </system>
</config>
