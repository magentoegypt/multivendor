<?xml version="1.0"?>
<!--
/**
 * The identity band and the Shopping Stats card, on the `customer_account`
 * handle so they appear on every account route rather than the dashboard only —
 * which is what the reference does.
 *
 * The band goes in `columns.top`, a container the page layout already owns, so
 * it spans both columns. Note that container also holds `page.messages`: the
 * band is declared AFTER it so a success or error message still lands above the
 * fold.
 *
 * Both blocks are `cacheable="false"` by inheritance from the account pages
 * themselves; they read the customer session, so they must never be cached.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="columns.top">
            <block class="Magento\Framework\View\Element\Template"
                   name="hm.account.identity"
                   after="page.messages"
                   template="MagentoEgypt_AccountExtend::account/identity.phtml">
                <arguments>
                    <argument name="account_stats" xsi:type="object">MagentoEgypt\AccountExtend\ViewModel\AccountStats</argument>
                </arguments>
            </block>
        </referenceContainer>

        <referenceContainer name="sidebar.main">
            <block class="Magento\Framework\View\Element\Template"
                   name="hm.account.stats"
                   after="sidebar.main.account_nav"
                   template="MagentoEgypt_AccountExtend::account/stats.phtml">
                <arguments>
                    <argument name="account_stats" xsi:type="object">MagentoEgypt\AccountExtend\ViewModel\AccountStats</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!--
            SIDEBAR NAV: icons, and the reference's four destinations first.

            The Figma nav has four items. This store has fourteen, and they are
            ORDERED rather than removed. Checked before deciding: product
            reviews has 373 rows, the newsletter has live subscribers, six
            downloadable products are saleable, GDPR is switched on, and the
            Vnecoms credit / RMA / quotation modules are all enabled. Removing a
            link does not remove its route — it strands anyone who arrives from
            a bookmark or an e-mail with no way back — so pruning to four would
            hide working features rather than simplify the account.

            Billing Agreements already self-hides (payment/paypal_express/active
            is 0) and is classed here only so it matches if it is ever enabled.

            The icon hook is the `attributes` ARRAY, not a `class` string.
            These links have no template — Link\Current renders its own markup
            in PHP — and although `class` appears in Html\Link's
            $allowedAttributes, that list feeds getLinkAttributes(), which
            Link\Current never calls. What it calls is a private
            getAttributesHtml() reading `attributes`. Verified by rendering a
            SortLink both ways: the `class` form emitted nothing at all.

            It lands on the <a> and, for the active entry, on the <strong> that
            replaces it — which matters, because the active item has no href for
            a selector to hook. Sort order is DESCENDING.
        -->
        <referenceBlock name="customer-account-navigation-account-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--account</item>
                    </argument>
                    <argument name="sortOrder" xsi:type="number">300</argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-orders-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--orders</item>
                    </argument>
                    <argument name="sortOrder" xsi:type="number">290</argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-wish-list-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--wishlist</item>
                    </argument>
                    <argument name="sortOrder" xsi:type="number">280</argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-address-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--address</item>
                    </argument>
                    <argument name="sortOrder" xsi:type="number">270</argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-account-edit-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--settings</item>
                    </argument>
                    <argument name="sortOrder" xsi:type="number">260</argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-delimiter-1">
                <arguments>
                    <argument name="sortOrder" xsi:type="number">255</argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-newsletter-subscriptions-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--newsletter</item>
                    </argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-product-reviews-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--reviews</item>
                    </argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-downloadable-products-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--downloads</item>
                    </argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-my-credit-cards-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--cards</item>
                    </argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-billing-agreements-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--cards</item>
                    </argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-vnecoms-credit-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--credit</item>
                    </argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-vnecoms-marketplace-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--marketplace</item>
                    </argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-rma">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--returns</item>
                    </argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-quotes-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--quotes</item>
                    </argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-gdpr-link">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--gdpr</item>
                    </argument>
                </arguments>
        </referenceBlock>
        <referenceBlock name="sms-notification">
                <arguments>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">hm-nav-link hm-nav-link--sms</item>
                    </argument>
                </arguments>
        </referenceBlock>
    </body>
</page>
