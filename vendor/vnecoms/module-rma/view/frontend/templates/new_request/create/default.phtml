/** @var $block \Magento\Sales\Block\Order\Email\Items\DefaultItems */

/** @var $_item \Magento\Sales\Model\Order\Item */
$_item = $block->getItem();
$_order = $_item->getOrder();
?>

<tr>
    <?php $dataItems = $block->getRmaItem($_item) ?>

    <td><?php if ($dataItems["qty"] != 0):?>
        <input type="checkbox" name="orderitems[<?php echo $_item->getId() ?>]" id="ves-items-selected-<?php echo $_item->getId() ?>" value="<?php echo $_item->getId() ?>" class="request-items-selected"/>
        <?php endif;?>
    </td>

    <td> <p class="product-name"><?= $block->escapeHtml($_item->getName()) ?></p></td>
    <td class="item-info<?php if ($block->getItemOptions()): ?> has-extra<?php endif; ?>">

        <p class="sku"><?= /* @escapeNotVerified */  __('SKU'); ?>: <?= $block->escapeHtml($block->getSku($_item)) ?></p>
        <?php if ($block->getItemOptions()): ?>
            <dl class="item-options">
                <?php foreach ($block->getItemOptions() as $option): ?>
                    <dt><strong><em><?= /* @escapeNotVerified */  $option['label'] ?></em></strong></dt>
                    <dd>
                        <?= /* @escapeNotVerified */  nl2br($option['value']) ?>
                    </dd>
                <?php endforeach; ?>
            </dl>
        <?php endif; ?>
        <?php $addInfoBlock = $block->getProductAdditionalInformationBlock(); ?>
        <?php if ($addInfoBlock) :?>
            <?php $addInfoBlock->setItem($_item)->toHtml() ?>
        <?php endif; ?>
        <?php $block->escapeHtml($_item->getDescription()) ?>
    </td>
    <td class="item-qty">

        <?php if ($dataItems["qty"] == 0):?>
            <span><?php echo $dataItems["qty"] ?></span>
        <?php else:?>
        <?php if($block->isEditQtyRma()): ?>
            <input id="orderitem-count<?php echo $_item->getId() ?>" class="ves-items-count" type="text"
                   value="<?php echo $dataItems["qty"]  ?>" name="<?php echo $_item->getId() ?>">
        <?php else: ?>
            <label><?php echo $dataItems["qty"] ?></label>
            <input id="orderitem-count<?php echo $_item->getId() ?>" class="ves-items-count" type="hidden"
                   value="<?php echo $dataItems["qty"]  ?>" name="<?php echo $_item->getId() ?>">
        <?php endif;?>
        <?php endif;?>

        <?php if ($dataItems["rma"]) : ?>
            <p><?php echo __("Other RMA for this product:") ?></p>
            <ul>
                <?php foreach($dataItems["rma"] as $request): ?>
                        <li><a href="<?php echo $block->getViewOtherRmaUrl($request["request_id"]) ?>" target="_blank">
                                <?php echo "#".$request["request_increment_id"] ?></a></li>
                <?php endforeach; ?>
            </ul>
        <?php endif ?>
        <input id="orderitem-count<?php echo $_item->getId() ?>-maxcount"
               type="hidden" value="<?php echo (int)($dataItems["qty"]) ?>">
        <input id="orderitem-track<?php echo $_item->getId() ?>"
               type="hidden" value="<?php echo $block->getTrackingNumberByItem($_item) ?>">
    </td>
</tr>
