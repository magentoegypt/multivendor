        .megamenu_action_mb,
        .close-menu-site {
            display: none !important;
        }
        .me-native-menu-wrapper {
            background: #061b5f !important;
            clear: both !important;
            height: 56px !important;
            min-height: 56px !important;
            overflow: visible !important;
