<?php
/**
 * Hub Market — the seller card's Contact Vendor action.
 *
 * The reference puts a prominent Contact Vendor button at the trailing edge of
 * the card. Vnecoms ships no contact or enquiry route on this install — there is
 * no frontName for one in any of its modules — so there is nothing to post a
 * message to.
 *
 * What there IS, is the seller's telephone, which this card already prints in
 * plain text a line below. So the button dials it. That is a real action against
 * a number the page publishes anyway, rather than a button that opens a form
 * this install cannot deliver.
 *
 * No phone, no button: an empty Contact Vendor that goes nowhere is worse than
 * the card simply not offering one.
 *
 * @var \Vnecoms\Vendors\Block\Profile\Title $block
 * @var \Magento\Framework\Escaper $escaper
 */
$hmVendor = $block->getVendor();
if (!$hmVendor) {
    return;
}

$hmPhone = trim((string) $hmVendor->getTelephone());
if ($hmPhone === '') {
    return;
}

//  tel: wants no spaces or punctuation; the visible text keeps the merchant's
//  own formatting.
$hmDial = preg_replace('/[^0-9+]/', '', $hmPhone);
if ($hmDial === '') {
    return;
}
?>
<div class="hm-vendor-contact">
    <a class="hm-vendor-contact__button"
       href="tel:<?= $escaper->escapeHtmlAttr($hmDial) ?>">
        <svg class="hm-vendor-contact__icon" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span><?= $escaper->escapeHtml(__('Contact Vendor')) ?></span>
    </a>
</div>
