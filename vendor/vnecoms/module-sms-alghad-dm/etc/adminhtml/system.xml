<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">
					<field id="alghaddm_api_url" translate="label tooltip" type="text" sortOrder="160" showInDefault="1" showInWebsite="1" showInStore="0">
						<label>API URL</label>
						<config_path>vsms/settings/alghaddm_api_url</config_path>
						<depends>
							<field id="gateway">alghaddm</field>
						</depends>
					</field>

	            	<field id="alghaddm_api" translate="label tooltip" type="text" sortOrder="161" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>API Key</label>
	                    <config_path>vsms/settings/alghaddm_api</config_path>
	                    <depends>
	                        <field id="gateway">alghaddm</field>
	                    </depends>
	                </field>

	                <field id="alghaddm_sender" translate="label tooltip" type="text" sortOrder="162" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Sender Name</label>
	                    <config_path>vsms/settings/alghaddm_sender</config_path>
	                    <depends>
	                        <field id="gateway">alghaddm</field>
	                    </depends>
	                </field>

					<field id="alghaddm_username" translate="label tooltip" type="text" sortOrder="162" showInDefault="1" showInWebsite="1" showInStore="0">
						<label>User Name</label>
						<config_path>vsms/settings/alghaddm_username</config_path>
						<depends>
							<field id="gateway">alghaddm</field>
						</depends>
					</field>


                </group>
            </group>
        </section>
    </system>
</config>
