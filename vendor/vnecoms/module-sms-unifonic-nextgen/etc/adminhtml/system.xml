<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">
                    <field id="unifonic_nextgen_username" translate="label tooltip" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Unifonic User Name</label>
                        <config_path>vsms/settings/unifonic_nextgen_username</config_path>
                        <depends>
                            <field id="gateway">unifonic_nextgen</field>
                        </depends>
                    </field>
                    <field id="unifonic_nextgen_password" translate="label tooltip" type="password" sortOrder="91" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Unifonic Password</label>
                        <config_path>vsms/settings/unifonic_nextgen_password</config_path>
                        <depends>
                            <field id="gateway">unifonic_nextgen</field>
                        </depends>
                    </field>

	            	<field id="unifonic_nextgen_app_id" translate="label tooltip" type="password" sortOrder="92" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Unifonic App Id</label>
	                    <config_path>vsms/settings/unifonic_nextgen_app_id</config_path>
	                    <depends>
	                        <field id="gateway">unifonic_nextgen</field>
	                    </depends>
	                </field>
                    <field id="unifonic_nextgen_sender" translate="label tooltip" type="text" sortOrder="93" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Unifonic Sender</label>
                        <config_path>vsms/settings/unifonic_nextgen_sender</config_path>
                        <depends>
                            <field id="gateway">unifonic_nextgen</field>
                        </depends>
                    </field>
                </group>
            </group>
        </section>
    </system>
</config>
