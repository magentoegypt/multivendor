<div  id="form-reply-ticket">
    <div class="ticket-template">
        <div class="content" >
            <select class="chosen-select admin__control-select" name="request[reponse_id]" id="reponse_id" style="width:230px"
                    onchange="return loadHtmlContent(this.value)">
                <option value=""><?php echo __('Search Quick Reponse') ?></option>
                <?php foreach ($block->getTemplateOptions() as $key=>$template):?>
                    <option value="<?php echo $key ?>"><?php echo $template ?></option>
                <?php endforeach;?>
            </select>


        </div>
    </div>
</div>

<script type="text/javascript">

    define("ves-js-tableft-request",
        [
            "prototype",
            "rma"
        ], function(){
            function loadHtmlContent(value){
                new Ajax.Request('<?php echo $block->getUrl("vrma/request/qreponse") ?>', {
                    method:'post',
                    parameters:{id: value},
                    onSuccess: function(transport) {
                        var response = transport;
                        tinyMCE.execCommand('mceInsertContent',false,response.responseText);
                    },
                });
            }

            window.loadHtmlContent = loadHtmlContent;
        });

    window.tinyMCE_GZ = window.tinyMCE_GZ || {}; window.tinyMCE_GZ.loaded = true;
    require([
        "jquery",
        'mage/validation',
        'ves-js-tableft-request',
        "Vnecoms_RMA/js/wysiwyg/tiny_mce/setup",
        "Vnecoms_RMA/js/chosen.jquery.min",
        "Vnecoms_RMA/js/jquery.colorbox-min"
    ],function($){
        $(function() {
            if($(".chosen-select")) $(".chosen-select").chosen();
        });
    });
</script>