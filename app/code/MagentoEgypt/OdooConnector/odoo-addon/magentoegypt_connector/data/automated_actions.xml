<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enqueue Odoo-side changes for push to Magento. enqueue() skips writes tagged
         with the magento_sync context (Magento's own M->O writes) so it never echoes
         them back.

         Odoo 17+ refactored base.automation: the Python no longer lives inline on the
         rule (state/code). The rule now links to an ir.actions.server (usage =
         'base_automation', base_automation_id) that carries state='code' + code.
         'records' is the triggering recordset, as before. -->

    <!-- product.template -->
    <record id="automation_product" model="base.automation">
        <field name="name">Magento sync: product.template</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="trigger">on_create_or_write</field>
    </record>
    <record id="automation_product_action" model="ir.actions.server">
        <field name="name">Magento sync: product.template</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="base_automation_id" ref="automation_product"/>
        <field name="code">env['magentoegypt.sync.outbox'].enqueue('product', records)</field>
    </record>

    <!-- res.partner -->
    <record id="automation_partner" model="base.automation">
        <field name="name">Magento sync: res.partner</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="trigger">on_create_or_write</field>
    </record>
    <record id="automation_partner_action" model="ir.actions.server">
        <field name="name">Magento sync: res.partner</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="base_automation_id" ref="automation_partner"/>
        <field name="code">env['magentoegypt.sync.outbox'].enqueue('customer_buyer', records)</field>
    </record>

    <!-- sale.order -->
    <record id="automation_order" model="base.automation">
        <field name="name">Magento sync: sale.order</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="trigger">on_create_or_write</field>
    </record>
    <record id="automation_order_action" model="ir.actions.server">
        <field name="name">Magento sync: sale.order</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="base_automation_id" ref="automation_order"/>
        <field name="code">env['magentoegypt.sync.outbox'].enqueue('order', records)</field>
    </record>

    <!-- stock.quant (inventory on-hand) O->M: on-hand changes push qty to Magento MSI.
         Quants without a product SKU enqueue an empty key and are skipped. -->
    <record id="automation_stock_quant" model="base.automation">
        <field name="name">Magento sync: stock.quant (inventory)</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="trigger">on_create_or_write</field>
    </record>
    <record id="automation_stock_quant_action" model="ir.actions.server">
        <field name="name">Magento sync: stock.quant (inventory)</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="base_automation_id" ref="automation_stock_quant"/>
        <field name="code">env['magentoegypt.sync.outbox'].enqueue('inventory_source_item', records)</field>
    </record>
</odoo>
