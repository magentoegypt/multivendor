    <route url="/V1/hubfulfillment/fleet/event" method="POST"><service class="MagentoEgypt\Fulfillment\Api\FleetInterface" method="event"/><resources><resource ref="MagentoEgypt_Fulfillment::fleet"/></resources></route>
