	<type name="Vnecoms\VendorsPriceComparison\Helper\Data">
        <arguments>
            <argument name="allowedAttributes" xsi:type="array">
                <item name="ves_enable_order" xsi:type="string">ves_enable_order</item>
                <item name="ves_enable_quote" xsi:type="string">ves_enable_quote</item>
            </argument>
        </arguments>
    </type>

	<type name="Vnecoms\Quotation\Block\Adminhtml\Quote\Edit\Items\Grid">
		<arguments>
			<argument name="productConfig" xsi:type="object">Vnecoms\Quotation\Helper\Product\Configuration</argument>
			<argument name="bundleConfig" xsi:type="object">Vnecoms\Quotation\Helper\Product\Bundle</argument>
		</arguments>
	</type>

	<type name="Magento\Checkout\Controller\Cart\Configure">
		<plugin name="beforeUpdateItemQuote" type="Vnecoms\Quotation\Plugin\Controller\UpdateItemOptions" disabled="false"/>
	</type>

