<?php
/**
 * Hub Market — final price, with the listing's struck-through regular price restored.
 *
 * Copy of Smartwave_Dailydeals::product/price/final_price.phtml (which itself is
 * a copy of Magento_Catalog's, swapped in by Smartwave\Dailydeals\Plugin\
 * FinalPricePlugin whenever daily deals are enabled — they are). One line differs:
 * how "is this discounted" is decided.
 *
 * THE BUG THIS WORKS AROUND (QA CL036-TC07 follow-up)
 * ---------------------------------------------------
 * On the English storefront a discounted product showed only its new price on
 * every listing — no regular price, no strike-through — while the product page
 * showed both. Arabic listings were correct.
 *
 * `Magento\Catalog\Pricing\Render\FinalPriceBox::hasSpecialPrice()` takes two
 * different routes:
 *
 *     if ($this->isProductList()) {                       // listings
 *         return (bool)$this->getData('special_price_map')[$id];
 *     }
 *     return $displayFinalPrice < $displayRegularPrice;   // product page
 *
 * The map comes from `SpecialPriceBulkResolver::generateSpecialPriceMap()`,
 * which joins the price index with
 *
 *     price.website_id = $storeId
 *
 * — a STORE id compared against a WEBSITE id. Here the English store is id 3 and
 * lives on website 1, so the join matches nothing, every entry is false, and the
 * template takes its `else` branch. Arabic is store id 1 on website 1, so the
 * numbers coincide and it works, which is exactly why this looked like an
 * English-only display bug rather than a pricing one.
 *
 * Rather than patch a vendor class or add DI (which needs a compile and an FPM
 * restart on this box), the check is repaired where it is consumed: fall back to
 * the same comparison the product page makes. When Adobe fixes the resolver the
 * extra clause simply stops mattering — `hasSpecialPrice()` becomes true on its
 * own and the `||` short-circuits.
 *
 * @var \Magento\Catalog\Pricing\Render\FinalPriceBox $block
 */
// @codingStandardsIgnoreFile

$helper = $this->helper('Smartwave\Dailydeals\Helper\Data');
$productId = $block->getSaleableItem()->getId();

/** @var \Magento\Framework\Pricing\Price\PriceInterface $priceModel */
$priceModel = $block->getPriceType('regular_price');

/** @var \Magento\Framework\Pricing\Price\PriceInterface $finalPriceModel */
$finalPriceModel = $block->getPriceType('final_price');
$idSuffix = $block->getIdSuffix() ? $block->getIdSuffix() : '';
$schema = ($block->getZone() == 'item_view') ? true : false;

/*
 * The repaired test. `hasSpecialPrice()` is still asked first so a correct core
 * (or a fixed special_price_map) keeps deciding; the comparison only rescues the
 * listing case above. Guarded with a null check because a price type can be
 * absent for some product types, where the original template would simply have
 * fallen through to the plain price.
 */
$hmHasSpecialPrice = $block->hasSpecialPrice();

if (!$hmHasSpecialPrice && $priceModel && $finalPriceModel) {
    $hmRegularAmount = $priceModel->getAmount();
    $hmFinalAmount   = $finalPriceModel->getAmount();

    if ($hmRegularAmount && $hmFinalAmount) {
        $hmHasSpecialPrice = $hmFinalAmount->getValue() < $hmRegularAmount->getValue();
    }
}
?>
<?php if ($helper->isDealProduct($productId)) : ?>
    <?php
        $deal_final_price_amount = number_format($helper->getDealproductbyId($productId), 2);
    ?>
    <span class="old-price">
        <?php /* @escapeNotVerified */ echo $block->renderAmount($finalPriceModel->getAmount(), [
            'display_label'     => __('Regular Price'),
            'price_id'          => $block->getPriceId('old-price-' . $idSuffix),
            'price_type'        => 'oldPrice',
            'include_container' => true,
            'skip_adjustments'  => true
        ]); ?>
    </span>
    <span class="special-price">
        <span class="price-container price-final_price tax weee">
            <span class="price-label"><?= $block->escapeHtml(__('Special Price')) ?></span>
            <span id="product-price-<?php echo $idSuffix; ?>" data-price-amount="<?php echo $deal_final_price_amount; ?>" data-price-type="finalPrice" class="price-wrapper ">
                <span class="price"><?php echo $helper->getcurrencySymbol().''.$deal_final_price_amount; ?></span>
            </span>
        </span>
    </span>
<?php elseif ($hmHasSpecialPrice): ?>
    <span class="old-price">
        <?php /* @escapeNotVerified */ echo $block->renderAmount($priceModel->getAmount(), [
            'display_label'     => __('Regular Price'),
            'price_id'          => $block->getPriceId('old-price-' . $idSuffix),
            'price_type'        => 'oldPrice',
            'include_container' => true,
            'skip_adjustments'  => true
        ]); ?>
    </span>
    <span class="special-price">
        <?php /* @escapeNotVerified */ echo $block->renderAmount($finalPriceModel->getAmount(), [
            'display_label'     => __('Special Price'),
            'price_id'          => $block->getPriceId('product-price-' . $idSuffix),
            'price_type'        => 'finalPrice',
            'include_container' => true,
            'schema' => $schema
        ]); ?>
    </span>
<?php else : ?>
    <?php /* @escapeNotVerified */ echo $block->renderAmount($finalPriceModel->getAmount(), [
        'price_id'          => $block->getPriceId('product-price-' . $idSuffix),
        'price_type'        => 'finalPrice',
        'include_container' => true,
        'schema' => $schema
    ]); ?>
<?php endif; ?>

<?php if ($block->showMinimalPrice()): ?>
    <?php if ($block->getUseLinkForAsLowAs()):?>
        <a href="<?php /* @escapeNotVerified */ echo $block->getSaleableItem()->getProductUrl(); ?>" class="minimal-price-link">
            <?php /* @escapeNotVerified */ echo $block->renderAmountMinimal(); ?>
        </a>
    <?php else:?>
        <span class="minimal-price-link">
            <?php /* @escapeNotVerified */ echo $block->renderAmountMinimal(); ?>
        </span>
    <?php endif?>
<?php endif; ?>
