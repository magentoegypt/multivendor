                                    <i class="action-icon quote-icon-cloud-download"></i>
                                </a>
                            </div>
                        </div>
                        <?php $i ++;?>
                    <?php endforeach;?>
                </div>
                <?php endif;?>
            </div>
            <?php endforeach;?>
        </div>
    </div>
</div>
<script type="text/javascript">
    require([
         'jquery',
         'Magento_Ui/js/modal/alert',
         'uiRegistry',
         'mage/mage',
         'domReady!'
    ], function($, alert, registry) {
         var dataForm = $('#quotation-message-form');
         var ignore = null;
         dataForm.mage('validation', {
                 ignore: ignore ? ':hidden:not(' + ignore + ')' : ':hidden'
             }).find('input:text').attr('autocomplete', 'off');

         dataForm.on("submit",function (event) {
             event.preventDefault();
             if (dataForm.validation() && dataForm.validation('isValid')) {
                 $.ajax({
                     url: "<?php echo $block->getPostAjaxMessageUrl()?>",
                     dataType: 'json',
                     type: 'POST',
                     data: dataForm.serializeArray(),
                     context: $('body'),
                     showLoader: true,

                     /**
                      * @param {*} response
                      */
                     success: function (response) {
                         if(response.error === false){
                            $(".quotation-messages").prepend(response.html);
                            $("#quotation-message-form textarea").val('');
                            registry.get('uploader').value([]);
                            bindAttachmentImagesEvents();
                         }else if(response.error){
                        	 alert({
      		            		title: $t('Error'),
      		                    content: response.message
    		                  });
                         }else{
                     	    alert({
    		            		title: $t('Error'),
    		                    content: response
		                    });
                         }
                     }
                 });
             }
         });

         function bindAttachmentImagesEvents(){
             $('.attachment-image').click(function(event){
                 if($(event.target).is('.action-icon') || $(event.target).is('.download-action')) return true;
            	 event.preventDefault();
            	 var id = $(this).data('identifier');
            	 if($('#'+id).length){
            		 $('#'+id).modal('openModal');
            	 }else{
            	 $('<div class="thumbnail-preview" id="'+id+'"></div>').html('<div class="thumbnail-preview-image-block"><img class="thumbnail-preview-image" src="'+$(this).data('image')+'" /></div>')
                     .modal({
                         title: $(this).data('title'),
                         type: 'popup',
                         modalClass: '_image-box quotation-attachment-modal',
                         autoOpen: true,
                         innerScroll: true,
                         buttons:{}
                      });
            	 }
             });
         }

         bindAttachmentImagesEvents();
    });
</script>
