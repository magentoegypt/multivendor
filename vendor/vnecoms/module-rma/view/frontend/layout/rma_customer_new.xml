<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <css src="jquery/fileUploader/css/jquery.fileupload-ui.css"/>
        <css src="Vnecoms_RMA::css/fileupload.css"/>
        <css src="Vnecoms_RMA::css/font-awesome.css"/>
        <css src="Vnecoms_RMA::css/rma.css"/>
    </head>
    <body>
      
        <referenceContainer name="content">
            <block class="Vnecoms\RMA\Block\Frontend\Customer\NewRequest" name="customer.list" template="customer/new_request.phtml" cacheable="false">
                <block class="Vnecoms\RMA\Block\Frontend\Customer\NewRequest\Info" name="info" template="new_request/info.phtml" />
                <block class="Vnecoms\RMA\Block\Frontend\Customer\NewRequest\Policy" name="policy" template="new_request/policy.phtml" />
            </block>
            <block class="Vnecoms\RMA\Block\Frontend\Customer\NewRequest\Info" template="new_request/js.phtml" name="rma_request_new_js"/>

        </referenceContainer>
        <!--<referenceContainer name="before_body_end">
            <block class="Vnecoms\RMA\Block\Frontend\Customer\NewRequest\Info" template="customer/new_request/js.phtml" name="rma_request_new_js"></block>
        </referenceContainer>-->
    </body>
</page>
