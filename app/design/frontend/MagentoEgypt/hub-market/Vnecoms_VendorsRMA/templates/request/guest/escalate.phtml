<?php
/**
 * Hub Market override of Vnecoms_VendorsRMA::request/guest/escalate.phtml.
 *
 * ONE change: the <form> no longer carries name="FORM_KEY".
 *
 * Same defect, same page-level consequence as the new-request form - see
 * Vnecoms_RMA/templates/customer/new_request.phtml in this theme for the full
 * trace. In short: a named form is published as a property of `window`, so
 * `name="FORM_KEY"` made `window.FORM_KEY` the FORM ELEMENT. Magento's
 * file-uploader picks its key with
 *
 *     formKey = window.FORM_KEY !== undefined ? window.FORM_KEY : $.cookie('form_key');
 *
 * and an HTMLFormElement is not `undefined`, so the attachment upload posted a
 * DOM element as `form_key` and the CSRF validator rejected it with a 302,
 * queueing "مفتاح النموذج غير صالح" for the next page to render.
 *
 * This template matters because it carries the SAME uploader, posting to the
 * same `vrma/customer/upload` endpoint (see the x-magento-init below), so
 * escalating a request with an attachment failed exactly the way creating one
 * did. This is the guest twin; guest RMA is currently disabled (those routes 404), but it is fixed in step so the defect cannot come back with the feature.
 *
 * The attribute is legacy and unused - the form is addressed as
 * `#request-note-form`, never by name.
 */
?>
<div class="form-note">
    <form action="<?php echo $block->getSaveNoteUrl() ?>" method="post" id="request-note-form"
          enctype="multipart/form-data" data-hasrequired="<?php /* @escapeNotVerified */ echo __('* Required Fields') ?>"
    >
        <div class="fieldset">
            <ul class="form-list">
                <li class="wide">
                    <label for="content_message_reply" class="required"><?php echo __("Message") ?></label>
                    <div class="input-box">
                        <textarea class="required-entry" name="message" id="content_message_reply"></textarea>
                    </div>
                </li>
                <li class="wide">
                    <div class="field uploader" id="knockout-message-attachment"  data-bind="scope: 'attachment'">
                        <label class="label" for="message"><span><?php echo __('Allow Extension : ').$block->getUploaderExtensionNote() ?></span></label>
                        <!-- ko template: getTemplate() --><!-- /ko -->
                        <script type="text/x-magento-init">
                            {
                                "#knockout-message-attachment": {
                                    "Magento_Ui/js/core/app": {
                                        "components": {
                                            "attachment": {
                                                "component": "Vnecoms_RMA/js/form/upload/uploader",
                                                "uploaderConfig":{
                                                    "url": "<?php echo $block->getUrl("vrma/guest/upload");?>"
                                                },
                                                "dataScope" : "data.attachment",
                                                "dataType" : "data.text",
                                                "formElement" : "data.input"
                                            }
                                        }
                                    }
                                }
                            }
                        </script>
                    </div>
                </li>
            </ul>

        </div>
        <div class="buttons-set">
            <input type="hidden" name="request_id" value="<?php echo $block->getRequestRma()->getId() ?>">
            <button class="action primary" type="button" id="msg-send-btn">
                    <span><i class="fa"></i>
                        <span><?php echo __('Submit Escalate')?>
                    </span></span></button>
        </div>
    </form>
</div>

<div class="back">
        <a href="<?php echo $block->getUrl('vrma/customer/view',array("id"=>$this->getRequestRma()->getId()));?>" class="left">
            <?php echo __('&laquo;Back View RMA')?>
        </a>
</div>

<script type="text/x-magento-init">
    {
        "#request-note-form": {
            "validation": {}
        }
    }
</script>

<script type="text/javascript">
    window.tinyMCE_GZ = window.tinyMCE_GZ || {}; window.tinyMCE_GZ.loaded = true;
    require(["jquery",'mage/validation',"Vnecoms_RMA/js/wysiwyg/tiny_mce/setup",], function($){
        $(function() {
            wysiwygpage_msg_content = new tinyMceWysiwygSetup(
                "content_message_reply",
                {
                    "enabled":true,
                    "theme":"simple",
                    "theme_advanced_buttons1":"bold,italic,justifyleft,justifycenter,justifyright,fontselect,fontsizeselect,forecolor,backcolor,link,unlink,image,bullist,numlist,code",
                    "theme_advanced_buttons2":"",
                    "theme_advanced_buttons3":"",
                    "theme_advanced_buttons4":"",
                    "content_css":"<?php echo $this->getContentCss() ?>",
                    "plugins":"",
                    "width":"100%",
                    "height":"250px"
                }
            );
            wysiwygpage_msg_content.turnOn();

            $("#msg-send-btn").click(function(){
                var content = tinyMCE.get('content_message_reply').getContent();
                if($("#request-note-form").validation() && $("#request-note-form").validation('isValid') && content){
                    $("#msg-send-btn").attr("disabled","disabled");
                    $("#request-note-form").submit();
                }else{
                    alert('<?php echo __("Please enter message");?>');
                }

            });

        });

    });
</script>