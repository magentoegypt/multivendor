<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">
	            	<field id="uigtc_apikey" translate="label tooltip" type="text" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Uigtc API Key</label>
	                    <config_path>vsms/settings/uigtc_apikey</config_path>
	                    <depends>
	                        <field id="gateway">uigtc</field>
	                    </depends>
                        <comment>The API Key provided in your control panel</comment>
	                </field>
                    <field id="uigtc_sender" translate="label tooltip" type="select" sortOrder="201" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Sender Id</label>
                        <config_path>vsms/settings/uigtc_sender</config_path>
                        <source_model>Vnecoms\SmsUigtc\Model\Config\Source\Sender</source_model>
                        <depends>
                            <field id="gateway">uigtc</field>
                        </depends>
                        <comment>You need to save the API Key first to reload this sender list.</comment>
                    </field>
                </group>
            </group>
        </section>
    </system>
</config>
