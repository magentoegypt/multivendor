<?php
/**
 * Hub Market — New Stores row (Figma: "New Stores on MECommerce").
 *
 * Only APPROVED vendors appear — the block filters on status = 1. Of the 25
 * vendor rows in this install only 3 are approved, and surfacing unvetted
 * applicants would contradict the homepage's own "reviewed and approved before
 * going live" promise.
 *
 * @var \MagentoEgypt\HomeSections\Block\NewStores $block
 * @var \Magento\Framework\Escaper $escaper
 */
$stores = $block->getStores();
if (!$stores) {
    return;
}
?>
<?php
/*
 * Heading and id are PARAMETERS because this template now renders TWICE on the
 * homepage — "New Stores" (by join date) and "Top Vendors This Month" (by rating).
 * Hard-coding them produced two identical headings AND a duplicate element id,
 * which breaks the aria-labelledby association: both sections would point at the
 * same node, so a screen reader announces the wrong name for one of them.
 */
$heading  = (string) ($block->getData('heading') ?: __('New Stores'));
$headingId = 'hm-stores-title-' . substr(md5($block->getNameInLayout() ?: $heading), 0, 8);
?>
<?php $hmStoresSlug = preg_replace('/[^a-z0-9]+/', '-', strtolower((string) $block->getNameInLayout())); ?>
<?php
/*
 * The two rails carry different card furniture in Figma, and both pieces have
 * to be true rather than decorative:
 *
 *   #1 VENDOR   Top Vendors only, first card only. The block sorts by rating,
 *               so the leading card genuinely IS the highest-rated seller —
 *               the badge restates the section's own ordering. It is suppressed
 *               when that card has no rating at all, because "#1" off an empty
 *               sort is a claim about nothing.
 *
 *   VERIFIED    New Stores only. There is no `verified` attribute on this
 *               install — 21 vendor attributes and not one of them is a
 *               verification flag — so this reads the only signal that exists,
 *               approval status, which is also exactly what the section's own
 *               subtitle already tells the shopper ("Recently joined verified
 *               sellers"). The badge restates the marketplace's existing claim;
 *               it does not invent a second one. A dedicated flag the vendor
 *               team controls would be better and is raised separately.
 */
$hmIsTopVendors = str_contains($hmStoresSlug, 'topvendors');
$hmIsNewStores  = str_contains($hmStoresSlug, 'newstores');
$hmIndex = 0;
?>
<section class="hm-stores hm-stores--<?= $escaper->escapeHtmlAttr($hmStoresSlug) ?>" aria-labelledby="<?= $escaper->escapeHtmlAttr($headingId) ?>">
    <div class="hm-section__head">
        <h2 class="hm-section__title" id="<?= $escaper->escapeHtmlAttr($headingId) ?>"><?= $escaper->escapeHtml($heading) ?></h2>
        <a class="hm-section__more" href="<?= $escaper->escapeUrl($block->getUrl('sellerlist')) ?>">
            <?= $escaper->escapeHtml(__('All stores')) ?>
        </a>
    </div>
    <ul class="hm-stores__list">
        <?php foreach ($stores as $s): ?>
            <?php $hmIndex++; ?>
            <li class="hm-stores__item">
                <a class="hm-stores__link" href="<?= $escaper->escapeUrl($s['url']) ?>">
                    <?php if ($hmIsTopVendors): ?>
                        <?php /* Cover band. No vendor image attribute exists on this
                                install, so this is a tinted band rather than a photo —
                                the same graceful-fallback call the initial-avatar makes
                                below. Real cover art needs a vendor banner field. */ ?>
                        <span class="hm-stores__cover" aria-hidden="true">
                            <?php if ($hmIndex === 1 && $s['stars'] !== null): ?>
                                <span class="hm-stores__rank"><?= $escaper->escapeHtml(__('#1 Vendor')) ?></span>
                            <?php endif; ?>
                        </span>
                    <?php endif; ?>
                    <?php
                    /*
                     * Avatar fallback: the store's INITIAL, not a generic glyph.
                     *
                     * No vendor on this install has uploaded a logo, so the fallback
                     * is what actually renders — four identical grey shop icons in a
                     * row, which reads as four broken images rather than as a design.
                     * An initial in a tinted disc is the standard avatar fallback and
                     * distinguishes the four cards from each other.
                     *
                     * mb_substr, not substr: an Arabic store name is multi-byte and
                     * substr would slice it mid-codepoint and emit a broken glyph.
                     */
                    $initial = mb_strtoupper(mb_substr(trim((string) $s['name']), 0, 1, 'UTF-8'), 'UTF-8');
                    ?>
                    <span class="hm-stores__avatar" aria-hidden="true">
                        <?php if ($s['logo']): ?>
                            <img src="<?= $escaper->escapeUrl($s['logo']) ?>" alt=""
                                 loading="lazy" width="56" height="56"/>
                        <?php else: ?>
                            <?= $escaper->escapeHtml($initial) ?>
                        <?php endif; ?>
                    </span>
                    <span class="hm-stores__name"><?= $escaper->escapeHtml($s['name']) ?></span>
                    <?php if ($s['stars'] !== null && $s['reviews'] > 0): ?>
                        <span class="hm-stores__rating"
                              aria-label="<?= $escaper->escapeHtmlAttr(__('Rated %1 out of 5 from %2 reviews', $s['stars'], $s['reviews'])) ?>">
                            <span class="hm-stars" aria-hidden="true">
                                <span class="hm-stars__fill" style="inline-size: <?= (float) $s['stars'] * 20 ?>%"></span>
                            </span>
                            <span class="hm-stores__score"><?= $escaper->escapeHtml(number_format((float) $s['stars'], 1)) ?></span>
                            <span class="hm-stores__reviews">(<?= (int) $s['reviews'] ?>)</span>
                        </span>
                    <?php endif; ?>
                    <?php if (!empty($s['dispatch'])): ?>
                        <span class="hm-stores__dispatch">
                            <svg class="hm-icon" aria-hidden="true" focusable="false"><use href="#hm-clock"/></svg>
                            <?= $escaper->escapeHtml($s['dispatch']) ?>
                        </span>
                    <?php endif; ?>
                    <span class="hm-stores__meta">
                        <?= $escaper->escapeHtml(__('%1 products', $s['products'])) ?>
                    </span>
                    <?php if ($hmIsNewStores): ?>
                        <span class="hm-stores__verified">
                            <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-check"/></svg>
                            <?= $escaper->escapeHtml(__('Verified')) ?>
                        </span>
                    <?php endif; ?>
                    <?php
                    /*
                     * Figma's "Visit Store" pill. Rendered on EVERY card, not only
                     * those with a rating: it is what makes four cards carrying
                     * different optional lines (rating, dispatch time) end on the
                     * same baseline. Not a nested <a> — the whole card is the link,
                     * and an anchor inside an anchor is invalid and unfocusable.
                     */
                    ?>
                    <span class="hm-stores__cta"><?= $escaper->escapeHtml(__('Visit Store')) ?></span>
                </a>
            </li>
        <?php endforeach; ?>
    </ul>
</section>
