<?xml version="1.0"?>
<!--
    GraphQL-area wiring of the app Home.

    SectionProviderPool maps each HmSectionType value to the provider that
    builds it. Satellites add their own types from their own graphql/di.xml
    (DI merges the "providers" array), e.g. HubAppVendors registers
    FEATURED_STORES, TOP_VENDORS and NEW_STORES.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MagentoEgypt\HubApp\Model\Home\SectionProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array"/>
        </arguments>
    </type>
</config>
