<?xml version="1.0"?>
<!--
/**
 * Hub Market cart heading semantics.
 *
 * Core renders the cart summary title through Magento_Theme::text.phtml as
 * `<strong class="summary title">Summary</strong>` — visually a section heading,
 * semantically nothing. text.phtml already takes the tag as an argument, so this
 * needs no template override at all.
 *
 * The class is kept so every existing rule that targets `.summary.title` still
 * applies; only the tag and the wording change. "Order Summary" matches the Figma
 * reference and already has an Arabic translation shipped in VendorExtend's
 * ar_SA.csv, so /ar/ renders it too.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.cart.summary.title">
            <arguments>
                <argument translate="true" name="text" xsi:type="string">Order Summary</argument>
                <argument name="tag" xsi:type="string">h2</argument>
                <argument name="css_class" xsi:type="string">summary title</argument>
            </arguments>
        </referenceBlock>

        <!--
            Per-seller grouping for the line items. The reference draws one card
            per vendor with the seller named across the top; this supplies the
            grouping and the shop-page URL. See the note at the head of the
            theme's cart/form.phtml.
        -->
        <referenceBlock name="checkout.cart.form">
            <arguments>
                <argument name="vendor_groups" xsi:type="object">MagentoEgypt\CheckoutExtend\ViewModel\CartVendors</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="page.main.title" template="Magento_Theme::html/title-cart.phtml">
            <arguments>
                <argument name="view_model" xsi:type="object">MagentoEgypt\CheckoutExtend\ViewModel\CartTitle</argument>
            </arguments>
        </referenceBlock>

        <!--
            THE ORDER OF THE SUMMARY RAIL.

            Core stacks it: title, shipping estimator, totals, coupon, checkout
            button. Measured against the reference, that put 101px of collapsed
            accordion between the heading and the first number, and another 93px
            between the Order Total and the button that acts on it — so the two
            things a shopper is looking for, the sum and the way to pay it, were
            the two furthest apart.

            The reference's sequence is numbers, action, reassurance. That is what
            this produces:

                Order Summary -> totals -> Proceed to Checkout -> trust list
                              -> Estimate Shipping and Tax -> Apply Discount Code

            Neither accordion is removed. Both are real features the static
            prototype simply does not have, both are collapsed by default, and
            both belong below the fold of the rail rather than in front of the
            total — which is also the conventional placement for a coupon field.
        -->
        <referenceContainer name="cart.summary">
            <block class="Magento\Framework\View\Element\Template"
                   name="checkout.cart.summary.trust"
                   template="Magento_Checkout::cart/trust.phtml"
                   after="checkout.cart.methods.bottom"/>
        </referenceContainer>

        <move element="checkout.cart.shipping" destination="cart.summary" after="checkout.cart.summary.trust"/>
        <move element="checkout.cart.coupon"   destination="cart.summary" after="checkout.cart.shipping"/>
    </body>
</page>
