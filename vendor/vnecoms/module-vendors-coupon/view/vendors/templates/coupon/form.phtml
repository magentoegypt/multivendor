<script type="text/javascript">
var GENERATE_URL = '<?php echo $block->getGenerateUrl()?>';

require([
    'jquery',
    'uiRegistry',
    'mage/translate',
    'mage/mage',
    'loader',
    'domReady!'
], function($, registry, $t){
	$('#generate-coupon-form').mage('validation', {
        submitHandler: function (form) {
        	var params = {};
        	$('#generate-coupon-form').find('input, select').each(function(index,el){
        		params[$(el).attr('name')] = $(el).val();
        	});

            $('body').trigger('processStart');

            $.ajax({
                url: GENERATE_URL,
                type: "POST",
                data: params,
                dataType: "json",
                success: function (result) {
                	$('body').trigger('processStop');
                	registry.get('vendor_coupon_grid.vendor_coupon_grid_data_source').set('params.t ', Date.now());
                	form.reset()
                }
            });
        }
    });

});
</script>
