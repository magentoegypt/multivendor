<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">
					<field id="topgun_sender_name" translate="label tooltip" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="0">
						<label>Sender Name</label>
						<config_path>vsms/settings/topgun_sender_name</config_path>
						<frontend_class>required-entry</frontend_class>
						<depends>
							<field id="gateway">topgun</field>
						</depends>
					</field>

	            	<field id="topgun_api" translate="label tooltip" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Api Key</label>
	                    <config_path>vsms/settings/topgun_api</config_path>
	                    <frontend_class>required-entry</frontend_class>
	                    <depends>
	                        <field id="gateway">topgun</field>
	                    </depends>
	                </field>
                </group>
            </group>
        </section>
    </system>
</config>
