/**
 * Hub Market override of Vnecoms_VendorsRMA::new_request/info.phtml.
 *
 * ONE change, at the bottom: the WYSIWYG init.
 *
 *   1. It speaks Arabic on the Arabic store. `js/hm-editor-locale` registers
 *      the language pack Magento does not ship and then apply() adds
 *      `language: 'ar'` + `directionality: 'rtl'` when <html lang> is Arabic.
 *      Every tooltip on this toolbar was English before, inside an otherwise
 *      Arabic form (ClickUp 86d4azdjx item 2, second half).
 *
 *   2. The `plugins` list is gone. It was three strings each holding several
 *      space-separated names, and HugeRTE treats one array entry as ONE plugin
 *      name - so it asked for "plugins/advlist autolink lists link image
 *      charmap print/plugin.min.js" and two more like it, got three 404s, and
 *      loaded NO plugins at all. Dropping the list is therefore behaviour for
 *      behaviour identical to what shoppers get today, minus three errors in
 *      their console. Writing the names out properly would instead ADD
 *      autolink and friends - a feature change, not this ticket's business.
 *      Several of those names (print, textcolor, paste) do not exist in
 *      HugeRTE 1.x anyway.
 *
 * Everything above this comment is Vnecoms' template, unchanged.
 */
?>
<script>
require([
    "mage/adminhtml/wysiwyg/tiny_mce/setup",
    "mage/adminhtml/wysiwyg/widget",
    "js/hm-editor-locale"
], function (wysiwyg, widget, hmEditorLocale) {
    tinymce.init(hmEditorLocale.apply({
        selector: '#content_message_reply',
        height: 200,
        menubar: false,
        toolbar: 'undo redo | formatselect | bold italic forecolor | alignleft aligncenter alignright alignjustify | removeformat'
    }));
});
</script>
    <li class="wide">
        <div class="field uploader" id="knockout-message-attachment"  data-bind="scope: 'attachment'">
            <label class="label" for="message"><span><?php echo __('Allow Extension : ').$block->getConfig()->allowFileExtension() ?></span></label>
            <!-- ko template: getTemplate() --><!-- /ko -->
            <script type="text/x-magento-init">
                {
                    "#knockout-message-attachment": {
                        "Magento_Ui/js/core/app": {
                            "components": {
                                "attachment": {
                                    "component": "Vnecoms_RMA/js/form/upload/uploader",
                                    "uploaderConfig":{
                                        "url": "<?php echo $block->getUrl("vrma/customer/upload");?>"
                                    },
                                    "dataScope" : "data.attachment",
                                    "dataType" : "data.text",
                                    "formElement" : "data.input"
                                }
                            }
                        }
                    }
                }
            </script>
        </div>
    </li>
</ul>
