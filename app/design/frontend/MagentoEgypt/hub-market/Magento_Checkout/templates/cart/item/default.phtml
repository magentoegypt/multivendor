<?php
/**
 * Hub Market cart line item.
 *
 * Rewritten from the core table row to the Figma reference's card line:
 *
 *   96px thumb | name, 2-line description, price + struck compare-at
 *              | trash / qty stepper / line total, stacked to the trailing edge
 *
 * The wrapper is a div, not a <tbody> — see the note at the top of
 * Magento_Checkout::cart/form.phtml for why the table had to go and what had to
 * keep working when it did.
 *
 * The qty input is UNCHANGED in every respect that Magento cares about: same
 * `name="cart[<id>][qty]"`, same `data-role="cart-item-qty"`, same validation
 * attributes. The stepper buttons around it are presentation; they write the
 * value and let the form commit it.
 *
 * phpcs:disable Magento2.Templates.ThisInTemplate
 * phpcs:disable Generic.Files.LineLength
 *
 * @var $block \Magento\Checkout\Block\Cart\Item\Renderer
 * @var $escaper \Magento\Framework\Escaper
 */

$_item    = $block->getItem();
$product  = $_item->getProduct();
/** @var \Magento\Msrp\Helper\Data $helper */
$helper       = $this->helper(Magento\Msrp\Helper\Data::class);
$canApplyMsrp = $helper->isShowBeforeOrderConfirm($product) && $helper->isMinimalPriceLessMsrp($product);

$hmItemId = (string) $_item->getId();

/*
 * Two-line summary under the name, matching the reference's `line-clamp-2`
 * paragraph.
 *
 * Resolved here rather than through a ViewModel because this template is shared
 * by every product type: `default`, `simple`, `configurable`, `bundle`,
 * `downloadable` and `grouped` renderers are declared across seven different
 * modules, and layout arguments do not inherit to child blocks — wiring one
 * ViewModel into all of them would be more code than the four lines it saves,
 * and would silently miss any renderer a future module adds.
 *
 * `short_description` is not on a quote item's product by default — quote items
 * load a restricted attribute set — so MagentoEgypt_CheckoutExtend's
 * catalog_attributes.xml adds it to the `quote_item` group. Without that this is
 * silently null on every line.
 *
 * Merchant copy here carries hard line breaks and stray markup, and the clamp
 * needs one continuous run of text.
 *
 * `description` is the fallback because short_description is the exception on
 * this catalogue, not the rule: 158 products of 2304 have one, against 2075 with
 * a description. It is stripped and collapsed the same way and clamped to two
 * lines in CSS, so a long body copy still renders as the reference's blurb.
 */
$hmDesc = null;
foreach (['short_description', 'description'] as $hmAttribute) {
    $hmRaw = $product ? (string) $product->getData($hmAttribute) : '';
    if ($hmRaw === '') {
        continue;
    }
    $hmCandidate = trim(preg_replace('/\s+/u', ' ', strip_tags($hmRaw)) ?? '');
    if ($hmCandidate !== '') {
        $hmDesc = $hmCandidate;
        break;
    }
}

/*
 * QA cycle 2, item 4: the tester crossed out an ARABIC description rendering
 * under an item on the ENGLISH cart. Most of this catalogue's descriptions are
 * Arabic-only, so on a non-Arabic store an Arabic-dominant blurb is dropped
 * rather than shown as mojibake-adjacent noise; the English-labelled line
 * beside it in the same screenshot was left uncrossed, which is exactly this
 * rule. The Arabic store keeps everything (English fallback copy is normal
 * there). Same guard as list.phtml's listing description.
 */
if ($hmDesc !== null && $product) {
    $hmSample = mb_substr($hmDesc, 0, 120);
    $hmArabic = (int) preg_match_all('/[\x{0600}-\x{06FF}]/u', $hmSample);
    $hmLatin  = (int) preg_match_all('/[A-Za-z]/u', $hmSample);
    $hmRtlView = str_starts_with((string) $product->getStore()->getConfig('general/locale/code'), 'ar');
    if (!$hmRtlView && $hmArabic > $hmLatin) {
        $hmDesc = null;
    }
}

/*
 * Struck compare-at price, as the reference draws it beside the current one.
 * Core's unit-price block renders the price being charged and nothing else, so
 * the "was" figure is worked out here: the product's own `price` against the
 * price this line is actually calculated at.
 *
 * Both are tax-exclusive, and this store displays tax-exclusive prices
 * (tax/display/type is unset, so Magento's default of 1), so the two are
 * directly comparable. If that setting ever changes to include tax, this
 * comparison has to move to the tax-inclusive pair or the struck figure will
 * read low against the one beside it.
 */
$hmWasPrice = null;
if ($product) {
    $hmBase  = (float) $product->getData('price');
    $hmFinal = (float) $_item->getCalculationPrice();

    if ($hmBase > 0.0 && $hmFinal > 0.0 && $hmBase - $hmFinal > 0.0001) {
        /*
         * Formatted off the quote's own store currency rather than a helper —
         * this block is a DataObject, so an undeclared $block->helper() call
         * does not fail loudly, it throws "Invalid method" and takes the cart
         * page with it.
         */
        $hmQuote = $_item->getQuote();
        $hmStore = $hmQuote ? $hmQuote->getStore() : null;

        if ($hmStore) {
            $hmWasPrice = $hmStore->getCurrentCurrency()->format($hmBase, [], false);
        }
    }
}
?>
<div class="cart item hm-cart-line">
    <div class="hm-cart-line__media">
        <?php if ($block->hasProductUrl()): ?>
            <a href="<?= $escaper->escapeUrl($block->getProductUrl()) ?>"
               title="<?= $escaper->escapeHtmlAttr($block->getProductName()) ?>"
               tabindex="-1"
               class="product-item-photo">
        <?php else: ?>
            <span class="product-item-photo">
        <?php endif; ?>
        <?= $block->getImage($block->getProductForThumbnail(), 'cart_page_product_thumbnail')->toHtml() ?>
        <?php if ($block->hasProductUrl()): ?>
            </a>
        <?php else: ?>
            </span>
        <?php endif; ?>
    </div>

    <div class="hm-cart-line__body">
        <?php /* Heading semantics so a screen reader can jump item to item:
                 h1 > h3 per line. role/aria-level on the existing <strong> keeps
                 every `strong.product-item-name` rule in core and in the theme
                 applying unchanged. */ ?>
        <strong class="product-item-name" role="heading" aria-level="3">
            <?php if ($block->hasProductUrl()): ?>
                <a href="<?= $escaper->escapeUrl($block->getProductUrl()) ?>"><?= $escaper->escapeHtml($block->getProductName()) ?></a>
            <?php else: ?>
                <?= $escaper->escapeHtml($block->getProductName()) ?>
            <?php endif; ?>
        </strong>

        <?php if ($hmDesc !== null): ?>
            <p class="hm-cart-line__desc"><?= $escaper->escapeHtml($hmDesc) ?></p>
        <?php endif; ?>

        <?php if ($_options = $block->getOptionList()): ?>
            <dl class="item-options">
                <?php foreach ($_options as $_option): ?>
                    <?php $_formatedOptionValue = $block->getFormatedOptionValue($_option) ?>
                    <dt><?= $escaper->escapeHtml($_option['label']) ?></dt>
                    <dd>
                        <?php if (isset($_formatedOptionValue['full_view'])): ?>
                            <?= $escaper->escapeHtml($_formatedOptionValue['full_view'], ['span', 'a']) ?>
                        <?php else: ?>
                            <?= $escaper->escapeHtml($_formatedOptionValue['value'], ['span', 'a']) ?>
                        <?php endif; ?>
                    </dd>
                <?php endforeach; ?>
            </dl>
        <?php endif; ?>

        <?php if ($messages = $block->getMessages()): ?>
            <?php foreach ($messages as $message): ?>
                <div class="cart item message <?= $escaper->escapeHtmlAttr($message['type']) ?>">
                    <div><?= $escaper->escapeHtml($message['text']) ?></div>
                </div>
            <?php endforeach; ?>
        <?php endif; ?>

        <?php $addInfoBlock = $block->getProductAdditionalInformationBlock(); ?>
        <?php if ($addInfoBlock): ?>
            <?= $addInfoBlock->setItem($_item)->toHtml() ?>
        <?php endif; ?>

        <div class="hm-cart-line__price">
            <?php if ($canApplyMsrp): ?>
                <span class="pricing msrp">
                    <span class="msrp notice"><?= $escaper->escapeHtml(__('See price before order confirmation.')) ?></span>
                    <?php $helpLinkId = 'cart-msrp-help-' . $hmItemId; ?>
                    <a href="#" class="action help map"
                       id="<?= $escaper->escapeHtmlAttr($helpLinkId) ?>"
                       data-mage-init='{"addToCart":{
                                            "origin": "info",
                                            "helpLinkId": "#<?= $escaper->escapeJs($escaper->escapeHtml($helpLinkId)) ?>",
                                            "productName": "<?= $escaper->escapeJs($escaper->escapeHtml($product->getName())) ?>",
                                            "showAddToCart": false
                                            }
                                        }'>
                        <span><?= $escaper->escapeHtml(__("What's this?")) ?></span>
                    </a>
                </span>
            <?php else: ?>
                <?= $block->getUnitPriceHtml($_item) ?>
                <?php if ($hmWasPrice !== null): ?>
                    <span class="old-price">
                        <span class="price"><?= $escaper->escapeHtml($hmWasPrice) ?></span>
                    </span>
                <?php endif; ?>
            <?php endif; ?>
        </div>
    </div>

    <div class="hm-cart-line__aside">
        <?php /*
            The remove control leads the column, as it does in the reference.
            It comes from getActions(), which renders BOTH Edit and Remove from
            their own block templates — so it stays whole here and the CSS gives
            Remove the icon treatment and demotes Edit to a quiet text link.
        */ ?>
        <div class="item-actions">
            <div class="actions-toolbar"><?= /* @noEscape */ $block->getActions($_item) ?></div>
        </div>

        <?php /*
            QTY STEPPER.

            The buttons are `type="button"` on purpose: inside `form.form-cart`
            a bare <button> defaults to type=submit, so a plus click would post
            the cart before the new value was written.

            aria-hidden on the glyphs, real labels on the controls — the
            reference ships all three of these as unnamed icon buttons.
        */ ?>
        <div class="field qty hm-qty" data-role="hm-qty">
            <div class="control qty">
                <button type="button"
                        class="hm-qty__btn hm-qty__btn--minus"
                        data-hm-qty="down"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Decrease quantity of %1', $block->getProductName())) ?>">
                    <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-minus"/></svg>
                </button>
                <label for="cart-<?= $escaper->escapeHtmlAttr($hmItemId) ?>-qty">
                    <span class="label"><?= $escaper->escapeHtml(__('Qty')) ?></span>
                    <input id="cart-<?= $escaper->escapeHtmlAttr($hmItemId) ?>-qty"
                           name="cart[<?= $escaper->escapeHtmlAttr($hmItemId) ?>][qty]"
                           data-cart-item-id="<?= $escaper->escapeHtmlAttr($_item->getSku()) ?>"
                           value="<?= $escaper->escapeHtmlAttr($block->getQty()) ?>"
                           type="number"
                           min="0"
                           size="4"
                           step="any"
                           title="<?= $escaper->escapeHtmlAttr(__('Qty')) ?>"
                           aria-label="<?= $escaper->escapeHtmlAttr(__('Quantity of %1', $block->getProductName())) ?>"
                           class="input-text qty"
                           data-validate="{required:true,'validate-greater-than-zero':true}"
                           data-item-qty="<?= $escaper->escapeHtmlAttr($block->getQty()) ?>"
                           data-role="cart-item-qty"/>
                </label>
                <button type="button"
                        class="hm-qty__btn hm-qty__btn--plus"
                        data-hm-qty="up"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Increase quantity of %1', $block->getProductName())) ?>">
                    <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-plus"/></svg>
                </button>
            </div>
        </div>

        <div class="hm-cart-line__total">
            <?php if ($canApplyMsrp): ?>
                <span class="cart msrp subtotal">--</span>
            <?php else: ?>
                <?= $block->getRowTotalHtml($_item) ?>
            <?php endif; ?>
        </div>
    </div>
</div>
