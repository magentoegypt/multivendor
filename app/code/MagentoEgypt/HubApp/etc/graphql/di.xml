<?xml version="1.0"?>
<!--
    GraphQL-area wiring of the app Home.

    SectionProviderPool maps each HmSectionType value to the provider that
    builds it. Satellites add their own types from their own graphql/di.xml
    (DI merges the "providers" array): HubAppVendors registers
    FEATURED_STORES, TOP_VENDORS and NEW_STORES. A type with no provider is
    left out of the Home with a log line, never an error.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MagentoEgypt\HubApp\Model\Home\SectionProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="DELIVERY_STRIP" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\CmsBlockProvider</item>
                <item name="CMS_PROMOS" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\CmsBlockProvider</item>
                <item name="TRUST_ROW" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\CmsBlockProvider</item>
                <item name="CMS_BLOCK" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\CmsBlockProvider</item>
                <item name="HERO_BANNERS" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\HeroBannerProvider</item>
                <item name="CATEGORY_CHIPS" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\CategoryChipsProvider</item>
                <item name="TODAYS_DEALS" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\DealsProvider</item>
                <item name="PICKED_FOR_YOU" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\ProductRailProvider</item>
                <item name="CATEGORY_RAIL" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\ProductRailProvider</item>
                <item name="BEST_SELLERS" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\ProductRailProvider</item>
                <item name="POPULAR_PRODUCTS" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\ProductRailProvider</item>
                <item name="PRODUCT_LIST" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\ProductRailProvider</item>
                <item name="BUNDLE_DEALS" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\BundleDealsProvider</item>
                <item name="TOP_BRANDS" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\BrandsProvider</item>
                <!-- Placement only: no content, the app draws the customer's own open order there. -->
                <item name="ACTIVE_ORDER" xsi:type="object">MagentoEgypt\HubApp\Model\Home\Provider\PlacementProvider</item>
            </argument>
        </arguments>
    </type>

    <!--
        A response that carries something expiring (the Algolia key of
        hmAppConfig) lowers the lifetime GraphQlCache gives it in the HTTP cache;
        see Model\Cache\ResponseTtl. GraphQL area only.
    -->
    <type name="Magento\Framework\App\Response\Http">
        <plugin name="magentoegypt_hubapp_cap_public_ttl" type="MagentoEgypt\HubApp\Plugin\Response\CapPublicTtl"/>
    </type>
</config>
