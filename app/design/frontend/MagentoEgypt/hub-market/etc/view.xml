<?xml version="1.0"?>
<!--
    Hub Market — view config deltas from Magento/blank. View config MERGES with
    the parent per var, so only the changed values live here.

    QA cycle 2, item 3-A ("the image to take its natural size and remove the
    arrows we use to flip through", both arrows crossed out in the screenshot):

    - gallery arrows off, on the stage and on the thumb strip. Navigation is
      the thumbnails themselves plus keyboard arrows, exactly the reference.

    - product_image_white_borders 0. The resizer was FRAMING every non-square
      source into an 800x800 white canvas, so a portrait garment floated small
      in a white sea and QA circled it as "not natural size". Without the
      frame the resize keeps the source aspect. The changed setting changes
      the image-cache hash, so first hits regenerate through pub/get.php on
      demand (verified wired in pub/media/.htaccess) — do NOT mass-resize
      2,300 products on this 2-core box for this.
-->
<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Config/etc/view.xsd">
    <media>
        <images module="Magento_Catalog">
            <!-- The gallery thumbnails: the reference runs three ~185px thumbs
                 across the column, not a strip of 88px chips. -->
            <image id="product_page_image_small" type="thumbnail">
                <!-- QA03 item 3-A: "the 3 small images should take the width of
                     the large image". They did not — three 170px thumbs plus
                     margins came to 514 inside a 592 stage. 592 = 3x192 + 2x8,
                     so the strip is declared at 192 with an 8px margin in the
                     gallery vars below.

                     The SIZE HAS TO LIVE HERE, not in those vars: Magento's
                     gallery block derives `thumbwidth`/`thumbheight` from this
                     image and writes them into the gallery config AFTER the
                     view.xml gallery vars, so a `thumbwidth` declared there is
                     overwritten (set to 400 here first, and the rendered config
                     came back "thumbwidth":400 while "thumbmargin":8 — declared
                     in the same block — went through untouched). -->
                <width>212</width>
                <height>212</height>
            </image>

            <!--
                Related / upsell cards. Magento/blank asks for a 152x190 source
                here, which was fine when the strip was four across; on a phone
                the parity pass gives each related card the full column, so that
                152px source was being painted into a 303px square — a 113x140
                file stretched 2.7x. That blur and stretch is what the client
                filed as the related products "showing with a lot of errors"
                (CL036-DEV01.03 item 4).

                400 square covers the largest box the card is drawn in — the
                full column on a phone, ~358px once the card border is off —
                with headroom, and matches the square aspect the grid uses, so
                nothing is upscaled or letter-boxed. Cache entries regenerate on demand through pub/get.php,
                as the note below explains — no mass resize.
            -->
            <image id="related_products_list" type="small_image">
                <width>400</width>
                <height>400</height>
            </image>
            <image id="upsell_products_list" type="small_image">
                <width>400</width>
                <height>400</height>
            </image>
        </images>
    </media>
    <vars module="Magento_Catalog">
        <var name="gallery">
            <var name="arrows">false</var>
            <var name="navarrows">false</var>
            <var name="navtype">thumbs</var>
            <!-- Three thumbs spanning the media column exactly:
                 3 x 212 + 2 x 10 = 656. Only the margin is settable here; the
                 width and height come from `product_page_image_small` above,
                 because Magento's gallery block derives thumbwidth/thumbheight
                 from that image and writes them over any set here. -->
            <var name="thumbmargin">10</var>
        </var>

        <!--
            Keep the thumbnail strip on a phone. Magento/blank's view.xml
            switches `nav` to `dots` under 768px, which on this catalogue loses
            the only cue that a product HAS more images — the client filed
            exactly that (CL036-DEV01.03 item 1). Same thumb strip as the
            desktop reference, just narrower.

            `breakpoints` is a SIBLING of `gallery`, not a child of it. That is
            where Magento/blank declares it and where the gallery block reads it
            from. Nested inside `gallery` it merges to `gallery/breakpoints`, a
            path nothing reads, so blank's `dots` silently keeps winning and the
            override looks applied while the phone still renders dots.
        -->
        <var name="breakpoints">
            <var name="mobile">
                <var name="conditions">
                    <var name="max-width">767px</var>
                </var>
                <var name="options">
                    <var name="options">
                        <var name="nav">thumbs</var>
                        <!--
                            Without these the strip inherits the desktop thumb
                            size and renders 172px tiles: two fill the width and
                            the nav alone is 174px tall, which is nothing like
                            the small strip the prototype shows.

                            118 is arithmetic, not taste. Fotorama lays frames
                            out on a pitch of thumbwidth + thumbmargin (2), and
                            the strip is the 360px stage: 3 x (118 + 2) = 360,
                            so three thumbs fill the row exactly and the fourth
                            begins precisely at the edge rather than peeking
                            through it. At 96 and again at 112 a sliver of the
                            fourth showed and the row read as four, which the
                            client filed twice. A fifth image still scrolls.

                            getBreakpoints() json-encodes this node as-is, so
                            these reach fotorama under its own option names.
                        -->
                        <var name="thumbwidth">118</var>
                        <var name="thumbheight">118</var>
                    </var>
                </var>
            </var>
        </var>
        <var name="product_image_white_borders">0</var>
    </vars>
</view>
