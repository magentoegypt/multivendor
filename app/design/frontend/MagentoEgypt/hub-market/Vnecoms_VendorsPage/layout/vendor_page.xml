<?xml version="1.0"?>
<!--
/**
 * Gives the vendor microsite its missing top-level heading.
 *
 * `vendor_page` is the shared handle every microsite screen pulls in (home, items,
 * about, shipping policy, refund policy, search, category), so opting in here
 * covers all of them from one place.
 *
 * BOTH the top and left titles are promoted, and that is deliberate rather than
 * sloppy — they are MUTUALLY EXCLUSIVE. Vnecoms renders whichever matches the
 * `vendors/vendorspage/profile_position` setting and the other returns an empty
 * string:
 *
 *   Block\Profile\Top::_toHtml()  -> '' unless position == POSITION_TOP
 *   Block\Profile\Left::_toHtml() -> '' unless position == POSITION_LEFT
 *
 * This store is set to `left`, which is why targeting only the top title changed
 * nothing on the first attempt. Setting both means the h1 survives an admin
 * flipping that setting, without ever producing two.
 *
 * The PDP's third copy (catalog_product_view.xml -> vendor.profile.title) is NOT
 * touched — that page already has an h1 for the product name.
 * See Vnecoms_Vendors/templates/profile/title.phtml for why the tag is a parameter.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="vendor.profile.top.title">
            <arguments>
                <argument name="heading_tag" xsi:type="string">h1</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="vendor.profile.left.title">
            <arguments>
                <argument name="heading_tag" xsi:type="string">h1</argument>
            </arguments>
        </referenceBlock>

        <!--
            Stat tiles under the seller's name, as the reference shows.

            Reuses Vnecoms' own Profile\Title class rather than introducing one:
            a new class needs a di:compile before layout may reference it, and
            until then Magento drops the block with nothing in the log. Both this
            class and the VendorNames ViewModel are already compiled.

            Added to the TOP profile container, which is where the profile renders
            now that `vendors/vendorspage/profile_position` is `top` — the
            reference puts the seller across the head of the page, not in a rail.
        -->
        <!--
            Declared in the profile WRAPPER, after the seller card, because that
            is the only place that renders where the reference puts them.

            The tab bar is not in `content` — it is its own block in `page.top`,
            so it paints before .columns does. Moving the tiles into `content`
            put them below the tabs; putting them in the wrapper puts them
            between the card and the tabs, which is the reference's order.
        -->
        <!--
            The shared product card already prints the seller's name above the
            title — it just needs the ViewModel that resolves vendor_id to a
            public name, and that is passed per block name. The category and home
            lists get it in their own layouts; the microsite's two lists were
            never on the list, so every card here rendered without a seller line.

            Both names are referenced because the two microsite screens declare
            their own: `vendors.products.list` on the shop home,
            `credit.products.list` on the items page. A reference to a block that
            is not in the current handle is simply ignored.

            The star rating needs no wiring — getReviewsSummaryHtml() is already
            in the card and renders wherever a product has reviews.
        -->
        <referenceBlock name="vendors.products.list">
            <arguments>
                <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="credit.products.list">
            <arguments>
                <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
            </arguments>
        </referenceBlock>

        <!--
            Contact Vendor, at the card's trailing edge as the reference has it.
            Reuses Profile\Title for the same reason the stats block does: a new
            class needs a di:compile before layout may reference it, and until
            then Magento drops the block with nothing in the log.
        -->
        <referenceContainer name="vendor.profile.top.container">
            <block class="Vnecoms\Vendors\Block\Profile\Title"
                   name="hm.vendor.contact"
                   after="-"
                   template="Vnecoms_Vendors::profile/contact.phtml"/>
        </referenceContainer>

        <referenceContainer name="vendor.profile.top.wrapper">
            <block class="Vnecoms\Vendors\Block\Profile\Title"
                   name="hm.vendor.stats"
                   after="vendor.profile.top.container"
                   template="Vnecoms_Vendors::profile/vendor-stats.phtml">
                <arguments>
                    <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!--
            The reference's vendor page has no filter rail — a banner, the seller
            card, four stat tiles, tabs, then a full-width product grid. Ours ran
            Vnecoms' layered navigation down the left, which on this catalogue
            listed raw attribute values ("Matrial", "storage", "ram") in mixed
            Arabic and English and squeezed the grid into two thirds of the page.

            The block is removed rather than the page layout switched to 1column:
            the microsite's own rules are scoped to
            `.hm-page.vendor-page.page-layout-2columns-*`, and changing the layout
            would silently turn every one of them off. The now-empty column is
            closed up in CSS instead.
        -->
        <referenceBlock name="vendor.catalog.leftnav" remove="true"/>

    </body>
</page>
