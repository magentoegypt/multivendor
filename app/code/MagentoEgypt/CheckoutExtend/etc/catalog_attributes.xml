<?xml version="1.0"?>
<!--
/**
 * Adds `price` to the attribute set loaded for quote items.
 *
 * Quote item products are NOT loaded with the full attribute set, only with the
 * `quote_item` group declared here and in core's own catalog_attributes.xml.
 * Declaring an attribute here joins it into the load the cart already does,
 * rather than costing a repository call per line from the template.
 *
 * short_description and description used to be here too, for the cart line's
 * product summary. That summary was removed at the client's request
 * (CL036-DEV01.47), and the long description in particular is not worth
 * selecting for every quote load with nothing reading it.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Catalog/etc/catalog_attributes.xsd">
    <group name="quote_item">
        <!--
            The cart line strikes through the pre-discount price, which means
            comparing the item's unit price against the product's own `price`
            attribute. That attribute is not in the quote_item load by default.
        -->
        <attribute name="price"/>
    </group>
</config>
