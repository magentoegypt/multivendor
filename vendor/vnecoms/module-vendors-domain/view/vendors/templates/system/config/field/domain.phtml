</ul>


<script>
require([
    'jquery',
], function($){
	function setRequiredElm(type){
		$('.vendor-domain-container input[type="text"]').removeClass('required-entry');
		$('.item-'+type).find('input[type="text"]').addClass('required-entry');;

		if(type == 'sub_folder'){
			$('.secure-domain-container').hide();
		}else{
			$('.secure-domain-container').show();
		}
	}
	
	$('.vendor-domain-container input[type="radio"]').change(function() {
		setRequiredElm(this.value);
	});

	$('.vendor-domain-container input[type="text"]').click(function() {
		$('.vendor-domain-container input[type="radio"]').each(function(){
			this.checked = false;
		});
		var selectedRadio = $(this).parent().parent().find('input[type="radio"]').first();
		selectedRadio.prop("checked", true);
		setRequiredElm(selectedRadio.val());
	});
	
	$('.vendor-domain-container input[type="radio"]').each(function(){
		if(this.checked){
			setRequiredElm(this.value);
		}
	});
	
    function updateScheme(isSecure){
        var find = isSecure?"http://":"https://";
        var replace = isSecure?"https://":"http://";
    	$('.vendor-domain-url').each(function(index, elm){
    		$(elm).html($(elm).html().replace(find,replace));
    	});
    }
    
	$('#vendor-domain-secure').change(function() {
        if($(this).is(":checked")) {
        	updateScheme(true);
        }else{
        	updateScheme(false);
        }
    });
	updateScheme(<?php echo $isSecureDomain?"true":"false"?>);
});
</script>