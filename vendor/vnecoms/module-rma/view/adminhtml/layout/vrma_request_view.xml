<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Vnecoms_RMA::css/rma.css"/>
        <css src="jquery/fileUploader/css/jquery.fileupload-ui.css"/>
        <css src="Vnecoms_RMA::css/fileupload.css"/>
        <css src="Vnecoms_RMA::css/font-awesome.css"/>
        <css src="Vnecoms_RMA::css/chosen.css"/>
        <css src="Vnecoms_RMA::css/colorbox.css"/>
    </head>
    <update handle="vrma_request_view_item_renderers"/>
    <body>
        <block class="Vnecoms\RMA\Block\Adminhtml\Request\Edit\Renderer\Items" name="rma_items"
               template="request/edit/items.phtml" cacheable="false">
            <block class="Magento\Framework\View\Element\RendererList" name="rma.request.item.renderers" as="renderer.list"/>
        </block>

        <referenceContainer name="left">
            <block class="Vnecoms\RMA\Block\Adminhtml\Request\Edit\TabsLeft" name="request_edit_tabs_left"
                   template="request/edit/tableft.phtml">
                <!--
                <block class="Vnecoms\RMA\Block\Adminhtml\Request\Edit\GeoIp"
                       name="request_edit_tabs_geoip" template="request/edit/tableft/geoip.phtml"/>
                -->
            </block>
        </referenceContainer>

        <referenceContainer name="content">
            <block class="Vnecoms\RMA\Block\Adminhtml\Request\Edit" name="request_edit_content"/>
        </referenceContainer>

        <referenceContainer name="js">
            <block class="Vnecoms\RMA\Block\Adminhtml\Request\Edit\Js" template="request/edit/js.phtml"/>
        </referenceContainer>

    </body>
</page>
