                        </div>
                    </div>

                    <div class="field field-item-short-description">
                        <label class="label required" for="item_short_desc"><?php /* @escapeNotVerified */ echo __('Item Short Description') ?></label>
                        <div class="control">
                            <textarea id="item_short_desc" rows="3" name="banner[media_gallery][images][<%- data.file_id %>][item_short_description]"><%- data.item_short_description %></textarea>
                        </div>
                    </div>

                    <div class="field field-item-status">
                        <label class="label required"><?php /* @escapeNotVerified */ echo __('Item Status') ?></label>
                        <div class="control">
                            <select id="item_status" class="item_select select" name="banner[media_gallery][images][<%- data.file_id %>][item_status]">
                                <option value="1"><?php /* @escapeNotVerified */ echo __('Enable') ?></option>
                                <option value="0"><?php /* @escapeNotVerified */ echo __('Disable') ?></option>
                            </select>
                        </div>
                    </div>

