<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">
	            	<field id="smsgateway_api_key" translate="label tooltip" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>User Name</label>
	                    <config_path>vsms/settings/smsgateway_username</config_path>
	                    <depends>
	                        <field id="gateway">smsgateway</field>
	                    </depends>
	                    <comment>User name at apps.gateway.sa</comment>
	                </field>
	                <field id="smsgateway_api_secret" translate="label tooltip" type="text" sortOrder="41" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Password</label>
	                    <config_path>vsms/settings/smsgateway_password</config_path>
	                    <depends>
	                        <field id="gateway">smsgateway</field>
	                    </depends>
	                </field>
	                
	                <field id="smsgateway_sender" translate="label tooltip" type="text" sortOrder="42" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Sender</label>
	                    <config_path>vsms/settings/smsgateway_sender</config_path>
	                    <depends>
	                        <field id="gateway">smsgateway</field>
	                    </depends>
	                </field>
                </group>
            </group>
        </section>
    </system>
</config>
