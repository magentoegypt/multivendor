<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <vendors>
            <pricecomparison>
                <main_product>lowest_price</main_product>
                <showing_number>5</showing_number>
                <show_address>1</show_address>
                <show_sales_count>1</show_sales_count>
                <show_joined_date>1</show_joined_date>
                <show_country_filter>1</show_country_filter>
                <product_type_restriction>store_credit,vendor_membership,membership</product_type_restriction>
            </pricecomparison>
        </vendors>

        <vendor_advanced_group>
            <select_and_sell>
                <can_use_select_and_sell>1</can_use_select_and_sell>
            </select_and_sell>
        </vendor_advanced_group>

    </default>
</config>
