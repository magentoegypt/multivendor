<?php
/**
 * Hub Market — add-to-cart row.
 *
 * Overridden for TWO reasons.
 *
 * ONE — the reference draws quantity as a stepper — minus, the number, plus —
 * and Magento ships a bare number input. The browser's own spinner arrows are
 * ~10px, appear only on hover, and vanish entirely on touch, so quantity was
 * effectively keyboard-only on a phone.
 *
 * TWO — core renders the submit button `disabled` and relies on
 * Magento_Catalog/js/validate-product to remove the attribute once it binds. On
 * this host that took a measured 1.2–2.4 seconds AFTER the page had painted, and
 * the disabled styling is grey-on-grey, so the primary call to action sat
 * looking unavailable for over a second and did nothing if clicked. The
 * attribute is gone here.
 *
 * Dropping it is safe because this form is a real POST to checkout/cart/add, not
 * an ajax-only control: a submit that beats the JavaScript still adds the
 * product, and required-option validation exists server-side as well as client-
 * side, so a configurable submitted without its options comes back with
 * Magento's own "specify the product's required option(s)" message rather than
 * adding something wrong.
 *
 * The buttons are type="button" so they cannot submit the form, and they drive
 * the same #qty input Magento validates — nothing downstream changes. `disabled`
 * on the minus at the floor is set by the script, not hard-coded, so it tracks
 * whatever minimum the product's own quantity validators impose.
 *
 * Everything else is core, kept verbatim so the next upgrade diff stays small.
 *
 * @var $block \Magento\Catalog\Block\Product\View
 */
?>
<?php $_product = $block->getProduct(); ?>
<?php $buttonTitle = __('Add to Cart'); ?>
<?php if ($_product->isSaleable()) :?>
<div class="box-tocart">
    <div class="fieldset">
        <?php if ($block->shouldRenderQuantity()) :?>
        <div class="field qty">
            <?php /* "Quantity", not core's "Qty" — the reference spells it out. */ ?>
            <label class="label" for="qty"><span><?= $block->escapeHtml(__('Quantity')) ?></span></label>
            <div class="control hm-qty">
                <button type="button" class="hm-qty__step hm-qty__step--down"
                        data-hm-qty="-1"
                        aria-label="<?= $block->escapeHtmlAttr(__('Decrease quantity')) ?>">&#8722;</button>
                <input type="number"
                       name="qty"
                       id="qty"
                       min="0"
                       value="<?= $block->getProductDefaultQty() * 1 ?>"
                       title="<?= $block->escapeHtmlAttr(__('Quantity')) ?>"
                       class="input-text qty"
                       data-validate="<?= $block->escapeHtml(json_encode($block->getQuantityValidators())) ?>"
                       />
                <button type="button" class="hm-qty__step hm-qty__step--up"
                        data-hm-qty="1"
                        aria-label="<?= $block->escapeHtmlAttr(__('Increase quantity')) ?>">&#43;</button>
            </div>
        </div>
        <?php endif; ?>
        <div class="actions hm-buybar">
            <?php /* No `disabled` — see the note at the top of this file. */ ?>
            <button type="submit"
                    title="<?= $block->escapeHtmlAttr($buttonTitle) ?>"
                    class="action primary tocart"
                    id="product-addtocart-button">
                <?php /* The reference puts a cart glyph before the label.
                         aria-hidden: the button already says "Add to Cart". */ ?>
                <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false">
                    <use href="#hm-cart"/>
                </svg>
                <span><?= $block->escapeHtml($buttonTitle) ?></span>
            </button>

            <?php /*
                The wishlist heart and the share control sit ON the buy row, as
                the reference shows — not stranded below it. The wishlist block
                is moved in from `product.info.social` by this theme's
                catalog_product_view.xml; see that file for why it is moved
                rather than re-rendered.
            */ ?>
            <?php
            /*
             * Looked up by NAME, not with getChildHtml('wishlist').
             *
             * Core declares TWO add-to-cart blocks from this same template —
             * `product.info.addtocart` and `product.info.addtocart.additional` —
             * and a product WITH options renders the additional one. The layout
             * move can only attach the wishlist to one of them, so on
             * configurables the heart became a child of a block that never
             * renders and vanished from the page entirely: no anchor in the buy
             * row, an empty `product-addto-links`, and no addToWishlist init.
             *
             * A name lookup renders it whichever instance is the live one. Only
             * one ever renders per page, so this cannot double it, and the loop
             * below skips the block by name so it is not emitted twice here.
             */
            $hmWishlist = $block->getLayout()->getBlock('view.addto.wishlist');
            ?>
            <?= $hmWishlist ? $hmWishlist->toHtml() : '' ?>

            <button type="button"
                    class="hm-buybar__icon hm-share"
                    data-hm-share
                    data-share-title="<?= $block->escapeHtmlAttr($_product->getName()) ?>"
                    title="<?= $block->escapeHtmlAttr(__('Share this product')) ?>">
                <svg class="hm-icon" aria-hidden="true" focusable="false"><use href="#hm-share"/></svg>
                <span class="hm-sr-only"><?= $block->escapeHtml(__('Share this product')) ?></span>
            </button>
        </div>

        <?php /*
            Every OTHER child of this block — Add to Quote, instant purchase,
            daily deals — rendered by name so it lands BELOW the buy row.
            `getChildHtml('', true)` cannot be used any more: it would render the
            moved wishlist a second time, giving the page two controls with the
            same post payload.
        */ ?>
        <?php foreach ($block->getChildNames() as $hmChild) : ?>
            <?php if ($hmChild === 'view.addto.wishlist') { continue; } ?>
            <?= $block->getLayout()->renderElement($hmChild, false) ?>
        <?php endforeach; ?>
    </div>
</div>
<?php endif; ?>
<script type="text/x-magento-init">
    {
        "#product_addtocart_form": {
            "Magento_Catalog/js/validate-product": {}
        }
    }
</script>

<script>
    //  Vanilla, not a jQuery widget: this is two buttons nudging one input, and
    //  a widget would have to be registered, deployed and initialised for it.
    //  `input` is dispatched so Magento's own validators and any price/stock
    //  listeners see the change exactly as if it had been typed.
    (function () {
        'use strict';
        var box = document.querySelector('.box-tocart .hm-qty');
        if (!box) {
            return;
        }
        var input = box.querySelector('#qty');
        var sync = function () {
            var min = parseFloat(input.getAttribute('min'));
            var down = box.querySelector('.hm-qty__step--down');
            if (down && !isNaN(min)) {
                down.disabled = (parseFloat(input.value) || 0) <= min;
            }
        };
        box.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-hm-qty]');
            if (!btn) {
                return;
            }
            var min = parseFloat(input.getAttribute('min'));
            var next = (parseFloat(input.value) || 0) + parseFloat(btn.getAttribute('data-hm-qty'));
            if (!isNaN(min) && next < min) {
                next = min;
            }
            input.value = next;
            input.dispatchEvent(new Event('input', {bubbles: true}));
            input.dispatchEvent(new Event('change', {bubbles: true}));
            sync();
        });
        input.addEventListener('input', sync);
        sync();
    }());

    /*
     * Share control.
     *
     * navigator.share is the native sheet where it exists (phones, Safari), and
     * it is the only path that can offer real targets — a page cannot enumerate
     * a user's apps. Everywhere else this copies the URL, which is what a
     * shopper on a desktop actually wants, and says so for a moment.
     *
     * No third-party share widgets on purpose: every one of them is a tracker on
     * a page that is otherwise free of them.
     *
     * navigator.share and navigator.clipboard both require a secure context and
     * both reject if the user dismisses the sheet, so every call is guarded and
     * the rejection is swallowed rather than logged as an error.
     */
    (function () {
        'use strict';
        var btn = document.querySelector('[data-hm-share]');
        if (!btn) {
            return;
        }
        btn.addEventListener('click', function () {
            var url = window.location.href;
            var title = btn.getAttribute('data-share-title') || document.title;

            if (navigator.share) {
                navigator.share({title: title, url: url}).catch(function () {});
                return;
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(function () {
                    btn.classList.add('is-copied');
                    window.setTimeout(function () {
                        btn.classList.remove('is-copied');
                    }, 1600);
                }).catch(function () {});
            }
        });
    }());
</script>
