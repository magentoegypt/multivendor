/** @var $block \Vnecoms\Quotation\Block\Customer\QuoteList */
// @codingStandardsIgnoreFile
$_quotes = $block->getQuoteCollection();
?>

<div class="block block-customerquotes">
    <div class="block-content">
        <?php if ($_quotes->getSize()): ?>
            <div class="table-wrapper customer-quotes">
                <table class="data table tbl-customer-quotes" id="tbl-customer-quotes">
                    <thead>
                        <tr>
                            <th scope="col" class="quote-id"><?php /* @escapeNotVerified */ echo __('ID') ?></th>
                            <th scope="col" class="quote-date"><?php /* @escapeNotVerified */ echo __('Date Created') ?></th>
                            <th scope="col" class="quote-customer"><?php /* @escapeNotVerified */ echo __('Customer') ?></th>
                            <th scope="col" class="quote-status"><?php /* @escapeNotVerified */ echo __('Status') ?></th>
                            <th scope="col" class="quote-actions"><?php /* @escapeNotVerified */ echo __('Action') ?></th>
                        </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($_quotes as $_quote): ?>
                        <tr>
                            <td data-th="<?php echo $block->escapeHtml(__('ID #')) ?>" class="quote-id"><?php /* @escapeNotVerified */ echo __('#%1',$_quote->getIncrementId()) ?></td>
                            <td data-th="<?php echo $block->escapeHtml(__('Date')) ?>" class="quote-date"><?php /* @escapeNotVerified */ echo $block->formatDate($_quote->getCreatedAt()) ?></td>
                            <td data-th="<?php echo $block->escapeHtml(__('Customer')) ?>" class="quote-customer"><?php /* @escapeNotVerified */ echo $_quote->getCustomerName(); ?></td>
                            <td data-th="<?php echo $block->escapeHtml(__('Status')) ?>" class="quote-status"><span class="bx-quote-status <?php /* @escapeNotVerified */ echo $block->getQuoteStatusTextClass($_quote->getStatus()) ?>"><span><?php /* @escapeNotVerified */ echo $block->getQuoteStatusLabel($_quote->getStatus()) ?></span></span></td>
                            <td data-th="<?php echo $block->escapeHtml(__('Actions')) ?>" class="quote-actions">
                                <a href="<?php /* @escapeNotVerified */ echo $block->getViewQuoteUrl($_quote->getId()) ?>" class="action view">
                                    <span><?php /* @escapeNotVerified */ echo __('View') ?></span>
                                </a>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
            <?php echo $this->getChildHtml();?>
        <?php else: ?>
            <div class="message info empty"><span><?php /* @escapeNotVerified */ echo __('You have no any quote!'); ?></span></div>
        <?php endif; ?>
    </div>
</div>
<script>
require([
    "jquery",
    "Magento_Ui/js/modal/prompt",
    "Magento_Ui/js/modal/confirm",
    "Magento_Ui/js/modal/alert",
    "Magento_Ui/js/modal/modal"
], function($, prompt, alert){
    'use strict';
    $(".tbl-customer-quotes .action.delete").each(function(element){
        $(this).on( "click", function (e) {
            e.preventDefault();
            var self = this;
            var action = $(this).attr("href");
            prompt({
                content: 'Are you sure you want to delete this quote?',
                actions: {
                    confirm: function (e) {
                        window.location  = action;
                    },
                    cancel: function () {
                        return false;
                    }
                }
            });

        });
    })
});
</script>