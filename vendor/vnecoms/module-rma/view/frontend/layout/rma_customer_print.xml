<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="rma_request_print_item_renderers" />
    <update handle="print" />
    <head>
        <css src="Vnecoms_RMA::css/rma.css"/>
    </head>
    <body>
        <attribute name="class" value="account"/>
        <referenceContainer name="content">
            <block class="Vnecoms\RMA\Block\Frontend\PrintRma" name="sales.order.print" template="Vnecoms_RMA::request/print/view.phtml">
                <block class="Vnecoms\RMA\Block\Frontend\View\Items" name="rma_items"
                       template="Vnecoms_RMA::request/view/items.phtml" cacheable="false">
                    <block class="Magento\Framework\View\Element\RendererList" name="rma.request.item.renderers" as="renderer.list"/>
                </block>
            </block>
        </referenceContainer>
        <block class="Magento\Framework\View\Element\Template" name="additional.product.info" template="Magento_Theme::template.phtml"/>
    </body>
</page>
