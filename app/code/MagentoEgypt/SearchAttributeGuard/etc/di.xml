<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Single save chokepoint for catalog product attributes: both the admin
        attribute-edit form ($model->save()) and ProductAttributeRepository::save()
        persist through Magento\Catalog\Model\ResourceModel\Attribute::save().
    -->
    <type name="Magento\Catalog\Model\ResourceModel\Attribute">
        <plugin name="me_search_attribute_guard"
                type="MagentoEgypt\SearchAttributeGuard\Plugin\AttributeSaveGuard"/>
    </type>

    <!--
        An empty category has no `position_category_<id>` in the index, and
        sorting on a field with no mapping fails the whole query. See the plugin.
    -->
    <type name="Magento\Elasticsearch\SearchAdapter\Query\Builder\Sort\Position">
        <plugin name="me_position_sort_unmapped"
                type="MagentoEgypt\SearchAttributeGuard\Plugin\PositionSortUnmapped"/>
    </type>
</config>
