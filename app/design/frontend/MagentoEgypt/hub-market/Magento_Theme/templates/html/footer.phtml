<?php
/**
 * Hub Market — footer.
 *
 * The Figma footer was the strongest part of the design — genuinely localised,
 * with per-country chips and Gulf payment methods (Mada, Tap, Tabby, STC Pay).
 * Two things are corrected here:
 *
 *   1. Contrast. Its legal links and copyright ran at ~2.2:1 on navy, the
 *      lowest real text contrast in the build. Everything here uses
 *      --hm-on-inverse / --hm-on-inverse-muted (10.56:1 on navy).
 *   2. Destinations. Ten distinct footer links all resolved to /about. These
 *      are driven by CMS blocks so each can point somewhere real.
 *
 * Column content is editable via CMS blocks rather than hard-coded, because the
 * link sets differ per store view (the Arabic store has different policy pages).
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

$layout  = $block->getLayout();
$columns = ['hm_footer_customer', 'hm_footer_sellers', 'hm_footer_categories', 'hm_footer_platform'];
?>
<div class="hm-footer hm-surface-inverse">
    <div class="hm-footer__inner">

        <div class="hm-footer__brand">
            <?php
            /*
             * Brand lockup — TEXT ONLY since QA cycle 2 (86d45m4tj item 1-L, and
             * item 1-A's brand ruling: everything reads "Hub Market" now).
             *
             * The reference's footer carries NO logo image at all: it opens with
             * the serif wordmark, first word in the accent orange, second in
             * white ("ME"/"Commerce" there, "Hub"/"Market" here). The logo
             * image this column used to render reads MAGENTO EGYPT and would
             * contradict the wordmark beside it; the header still shows that
             * artwork, which is a known inconsistency only new artwork can fix
             * (recorded in the copyright note below).
             *
             * Not translated, deliberately — same reasoning as
             * header/logo.phtml: a brand is a name, and half-transliterating a
             * two-word name is worse than leaving it in Latin script on the
             * Arabic store.
             */
            ?>
            <a class="hm-footer__logo hm-logo--lockup" dir="ltr"
               href="<?= $escaper->escapeUrl($block->getBaseUrl()) ?>"
               aria-label="<?= $escaper->escapeHtmlAttr(__('Go to Home page')) ?>">
                <span class="hm-logo__word" aria-hidden="true">
                    <span class="hm-logo__word-lead">Hub</span><span
                          class="hm-logo__word-rest">Market</span>
                </span>
                <span class="hm-sr-only">Hub Market</span>
            </a>

            <?= /* @noEscape */ $layout->createBlock(\Magento\Cms\Block\Block::class)
                ->setBlockId('hm_footer_brand')->toHtml() ?>
        </div>

        <div class="hm-footer__cols">
            <?php foreach ($columns as $blockId): ?>
                <div class="hm-footer__col">
                    <?= /* @noEscape */ $layout->createBlock(\Magento\Cms\Block\Block::class)
                        ->setBlockId($blockId)->toHtml() ?>
                </div>
            <?php endforeach; ?>
            <?php if ($block->getChildHtml('hm.footer.links')): ?>
                <div class="hm-footer__col"><?= $block->getChildHtml('hm.footer.links') ?></div>
            <?php endif; ?>
        </div>

        <?php /* Newsletter — moved here from the footer container, see default.xml. */ ?>
        <?php if ($block->getChildHtml('newsletter')): ?>
            <div class="hm-footer__newsletter">
                <?= $block->getChildHtml('newsletter') ?>
            </div>
        <?php endif; ?>

        <div class="hm-footer__bottom">
            <p class="hm-footer__copyright hm-muted">
                <?php
                /*
                 * The brand is a PARAMETER, not part of the translated string.
                 *
                 * THIRD BRAND STATE, each one QA-directed — the history matters
                 * because this line has now changed three times:
                 *   1. "Magento Egypt"  (the merchant's logo artwork)
                 *   2. "MECommerce"     (QA cycle 1: match the reference)
                 *   3. "Hub Market"     (QA cycle 2, 86d45m4tj item 1-A:
                 *      'We need to change from "mecommerce" to "Hub Market"')
                 * Do not change it again without a ticket in hand.
                 *
                 * "Powered by Magento 2." is appended per the reference's own
                 * copyright line, and it is simply true of this store.
                 *
                 * KNOWN INCONSISTENCY, recorded so it is not rediscovered as a
                 * bug: the header logo is an IMAGE and still reads MAGENTO
                 * EGYPT. Resolving that needs new logo artwork, which is not a
                 * code change.
                 *
                 * Passing the brand as %2 keeps the sentence translatable while
                 * the brand itself never goes through __() — see
                 * header/logo.phtml for why a brand must not be translated.
                 */
                ?>
                <?= $escaper->escapeHtml(
                    __('© %1 %2. All rights reserved. Powered by Magento 2.', date('Y'), 'Hub Market')
                ) ?>
            </p>
            <div class="hm-footer__legal">
                <?= /* @noEscape */ $layout->createBlock(\Magento\Cms\Block\Block::class)
                    ->setBlockId('hm_footer_legal')->toHtml() ?>
            </div>
        </div>
    </div>
</div>
