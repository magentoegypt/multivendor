<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">magentoegypt_herobanner_banner_listing.magentoegypt_herobanner_banner_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>magentoegypt_herobanner_banner_columns</spinner>
        <deps>
            <dep>magentoegypt_herobanner_banner_listing.magentoegypt_herobanner_banner_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Banner</label>
            </button>
        </buttons>
    </settings>

    <dataSource name="magentoegypt_herobanner_banner_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">banner_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MagentoEgypt_HeroBanner::banner</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="magentoegypt_herobanner_banner_listing_data_source">
            <settings>
                <requestFieldName>banner_id</requestFieldName>
                <primaryFieldName>banner_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="magentoegypt_herobanner_banner_columns">
        <settings>
            <editorConfig>
                <param name="indexField" xsi:type="string">banner_id</param>
            </editorConfig>
        </settings>

        <column name="banner_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>

        <column name="slot" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <options class="MagentoEgypt\HeroBanner\Model\Source\Slot"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Slot</label>
            </settings>
        </column>

        <column name="title" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Headline</label>
            </settings>
        </column>

        <column name="kicker" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Kicker</label>
            </settings>
        </column>

        <column name="sort_order" sortOrder="50">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Position</label>
            </settings>
        </column>

        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Enabledisable"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>

        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="70">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>

        <actionsColumn name="actions" class="MagentoEgypt\HeroBanner\Ui\Component\Listing\Column\Actions" sortOrder="80">
            <settings>
                <indexField>banner_id</indexField>
                <resizeEnabled>false</resizeEnabled>
            </settings>
        </actionsColumn>
    </columns>
</listing>
