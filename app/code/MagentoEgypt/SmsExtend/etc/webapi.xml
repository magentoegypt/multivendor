<?xml version="1.0"?>

<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/whatsapp/otp/send" method="POST">
        <service class="MagentoEgypt\SmsExtend\Api\WhatsAppInterface" method="sendOtp"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/whatsapp/otp/verify" method="POST">
        <service class="MagentoEgypt\SmsExtend\Api\WhatsAppInterface" method="verifyOtp"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
</routes>