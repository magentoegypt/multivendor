<?xml version="1.0"?>
<!--
/**
 * hmAppConfig.capabilities lists `fulfillment` while this module is enabled: the app asks for
 * CustomerOrder.hm_fulfillment only then, and shows its delivery section only then.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MagentoEgypt\HubApp\Model\Config\Capabilities">
        <arguments>
            <argument name="modules" xsi:type="array">
                <item name="fulfillment" xsi:type="string">MagentoEgypt_FulfillmentTracking</item>
            </argument>
        </arguments>
    </type>
</config>
