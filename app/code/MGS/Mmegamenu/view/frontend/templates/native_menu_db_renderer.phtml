        .me-native-menu-wrapper .me-nav-item:hover > .me-sub-panel,
        .me-native-menu-wrapper .me-nav-item:focus-within > .me-sub-panel,
        .me-native-menu-wrapper .me-nav-item.me-open > .me-sub-panel {
            display: block !important;
