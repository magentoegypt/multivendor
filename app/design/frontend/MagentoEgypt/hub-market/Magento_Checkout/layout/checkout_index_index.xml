<?xml version="1.0"?>
<!--
/**
 * Hub Market. Checkout: correct page layout, plus the site header and footer.
 *
 * TWO SEPARATE FACTS, EASILY CONFUSED.
 *
 * 1. THE PAGE LAYOUT MUST BE `checkout`. Six modules declare a layout for this
 *    handle and they disagree: core Checkout, CSP and Vnecoms_Sms say
 *    `checkout`; MGS_AjaxCart, Accept_Payments and Vnecoms_Credit say
 *    `1column`. While Amasty's one step checkout was enabled its own handle
 *    settled it at `checkout`. Disabling Amasty removed that tie breaker, a
 *    1column declaration won, and the Knockout checkout stopped mounting: a
 *    spinner, .opc-wrapper at zero height, no sidebar, no inputs. `checkout` is
 *    not cosmetic, it defines the container structure the checkout's own layout
 *    and JS are written against. Declared here so the theme, which is resolved
 *    last, ends the argument.
 *
 * 2. THE HEADER AND FOOTER ARE MISSING BECAUSE `checkout` OMITS THEIR
 *    CONTAINERS, not because anything removes the blocks. Magento_Theme's
 *    default.xml declares them on every page; on this handle their destinations
 *    simply do not exist, so they are dropped. Adding the three containers
 *    1column would have contributed puts them back without touching anything
 *    the checkout defines.
 *
 * Order matters between the two. Adding these containers while the page was on
 * 1column REPLACED the existing ones and discarded the blocks default.xml had
 * already placed in them, which is why an earlier attempt produced a page with
 * neither header nor footer AND a broken form. Both are in this branch's
 * history.
 *
 * Reverting is one attribute: drop layout="checkout" and the referenceContainer
 * block, and the page returns to Magento's logo only checkout header.
 */
-->
<page layout="checkout"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <attribute name="class" value="hm-checkout"/>

        <!--
            The three containers 1column contributes to page.wrapper, and nothing
            else. Names, tags and positions copied from
            vendor/magento/module-theme/view/frontend/page_layout/1column.xml so
            default.xml's blocks resolve exactly as they do on every other page.
        -->
        <referenceContainer name="page.wrapper">
            <container name="header.container" as="header_container"
                       label="Page Header Container"
                       htmlTag="header" htmlClass="page-header" before="main.content"/>
            <container name="page.top" as="page_top"
                       label="After Page Header" after="header.container"/>
            <container name="footer-container" as="footer"
                       label="Page Footer Container"
                       htmlTag="footer" htmlClass="page-footer" before="before.body.end"/>
        </referenceContainer>

        <!--
            The checkout's own logo only header goes, or the page carries two:
            the stub above the real one. The logo the page layout moves into it
            goes with it, which is correct, since the site header renders its own.
        -->
        <referenceContainer name="checkout.header.container" remove="true"/>

        <!--
            The page heading. Magento's checkout declares no title block at all,
            so the document opened with no h1 and the page never named itself —
            the reference leads with "Checkout" over a Cart / Checkout crumb.

            A plain Template block with a theme template: no new class, so this
            needs no di:compile.
        -->
        <referenceContainer name="main.content">
            <block class="Magento\Framework\View\Element\Template"
                   name="hm.checkout.title"
                   before="-"
                   template="Magento_Checkout::checkout-title.phtml"/>
        </referenceContainer>

        <!--
            THIRD CHECKOUT STEP.

            Magento ships two: shipping, then a billing step carrying payment
            selection AND place-order together. The reference splits that into
            Shipping Info / Payment / Review, so a Review step is registered after
            payment and a "Continue to Review" button is added to the payment
            step's own afterMethods region.

            The payment RENDERERS are untouched. Each method owns its place-order
            handler — and one of the three here is a card gateway that may own
            redirect behaviour — so the review step calls the selected renderer's
            existing placeOrder() rather than reimplementing it.
        -->
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="review-step" xsi:type="array">
                                            <item name="component" xsi:type="string">MagentoEgypt_CheckoutExtend/js/view/review-step</item>
                                            <item name="sortOrder" xsi:type="string">3</item>
                                            <item name="config" xsi:type="array">
                                                <item name="template" xsi:type="string">MagentoEgypt_CheckoutExtend/review-step</item>
                                            </item>
                                        </item>
                                        <!--
                                            Step one's field list, matched to the
                                            reference: no Company, and Phone sits
                                            with the name rather than trailing the
                                            address. Country keeps its place ahead
                                            of city/state/ZIP so those three stay
                                            adjacent for the three-up grid row.
                                        -->
                                        <item name="shipping-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="shippingAddress" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="shipping-address-fieldset" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="company" xsi:type="array">
                                                                    <item name="visible" xsi:type="boolean">false</item>
                                                                </item>
                                                                <item name="telephone" xsi:type="array">
                                                                    <item name="sortOrder" xsi:type="string">50</item>
                                                                </item>
                                                                <item name="country_id" xsi:type="array">
                                                                    <item name="sortOrder" xsi:type="string">75</item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                        <item name="billing-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <!--
                                                    DISCOUNT CODE, REMOVED.

                                                    QA cycle 1: "Completely remove the
                                                    Apply Discount Code dropdown/option
                                                    below the payment methods." The
                                                    reference has no coupon field in
                                                    checkout.

                                                    `componentDisabled` rather than a
                                                    `<referenceBlock remove>`: this is a
                                                    UI-component node inside a jsLayout
                                                    array, not a layout block, so there is
                                                    no block name to reference. Disabling
                                                    it stops the component being
                                                    instantiated at all, which is cheaper
                                                    than rendering it and hiding it, and
                                                    leaves no empty container behind.

                                                    THE COUPON FEATURE IS NOT SWITCHED
                                                    OFF — the cart page still carries its
                                                    own "Apply Discount Code" block and
                                                    any active cart price rule still
                                                    applies. Only this entry point goes.
                                                -->
                                                <item name="payment" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="afterMethods" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="discount" xsi:type="array">
                                                                    <item name="config" xsi:type="array">
                                                                        <item name="componentDisabled" xsi:type="boolean">true</item>
                                                                    </item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                        <item name="hm-continue-to-review" xsi:type="array">
                                                            <item name="component" xsi:type="string">MagentoEgypt_CheckoutExtend/js/view/continue-to-review</item>
                                                            <item name="displayArea" xsi:type="string">afterMethods</item>
                                                            <item name="sortOrder" xsi:type="string">100</item>
                                                            <item name="config" xsi:type="array">
                                                                <item name="template" xsi:type="string">MagentoEgypt_CheckoutExtend/continue-to-review</item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>

        <!--
            NO BOTTOM NAVIGATION DURING CHECKOUT (CL036-DEV01.13, on request).

            The bar is added on the `default` handle and shows on every other
            page under 768px. Checkout is the one place five ways out of the
            flow are a liability rather than a convenience, so the block is
            removed here — removed, not hidden, so the markup is not shipped
            either.

            The room reserved for it at the foot of the page is keyed on the
            bar actually being in the document (`:has(> .hm-bottomnav)` in
            _hm-qa03.less), so it disappears with it and checkout does not end
            in 58px of dead space.

            The CART keeps its bar: a shopper reviewing a basket is still
            browsing. So does the order-success page, where "back to the shop"
            is exactly what is wanted.
        -->
        <referenceBlock name="hm.bottom.nav" remove="true"/>
    </body>
</page>
