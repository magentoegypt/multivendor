<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!--
        <referenceContainer name="admin.scope.col.wrap" htmlClass="admin__old" />
        <referenceBlock name="sales_shipment_create" remove="true"/>
        -->

        <referenceBlock name="form">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Vnecoms_VendorsShipping::order/shipment/create/form.phtml</argument>
            </action>
            <arguments>
                <argument name="view_model" xsi:type="object">Vnecoms\VendorsShipping\ViewModel\Shipment\Create\Form</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="order_items">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Vnecoms_VendorsShipping::order/shipment/create/items.phtml</argument>
            </action>
            <arguments>
                <argument name="view_model" xsi:type="object">Vnecoms\VendorsShipping\ViewModel\Shipment\Create\Form</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="shipment_packaging">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Vnecoms_VendorsShipping::order/shipment/packaging/popup.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="shipment_tracking">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Vnecoms_VendorsShipping::order/shipment/tracking.phtml</argument>
            </action>
        </referenceBlock>
        
    </body>
</page>
