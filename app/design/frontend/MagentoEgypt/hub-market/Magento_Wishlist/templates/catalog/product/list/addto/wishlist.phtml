 *
 * Hub Market fork. ONE change: the sprite icon.
 *
 * The card CSS renders these secondary actions as 32px icon buttons and clips
 * their label — that is the design. Core emits only the label, so on the category
 * listing every card showed two empty bordered squares where the wishlist and
 * compare buttons should be. The homepage rails did not have the problem because
 * their template supplies the icon inline.
 *
 * The <span> is KEPT and clipped rather than dropped: with the label gone the
 * control would have no accessible name beyond its title attribute.
 *
 * @var Magento\Wishlist\Block\Catalog\Product\ProductList\Item\AddTo\Wishlist $block
 */
?>
<?php if ($block->getWishlistHelper()->isAllow()) : ?>
    <a href="#"
       class="action towishlist"
       title="<?= $block->escapeHtmlAttr(__('Add to Wish List')) ?>"
       aria-label="<?= $block->escapeHtmlAttr(__('Add to Wish List')) ?>"
       data-post='<?= /* @noEscape */ $block->getAddToWishlistParams($block->getProduct()) ?>'
       data-action="add-to-wishlist"
       role="button">
        <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-wishlist"/></svg>
        <span><?= $block->escapeHtml(__('Add to Wish List')) ?></span>
    </a>
<?php endif; ?>
