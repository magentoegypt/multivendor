<?php
/**
 * Hub Market — logo.
 *
 * dir="ltr" is the important part. In the Figma build the wordmark was two flex
 * siblings, so RTL reversed "MECommerce" into "CommerceME". A wordmark is a
 * single indivisible object and must never mirror, whatever the page direction.
 *
 * ---------------------------------------------------------------------------
 * WHY THIS IS A LOCKUP AND NOT THE ADMIN LOGO IMAGE
 *
 * Figma's brand is a horizontal two-tone wordmark ~26px tall sitting directly on
 * the navy. The admin logo here is `Screenshot_5336.jpg` — 150x120, portrait,
 * emblem stacked over two lines of type, on an OPAQUE WHITE ground. Painted on
 * the navy header it is a white rectangle, which is why the previous pass had to
 * round its corners to make it read as a deliberate chip rather than an artefact.
 * That stopgap is recorded in _hm-header.less.
 *
 * So the mark is derived from the store's OWN artwork rather than replaced: the
 * emblem is cropped out of that JPG, the white ground knocked out to alpha and
 * the ink forced to white, giving web/images/hm-logo-mark.png — a transparent
 * asset that sits on the navy with no chip. The type beside it is live text, so
 * it stays selectable, translatable and crisp at any density, exactly as the
 * reference build renders it.
 *
 * TO GO BACK TO THE ADMIN IMAGE: set $useLockup to false. The raster branch below
 * is the previous template verbatim, so the admin logo keeps working — including
 * for any store view that uploads a proper transparent asset later, at which
 * point the lockup should come out rather than be kept.
 * ---------------------------------------------------------------------------
 *
 * @var \Magento\Theme\Block\Html\Header\Logo $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

$useLockup = true;

/*
 * THE BRAND IS "MAGENTO EGYPT", NOT "MECommerce".
 *
 * This read ME|Commerce, which is the Figma reference build's brand — a design
 * mock's placeholder that reached the live storefront. The merchant's own
 * uploaded logo (pub/media/logo/default/Screenshot_5336.jpg, the same artwork
 * hm-logo-mark.png is cropped from) reads "MAGENTO EGYPT / Multi-Vendors
 * Marketplace", and that artwork is the authority here — there is no
 * general/store_information/name configured on any store view to defer to.
 *
 * Split so the leading word carries the accent, which is what makes this read as
 * Magento|Egypt rather than as one word.
 *
 * NOT run through __(). A wordmark is a brand asset, not UI copy, and translating
 * it piece by piece is worse than leaving it alone. That is not theoretical here:
 * this mark once rendered half-transliterated as "ماجنتو Egypt", because some
 * module shipped an ar_SA entry for "Magento" and none for "Egypt". Nothing on
 * this install translates either word TODAY — checked across every app and
 * vendor i18n file — so passing them through __() would look harmless right up
 * until some module ships one again. The reference build keeps its
 * wordmark in Latin script in both locales for the same reason.
 */
/*
 * "Hub" + "Market" — THE THIRD BRAND STATE, each one QA-directed:
 *   1. Magento|Egypt   (the merchant's logo artwork)
 *   2. ME|Commerce     (QA cycle 1: match the reference)
 *   3. Hub|Market      (QA cycle 2, 86d45m4tj item 1-A: 'change from
 *                       "mecommerce" to "Hub Market"' — everywhere, and the
 *                       header is the most visible instance of all)
 * Split at the word joint so the lead carries the accent, exactly as the
 * reference splits its own two-part mark. The bidi and transliteration
 * reasoning above is unchanged. Do not change it again without a ticket.
 */
$brandLead = 'Hub';
$brandRest = 'Market';
?>
<a class="hm-logo<?= $useLockup ? ' hm-logo--lockup' : '' ?>"
   dir="ltr"
   href="<?= $escaper->escapeUrl($block->getUrl('')) ?>"
   aria-label="<?= $escaper->escapeHtmlAttr(__('Go to Home page')) ?>">
    <?php if ($useLockup): ?>
        <?php /* No emblem. Compared band by band against the prototype (QA
                 cycle 2): the reference header is the text wordmark alone, and
                 the cropped MAGENTO EGYPT mark contradicted the wordmark it
                 sat beside. hm-logo-mark.png stays on disk, unreferenced. */ ?>
        <span class="hm-logo__word" aria-hidden="true">
            <span class="hm-logo__word-lead"><?= $escaper->escapeHtml($brandLead) ?></span><span
                  class="hm-logo__word-rest"><?= $escaper->escapeHtml($brandRest) ?></span>
        </span>
    <?php else: ?>
        <img class="hm-logo__img"
             src="<?= $escaper->escapeUrl($block->getLogoSrc()) ?>"
             alt="<?= $escaper->escapeHtmlAttr($block->getLogoAlt()) ?>"
            <?php if ($block->getLogoWidth()): ?>
             width="<?= $escaper->escapeHtmlAttr($block->getLogoWidth()) ?>"
            <?php endif; ?>
            <?php if ($block->getLogoHeight()): ?>
             height="<?= $escaper->escapeHtmlAttr($block->getLogoHeight()) ?>"
            <?php endif; ?>
        />
    <?php endif; ?>
</a>
