<?xml version="1.0"?>
<!--
/**
 * Hub Market — product detail page.
 *
 * Measured against https://doze-coyote-58038022.figma.site/product/3.
 *
 * The reference stacks the info column in this order: seller, title, rating,
 * price with a savings chip, description, options, quantity, add-to-cart, then
 * three assurances. Magento renders the title OUTSIDE that column entirely — as
 * a page heading above both columns — which is the one structural difference; the
 * rest is styling and two small additions.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <attribute name="class" value="hm-pdp"/>

        <!--
            The title belongs to the info column, not to the page.
            `move` rather than remove-and-recreate: it keeps the same block, so it
            stays the document's one <h1> and keeps whatever other modules have
            attached to it.
        -->
        <move element="page.main.title" destination="product.info.main" before="-"/>

        <!--
            Savings chip, immediately after the price. Renders nothing when the
            product is not discounted.
        -->
        <referenceBlock name="product.info.price">
            <block class="Magento\Framework\View\Element\Template"
                   name="hm.pdp.savings"
                   after="-"
                   template="Magento_Catalog::product/view/savings.phtml">
                <arguments>
                    <argument name="savings" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\ProductSavings</argument>
                </arguments>
            </block>
        </referenceBlock>

        <!--
            Seller credit above the title, which is where the reference opens the
            info column.

            Placed with <move>, not with a `before=` on the block itself. The
            title arrives in this container via <move> too, and a `before=`
            naming it is evaluated while scheduling — before that move has run —
            so the reference does not resolve and the block is quietly appended
            to the end of the column. It rendered under the vendor card. Moves
            are processed after everything is scheduled, so by then the title is
            a real sibling and the reference holds.

            It reuses Vnecoms' own Profile\Title block — same vendor resolution
            as the profile card lower down, so the two can never disagree — with
            this theme's template.
        -->
        <referenceContainer name="product.info.main">
            <block class="Vnecoms\Vendors\Block\Profile\Title"
                   name="hm.pdp.seller"
                   template="Vnecoms_Vendors::profile/seller-line.phtml"/>
        </referenceContainer>
        <move element="hm.pdp.seller" destination="product.info.main" before="page.main.title"/>

        <!--
            Wishlist heart onto the buy row.

            The reference puts the heart beside Add to Cart as a square icon
            button. Core parks it in the `product.info.social` container well
            below the buy box, which is what produced the dead band under the
            button.

            MOVED, not re-rendered. The block carries its own `addToWishlist`
            x-magento-init, and that is what keeps the post payload in step with
            the options chosen on a CONFIGURABLE product. Rebuilding the anchor
            from getAddToWishlistParams() in addtocart.phtml would have looked
            identical and quietly wishlisted the wrong variant.

            `product.info.addtocart` is a real block in Magento_Catalog's own
            catalog_product_view.xml, so this destination exists — a <move> to a
            missing destination DROPS the element instead of no-opping.

            The alias matters: addtocart.phtml pulls it with
            getChildHtml('wishlist') and skips it in the loop that renders the
            block's other children, so it cannot render twice.
        -->
        <move element="view.addto.wishlist" destination="product.info.addtocart" as="wishlist"/>

        <!--
            Compare, removed here rather than through themesettings.
            MGS_ThemeSettings has an observer that unsets `view.addto.compare`
            when themesettings/product_details/compare is 0. That flag is 0 and
            the button still rendered — the module is disabled, so the observer
            never fires and none of those switches do anything. Layout removal
            does not depend on it. The reference PDP draws no Compare control,
            and the listing pages already had theirs removed in default.xml.
        -->
        <referenceBlock name="view.addto.compare" remove="true"/>

        <!--
            Summary paragraph, directly under the price — where the reference
            puts it. Placed after product.info.price rather than replacing
            product.info.overview: that core block renders `short_description`
            and nothing else, and short_description is empty on all 2304
            products here, so it emitted nothing at all.
        -->
        <referenceContainer name="product.info.main">
            <block class="Magento\Catalog\Block\Product\View"
                   name="hm.pdp.summary"
                   after="product.info.price"
                   template="Magento_Catalog::product/view/summary.phtml"/>
        </referenceContainer>

        <!--
            Seller names for the related and upsell cards. Same ViewModel the
            category page passes to its own list template, so a card in these
            rows carries the same seller credit as one on a category page.
        -->
        <referenceBlock name="catalog.product.related">
            <arguments>
                <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="product.info.upsell">
            <arguments>
                <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
            </arguments>
        </referenceBlock>

        <!-- Delivery, returns and payment, under the add-to-cart row. -->
        <referenceContainer name="product.info.main">
            <block class="Magento\Framework\View\Element\Template"
                   name="hm.pdp.assurances"
                   after="product.info.form"
                   template="Magento_Catalog::product/view/assurances.phtml"/>
        </referenceContainer>

        <!--
            Breadcrumbs come from the theme's own template rather than core's,
            which prints an empty div and builds Home + product name in JS. The
            design calls for Home / Category / Product, and the category is
            unreachable through core's widget without turning on
            catalog/seo/product_use_categories — a setting that rewrites every
            product URL. The view model resolves the category instead.
        -->
        <referenceBlock name="breadcrumbs">
            <arguments>
                <argument name="product_crumbs" xsi:type="object">
                    MagentoEgypt\Breadcrumbs\ViewModel\ProductCrumbs
                </argument>
            </arguments>
        </referenceBlock>
        <!--
            UNWANTED ELEMENTS ON THE 3-COLUMN SHAPE.
            MagentoEgypt_VendorExtend's catalog_product_view_amazon_three handle
            builds an Amazon-style column the reference does not draw. These are
            removed as BLOCKS rather than hidden with CSS — a display:none block
            still runs its queries and still ships its markup, and two of these
            are duplicates of something already on the page.

            Each is one line to restore if the business wants it back.
        -->

        <!-- "Fullfilled By ronza" — duplicates the seller credit now above the
             title, and carries a typo. -->
        <referenceBlock name="product.info.vendor.profile.title" remove="true"/>

        <!--
            PDP vendor card, rebuilt to the shared UI.

            Vnecoms stacks six rows in `.vendor-profile-container` — store name,
            description, address, sales, join date, phone, opening hours. The
            design keeps three things: who the seller is, how they are rated, and
            a way through to their shop. The rest is removed as BLOCKS rather than
            hidden in CSS, so the page stops querying and rendering them at all.

            Address in particular was carrying junk: an Egyptian seller filed
            under Andorra, and free-text regions like "999999999". Not something
            to display more prominently on the product page.
        -->
        <!--
            The social container is empty now the wishlist has moved onto the buy
            row, but it was still costing a full 24px of the info column's gap: it
            holds an empty `product-addto-links` wrapper, so `:empty` never
            matched it and the CSS meant to collapse it did nothing.

            Removed as a container rather than hidden — there is nothing left in
            it. Compare was already removed by this theme, and email-to-a-friend
            is off, so `product.info.addto` had no visible children either.
        -->
        <!--
            Buy Now and Add to Quote off the product page.

            Both hang off `product.info.addtocart`, and both ship a SECOND copy on
            `product.info.addtocart.additional` — the block a product WITH options
            renders. Removing only the first pair leaves them on every configurable
            and nowhere else, which is the trap that hid the missing wishlist
            earlier in this branch. All four names are removed.

            Buy Now (Mageprince) skipped the cart entirely; Add to Quote is
            Vnecoms Quotation. Removed as blocks rather than hidden, so neither
            renders, queries, or ships its JS.
        -->
        <referenceBlock name="product.buynow" remove="true"/>
        <referenceBlock name="product.buynow.config" remove="true"/>
        <referenceBlock name="product.info.addtoquote" remove="true"/>
        <referenceBlock name="product.info.additional.addtoquote" remove="true"/>

        <referenceContainer name="product.info.social" remove="true"/>

        <referenceBlock name="vendor.profile.description" remove="true"/>
        <referenceContainer name="vendor.profile.address.container" remove="true"/>
        <referenceContainer name="vendor.profile.sales_joindate.container" remove="true"/>
        <referenceContainer name="vendor.profile.phone_opentime.container" remove="true"/>

        <!--
            Rating and catalogue size, under the store name.

            Reuses Vnecoms' own Profile\Title block class rather than introducing
            one: a NEW class needs a di:compile before layout can reference it, and
            until then Magento drops the block with nothing in the log. This class
            is already compiled and already gives getVendor().

            VendorNames is likewise an EXISTING compiled ViewModel — it is passed
            the same way on the homepage rails — so this argument is safe.
        -->
        <referenceContainer name="vendor.profile.description.container">
            <block class="Vnecoms\Vendors\Block\Profile\Title"
                   name="hm.pdp.vendor.meta"
                   after="vendor.profile.title"
                   template="Vnecoms_Vendors::profile/meta.phtml">
                <arguments>
                    <argument name="vendor_names" xsi:type="object">MagentoEgypt\HomeSections\ViewModel\VendorNames</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!--
            "Visit Store" spans the whole card, so it belongs to the container
            rather than to the text column beside the logo.
        -->
        <referenceContainer name="vendor.profile.container">
            <block class="Vnecoms\Vendors\Block\Profile\Title"
                   name="hm.pdp.vendor.visit"
                   after="vendor.profile.description.container"
                   template="Vnecoms_Vendors::profile/visit-store.phtml">
                <!--
                    getVendorUrl() is NOT computed by the block — it returns
                    getData('vendor_url'), and this child is what sets it: its
                    _prepareLayout() calls setVendorUrl() on its PARENT. Vnecoms
                    attaches the same child to the title and logo blocks for
                    exactly this reason. Without it the URL is empty and the
                    button silently renders nothing, which is what happened on
                    the first pass.
                -->
                <block class="Vnecoms\VendorsPage\Block\Catalog\Product\Profile"
                       name="hm.pdp.vendor.visit.link"/>
            </block>
        </referenceContainer>

        <!-- The SECOND price, at the head of .product-info-last, detached from
             the title it belongs to. -->
        <referenceBlock name="product.price.last" remove="true"/>

        <!-- The attribute table inside the add-to-cart form. The same table is
             the entire content of the More Information tab; this copy pushed the
             cart 196px down the page. -->
        <referenceBlock name="product.info.attribute" remove="true"/>

        <!-- "About this item" — a THIRD copy of the description, after the
             summary under the price and the description tab. -->
        <referenceBlock name="product.info.overview" remove="true"/>

        <!-- Installment strip (تمارا / تابى / After Pay / الراجحى). Not in the
             reference, and those are Gulf BNPL providers on a store that
             delivers inside Egypt and takes COD, Visa and Mastercard. -->
        <referenceContainer name="product.info.main.last.installment" remove="true"/>

        <!-- "Paying off / Delivery by / Sold by" table. The reference draws no
             such block, and the seller credit above the title already carries
             the attribution that matters. -->
        <referenceBlock name="product.info.vendor.profile.soldby" remove="true"/>
    </body>
</page>
