    <!--upload category image-->
    <virtualType name="Vnecoms\VendorsCategory\CategoryImageUpload" type="Magento\Catalog\Model\ImageUploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="string">ves_vendorscategory/tmp/category</argument>
            <argument name="basePath" xsi:type="string">ves_vendorscategory/category</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="png" xsi:type="string">png</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Vnecoms\VendorsCategory\Controller\Vendors\Category\Image\Upload">
        <arguments>
            <argument name="imageUploader" xsi:type="object">Vnecoms\VendorsCategory\CategoryImageUpload</argument>
        </arguments>
    </type>

