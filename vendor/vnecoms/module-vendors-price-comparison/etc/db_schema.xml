<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ves_vendors_comparison_queue" resource="default" engine="innodb" comment="Comparison Queue">
        <column xsi:type="smallint" name="queue_id" padding="6" unsigned="false" nullable="false" identity="true"
                comment="Queue ID"/>
        <column xsi:type="varchar" name="sell_product_id" nullable="false" length="255" comment="Product Id"/>
        <column xsi:type="varchar" name="type" nullable="false" length="255" comment="Type"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="queue_id"/>
        </constraint>
    </table>
</schema>
