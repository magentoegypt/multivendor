<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Success Page</title>
    </head>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">Thank you for your quote request!</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Vnecoms\Quotation\Block\Quote\Success" name="quote.success" template="Vnecoms_Quotation::success.phtml" cacheable="false">
                <container name="quote.success.additional.info" label="Quote Success Additional Info"/>
            </block>
        </referenceContainer>
    </body>
</page>
