<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="master_password" translate="label" type="text" sortOrder="101" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Master Password</label>
            <tab>vnecoms</tab>
            <resource>Vnecoms_MasterPassword::configuration</resource>
            <group id="general" translate="label tooltip" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
            	<label>General</label>
				<field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable extension</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="password" translate="label comment" type="password" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Master Password</label>
                    <comment>You can use this password to login to any customer email account.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
