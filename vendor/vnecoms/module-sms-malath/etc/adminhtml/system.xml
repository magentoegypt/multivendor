<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">
	            	<field id="malath_username" translate="label tooltip" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>User Name</label>
	                    <config_path>vsms/settings/malath_username</config_path>
	                    <depends>
	                        <field id="gateway">malath</field>
	                    </depends>
	                    <comment>Your user name from sms.malath.net.sa</comment>
	                </field>
	                
	                <field id="malath_password" translate="label tooltip" type="text" sortOrder="81" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Password</label>
	                    <config_path>vsms/settings/malath_password</config_path>
	                    <depends>
	                        <field id="gateway">malath</field>
	                    </depends>
	                </field>
	                <field id="malath_sender" translate="label tooltip" type="text" sortOrder="82" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Sender Name</label>
	                    <config_path>vsms/settings/malath_sender</config_path>
	                    <depends>
	                        <field id="gateway">malath</field>
	                    </depends>
	                    <comment>Sender Name musts be actived before do any test.</comment>
	                </field>
                </group>
            </group>
        </section>
    </system>
</config>
