<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">magentoegypt_herobanner_banner_form.banner_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Banner</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="MagentoEgypt\HeroBanner\Block\Adminhtml\Banner\Edit\BackButton"/>
            <button name="save" class="MagentoEgypt\HeroBanner\Block\Adminhtml\Banner\Edit\SaveButton"/>
        </buttons>
        <namespace>magentoegypt_herobanner_banner_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>magentoegypt_herobanner_banner_form.banner_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="banner_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="magentoegypt_herobanner/banner/save"/>
        </settings>
        <dataProvider class="MagentoEgypt\HeroBanner\Model\Banner\DataProvider" name="banner_form_data_source">
            <settings>
                <requestFieldName>banner_id</requestFieldName>
                <primaryFieldName>banner_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">Banner</label>
        </settings>

        <field name="banner_id" formElement="hidden">
            <settings>
                <dataType>number</dataType>
            </settings>
        </field>

        <field name="slot" formElement="select" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">MagentoEgypt\HeroBanner\Model\Source\Slot</item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Slot</label>
                <notice translate="true">Carousel slides fill the large area on the left; tiles stack in the column beside it. Three tiles fit.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="title" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Headline</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="kicker" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Kicker</label>
                <notice translate="true">Small pill above the headline, e.g. "New Season". Carousel slides only.</notice>
            </settings>
        </field>

        <field name="subtitle" formElement="textarea" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Supporting line</label>
            </settings>
        </field>

        <field name="cta_label" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Button label</label>
                <notice translate="true">Carousel slides only. Leave empty for no button.</notice>
            </settings>
        </field>

        <field name="url" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Links to</label>
                <notice translate="true">Path relative to the store, e.g. clothes.html or bundles. A full https:// address is used as-is.</notice>
            </settings>
        </field>

        <field name="image" sortOrder="70">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Image</item>
                    <item name="formElement" xsi:type="string">fileUploader</item>
                    <item name="componentType" xsi:type="string">fileUploader</item>
                    <item name="dataScope" xsi:type="string">image</item>
                    <item name="maxFileSize" xsi:type="number">4194304</item>
                    <item name="allowedExtensions" xsi:type="string">jpg jpeg png webp</item>
                    <item name="uploaderConfig" xsi:type="array">
                        <item name="url" xsi:type="url" path="magentoegypt_herobanner/banner/upload"/>
                    </item>
                    <item name="notice" xsi:type="string" translate="true">Carousel slides are shown at roughly 1600x840; tiles at 800x380.</item>
                </item>
            </argument>
        </field>

        <field name="sort_order" formElement="input" sortOrder="80">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Position</label>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="store_id" formElement="select" sortOrder="90">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Store\Model\System\Store</item>
            </argument>
            <settings>
                <dataType>number</dataType>
                <label translate="true">Store view</label>
                <notice translate="true">Leave on "All Store Views" unless this banner replaces the one at the same position for a single language.</notice>
            </settings>
        </field>

        <field name="is_active" formElement="checkbox" sortOrder="100">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
