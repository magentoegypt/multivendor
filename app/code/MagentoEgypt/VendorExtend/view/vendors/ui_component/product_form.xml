                        </item>
                    </argument>
                </field>
            </container>
            <field name="is_qty_decimal">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="scopeLabel" xsi:type="string" translate="true">[GLOBAL]</item>
                    </item>
                </argument>
            </field>
            <field name="is_decimal_divided">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="scopeLabel" xsi:type="string" translate="true">[GLOBAL]</item>
                    </item>
                </argument>
            </field>
            <container name="container_backorders">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="scopeLabel" xsi:type="string" translate="true">[GLOBAL]</item>
                    </item>
                </argument>
                <field name="backorders">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
