    <route method="PUT" url="/V1/vnecoms-quotation/:messageId">
        <service class="Vnecoms\Quotation\Api\MessageRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Vnecoms_Quotation::Message_update"/>
        </resources>
    </route>
    <route method="DELETE" url="/V1/vnecoms-quotation/:messageId">
        <service class="Vnecoms\Quotation\Api\MessageRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="Vnecoms_Quotation::Message_delete"/>
        </resources>
    </route>
    <route method="POST" url="/V1/vnecoms-quotation/proposal">
