<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vsms">
            <group id="settings">
            	<group id="sms_gateway">
            		<field id="smskannel_url" translate="label tooltip" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Kannel Send Sms URL</label>
	                    <config_path>vsms/settings/smskannel_url</config_path>
	                    <depends>
	                        <field id="gateway">smskannel</field>
	                    </depends>
	                    <comment>e.g. http://smsbox.host.name:13013/cgi-bin/sendsms</comment>
	                </field>
	            	<field id="smskannel_username" translate="label tooltip" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Kannel Username</label>
	                    <config_path>vsms/settings/smskannel_username</config_path>
	                    <depends>
	                        <field id="gateway">smskannel</field>
	                    </depends>
	                </field>
	                <field id="smskannel_password" translate="label tooltip" type="text" sortOrder="61" showInDefault="1" showInWebsite="1" showInStore="0">
	                    <label>Kannel Password</label>
	                    <config_path>vsms/settings/smskannel_password</config_path>
	                    <depends>
	                        <field id="gateway">smskannel</field>
	                    </depends>
	                </field>
                </group>
            </group>
        </section>
    </system>
</config>
