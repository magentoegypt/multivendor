<script>
(function () {
    'use strict';

    var phone = window.matchMedia('(max-width: 767px)');

    /* The chevron shows while more results sit below the visible part of the list. */
    function more(list) {
        list.toggleAttribute('data-hm-more', list.scrollHeight - list.scrollTop - list.clientHeight > 8);
    }

    function tag() {
        var panel = phone.matches && document.querySelector('.aa-Panel'),
            footer,
            link,
            count,
            list;

        if (!panel) {
            return;
        }
        [].forEach.call(panel.querySelectorAll('.aa-Source:not([data-autocomplete-source-id="products"])'), function (source) {
            source.toggleAttribute('data-hm-none', !source.querySelector('.aa-Item'));
        });
        footer = panel.querySelector('#autocomplete-products-footer');
        link = footer && footer.querySelector('a');
        count = footer && /\(([0-9٠-٩][0-9٠-٩.,٬]*)\)/.exec(footer.textContent);
        if (link && count && link.getAttribute('data-hm-count') !== count[1]) {
            link.setAttribute('data-hm-count', count[1]);
        }
        list = panel.querySelector('[data-autocomplete-source-id="products"] > .aa-List');
        if (list) {
            more(list);
        }
    }

    new MutationObserver(tag).observe(document.documentElement, {childList: true, subtree: true});
    document.addEventListener('scroll', function (event) {
        var target = event.target;

        if (target && target.classList && target.classList.contains('aa-List')) {
            more(target);
        }
    }, true);
}());
</script>
