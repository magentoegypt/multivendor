<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">vrma_reason_form.reason_form_data_source</item>
            <item name="deps" xsi:type="string">vrma_reason_form.reason_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">General Information</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">rma_reason_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>


        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">Vnecoms\RMA\Block\Adminhtml\Reason\Edit\BackButton</item>
            <item name="delete" xsi:type="string">Vnecoms\RMA\Block\Adminhtml\Reason\Edit\DeleteButton</item>
            <item name="reset" xsi:type="string">Vnecoms\RMA\Block\Adminhtml\Reason\Edit\ResetButton</item>
            <item name="save" xsi:type="string">Vnecoms\RMA\Block\Adminhtml\Reason\Edit\SaveButton</item>
            <item name="save_and_continue" xsi:type="string">Vnecoms\RMA\Block\Adminhtml\Reason\Edit\SaveAndContinueButton</item>
        </item>

    </argument>
    <dataSource name="reason_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Vnecoms\RMA\Model\Request\Reason\DataProvider</argument>
            <argument name="name" xsi:type="string">reason_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">reason_id</argument>
            <argument name="requestFieldName" xsi:type="string">reason_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" xsi:type="url" path="vrma/reason/save"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="main">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">General Information</item>
            </item>
        </argument>
        <field name="reason_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="dataReason" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">reason</item>
                    <item name="dataScope" xsi:type="string">reason_id</item>
                </item>
            </argument>
        </field>
        <field name="status">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataReason" xsi:type="string">boolean</item>
                    <item name="label" xsi:type="string" translate="true">Status</item>
                    <item name="formElement" xsi:type="string">checkbox</item>
                    <item name="source" xsi:type="string">reason</item>
                    <item name="sortOrder" xsi:type="number">10</item>
                    <item name="dataScope" xsi:type="string">status</item>
                    <item name="prefer" xsi:type="string">toggle</item>
                    <item name="valueMap" xsi:type="array">
                        <item name="true" xsi:type="number">1</item>
                        <item name="false" xsi:type="number">0</item>
                    </item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
        </field>

        <field name="title">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataReason" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Title</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">reason</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                    <item name="dataScope" xsi:type="string">title</item>
                    <item name="required" xsi:type="boolean">true</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>

        <field name="who_pay_shipping">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">\Vnecoms\RMA\Ui\Component\Listing\Columns\Reason\Shipping</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true"> Who Pays for Shipping</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">reason</item>
                    <!--<item name="component" xsi:type="string">Vnecoms_RMA/js/form/element/reason</item>-->
                    <item name="dataScope" xsi:type="string">who_pay_shipping</item>
                    <item name="sortOrder" xsi:type="number">30</item>
                    <item name="default" xsi:type="string">0</item>
                    <item name="required" xsi:type="boolean">true</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>

        <field name="sort_order">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataReason" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Sort Order</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">reason</item>
                    <item name="sortOrder" xsi:type="number">35</item>
                    <item name="dataScope" xsi:type="string">sort_order</item>
                    <item name="validation" xsi:type="array">
                        <item name="validate-number" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>

        <container name="store_view_labels" >
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">40</item>
                </item>
            </argument>
            <htmlContent name="html_content">
                <argument name="block" xsi:type="object">Vnecoms\RMA\Block\Adminhtml\Reason\Edit\Tab\Labels</argument>
            </htmlContent>
        </container>

    </fieldset>

</form>
