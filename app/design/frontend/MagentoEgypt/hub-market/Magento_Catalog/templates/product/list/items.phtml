<?php
/**
 * Hub Market override of Magento_Catalog::product/list/items.phtml.
 *
 * This template renders the cross-sell rail at the foot of /checkout/cart, and
 * it was the last card on the site still emitting the pre-rebuild markup. The
 * rebuilt card CSS sizes `.action.tocart` as a 32px icon button and clips its
 * label, so a button carrying no <svg> painted as a BARE ORANGE SQUARE — four of
 * them, measured at x111-142 on the captured cart page. The photo also sat
 * outside `.product-item-media` and the price outside `.hm-card__foot`, so the
 * card had neither a media band nor a price row.
 *
 * Deltas from core, and nothing else:
 *   1. the two Add to Cart buttons get the #hm-cart sprite icon
 *   2. the photo anchor is wrapped in .product-item-media
 *   3. the price and the action row are wrapped together in .hm-card__foot
 *
 * Keep in step with Magento_CatalogWidget's grid.phtml and Magento_Catalog's
 * list.phtml, which carry the same card.
 */
?>
<?php
/**
 * Copyright © Magento, Inc. All rights reserved.
 * See COPYING.txt for license details.
 */

use Magento\Catalog\Block\Product\ReviewRendererInterface;
use Magento\Catalog\Pricing\Price\FinalPrice;
use Magento\Catalog\Pricing\Price\RegularPrice;
use Magento\Catalog\ViewModel\Product\Listing\PreparePostData;
use Magento\Framework\App\ActionInterface;

/* @var $block \Magento\Catalog\Block\Product\AbstractProduct */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */

/**
 * Seller names for the cards. Supplied as a layout argument, exactly as
 * catalog_category_view.xml supplies it to product/list.phtml — one query for
 * the whole row rather than a vendor load per card.
 *
 * Null-safe: this template also renders in contexts where the argument was not
 * passed (cross-sell in the cart, any third-party block reusing it), and a
 * missing seller name simply omits the line.
 *
 * @var \MagentoEgypt\HomeSections\ViewModel\VendorNames|null $hmVendors
 */
$hmVendors = $block->getData('vendor_names');
?>

<?php
switch ($type = $block->getType()) {

    case 'related-rule':
        if ($exist = $block->hasItems()) {
            $type = 'related';
            $class = $type;

            $image = 'related_products_list';
            $title = __('Related Products');
            $items = $block->getAllItems();
            $limit = $block->getPositionLimit();
            $shuffle = (int) $block->isShuffled();
            $isWeightedRandom = (int) $block->getRotation()->isWeightedRandom($block->getProductListType());
            $canItemsAddToCart = $block->canItemsAddToCart();

            $showAddTo = true;
            /*
             * TRUE since the reference-motion pass (QA cycle 2, item 3-D): the
             * prototype's Related card is the same full card as everywhere
             * else — wishlist disc and a fade-in cart button — where core (and
             * this template until now) rendered Magento's "check items to add
             * to the cart" checkbox instead, so the related row had no cart
             * control at all. With $showCart on, the per-item checkbox branch
             * below is skipped and the standard button branch renders.
             */
            $showCart = true;
            /*
             * SHORT_VIEW, not null.
             *
             * Core sets $templateType = null in all four branches of this
             * template, and getReviewsSummaryHtml($item, null) renders nothing —
             * so the related, upsell and cross-sell rows have never shown a star
             * rating, on any product, however many reviews it has. The PLP and
             * the homepage rails both pass SHORT_VIEW and do show them; these
             * rows were the odd ones out, and the reference puts stars on every
             * card it draws.
             */
            $templateType = ReviewRendererInterface::SHORT_VIEW;
            $description = false;
        }
        break;

    case 'related':
        /** @var \Magento\Catalog\Block\Product\ProductList\Related $block */
        if ($exist = $block->getItems()->getSize()) {
            $type = 'related';
            $class = $type;

            $image = 'related_products_list';
            $title = __('Related Products');
            $items = $block->getItems();
            $limit = 0;
            $shuffle = 0;
            $isWeightedRandom = 0;
            $canItemsAddToCart = $block->canItemsAddToCart();

            $showAddTo = true;
            /*
             * TRUE since the reference-motion pass (QA cycle 2, item 3-D): the
             * prototype's Related card is the same full card as everywhere
             * else — wishlist disc and a fade-in cart button — where core (and
             * this template until now) rendered Magento's "check items to add
             * to the cart" checkbox instead, so the related row had no cart
             * control at all. With $showCart on, the per-item checkbox branch
             * below is skipped and the standard button branch renders.
             */
            $showCart = true;
            $templateType = ReviewRendererInterface::SHORT_VIEW;
            $description = false;
        }
        break;

    case 'upsell-rule':
        if ($exist = $block->hasItems()) {
            $type = 'upsell';
            $class = $type;

            $image = 'upsell_products_list';
            $title = __('We found other products you might like!');
            $items = $block->getAllItems();
            $limit = $block->getPositionLimit();
            $shuffle = (int) $block->isShuffled();
            $isWeightedRandom = (int) $block->getRotation()->isWeightedRandom($block->getProductListType());

            $showAddTo = false;
            $showCart = false;
            $templateType = ReviewRendererInterface::SHORT_VIEW;
            $description = false;
            $canItemsAddToCart = false;
        }
        break;

    case 'upsell':
        /** @var \Magento\Catalog\Block\Product\ProductList\Upsell $block */
        if ($exist = count($block->getItemCollection()->getItems())) {
            $type = 'upsell';
            $class = $type;

            $image = 'upsell_products_list';
            $title = __('We found other products you might like!');
            $items = $block->getItemCollection()->getItems();
            $limit = $block->getItemLimit('upsell');
            $shuffle = 0;
            $isWeightedRandom = 0;

            $showAddTo = false;
            $showCart = false;
            $templateType = ReviewRendererInterface::SHORT_VIEW;
            $description = false;
            $canItemsAddToCart = false;
        }
        break;

    case 'crosssell-rule':
        /** @var \Magento\Catalog\Block\Product\ProductList\Crosssell $block */
        if ($exist = $block->hasItems()) {
            $type = 'crosssell';
            $class = $type;

            $image = 'cart_cross_sell_products';
            $title = __('More Choices:');
            $items = $block->getItemCollection();

            $showAddTo = true;
            $showCart = true;
            $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
            $description = false;
            $canItemsAddToCart = false;
        }
        break;

    case 'crosssell':
        /** @var \Magento\Catalog\Block\Product\ProductList\Crosssell $block */
        if ($exist = count($block->getItems())) {
            $type = 'crosssell';
            $class = $type;

            $image = 'cart_cross_sell_products';
            $title = __('More Choices:');
            $items = $block->getItems();

            $showAddTo = true;
            $showCart = true;
            $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
            $description = false;
            $canItemsAddToCart = false;
        }
        break;

    case 'new':
        if ($exist = $block->getProductCollection()) {
            $type = 'new';
            $mode = 'grid';
            $type = $type . ' ' . $mode;

            $class = 'widget' . ' ' . $type;

            $image = 'new_products_content_widget_grid';
            $title = __('New Products');
            $items = $exist;

            $showAddTo = true;
            $showCart = true;
            $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
            $description = ($mode == 'list') ? true : false;
            $canItemsAddToCart = false;
        }
        break;

    default:
        $exist = null;
}
$_item = null;
?>

<?php if ($exist):?>

    <?php if ($type == 'related' || $type == 'upsell'):?>
        <?php if ($type == 'related'):?>
<div class="block <?= $block->escapeHtmlAttr($class) ?>"
     data-mage-init='{"relatedProducts":{"relatedCheckbox":".related.checkbox"}}'
     data-limit="<?= $block->escapeHtmlAttr($limit) ?>"
     data-shuffle="<?= /* @noEscape */ $shuffle ?>"
     data-shuffle-weighted="<?= /* @noEscape */ $isWeightedRandom ?>">
    <?php else:?>
    <div class="block <?= $block->escapeHtmlAttr($class) ?>"
         data-mage-init='{"upsellProducts":{}}'
         data-limit="<?= $block->escapeHtmlAttr($limit) ?>"
         data-shuffle="<?= /* @noEscape */ $shuffle ?>"
         data-shuffle-weighted="<?= /* @noEscape */ $isWeightedRandom ?>">
        <?php endif; ?>
        <?php else:?>
        <div class="block <?= $block->escapeHtmlAttr($class) ?>">
            <?php endif; ?>
            <?php
            /*
             * Kicker over the heading, like every section head on this site and
             * like the reference, which sets "MORE LIKE THIS" above "Related
             * Products". It is per-row because this template renders three
             * different rows and one label cannot describe all of them.
             */
            $hmKicker = $type === 'related' ? __('More like this')
                : ($type === 'upsell' ? __('You may also like') : null);

            /*
             * "View All" — the reference draws one and I left it out last pass
             * because related products are not a browsable collection, so there
             * was nothing honest to link to.
             *
             * There is: the product's own category. It is a real page of
             * genuinely related items, which is what the shopper clicking
             * "View All" next to "More like this" expects. Deepest category
             * wins (getCategoryCollection returns ancestors too, and "View All"
             * pointing at the site root would be useless).
             *
             * Rendered only when a category resolves — a product in no category
             * gets no link rather than a dead one.
             */
            $hmRailUrl = null;
            if (method_exists($block, 'getProduct') && $block->getProduct()) {
                try {
                    $hmCats = $block->getProduct()->getCategoryCollection()
                        ->addAttributeToSelect('url_key')
                        ->addAttributeToFilter('is_active', 1)
                        ->addAttributeToSort('level', 'DESC')
                        ->setPageSize(1);
                    $hmCat = $hmCats->getFirstItem();
                    if ($hmCat && $hmCat->getId()) {
                        $hmRailUrl = $hmCat->getUrl();
                    }
                } catch (\Throwable $e) {
                    $hmRailUrl = null;
                }
            }
            ?>
            <div class="block-title title hm-rail__head">
                <div class="hm-rail__heading">
                    <?php if ($hmKicker): ?>
                        <span class="hm-rail__kicker"><?= $block->escapeHtml($hmKicker) ?></span>
                    <?php endif; ?>
                    <strong id="block-<?= $block->escapeHtmlAttr($class) ?>-heading" role="heading"
                            aria-level="2"><?= $block->escapeHtml($title) ?></strong>
                </div>
                <?php if ($hmRailUrl): ?>
                    <a class="hm-rail__more" href="<?= $block->escapeUrl($hmRailUrl) ?>">
                        <?= $block->escapeHtml(__('View All')) ?>
                    </a>
                <?php endif; ?>
            </div>
            <div class="block-content content" aria-labelledby="block-<?= $block->escapeHtmlAttr($class) ?>-heading">
                <?php if ($type == 'related' && $canItemsAddToCart && !$showCart):?>
                    <div class="block-actions">
                        <?= $block->escapeHtml(__('Check items to add to the cart or')) ?>
                        <button type="button" class="action select"
                                data-role="select-all"><span><?= $block->escapeHtml(__('select all')) ?></span></button>
                    </div>
                <?php endif; ?>
                <?php
                /*
                 * ONE ROW, CAPPED HERE RATHER THAN IN CSS.
                 *
                 * The reference draws four related products; this install was
                 * building ten, and eight upsells, then hiding all but four with
                 * `:nth-child(n+5){display:none !important}`. Every hidden card
                 * still cost a resized image, a price render, a review summary
                 * and an add-to-cart form — the markup is by far the expensive
                 * part, not the query.
                 *
                 * The CSS cap is gone with this change; keeping both would mean
                 * two places to change the number.
                 *
                 * NOT a limit on the collection: Related and Upsell each declare
                 * a limit API they never apply to their own query, and the hooks
                 * that would fix that (_prepareData) are protected. Limiting the
                 * query needs a plugin on Product::getRelatedProductCollection()
                 * and a DI compile, which is a bigger and riskier change than
                 * the saving justifies on this host — the query is one indexed
                 * link lookup for a single product.
                 */
                $hmRailLimit = 4;
                ?>
                <div class="products wrapper grid products-grid products-<?= $block->escapeHtmlAttr($type) ?>">
                    <ol class="products list items product-items">
                        <?php $hmRendered = 0; ?>
                        <?php foreach ($items as $_item):?>
                            <?php if (++$hmRendered > $hmRailLimit) { break; } ?>
                            <?php $available = ''; ?>
                            <?php if (!$_item->isComposite() && $_item->isSaleable() && $type == 'related'):?>
                                <?php if (!$_item->getRequiredOptions()):?>
                                    <?php $available = 'related-available'; ?>
                                <?php endif; ?>
                            <?php endif; ?>
                            <?php if ($type == 'related' || $type == 'upsell'):?>
                                <li class="item product product-item"
                                id="product-item_<?= /* @noEscape */ $_item->getId() ?>"
                                data-shuffle-group="<?= $block->escapeHtmlAttr($_item->getPriority()) ?>" >
                                <?= /* @noEscape */ $secureRenderer->renderStyleAsTag(
                                    'display:none;',
                                    'li#product-item_' . $_item->getId()
                                ) ?>
                            <?php else:?>
                                <li class="item product product-item">
                            <?php endif; ?>
                            <?php /* Bundles keep a permanently visible action — see list.phtml. */ ?>
                            <?php $hmIsBundle = in_array($_item->getTypeId(), ['bundle', 'new_bundle'], true); ?>
                            <div class="product-item-info <?= /* @noEscape */ $available ?><?= $hmIsBundle ? ' hm-card--bundle' : '' ?>">
                                <?php
                                /*
                                 * Discount and seller, lifted verbatim from this theme's
                                 * product/list.phtml so a card in the related row is the same
                                 * card as one on a category page. They were the two pieces the
                                 * reference draws and this template did not.
                                 *
                                 * Discount comes from the price model, never from special_price
                                 * alone — a special price that is not currently active, or that
                                 * equals the regular price, must not print a badge.
                                 */
                                $hmDiscount = 0;
                                try {
                                    $hmPriceInfo = $_item->getPriceInfo();
                                    $hmRegular   = (float) $hmPriceInfo->getPrice(RegularPrice::PRICE_CODE)->getAmount()->getValue();
                                    $hmFinal     = (float) $hmPriceInfo->getPrice(FinalPrice::PRICE_CODE)->getAmount()->getValue();
                                    if ($hmRegular > 0 && $hmFinal > 0 && $hmFinal < $hmRegular) {
                                        $hmDiscount = (int) round((1 - $hmFinal / $hmRegular) * 100);
                                    }
                                } catch (\Throwable $e) {
                                    $hmDiscount = 0;
                                }
                                $hmVendorName = $hmVendors ? $hmVendors->getName($_item->getData('vendor_id')) : null;
                                ?>
                                <div class="product-item-media">
                                    <a href="<?= $block->escapeUrl($block->getProductUrl($_item)) ?>"
                                       class="product photo product-item-photo">
                                        <?= $block->getImage($_item, $image)->toHtml() ?>
                                    </a>
                                    <?php if ($hmDiscount > 0): ?>
                                        <span class="hm-badge hm-badge--discount">
                                            <?= $block->escapeHtml(__('-%1%', $hmDiscount)) ?>
                                        </span>
                                    <?php endif; ?>
                                </div>
                                <div class="product details product-item-details">
                                    <?php if ($hmVendorName): ?>
                                        <span class="hm-card__vendor"><?= $block->escapeHtml($hmVendorName) ?></span>
                                    <?php endif; ?>
                                    <strong class="product name product-item-name"><a
                                                class="product-item-link"
                                                title="<?= $block->escapeHtmlAttr($_item->getName()) ?>"
                                                href="<?= $block->escapeUrl($block->getProductUrl($_item)) ?>">
                                            <?= $block->escapeHtml($_item->getName()) ?></a>
                                    </strong>

                                    <?php if ($templateType):?>
                                        <?php /*
                                            THIRD ARGUMENT IS THE POINT. Core's ReviewRenderer returns an
                                            empty string before it reaches any template when a product has
                                            no rating summary:
                                                if (null === getRatingSummary() && !$displayIfNoReviews) return '';
                                            Passing true is the only way this theme's override of
                                            summary_short.phtml gets to draw its empty five-star track, which
                                            is what keeps every card in a row the same height. 94% of this
                                            catalogue carries no review, so without it the rows render ragged —
                                            the defect QA cycle 1 filed as "star ratings missing" against five
                                            separate sections.
                                        */ ?>
                                        <?= $block->getReviewsSummaryHtml($_item, $templateType, true) ?>
                                    <?php endif; ?>

                                    <?php if ($canItemsAddToCart && !$_item->isComposite() && $_item->isSaleable()
                                        && $type == 'related' && !$showCart):?>
                                        <?php if (!$_item->getRequiredOptions()):?>
                                            <div class="field choice related">
                                                <input
                                                    type="checkbox"
                                                    class="checkbox related"
                                                    id="related-checkbox<?= $block->escapeHtmlAttr($_item->getId()) ?>"
                                                    name="related_products[]"
                                                    value="<?= $block->escapeHtmlAttr($_item->getId()) ?>" />
                                                <label class="label"
                                                       for="related-checkbox<?= $block->escapeHtmlAttr($_item->getId())
                                                        ?>"><span><?= $block->escapeHtml(__('Add to Cart')) ?></span>
                                                </label>
                                            </div>
                                        <?php endif; ?>
                                    <?php endif; ?>

                                    <div class="hm-card__foot">
                                    <?= /* @noEscape */ $block->getProductPrice($_item) ?>

                                    <?php if ($showAddTo || $showCart):?>
                                        <?php // phpcs:disable ?>
                                        <div class="product actions product-item-actions">
                                            <?php if ($showCart):?>
                                                <div class="actions-primary">
                                                <?php if ($_item->isSaleable()):?>
                                                    <?php if (!$_item->getTypeInstance()->isPossibleBuyFromList($_item)):?>
                                                        <button
                                                                class="action tocart primary"
                                                                data-mage-init='{"redirectUrl": {"url": "<?= $block->escapeUrl($block->getAddToCartUrl($_item)) ?>"}}' type="button" title="<?= $block->escapeHtmlAttr(__('Add to Cart')) ?>">
                                                            <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-cart"/></svg>
                                                            <span><?= $block->escapeHtml(__('Add to Cart')) ?></span>
                                                        </button>
                                                    <?php else :?>
                                                        <?php
                                                        /** @var $viewModel PreparePostData */
                                                        $viewModel = $block->getViewModel();
                                                        $postArray = $viewModel->getPostData(
                                                            $block->escapeUrl($block->getAddToCartUrl($_item)),
                                                            ['product' => $_item->getEntityId()]
                                                        );
                                                        $value = $postArray['data'][ActionInterface::PARAM_NAME_URL_ENCODED];
                                                        ?>
                                                        <form data-role="tocart-form"
                                                              data-product-sku="<?= $block->escapeHtmlAttr($_item->getSku()) ?>"
                                                              action="<?= $block->escapeUrl($block->getAddToCartUrl($_item)) ?>"
                                                              method="post">
                                                            <input type="hidden" name="product"
                                                                   value="<?= /* @noEscape */ (int)$_item->getEntityId() ?>">
                                                            <input type="hidden"
                                                                   name="<?= /* @noEscape */ ActionInterface::PARAM_NAME_URL_ENCODED?>"
                                                                   value="<?= /* @noEscape */ $value ?>">
                                                            <?= $block->getBlockHtml('formkey') ?>
                                                            <button type="submit"
                                                                    title="<?= $block->escapeHtmlAttr(__('Add to Cart')) ?>"
                                                                    class="action tocart primary">
                                                                <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-cart"/></svg>
                                                            <span><?= $block->escapeHtml(__('Add to Cart')) ?></span>
                                                            </button>
                                                        </form>
                                                    <?php endif; ?>
                                                <?php else:?>
                                                    <?php if ($_item->isAvailable()):?>
                                                        <div class="stock available">
                                                            <span><?= $block->escapeHtml(__('In stock')) ?></span>
                                                        </div>
                                                    <?php else:?>
                                                        <div class="stock unavailable">
                                                            <span><?= $block->escapeHtml(__('Out of stock')) ?></span>
                                                        </div>
                                                    <?php endif; ?>
                                                <?php endif; ?>
                                                </div>
                                            <?php endif; ?>

                                            <?php if ($showAddTo):?>
                                                <div class="secondary-addto-links actions-secondary"
                                                     data-role="add-to-links">
                                                    <?php if ($addToBlock = $block->getChildBlock('addto')):?>
                                                        <?= $addToBlock->setProduct($_item)->getChildHtml() ?>
                                                    <?php endif; ?>
                                                </div>
                                            <?php endif; ?>
                                        </div>
                                        <?php // phpcs:enable ?>
                                    <?php endif; ?>
                                    </div>
                                </div>
                            </div>
                            </li>
                        <?php endforeach ?>
                    </ol>
                </div>
            </div>
        </div>
        <?php if (!$block->isRedirectToCartEnabled() && $_item):?>
            <script type="text/x-magento-init">
            {
                "[data-role=tocart-form], .form.map.checkout": {
                    "catalogAddToCart": {
                        "product_sku": "<?= $block->escapeJs($_item->getSku()) ?>"
                    }
                }
            }
            </script>
        <?php endif;?>
        <?php endif;?>
