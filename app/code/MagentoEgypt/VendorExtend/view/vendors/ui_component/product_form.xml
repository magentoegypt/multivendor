                            <item name="scopeLabel" xsi:type="string" translate="true">[GLOBAL]</item>
                        </item>
                    </argument>
                </field>
            </container>
            <container name="container_is_in_stock">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="scopeLabel" xsi:type="string" translate="true">[GLOBAL]</item>
                    </item>
                </argument>
                <field name="is_in_stock">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="scopeLabel" xsi:type="string" translate="true">[GLOBAL]</item>
                        </item>
                    </argument>
                </field>
            </container>
        </fieldset>
    </modal>
</form>
