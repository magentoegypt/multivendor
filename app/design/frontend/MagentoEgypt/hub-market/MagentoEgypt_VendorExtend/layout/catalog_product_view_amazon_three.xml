<?xml version="1.0"?>
<!--
/**
 * Hub Market — placement for the 3-columns-product PDP only.
 *
 * MagentoEgypt_VendorExtend nests .product-info-content and .product-info-last
 * inside product.info.main on this shape, so the seller credit and the summary
 * have to be moved into the content container to sit with the title and price.
 *
 * These moves MUST live in this handle and not in catalog_product_view.xml.
 * A <move> whose destination does not exist does not quietly no-op — it DROPS
 * the element. Putting them in the shared file removed the seller line and the
 * summary from every 1column product on the site, which is exactly what
 * happened and what this file exists to prevent.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <move element="hm.pdp.seller"  destination="product.info.main.content" before="-"/>
        <move element="hm.pdp.summary" destination="product.info.main.content" after="product.info.price"/>

        <!--
            Delivery estimate (TC72-QA01 item 5). The MGS demo CMS block it replaces printed a
            hand-typed "26 EGP, July 9 - 10" on every page of this layout. The fee now comes from
            the flat-rate carrier in the store currency, and the dates are today + min/max days,
            worked out in the browser (the page is cached). See the template.
        -->
        <referenceBlock name="custom.product.detail.after.price" remove="true"/>
        <referenceContainer name="product.info.main.last">
            <block class="Magento\Framework\View\Element\Template"
                   name="hm.pdp.delivery.estimate"
                   template="Magento_Catalog::product/view/delivery-estimate.phtml"
                   before="-">
                <arguments>
                    <argument name="min_days" xsi:type="number">2</argument>
                    <argument name="max_days" xsi:type="number">4</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
