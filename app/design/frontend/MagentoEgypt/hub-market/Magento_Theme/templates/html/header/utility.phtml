<?php
/**
 * Hub Market — header utility bar (band 1 of 3).
 *
 * Carries the delivery promise, the store/language switcher and the account
 * links. Magento's own header.panel.wrapper is removed in favour of this.
 *
 * The delivery promise is deliberately a CMS block (`hm_delivery_promise`) and
 * not hard-coded copy: the Figma build hard-coded "Free delivery on orders over
 * AED 150" in one place and three different thresholds in two currencies
 * elsewhere. One editable source avoids repeating that.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

/*
 * See the long note on the auth links below: this boolean comes from the cache
 * CONTEXT, which the full-page cache varies on, not from the customer session.
 */
$authState  = $block->getChildBlock('authState');
$isLoggedIn = $authState !== false && $authState->isLoggedIn();
?>
<div class="hm-header__utility">
    <div class="hm-header__utility-inner">
        <?php
        /*
         * A <div>, NOT a <p>.
         *
         * The CMS block below outputs its own <p>. A <p> inside a <p> is invalid
         * HTML, so the browser auto-closes the outer one — and the promise text
         * stopped being a child of this element and became a SIBLING flex item of
         * the utility row. With `justify-content: space-between` and three items
         * instead of two, that pushed the text into the middle of the bar.
         *
         * Measured before the fix: .hm-header__promise was 16px wide — the truck
         * icon alone. Figma left-aligns this text; it was never a CSS alignment
         * problem, it was invalid nesting.
         */
        ?>
        <div class="hm-header__promise">
            <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-delivery"/></svg>
            <?= /* @noEscape */ $block->getLayout()
                ->createBlock(\Magento\Cms\Block\Block::class)
                ->setBlockId('hm_delivery_promise')
                ->toHtml() ?>
        </div>

        <div class="hm-header__utility-right">
            <?php
            /*
             * Language switcher — FIRST in the rail, as Figma orders it
             * (globe + عربي, then Login / Register / Sell / Track Order / Help).
             * It was last here, which put the one control the Arabic-speaking
             * majority reaches for at the far end of the row.
             *
             * Being first also anchors the divider rules in _hm-header.less: every
             * rail item draws a leading hairline and the first one suppresses it.
             * Renders only when more than one store view is active.
             */
            ?>
            <?php $switcher = $block->getChildHtml('store_switcher'); ?>
            <?php if (trim((string) $switcher) !== ''): ?>
                <div class="hm-utility__lang">
                    <?php /* Globe icon, as Figma shows. Decorative — the switcher's
                             own "Language" label already names the control. */ ?>
                    <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-globe"/></svg>
                    <?= /* @noEscape */ $switcher ?>
                </div>
            <?php endif; ?>

            <?php
            /*
             * Auth-dependent links.
             *
             * THE BOOLEAN COMES FROM THE CACHE CONTEXT, NOT THE SESSION. This
             * header sits inside full-page cache, so a PHP `if` on
             * Customer\Model\Session would bake one visitor's state into the
             * shared page. `AuthorizationLink::isLoggedIn()` instead reads
             * Magento\Framework\App\Http\Context, and the FPC varies its
             * entries by that context — guests and signed-in customers get
             * separate cached copies, which is exactly what core's own
             * authorization-link.phtml relies on.
             *
             * This used to ship BOTH branches and let Knockout pick from the
             * `customer` customer-data section. QA signed in and this strip
             * still read "Login | Register" (CL036-DEV01.05 follow-up): that
             * section is per-visitor, lives in localStorage, and only refreshes
             * when the action that changed it is listed in a sections.xml —
             * something in this store's login path leaves it holding the guest
             * copy. It is NOT a server problem: asked directly, the section
             * returns {"fullname":"test dev5",...} for that customer.
             *
             * The NAME still comes from Knockout, and must: the FPC varies on
             * "is anyone signed in", not on WHO, so rendering a first name here
             * would serve one customer's name to the next. When the section is
             * stale the bound label simply falls back to the server-rendered
             * "My Account", which is why that text is written out rather than
             * left to the binding.
             */
            ?>
            <span class="hm-utility__auth" data-bind="scope: 'customer'">
                <?php if ($isLoggedIn): ?>
                    <a class="hm-utility__link" href="<?= $escaper->escapeUrl($block->getUrl('customer/account')) ?>">
                        <span data-bind="text: customer().firstname || '<?= $escaper->escapeJs(__('My Account')) ?>'"><?= $escaper->escapeHtml(__('My Account')) ?></span>
                    </a>
                    <?php /* Logout accepts GET in 2.4.8 (Controller\Account\Logout
                             implements HttpGetActionInterface AND HttpPostActionInterface),
                             so a plain link avoids baking a form key into cached HTML. */ ?>
                    <a class="hm-utility__link" href="<?= $escaper->escapeUrl($block->getUrl('customer/account/logout')) ?>">
                        <?= $escaper->escapeHtml(__('Sign Out')) ?>
                    </a>
                <?php else: ?>
                    <a class="hm-utility__link" href="<?= $escaper->escapeUrl($block->getUrl('customer/account/login')) ?>">
                        <?= $escaper->escapeHtml(__('Login')) ?>
                    </a>
                    <a class="hm-utility__link" href="<?= $escaper->escapeUrl($block->getUrl('customer/account/create')) ?>">
                        <?= $escaper->escapeHtml(__('Register')) ?>
                    </a>
                <?php endif; ?>
            </span>
            <script type="text/x-magento-init">
                {
                    "*": {
                        "Magento_Ui/js/core/app": {
                            "components": {
                                "customer": {
                                    "component": "Magento_Customer/js/view/customer"
                                }
                            }
                        }
                    }
                }
            </script>
            <?php /* "Hub Market", not MECommerce — QA cycle 2 item 1-A reversed
                     the cycle-1 reversal: every brand string on the storefront
                     now reads Hub Market. The brand is part of the translated
                     string here because the Arabic store writes the brand in
                     Arabic script inside this label. */ ?>
            <a class="hm-utility__link hm-utility__link--sell" href="<?= $escaper->escapeUrl($block->getUrl('marketplace/seller/register')) ?>">
                <?= $escaper->escapeHtml(__('Sell on Hub Market')) ?>
            </a>
            <a class="hm-utility__link" href="<?= $escaper->escapeUrl($block->getUrl('sales/guest/form')) ?>">
                <?= $escaper->escapeHtml(__('Track Order')) ?>
            </a>
            <a class="hm-utility__link" href="<?= $escaper->escapeUrl($block->getUrl('contact')) ?>">
                <svg class="hm-icon hm-icon--sm" aria-hidden="true" focusable="false"><use href="#hm-phone"/></svg>
                <?= $escaper->escapeHtml(__('Help')) ?>
            </a>

        </div>
    </div>
</div>
