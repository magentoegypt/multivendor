<?xml version="1.0"?>
<!--
    Defaults of Stores > Configuration > Magento Egypt > Hub Market App > WhatsApp Sign-in (App).
    Answers do not reveal whether a number has an account; every code sent is a paid message.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <hubapp>
            <otp>
                <reveal_unknown_number>0</reveal_unknown_number>
                <send_limit_ip_hour>10</send_limit_ip_hour>
                <send_limit_number_hour>5</send_limit_number_hour>
            </otp>
        </hubapp>
    </default>
</config>
